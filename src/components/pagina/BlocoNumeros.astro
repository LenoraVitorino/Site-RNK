---
/**
 * Bloco 'numeros' das internas. Especificação: docs/04-design/paginas-internas.md, "numeros".
 *
 * Duas formas, as duas sem contador e sem amarelo:
 * - Régua (padrão: Treinamento CRM, Cultura Pro, Contato): a régua de
 *   números do método da home, valor light grande e legenda curta embaixo;
 *   no celular, linhas 'valor | legenda', como o .metodo__numero.
 * - Régua compacta (`compacto: true`, Contato, 29/09/2026): os mesmos
 *   cartões, baixos, com valor e legenda lado a lado.
 * - Grade (`grade: true`, Revena Full): cartões do Features com a estrutura
 *   da ficha de Resultados, índice no topo e a palavra no pé.
 *
 * partesNumero() só divide a frase: as duas spans, com o espaço real entre
 * elas, somam o item tal como está nos dados. Quando o valor termina em ':'
 * ('GPTW:', '1ª semana:'), o sinal sai da escala grande e fica só para o
 * leitor de tela, como os valores da home, que não levam pontuação. O texto
 * do DOM continua idêntico ao dado. A flag `fundo` é ignorada.
 *
 * Tons (ritmo-dobras-internas.md): valor e palavra em --int-tinta; legenda,
 * nota e cartão já seguem --int-mudo, --int-apoio e --int-cartao.
 */
import CabecaSecao from './CabecaSecao.astro';
import { classesSecao, indice2, partesNumero, type BlocoDe, type ContextoSecao } from './contexto';

interface Props {
  bloco: BlocoDe<'numeros'>;
  secao: ContextoSecao;
}

const { bloco, secao } = Astro.props;
const titulo = bloco.h2;
const n = bloco.itens.length;
/* A nota que começa com aspas é uma fala (Cultura Pro): vira citação. */
const notaCitacao = !!bloco.nota && /^["“”«]/.test(bloco.nota.trim());
const iNota = Math.min(n, 5);
---
<section
  class:list={classesSecao(secao, 'int-numeros', bloco.grade ? 'int-numeros--grade' : 'int-numeros--regua', !bloco.grade && bloco.compacto && 'int-numeros--compacto')}
  id={secao.id}
  data-cena={secao.cena}
  data-tom={secao.tom}
  aria-labelledby={titulo ? secao.tituloId : undefined}
>
  <div class="container">
    {titulo && <CabecaSecao id={secao.tituloId} titulo={titulo} />}

    {bloco.grade ? (
      <ol class="int-numeros__grade" role="list">
        {bloco.itens.map((item, i) => (
          <li class="int-cartao int-numeros__cartao entra" style={`--i:${Math.min(i, 4)}`}>
            <span class="int-indice" aria-hidden="true">{indice2(i + 1)}</span>
            <span class="int-numeros__palavra">{item}</span>
          </li>
        ))}
      </ol>
    ) : (
      <ul class="int-regua" role="list" style={`--n:${Math.min(n, 4)}; --n-tab:${n === 3 ? 3 : 2}`}>
        {bloco.itens.map((item, i) => {
          const [valor, legenda] = partesNumero(item);
          return (
            <li class="int-regua__item entra" style={`--i:${Math.min(i, 4)}`}>
              <span class="int-regua__valor">{valor.endsWith(':')
                ? <>{valor.slice(0, -1)}<span class="visually-hidden">:</span></>
                : valor}</span>
              {legenda && <>{' '}<span class="int-regua__legenda">{legenda}</span></>}
            </li>
          );
        })}
      </ul>
    )}

    {bloco.nota && (
      bloco.grade
        ? <p class="int-numeros__nota entra" style={`--i:${iNota}`}>{bloco.nota}</p>
        : notaCitacao
          ? <p class="int-citacao int-regua__nota entra" style={`--i:${iNota}`}>{bloco.nota}</p>
          : <p class="int-cabeca__apoio int-regua__nota entra" style={`--i:${iNota}`}>{bloco.nota}</p>
    )}
  </div>
</section>

<style>
  /* ---------- Régua: a dos números do método, sem contador ---------- */
  .int-regua {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px); align-items: start;
  }
  /* Cada item ocupa duas linhas da grade (valor, legenda) em subgrid: quando
     um valor quebra em duas linhas, as legendas da fileira seguem juntas. */
  /* Cartões em degradê (28/09, referência de card de preço da Lenora): luz
     cinza vinda do canto de cima que escurece até quase preto embaixo, borda
     clara fina e brilho na aresta de cima. Os valores ficam numa linha só,
     na mesma altura. */
  .int-regua { gap: 8px; }
  .int-regua__item {
    position: relative; overflow: hidden;
    min-width: 0; display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 12px;
    padding: clamp(24px, 2.4vw, 36px); border-radius: 18px;
    background:
      radial-gradient(120% 95% at 22% 0%, rgb(255 255 255 / .2) 0%, rgb(255 255 255 / .06) 38%, transparent 70%),
      linear-gradient(180deg, rgb(42 42 41 / .6) 0%, rgb(20 20 19 / .7) 55%, rgb(11 11 11 / .8) 100%);
    border: 1px solid rgb(255 255 255 / .14);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .2), 0 24px 48px -28px rgb(0 0 0 / .4);
    -webkit-backdrop-filter: blur(16px) saturate(1.15); backdrop-filter: blur(16px) saturate(1.15);
  }
  .int-regua__item::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / .4), transparent);
  }
  .int-regua__valor {
    display: block; font-family: var(--font-titulo); font-weight: 300;
    font-size: clamp(24px, 1.9vw, 34px); line-height: 1.05; letter-spacing: -.045em;
    font-variant-numeric: tabular-nums; color: #f2f2ee; white-space: nowrap;
  }
  .int-regua__legenda { display: block; font-size: 15px; line-height: 1.5; color: rgb(242 242 238 / .72); max-width: 26ch; }
  /* Com o valor numa linha só, quatro colunas só a partir de 1200px: abaixo
     disso 'Sem equipe nova' passava da coluna. */
  @media (max-width: 1199.98px) {
    .int-regua { grid-template-columns: repeat(var(--n-tab, 2), minmax(0, 1fr)); }
  }
  .int-regua__nota { margin-top: clamp(40px, 5vw, 72px); }

  /* Régua compacta (Contato): o cartão da altura da informação. Valor e
     legenda na mesma linha, alinhados pela base; menos respiro interno. */
  .int-numeros--compacto .int-regua__item {
    grid-row: auto; grid-template-rows: none;
    display: flex; align-items: baseline; gap: 14px;
    padding: 20px 24px; border-radius: 14px;
  }
  .int-numeros--compacto .int-regua__valor { font-size: clamp(24px, 1.9vw, 30px); flex: none; }
  .int-numeros--compacto .int-regua__legenda { font-size: 14px; max-width: none; }

  /* ---------- Grade: cartões do Features com a ficha de Resultados ---------- */
  .int-numeros__grade {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--int-gap-cartoes);
  }
  .int-numeros__cartao { display: flex; flex-direction: column; min-width: 0; min-height: clamp(150px, 13vw, 190px); }
  .int-numeros__palavra {
    margin-top: auto; padding-top: 24px;
    font-family: var(--font-titulo); font-weight: 300; font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.1; letter-spacing: -.04em; color: var(--int-tinta);
    overflow-wrap: break-word;
  }
  .int-numeros__nota { margin-top: 32px; font-size: 18px; line-height: 1.55; color: var(--int-apoio); max-width: 56ch; }

  /* No tablet, duas colunas; com três números, três (senão o terceiro
     ficava sozinho na segunda fileira). */
  @media (max-width: 899.98px) {
    .int-regua { grid-template-columns: repeat(var(--n-tab, 2), minmax(0, 1fr)); }
    .int-numeros__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* No celular a régua empilha valor e legenda, como no tablet. Em linhas
     'valor | legenda' a coluna do valor tinha 118 a 145px e partia os números
     ao meio ('R$5k a / R$40k', 'Sem equipe / nova'). */
  @media (max-width: 599.98px) {
    .int-regua { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .int-regua__item { grid-row: auto; grid-template-rows: none; row-gap: 6px; }
    .int-regua__valor { font-size: 28px; }
    .int-regua__legenda { max-width: 32ch; }
    .int-numeros--compacto .int-regua__item { padding: 16px 20px; }
    .int-numeros--compacto .int-regua__valor { font-size: 24px; }
    /* Dois cartões por linha até 360px: a palavra inteira ('Experiência')
       cabe sem hifenizar com um respiro interno menor. */
    .int-numeros__cartao { padding: 20px; min-height: 140px; }
    .int-numeros__palavra { font-size: 21px; }
  }
  @media (max-width: 359.98px) {
    .int-numeros__grade { grid-template-columns: minmax(0, 1fr); }
    .int-numeros__cartao { padding: 24px; }
    .int-numeros__palavra { font-size: 24px; }
  }
</style>
