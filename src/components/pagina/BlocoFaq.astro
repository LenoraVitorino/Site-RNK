---
/**
 * Bloco 'faq' das internas. Especificação: docs/04-design/paginas-internas.md,
 * emenda E2 (prevalece sobre o mapeamento "faq").
 *
 * Grade editorial com o título preso à esquerda (preset Operação) e, à
 * direita, o acordeão em caixas grafite do pin 800022321353572224:
 * <details> nativo, pergunta à esquerda e um Plus que gira 45° quando abre.
 * A primeira pergunta nasce aberta. Sem JS, sem chevron, sem fio.
 * A altura animada é só aprimoramento (interpolate-size + ::details-content).
 */
import CabecaSecao from './CabecaSecao.astro';
import Icone from '../ui/Icone.astro';
import { classesSecao, type BlocoDe, type ContextoSecao } from './contexto';

interface Props {
  bloco: BlocoDe<'faq'>;
  secao: ContextoSecao;
}

const { bloco, secao } = Astro.props;
---
<section class:list={classesSecao(secao, 'int-faq')} id={secao.id} data-cena={secao.cena} aria-labelledby={secao.tituloId}>
  <div class="container int-grade-2">
    <CabecaSecao id={secao.tituloId} titulo={bloco.h2} classe="int-cabeca--coluna int-grade-2__fixo" />

    <div class="int-faq__lista">
      {bloco.perguntas.map((q, i) => (
        <details class="int-faq__item entra" style={`--i:${Math.min(i, 5)}`} open={i === 0}>
          <summary class="int-faq__resumo">
            <h3 class="int-faq__pergunta">{q.p}</h3>
            <span class="int-faq__icone" aria-hidden="true"><Icone nome="Plus" size={18} /></span>
          </summary>
          <p class="int-faq__resposta">{q.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .int-faq__lista { display: grid; gap: 8px; }

  .int-faq__item { border-radius: 16px; background: rgb(242 242 238 / .06); interpolate-size: allow-keywords; }
  /* O foco vai na caixa inteira, não só na linha da pergunta. */
  .int-faq__item:has(.int-faq__resumo:focus-visible) { outline: 2px solid var(--papel); outline-offset: 3px; }

  .int-faq__resumo {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 22px 24px; cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
  .int-faq__resumo::-webkit-details-marker { display: none; }
  .int-faq__resumo::marker { content: ''; }
  .int-faq__resumo:focus-visible { outline: none; }

  .int-faq__pergunta { font-size: clamp(17px, 1.4vw, 20px); font-weight: 400; line-height: 1.35; letter-spacing: -.02em; color: var(--papel); text-wrap: pretty; }

  .int-faq__icone { display: grid; place-items: center; flex-shrink: 0; width: 18px; height: 18px; color: var(--papel); transition: transform .45s var(--easing); }
  .int-faq__item[open] .int-faq__icone { transform: rotate(45deg); }

  .int-faq__resposta { max-width: 60ch; padding: 0 24px 24px; font-size: 16px; line-height: 1.65; color: var(--int-apoio); }

  /* Altura animada onde o navegador sabe interpolar até auto. */
  @supports (interpolate-size: allow-keywords) {
    .int-faq__item::details-content {
      block-size: 0; overflow: clip;
      transition: block-size .5s var(--easing), content-visibility .5s allow-discrete;
    }
    .int-faq__item[open]::details-content { block-size: auto; }
  }

  @media (max-width: 599.98px) {
    .int-faq__resumo { gap: 16px; padding: 20px; }
    .int-faq__resposta { padding: 0 20px 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .int-faq__icone { transition: none; }
    .int-faq__item::details-content { transition: none; }
  }
</style>
