---
/**
 * S4 · A casa (docs/04-design/pagina-sobre.md, (a) "S4", com a emenda ES1).
 * O arquivo do estúdio: cartões de foto numa fileira que sangra à direita,
 * com rolagem horizontal nativa, sobre a cena (28/09/2026: saiu o grafite,
 * para nunca haver duas dobras sólidas encostadas). Referência: Apparatus
 * (cartões no escuro, em ritmo de catálogo), sem os fios: a separação é
 * feita por espaço.
 *
 * Cabeça na .sb-grade: H2 nas colunas 1–6, texto nas 1–5 e as setas nas
 * 11–12, no pé da cabeça. O trilho fica fora do .container e começa no
 * mesmo recuo da grade (--grid-inset), de modo que o 1º cartão alinha com
 * o H2 e a fileira passa da borda direita.
 *
 * O trilho rolável é o div com role="region" (foco pelo teclado, rola pelas
 * setas do teclado); dentro dele, a ul com role="list". Assim a lista
 * continua lista para o leitor de tela, o que não aconteceria com
 * role="region" na própria ul (desvio consciente da especificação).
 * data-cena="pilares" e data-tom="cena": fundo transparente. A cabeça
 * entra na máscara de leitura (TEXTOS_INTERNAS em fundo-internas.ts); as
 * setas são de vidro fosco, legíveis sobre qualquer quadro da cena.
 *
 * Movimento: sem autoplay, sem trava e sem arrastar por JS. As setas só
 * chamam scrollBy; o resto é a rolagem nativa. Com (hover: none) elas
 * somem, e o dedo rola o trilho.
 */
import CartaoFoto from './CartaoFoto.astro';
import Icone from '../ui/Icone.astro';
import { casa, casaCartoes } from '../../data/sobre';

const retrato = (proporcao: string) => proporcao === '4 / 5';
/* sizes a partir das larguras do CSS abaixo: 3:2 = clamp(280px, 40vw, 640px)
   e 4:5 = clamp(220px, 26vw, 380px). */
const sizesPaisagem = '(min-width: 1600px) 640px, (min-width: 700px) 40vw, 280px';
const sizesRetrato = '(min-width: 1462px) 380px, (min-width: 900px) 26vw, (min-width: 700px) 22vw, 150px';
---
<section class="secao int-secao sb-casa" id="sobre-casa" data-cena="pilares" data-tom="cena" aria-labelledby="sobre-casa-titulo">
  <div class="container sb-grade sb-casa__cabeca">
    <h2 class="titulo sb-casa__titulo entra" id="sobre-casa-titulo" style="--i:0">{casa.h2}</h2>
    <p class="sb-casa__texto entra" style="--i:1">{casa.texto}</p>
    <div class="sb-casa__setas entra" style="--i:2">
      <button
        type="button" class="sb-casa__seta sb-casa__seta--anterior"
        aria-controls="sobre-casa-trilho" aria-label={casa.rotuloAnterior}
        aria-disabled="true" data-direcao="-1"
      >
        <Icone nome="ArrowRight" size={18} />
      </button>
      <button
        type="button" class="sb-casa__seta sb-casa__seta--proxima"
        aria-controls="sobre-casa-trilho" aria-label={casa.rotuloProxima}
        data-direcao="1"
      >
        <Icone nome="ArrowRight" size={18} />
      </button>
    </div>
  </div>
  <div class="sb-casa__trilho" id="sobre-casa-trilho" role="region" aria-label={casa.rotuloTrilho} tabindex="0">
    <ul class="sb-casa__lista" role="list">
      {casaCartoes.map((slot, i) => (
        <li
          class:list={['sb-casa__cartao', 'entra', retrato(slot.proporcao) ? 'sb-casa__cartao--retrato' : 'sb-casa__cartao--paisagem']}
          style={`--i:${i}`}
        >
          <CartaoFoto slot={slot} sizes={retrato(slot.proporcao) ? sizesRetrato : sizesPaisagem} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ---------- Cabeça ---------- */
  .sb-casa__titulo { grid-row: 1; grid-column: 1 / 7; }
  .sb-casa__texto {
    grid-row: 2; grid-column: 1 / 6; margin-top: 20px; max-width: 44ch;
    font-size: 18px; line-height: 1.55; color: #bcbcbc;   /* 9:1 ou mais sobre a cena mascarada */
  }
  .sb-casa__setas {
    grid-row: 1 / 3; grid-column: 11 / 13; justify-self: end; align-self: end;
    display: flex; gap: 8px;
  }

  /* ---------- Setas: vidro fosco, 44×44, raio 8 ----------
     Sobre a cena, o desfoque tira o brilho do quadro de trás e a seta
     fica legível em qualquer ponto do roteiro. */
  .sb-casa__seta {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: 8px; color: var(--papel);
    background: rgb(22 22 22 / .55); box-shadow: inset 0 0 0 1px rgb(242 242 238 / .1);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    cursor: pointer;
    transition: background-color .4s cubic-bezier(.22, 1, .36, 1), opacity .4s cubic-bezier(.22, 1, .36, 1);
  }
  .sb-casa__seta--anterior :global(svg) { transform: rotate(180deg); }
  .sb-casa__seta:hover:not([aria-disabled='true']) { background: rgb(46 46 46 / .7); }
  .sb-casa__seta:focus-visible { outline: 2px solid var(--papel); outline-offset: 3px; }
  .sb-casa__seta[aria-disabled='true'] { opacity: .35; cursor: default; }
  /* Toque: o dedo rola o trilho; as setas saem. */
  @media (hover: none) { .sb-casa__setas { display: none; } }

  /* ---------- Trilho: fora do .container, sangra à direita ---------- */
  .sb-casa__trilho {
    width: 100%; margin-top: clamp(40px, 5vw, 72px);
    /* 6px em cima: o contorno de foco (por dentro) não encosta no cartão
       mais alto; 16px embaixo: respiro entre os cartões e a barra. */
    padding: 6px var(--grid-inset) 16px; scroll-padding-inline: var(--grid-inset);
    overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    scrollbar-width: thin; scrollbar-color: rgb(242 242 238 / .3) transparent;
    /* Snap desligado de propósito (vetado na página; pendência 6):
       scroll-snap-type: x proximity; */
  }
  /* Por dentro (offset negativo): o trilho vai de borda a borda, e um
     contorno por fora seria cortado pela janela. */
  .sb-casa__trilho:focus-visible { outline: 2px solid var(--papel); outline-offset: -2px; }
  /* max-content: a lista mede a fileira inteira, e o padding final do
     trilho entra na área rolável em todos os navegadores.
     Desvio da especificação: alinhados pelo topo (flex-start), e não pela
     base. Pela base, os 4:5 fora da janela, mais altos, abriam um vão
     vazio entre o texto e as fotos que se veem; pelo topo, o espaço da
     cabeça até a 1ª foto é sempre o margin-top do trilho. */
  .sb-casa__lista {
    display: flex; align-items: flex-start; gap: clamp(12px, 1.6vw, 24px);
    width: max-content; list-style: none; margin: 0; padding: 0;
  }
  .sb-casa__cartao { flex: none; /* scroll-snap-align: start; */ }
  /* Desvio da especificação: 40vw no lugar de 44vw. Com 44vw, dois cartões
     3:2 mais o recuo davam quase exatamente a janela (a 1440, 1100 e 768 o
     3º cartão aparecia com 2 a 4px), e a fileira não parecia sangrar. Com
     40vw, o 3º cartão entra cortado na borda direita (120px a 1440). */
  .sb-casa__lista { --sb-casa-l: clamp(280px, 40vw, 640px); }
  .sb-casa__cartao--paisagem { width: var(--sb-casa-l); }
  /* O 4:5 desce um pouco em relação aos 3:2: o desencontro do catálogo. */
  .sb-casa__cartao--retrato { width: clamp(220px, 26vw, 380px); margin-top: clamp(24px, 4vw, 64px); }

  /* Abaixo de 900px (OUT-02): o 4:5 fica com a altura do 3:2 (8/15 da
     largura dele) e sem o desencontro. Antes, os retratos, fora da janela,
     davam ao trilho ~110px a mais que as fotos à vista, e sobrava um vão
     escuro sob a fileira. O desencontro continua a partir de 900px. */
  @media (max-width: 899.98px) {
    .sb-casa__cartao--retrato { width: calc(var(--sb-casa-l) * 8 / 15); margin-top: 0; }
  }
  /* Abaixo de 600px, o 3:2 fica em 78vw até 280px: a 320, com 280px, o 2º
     cartão começava 1px antes da borda e a fileira não mostrava que
     continua (no toque não há setas). Com 78vw, ele aparece ~30px. */
  @media (max-width: 599.98px) {
    .sb-casa__lista { --sb-casa-l: min(280px, 78vw); }
  }

  /* ---------- Hover: a foto assenta (escala e cor), devagar ---------- */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sb-casa__cartao :global(.sb-foto__miolo img) {
      transform: scale(1.04); filter: saturate(.8);
      transition: transform 1.2s cubic-bezier(.22, 1, .36, 1), filter 1.2s cubic-bezier(.22, 1, .36, 1);
    }
    .sb-casa__cartao:hover :global(.sb-foto__miolo img) { transform: scale(1); filter: saturate(.95); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-casa__seta { transition: none; }
  }

  /* ---------- 6 colunas (600–899) ---------- */
  @media (max-width: 899.98px) {
    .sb-casa__titulo { grid-column: 1 / 5; }
    .sb-casa__texto { grid-column: 1 / 5; }
    .sb-casa__setas { grid-column: 5 / 7; }
  }
  /* ---------- 4 colunas (<600): as setas descem para baixo do texto ---------- */
  @media (max-width: 599.98px) {
    .sb-casa__titulo, .sb-casa__texto { grid-column: 1 / -1; }
    .sb-casa__texto { font-size: 17px; }
    .sb-casa__setas { grid-row: 3; grid-column: 1 / -1; margin-top: 24px; }
  }
</style>

<script>
  /* Setas do trilho: rolam um cartão (largura do 1º + gap). Nas pontas,
     aria-disabled; o estado segue a rolagem por um listener passivo com um
     único rAF. Com movimento reduzido, o salto é seco. */
  const reduzido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.sb-casa').forEach((secao) => {
    const trilho = secao.querySelector<HTMLElement>('.sb-casa__trilho');
    const lista = secao.querySelector<HTMLElement>('.sb-casa__lista');
    const setas = secao.querySelectorAll<HTMLButtonElement>('.sb-casa__seta');
    if (!trilho || !lista || !setas.length) return;

    let quadro = 0;
    const atualizar = () => {
      quadro = 0;
      const max = trilho.scrollWidth - trilho.clientWidth;
      const pos = trilho.scrollLeft;
      setas.forEach((seta) => {
        const dir = Number(seta.dataset.direcao);
        const noFim = dir < 0 ? pos <= 1 : pos >= max - 1;
        seta.setAttribute('aria-disabled', String(noFim));
      });
    };
    const agendar = () => { if (!quadro) quadro = requestAnimationFrame(atualizar); };

    setas.forEach((seta) => {
      seta.addEventListener('click', () => {
        if (seta.getAttribute('aria-disabled') === 'true') return;
        const primeiro = lista.firstElementChild as HTMLElement | null;
        if (!primeiro) return;
        const passo = primeiro.getBoundingClientRect().width + (parseFloat(getComputedStyle(lista).columnGap) || 0);
        trilho.scrollBy({ left: Number(seta.dataset.direcao) * passo, behavior: reduzido() ? 'auto' : 'smooth' });
      });
    });

    trilho.addEventListener('scroll', agendar, { passive: true });
    addEventListener('resize', agendar, { passive: true });
    atualizar();

    /* Os cartões fora da janela ficam cortados pelo trilho e nunca "entram"
       para o observador da Base2; sem isto, cada um surgiria atrasado ao
       rolar para o lado. Aqui a fileira inteira revela junto quando o
       trilho aparece (os cartões visíveis mantêm a cascata do --i). */
    if (!reduzido() && 'IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entradas) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        lista.querySelectorAll('.entra').forEach((c) => c.classList.add('visivel'));
        obs.disconnect();
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
      obs.observe(trilho);
    }
  });
</script>
