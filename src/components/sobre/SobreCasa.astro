---
/**
 * A casa (04/10/2026, layout editorial). Duas fotos da sede montadas como
 * página de revista: o salão grande, sangrando à esquerda, e o nicho
 * amarelo mais baixo, à direita. O título em caixa alta atravessa a borda
 * do salão e o texto fecha embaixo.
 */
import { Image } from 'astro:assets';
import { casa, fotos } from '../../data/sobre';
import { doisPesos } from '../editorial/pesos';
const [leve, forte] = doisPesos(casa.h2, 1);
const a = fotos.casa, b = fotos.casaDetalhe;
---
<section class="ed-secao ed-secao--grafite sb-casa" id="sobre-casa" aria-labelledby="sobre-casa-titulo">
  <div class="container ed-grade sb-casa__grade">
    <figure class="ed-foto ed-revela entra ed-sangra-esq sb-casa__a">
      <Image src={a.foto} alt={a.alt} format="webp" quality={78} widths={[720, 1280, 1760]} sizes="(min-width: 900px) 66vw, 100vw" style={`object-position: ${a.foco}`} />
    </figure>
    <figure class="ed-foto ed-revela entra sb-casa__b" style="--i:1">
      <Image src={b.foto} alt={b.alt} format="webp" quality={78} widths={[480, 800, 1200]} sizes="(min-width: 900px) 30vw, 100vw" style={`object-position: ${b.foco}`} />
    </figure>
    <h2 class="ed-display sb-casa__titulo entra" id="sobre-casa-titulo"><span>{leve}</span> <span><b>{forte}</b></span></h2>
    <p class="ed-corpo sb-casa__texto entra" style="--i:1">{casa.texto}</p>
  </div>
</section>

<style>
  .sb-casa__grade { row-gap: 0; }
  .sb-casa__a { grid-column: 1 / span 8; grid-row: 1 / span 2; aspect-ratio: 3 / 2; }
  .sb-casa__b { grid-column: 10 / -1; grid-row: 1; aspect-ratio: 4 / 5; margin-top: clamp(64px, 9vw, 160px); }
  /* O título sobe pela foto grande: a linha forte fica toda no grafite. */
  .sb-casa__titulo {
    grid-column: 5 / -1; grid-row: 2; align-self: end; position: relative; z-index: 1;
    margin-bottom: -.5em;   /* a 2ª linha passa da borda de baixo da foto */
    font-size: clamp(48px, 7.4vw, 132px);
  }
  .sb-casa__texto { grid-column: 9 / -1; grid-row: 3; margin-top: clamp(56px, 6vw, 96px); }
  @media (min-width: 900px) { .sb-casa__titulo > span { white-space: nowrap; } }
  @media (max-width: 899.98px) {
    .sb-casa__a, .sb-casa__b, .sb-casa__titulo, .sb-casa__texto { grid-column: 1 / -1; grid-row: auto; }
    .sb-casa__b { width: 62%; justify-self: end; margin-top: -48px; position: relative; z-index: 1; }
    .sb-casa__titulo { margin: 40px 0 0; }
    .sb-casa__texto { margin-top: 24px; }
  }
</style>
