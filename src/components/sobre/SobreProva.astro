---
/**
 * A prova (04/10/2026). "140 clínicas" vira o número grande, com o começo
 * da frase acima, pequeno, como "+1.300 km
 * percorridos", na Inter fina dos números da home. Embaixo, a foto do
 * café sangra até a borda do painel e as frases vêm à direita; a última,
 * numa caixa de vidro, se sobrepõe à foto.
 */
import { Image } from 'astro:assets';
import { prova, fotos } from '../../data/sobre';
const f = fotos.prova;
const [a, b, c] = prova.frases;
---
<section class="ed-secao ed-secao--papel sb-prova" id="sobre-prova" data-tom="claro" aria-labelledby="sobre-prova-titulo">
  <div class="container ed-grade sb-prova__grade">
    <h2 class="sb-prova__titulo entra" id="sobre-prova-titulo">
      <span class="ed-antetitulo sb-prova__antes">{prova.h2.antes.trim()}</span>
      <span class="ed-display sb-prova__numero">{prova.h2.realce}{prova.h2.depois}</span>
    </h2>
    <figure class="ed-foto ed-revela entra ed-sangra-esq sb-prova__foto">
      <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[640, 1120, 1600]} sizes="(min-width: 900px) 52vw, 100vw" style={`object-position: ${f.foco}`} />
    </figure>
    <div class="sb-prova__frases">
      <p class="ed-chamada entra">{a}</p>
      <p class="ed-chamada entra" style="--i:1">{b}</p>
    </div>
    <p class="ed-chamada ed-vidro sb-prova__fecho entra" style="--i:2">{c}</p>
  </div>
</section>

<style>
  .sb-prova__grade { row-gap: clamp(48px, 6vw, 104px); }
  .sb-prova__titulo { margin: 0; display: grid; }
  .sb-prova__antes { max-width: 24ch; }
  .sb-prova__numero { font-size: clamp(60px, 9.6vw, 172px); font-weight: 200; line-height: .92; letter-spacing: -.06em; }
  .sb-prova__foto { grid-column: 1 / span 6; grid-row: 2 / span 2; aspect-ratio: 4 / 5; }
  .sb-prova__frases {
    grid-column: 8 / -1; grid-row: 2; align-self: start;
    display: grid; gap: clamp(28px, 3vw, 44px);
  }
  .sb-prova__frases .ed-chamada { padding-top: clamp(28px, 3vw, 44px); border-top: 1px solid var(--ed-fio-claro); color: var(--ed-tinta-2); }
  /* O fecho começa sobre a foto e termina no papel. */
  .sb-prova__fecho {
    grid-column: 5 / -1; grid-row: 3; align-self: end; margin-bottom: clamp(32px, 5vw, 80px);
    position: relative; z-index: 2;
    font-size: clamp(22px, 2.2vw, 34px); line-height: 1.25;
    background: linear-gradient(170deg, rgb(250 250 248 / .94), rgb(240 240 237 / .9));
  }
  @media (max-width: 899.98px) {
    .sb-prova__foto, .sb-prova__frases, .sb-prova__fecho { grid-column: 1 / -1; grid-row: auto; }
    .sb-prova__foto { margin-right: 0; }
    .sb-prova__fecho { margin: 0; }
  }
</style>
