---
/**
 * A prova (04/10/2026). No painel claro, a cabeça centrada: a frase em
 * cima e "140 clínicas" no número fino da home. Embaixo, numa fileira, a
 * foto do time e as três frases em cartões claros com ícone.
 */
import { Image } from 'astro:assets';
import { prova, fotos } from '../../data/sobre';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
const f = fotos.prova;
const icones: NomeIconeRenke[] = ['camadas', 'tecnologia', 'pessoas'];
---
<section class="ed-secao ed-painel sb-prova" id="sobre-prova" data-tom="claro" aria-labelledby="sobre-prova-titulo">
  <div class="container">
    <h2 class="ed-cabeca sb-prova__titulo entra" id="sobre-prova-titulo">
      <span class="sb-prova__antes">{prova.h2.antes.trim()}</span>
      <span class="sb-prova__numero">{prova.h2.realce}{prova.h2.depois}</span>
    </h2>
    <div class="sb-prova__fileira">
      <figure class="ed-foto sb-prova__foto entra">
        <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[400, 720, 960]} sizes="(min-width: 900px) 24vw, 100vw" style={`object-position: ${f.foco}`} />
      </figure>
      {prova.frases.map((t, i) => (
        <article class="ed-cartao sb-prova__cartao entra" style={`--i:${i + 1}`}>
          <span class="ed-anel" aria-hidden="true"><IconeRenke nome={icones[i]} size={22} /></span>
          <p class="sb-prova__frase">{t}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sb-prova__titulo { margin-top: 0; font-weight: 300; }
  .sb-prova__antes { font-size: clamp(18px, 1.5vw, 22px); letter-spacing: -.02em; color: #50504e; }
  .sb-prova__numero { margin-top: 10px; font-size: clamp(64px, 7.4vw, 128px); font-weight: 200; line-height: .95; letter-spacing: -.06em; }
  .sb-prova__fileira { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ed-vao); }
  .sb-prova__foto { min-height: 100%; }
  .sb-prova__cartao { min-height: clamp(260px, 21vw, 320px); }
  .sb-prova__frase { margin: 0; font-size: clamp(18px, 1.45vw, 22px); line-height: 1.35; letter-spacing: -.02em; text-wrap: pretty; }
  @media (max-width: 1099.98px) { .sb-prova__fileira { grid-template-columns: repeat(2, minmax(0, 1fr)); } .sb-prova__foto { aspect-ratio: 4 / 3; } }
  @media (max-width: 599.98px) { .sb-prova__fileira { grid-template-columns: 1fr; } .sb-prova__cartao { min-height: 0; } }
</style>
