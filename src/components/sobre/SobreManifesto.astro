---
/**
 * O que somos (04/10/2026). No painel claro chanfrado, como o do método: o
 * título fino, a 2ª linha em 500; embaixo, a frase grande à
 * esquerda e a foto do estúdio sangrando para a direita.
 */
import { Image } from 'astro:assets';
import { somos, fotos } from '../../data/sobre';
const f = fotos.somos;
---
<section class="ed-secao ed-secao--papel sb-somos" id="sobre-somos" data-tom="claro" aria-labelledby="sobre-somos-titulo">
  <div class="container ed-grade sb-somos__grade">
    <h2 class="ed-display ed-display--medio sb-somos__titulo entra" id="sobre-somos-titulo">
      <span>{somos.h2[0]}</span>{' '}<span><b>{somos.h2[1]}</b></span>
    </h2>
    <p class="ed-chamada sb-somos__texto entra" style="--i:1">{somos.texto}</p>
    <figure class="ed-foto ed-revela entra ed-sangra-dir sb-somos__foto">
      <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[720, 1280, 1760]} sizes="(min-width: 900px) 60vw, 100vw" style={`object-position: ${f.foco}`} />
    </figure>
  </div>
</section>

<style>
  .sb-somos { margin-top: clamp(40px, 5vw, 80px); }
  .sb-somos__grade { row-gap: clamp(48px, 6vw, 96px); align-items: end; }
  .sb-somos__texto { grid-column: 1 / span 4; grid-row: 2; align-self: end; padding-bottom: 8px; }
  .sb-somos__foto { grid-column: 6 / -1; grid-row: 2; aspect-ratio: 16 / 10; }
  @media (max-width: 899.98px) {
    .sb-somos__texto, .sb-somos__foto { grid-column: 1 / -1; grid-row: auto; }
  }
</style>
