---
/**
 * Capa do Sobre (04/10/2026, layout editorial). A foto do salão na tela
 * inteira, o nome em caixa alta por cima e a frase de abertura numa caixa
 * de papel que nasce da dobra seguinte e sobe pela foto, como o cartão
 * branco do carrossel "Nosso CEO foi convidado…".
 */
import { Image } from 'astro:assets';
import { abertura, fotos } from '../../data/sobre';
import Selo from '../ui/Selo.astro';
const f = fotos.capa;
---
<section class="ed-capa sb-capa" id="sobre-abertura" aria-labelledby="sobre-abertura-titulo">
  <figure class="ed-foto ed-capa__foto" style={`--foco: ${f.foco}`}>
    <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[960, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
  </figure>
  <div class="container ed-grade sb-capa__miolo">
    <Selo class="sb-capa__rotulo" tom="escuro">{abertura.rotulo}</Selo>
    <h1 class="ed-display sb-capa__titulo entra" id="sobre-abertura-titulo">
      <span>{abertura.linhasH1[0]}</span>{' '}<span><b>{abertura.linhasH1[1]}</b></span>
    </h1>
    <div class="sb-capa__caixa entra" style="--i:1">
      <p class="ed-chamada" set:html={abertura.lead} />
    </div>
  </div>
</section>

<style>
  .sb-capa { padding-bottom: 0; }
  .sb-capa__miolo { align-items: end; row-gap: 24px; }
  .sb-capa__rotulo { grid-row: 1; justify-self: start; }
  .sb-capa__titulo {
    grid-row: 2; grid-column: 1 / span 8; align-self: end;
    padding-bottom: clamp(40px, 5vw, 88px);
    font-size: clamp(64px, 10.4vw, 188px);
  }
  /* A caixa de papel encosta no pé da capa e emenda com a dobra de baixo. */
  .sb-capa__caixa {
    grid-row: 2; grid-column: 9 / -1; align-self: end;
    margin-right: calc(-1 * var(--grid-inset));
    padding: clamp(32px, 3.4vw, 56px) var(--grid-inset) clamp(32px, 3.4vw, 56px) clamp(32px, 3.4vw, 56px);
    background-color: var(--ed-papel); color: var(--ed-tinta);
  }
  .sb-capa__titulo > span { white-space: nowrap; }
  .sb-capa__caixa :global(strong) { font-weight: 700; }
  @media (max-width: 899.98px) {
    .sb-capa__titulo { grid-column: 1 / -1; padding-bottom: 32px; }
    .sb-capa__caixa { grid-row: 3; grid-column: 1 / -1; margin-inline: calc(-1 * var(--grid-inset)); padding-inline: var(--grid-inset); }
  }
</style>
