---
/**
 * Capa do Sobre (04/10/2026). A foto do salão na tela inteira, se
 * desfazendo na cena, e o título da hero da home por cima dela, com a
 * frase de abertura logo abaixo.
 */
import { Image } from 'astro:assets';
import { abertura, fotos } from '../../data/sobre';
import Selo from '../ui/Selo.astro';
const f = fotos.capa;
---
<section class="ed-capa sb-capa" id="sobre-abertura" data-cena="hero" data-tom="cena" aria-labelledby="sobre-abertura-titulo">
  <figure class="ed-capa__foto" style={`--foco: ${f.foco}`}>
    <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[960, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
  </figure>
  <div class="container sb-capa__miolo">
    <Selo class="sb-capa__rotulo" tom="escuro">{abertura.rotulo}</Selo>
    <h1 class="ed-capa__titulo entra" id="sobre-abertura-titulo">
      <span>{abertura.linhasH1[0]}</span>{' '}<span><b>{abertura.linhasH1[1]}</b></span>
    </h1>
    <p class="ed-capa__sub entra" style="--i:1" set:html={abertura.lead} />
  </div>
</section>

<style>
  .sb-capa__miolo { display: grid; justify-items: start; }
  .sb-capa__rotulo { margin-bottom: clamp(20px, 2.2vw, 28px); }
</style>
