---
/**
 * S0 · Abertura do Sobre (docs/04-design/pagina-sobre.md, (a) "S0").
 * Capa de livro: o nome gigante e a frase sobre a cena, sem foto. A foto
 * chega na dobra seguinte, atravessando a costura.
 *
 * Composição (a partir de 900px): o H1 nas colunas 1–7 e o lead nas 8–12,
 * com a última linha do lead na mesma linha de base de "Renke" (alinhamento
 * pela última linha de base da grade; onde não houver, cai em `end`). Abaixo
 * de 900px, o lead desce para baixo do H1.
 *
 * O padding de baixo guarda --sb-sobe a mais: é o espaço que a foto de S1
 * (SobreManifesto.astro) ocupa quando sobe acima da costura. Os dois
 * componentes dependem desse mesmo token, que mora no sobre.css.
 *
 * A máscara de leitura da cena (fundo-internas.ts) protege
 * .sb-abertura__miolo; por isso a seção é filha direta do <main> e leva
 * data-cena="hero".
 */
import { abertura } from '../../data/sobre';
import Selo from '../ui/Selo.astro';
---
<section class="secao int-secao sb-abertura" id="sobre-abertura" data-cena="hero" data-tom="cena" aria-labelledby="sobre-abertura-titulo">
  <div class="container sb-grade sb-abertura__miolo">
    <Selo class="sb-abertura__rotulo">{abertura.rotulo}</Selo>
    <h1 class="titulo sb-abertura__titulo entra" id="sobre-abertura-titulo" style="--i:0">
      <span>{abertura.linhasH1[0]}</span>{' '}<span>{abertura.linhasH1[1]}</span>
    </h1>
    <p class="sb-abertura__lead entra" style="--i:1" set:html={abertura.lead} />
  </div>
</section>

<style>
  /* A capa: o miolo encostado embaixo, com a reserva da foto de S1. */
  .sb-abertura {
    display: flex; flex-direction: column; justify-content: flex-end;
    min-height: min(86vh, 900px);
    min-height: min(86svh, 900px);
    padding-top: calc(var(--altura-header) + 64px);
    padding-bottom: calc(var(--esp-secao) + var(--sb-sobe));
    color: var(--papel);
  }

  .sb-abertura__rotulo { grid-row: 1; margin-bottom: clamp(20px, 2.2vw, 32px); }

  /* O nome gigante, em tom duplo: "Sobre a" em cinza, "Renke" em papel.
     A quebra entre as duas linhas é só tipográfica (um único h1). */
  .sb-abertura__titulo {
    grid-row: 2; grid-column: 1 / 8;
    align-self: end;
    align-self: last baseline;   /* o par H1 + lead divide a mesma linha de base */
    font-size: clamp(56px, 10vw, 168px);
    font-weight: 250;
    line-height: .92;
    letter-spacing: -.055em;
    word-spacing: -.08em;
    text-wrap: nowrap;
    color: var(--papel);
  }
  .sb-abertura__titulo > span { display: block; }
  .sb-abertura__titulo > span:first-child { color: var(--cinza); }

  /* A frase na coluna da direita, com a última linha na base de "Renke". */
  .sb-abertura__lead {
    grid-row: 2; grid-column: 8 / 13;
    align-self: end;
    align-self: last baseline;
    max-width: 34ch;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 300;
    line-height: 1.45;
    color: #bcbcbc;   /* 9:1 ou mais sobre a cena mascarada */
    text-wrap: pretty;
  }
  .sb-abertura__lead :global(strong) { font-weight: 500; color: var(--papel); }

  /* 6 e 4 colunas: o H1 na largura toda e o lead embaixo; a capa fica com a
     altura do conteúdo. */
  @media (max-width: 899.98px) {
    .sb-abertura { min-height: auto; }
    .sb-abertura__titulo { grid-column: 1 / -1; align-self: start; }
    .sb-abertura__lead {
      grid-row: 3; grid-column: 1 / -1;
      align-self: start;
      margin-top: 32px;
    }
  }
</style>
