---
/**
 * A tese (04/10/2026, layout editorial). A foto da sala de vidro abre a
 * dobra e se desfaz no grafite; o título sobe pela foto e as afirmações
 * descem numa lista de setas entre fios, como "Atrair pacientes sem
 * construir reputação é frágil".
 */
import { Image } from 'astro:assets';
import { tese, fotos } from '../../data/sobre';
import Seta from '../editorial/Seta.astro';
import { doisPesos } from '../editorial/pesos';
const f = fotos.tese;
const [leve, forte] = doisPesos(tese.h2, 2);
---
<section class="ed-secao ed-secao--grafite sb-tese" id="sobre-tese" aria-labelledby="sobre-tese-titulo">
  <figure class="ed-foto sb-tese__foto">
    <Image src={f.foto} alt={f.alt} format="webp" quality={76} widths={[960, 1600, 2200]} sizes="100vw" style={`object-position: ${f.foco}`} />
  </figure>
  <div class="container ed-grade sb-tese__miolo">
    <h2 class="ed-display ed-display--medio sb-tese__titulo entra" id="sobre-tese-titulo">{leve} <b>{forte}</b></h2>
    <ol class="ed-setas sb-tese__lista">
      {tese.passos.map((p, i) => (
        <li class="entra" style={`--i:${i}`}>
          <Seta />
          <div>
            <p class="ed-setas__frase sb-tese__frase">{p.frase}</p>
            {p.apoio && <p class="ed-setas__apoio">{p.apoio}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sb-tese { padding-top: 0; }
  .sb-tese__foto { height: clamp(360px, 62vh, 720px); }
  .sb-tese__foto::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, var(--ed-grafite) 0%, rgb(13 13 13 / .6) 30%, rgb(13 13 13 / 0) 70%);
  }
  .sb-tese__miolo { position: relative; z-index: 1; margin-top: clamp(-200px, -12vw, -96px); row-gap: clamp(48px, 5vw, 80px); }
  .sb-tese__titulo { grid-column: 1 / span 9; }
  .sb-tese__lista { grid-column: 4 / -1; }
  .sb-tese__frase { font-weight: 500; }
  @media (max-width: 899.98px) {
    .sb-tese__titulo, .sb-tese__lista { grid-column: 1 / -1; }
  }
</style>
