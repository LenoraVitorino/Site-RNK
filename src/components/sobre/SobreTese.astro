---
/**
 * A tese (04/10/2026). A foto da sala de vidro abre a dobra e se desfaz
 * na cena; o título sobe pela foto e as afirmações
 * descem numa lista de setas entre fios, como "Atrair pacientes sem
 * construir reputação é frágil".
 */
import { Image } from 'astro:assets';
import { tese, fotos } from '../../data/sobre';
import Seta from '../editorial/Seta.astro';
import { doisPesos } from '../editorial/pesos';
const f = fotos.tese;
const [leve, forte] = doisPesos(tese.h2, 2);
---
<section class="ed-secao ed-secao--grafite sb-tese" id="sobre-tese" data-cena="pilares" data-tom="cena" aria-labelledby="sobre-tese-titulo">
  <figure class="ed-foto ed-desfaz sb-tese__foto">
    <Image src={f.foto} alt={f.alt} format="webp" quality={76} widths={[960, 1600, 2200]} sizes="100vw" style={`object-position: ${f.foco}`} />
  </figure>
  <div class="container ed-grade sb-tese__miolo">
    <h2 class="ed-display ed-display--medio ed-mascara sb-tese__titulo entra" id="sobre-tese-titulo">{leve} <b>{forte}</b></h2>
    <ol class="ed-setas ed-mascara sb-tese__lista">
      {tese.passos.map((p, i) => (
        <li class="entra" style={`--i:${i}`}>
          <Seta />
          <div>
            <p class="ed-setas__frase sb-tese__frase">{p.frase}</p>
            {p.apoio && <p class="ed-setas__apoio">{p.apoio}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sb-tese { padding-top: 0; }
  /* A foto fica recuada como os painéis, com o chanfro em cima, e some na cena embaixo. */
  .sb-tese__foto {
    height: clamp(360px, 62vh, 720px); margin: var(--ed-recuo) var(--ed-recuo) 0;
    clip-path: polygon(var(--ed-chanfro) 0, calc(100% - var(--ed-chanfro)) 0, 100% var(--ed-chanfro), 100% 100%, 0 100%, 0 var(--ed-chanfro));
  }
  .sb-tese__miolo { position: relative; z-index: 1; margin-top: clamp(-180px, -11vw, -88px); row-gap: clamp(48px, 5vw, 80px); }
  .sb-tese__titulo { grid-column: 1 / span 9; }
  .sb-tese__lista { grid-column: 4 / -1; }
  @media (max-width: 899.98px) {
    .sb-tese__titulo, .sb-tese__lista { grid-column: 1 / -1; }
  }
</style>
