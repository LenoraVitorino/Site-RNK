---
/**
 * A tese (04/10/2026). Sobre a cena, a cabeça centrada da home e as
 * afirmações em cartões de vidro com ícone (os das Perguntas), em volta de
 * uma foto da sala de vidro em cartão alto.
 */
import { Image } from 'astro:assets';
import { tese, fotos } from '../../data/sobre';
import { doisPesos } from '../editorial/pesos';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
const f = fotos.tese;
const [leve, forte] = doisPesos(tese.h2, 2);
const icones: NomeIconeRenke[] = ['crescimento', 'funil', 'conexao', 'dados', 'mira'];
const cinco = tese.passos.length > 4;
---
<section class="ed-secao ed-secao--cena sb-tese" id="sobre-tese" data-cena="pilares" data-tom="cena" aria-labelledby="sobre-tese-titulo">
  <div class="container">
    <header class="ed-cabeca ed-mascara entra">
      <Selo class="cabeca-dobra__selo">A tese</Selo>
      <h2 class="ed-titulo" id="sobre-tese-titulo">{leve} <b>{forte}</b></h2>
    </header>
    <div class:list={['sb-tese__grade', { 'sb-tese__grade--cinco': cinco }]}>
      {tese.passos.map((p, i) => (
        <article class="ed-cartao sb-tese__cartao entra" style={`--i:${i}; grid-area: c${i + 1}`}>
          <span class="ed-anel" aria-hidden="true"><IconeRenke nome={icones[i]} size={22} /></span>
          <div class="ed-cartao__corpo">
            <h3 class="ed-cartao__nome">{p.frase}</h3>
            {p.apoio && <p class="ed-cartao__texto">{p.apoio}</p>}
          </div>
        </article>
      ))}
      <figure class="ed-foto sb-tese__foto entra" style="--i:2">
        <Image src={f.foto} alt={f.alt} format="webp" quality={78} widths={[480, 800, 1120]} sizes="(min-width: 900px) 32vw, 100vw" style={`object-position: ${f.foco}`} />
      </figure>
    </div>
  </div>
</section>

<style>
  .sb-tese__grade {
    display: grid; gap: var(--ed-vao);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas: "c1 foto c2" "c3 foto c4";
  }
  .sb-tese__grade--cinco { grid-template-areas: "c1 c2 foto" "c3 c4 c5"; }
  .sb-tese__cartao { min-height: clamp(240px, 19vw, 300px); }
  .sb-tese__foto { grid-area: foto; min-height: 100%; }
  @media (max-width: 899.98px) {
    .sb-tese__grade, .sb-tese__grade--cinco { grid-template-columns: 1fr; grid-template-areas: none; }
    .sb-tese__cartao { grid-area: auto !important; min-height: 0; }
    .sb-tese__foto { grid-area: auto; aspect-ratio: 4 / 3; grid-row: 1; }
  }
</style>
