---
/**
 * S5 · Cultura (docs/04-design/pagina-sobre.md, (a) "S5").
 * Colofão: uma frase isolada e os valores como palavras, sem cartões.
 *
 * 29/09/2026 (nas duas versões): uma coluna só, no centro da página. O H2
 * pequeno em cima (antes ficava sozinho à esquerda), a frase, os valores
 * separados por pontos finos e o link. O selo #TEAMRENKE só existe na
 * versão copy (cultura.rotulo); na estudio saiu. Abaixo de 600px o texto
 * alinha à esquerda, para a frase longa não virar uma coluna centrada.
 *
 * O retrato do time (slot cultura) só aparece com foto: retrato placeholder
 * está vetado. Com ele, a seção ganha .sb-cultura--com-foto.
 */
import CartaoFoto from './CartaoFoto.astro';
import Icone from '../ui/Icone.astro';
import { cultura, fotos } from '../../data/sobre';
import Selo from '../ui/Selo.astro';

const comFoto = !!fotos.cultura.foto;
---
<section
  class:list={['secao', 'int-secao', 'int-secao--papel', 'sb-cultura', comFoto && 'sb-cultura--com-foto']}
  id="sobre-cultura"
  data-tom="papel"
  aria-labelledby="sobre-cultura-titulo"
>
  <div class="container sb-grade">
    <div class="sb-cultura__cabeca entra" style="--i:0">
      {cultura.rotulo && <Selo>{cultura.rotulo}</Selo>}
      <h2 class="sb-cultura__titulo" id="sobre-cultura-titulo">{cultura.h2}</h2>
    </div>
    <div class="sb-cultura__corpo entra" style="--i:1">
      <p class="titulo sb-cultura__frase">{cultura.frase}</p>
      <ul class="sb-cultura__valores" role="list">
        {cultura.valores.map((v) => <li>{v}</li>)}
      </ul>
      <a class="sb-cultura__link" href={cultura.link.rota}>
        <span>{cultura.link.rotulo}</span>
        <Icone nome="ArrowUpRight" size={16} />
      </a>
    </div>
    {comFoto && (
      <div class="sb-cultura__foto entra" style="--i:2">
        <CartaoFoto slot={fotos.cultura} sizes="(min-width: 900px) 300px, 60vw" tom="claro" />
      </div>
    )}
  </div>
</section>

<style>
  /* ---------- Uma coluna no centro ---------- */

  .sb-cultura__cabeca, .sb-cultura__corpo, .sb-cultura__foto { grid-column: 1 / -1; justify-self: center; }
  .sb-cultura__cabeca { display: grid; justify-items: center; gap: 20px; text-align: center; }
  /* O H2 como abertura discreta da frase: pequeno, em caixa alta espaçada. */
  .sb-cultura__titulo {
    margin: 0;
    font-size: 13px; font-weight: 500; line-height: 1.2;
    letter-spacing: .14em; text-transform: uppercase; color: var(--sb-tinta-2);
  }

  /* ---------- Corpo: a frase isolada, os valores e o link ---------- */

  /* O .titulo dá a família e o tracking; o tamanho e o peso são os daqui. */
  /* 29/09/2026: de 64px para 40px no máximo, nas duas versões ("muito
     grande"). A frase da versão estudio tem 155 caracteres; na escala de
     título ficava com seis linhas a 1440 e onze a 320. Na escala de frase,
     com o espaçamento entre palavras normal, lê como um parágrafo curto. */
  .sb-cultura__frase {
    max-width: 30ch; margin: 28px 0 0;
    font-size: clamp(26px, 2.8vw, 40px); font-weight: 300; line-height: 1.18;
    letter-spacing: -.03em;
    color: var(--sb-tinta);
    text-align: center; text-wrap: balance;
  }

  /* Os valores como palavras soltas, separadas por um ponto fino. */
  .sb-cultura__valores {
    list-style: none; margin: 48px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 0;
    font-size: clamp(18px, 1.7vw, 24px); font-weight: 300; line-height: 1.2;
    letter-spacing: -.02em; color: var(--sb-tinta-2);
  }
  .sb-cultura__valores li { display: inline-flex; align-items: center; }
  .sb-cultura__valores li + li::before {
    content: ''; width: 4px; height: 4px; margin-inline: clamp(16px, 2vw, 28px);
    border-radius: 50%; background: currentColor; opacity: .45;
  }

  .sb-cultura__link {
    display: inline-flex; align-items: center; gap: 6px;
    /* Alvo de toque de 44px (OUT-07). A caixa cresce 11px acima do texto;
       a margem cai de 40 para 29, e o texto fica onde estava. */
    min-height: 44px; margin-top: 29px;
    font-size: 16px; font-weight: 400; line-height: 1.4; color: var(--sb-tinta);
    text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px;
    text-decoration-color: rgb(37 37 35 / .4);
    transition: text-decoration-color .3s var(--easing, ease);
  }
  .sb-cultura__link :global(svg) { flex: none; transition: transform .3s var(--easing, ease); }
  .sb-cultura__link:hover { text-decoration-color: currentColor; }
  .sb-cultura__link:hover :global(svg) { transform: translate(2px, -2px); }
  /* O link fica numa linha própria, abaixo dos valores. */
  .sb-cultura__corpo { display: flex; flex-direction: column; align-items: center; }
  .sb-cultura__foto { width: min(300px, 60%); margin-top: 56px; }

  @media (max-width: 899.98px) {
    .sb-cultura__frase { font-size: 30px; }
  }
  /* Celular: tudo à esquerda, na margem das outras dobras. */
  @media (max-width: 599.98px) {
    .sb-cultura__cabeca, .sb-cultura__corpo, .sb-cultura__foto { justify-self: stretch; }
    .sb-cultura__cabeca { justify-items: start; text-align: start; }
    .sb-cultura__corpo { align-items: flex-start; }
    .sb-cultura__frase { font-size: 23px; text-align: start; text-wrap: pretty; }
    .sb-cultura__valores { justify-content: flex-start; font-size: 18px; margin-top: 40px; }
    .sb-cultura__valores li + li::before { margin-inline: 12px; }
    .sb-cultura__foto { width: 72%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-cultura__link, .sb-cultura__link :global(svg) { transition: none; }
    .sb-cultura__link:hover :global(svg) { transform: none; }
  }
</style>
