---
import { doutores, totalDoutores } from '../../data/doutores';
import { numerosProva } from '../../data/home';
import { copyLiteral } from '../../data/versao';
/* Retratos e contagem só entram quando existem de verdade (data/doutores.ts).
   Até lá, a prova são os três números do briefing, os mesmos do Sobre. */
const temRetratos = doutores.length > 0 && totalDoutores !== null;
const retratos = Array.from({ length: 6 }, (_, i) => doutores[i] ?? null);
const numero = totalDoutores === null ? '' : totalDoutores.toLocaleString('pt-BR');
const numeros = copyLiteral ? numerosProva.copy : numerosProva.estudio;
---
{temRetratos ? (
  <div class="hero-prova">
    <ul class="hero-prova__retratos" aria-label="Retratos dos doutores">
      {retratos.map((doutor) => (
        <li class:list={['hero-prova__retrato', !doutor && 'hero-prova__retrato--vazio']} tabindex={doutor ? '0' : undefined} aria-label={doutor ? `${doutor.nome}, ${doutor.especialidade}` : undefined} aria-hidden={!doutor ? 'true' : undefined}>
          {doutor && <>
            <img src={doutor.foto} alt="" width="56" height="56" />
            <span class="hero-prova__tooltip" aria-hidden="true"><strong>{doutor.nome}</strong><span>{doutor.especialidade}</span></span>
          </>}
        </li>
      ))}
    </ul>
    <p class="hero-prova__legenda">
      <strong class="hero-prova__numero">+ de {numero}</strong>
      <span>Doutores que<br /><strong>confiam na gente</strong></span>
    </p>
  </div>
) : (
  <ul class="hero-numeros" aria-label="Números da Renke">
    {numeros.map((n) => (
      <li class="hero-numeros__item">
        <strong class="hero-numeros__valor">{n.valor}</strong>
        <span class="hero-numeros__legenda">{n.legenda}</span>
      </li>
    ))}
  </ul>
)}
