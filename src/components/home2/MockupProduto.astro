---
/** Prévia conceitual: não representa uma captura das plataformas reais. */
interface Props { produto: 'academy' | 'tools' }
const { produto } = Astro.props;
const academy = produto === 'academy';
const id = `mockup-${produto}`;
const cursos = [
  ['Protocolo', 'Renke'], ['Formação', 'Performa'], ['Treinamento', 'CRM'],
  ['Rastreamento', 'Avançado'], ['Cultura', 'Pro'],
];
---
<div class:list={['produto-mockup', `produto-mockup--${produto}`]}>
  <svg viewBox="0 0 640 450" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${id}-janela`} x1="110" y1="0" x2="470" y2="440" gradientUnits="userSpaceOnUse"><stop stop-color="#282828"/><stop offset=".45" stop-color="#181818"/><stop offset="1" stop-color="#111"/></linearGradient>
      <linearGradient id={`${id}-capa`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#363636"/><stop offset="1" stop-color="#191919"/></linearGradient>
      <radialGradient id={`${id}-luz`}><stop stop-color="#aaa" stop-opacity=".13"/><stop offset="1" stop-color="#aaa" stop-opacity="0"/></radialGradient>
      <filter id={`${id}-sombra`} x="-20%" y="-20%" width="150%" height="170%"><feDropShadow dy="18" stdDeviation="12" flood-opacity=".5"/></filter>
    </defs>
    <ellipse cx="320" cy="230" rx="318" ry="215" fill={`url(#${id}-luz)`}/>
    <g class="produto-mockup__janela" filter={`url(#${id}-sombra)`}>
      <rect x="24" y="26" width="592" height="396" rx="16" fill={`url(#${id}-janela)`}/>
      <path d="M24 71H616" stroke="#343434"/>
      <g fill="#5b5b5b"><circle cx="44" cy="49" r="3"/><circle cx="56" cy="49" r="3"/><circle cx="68" cy="49" r="3"/></g>
      <text x="320" y="53" text-anchor="middle" class="mockup__marca">{academy?'RENKE ACADEMY':'RENKE CONNECT'}</text>
      <circle cx="587" cy="49" r="9" fill="#383838"/><path d="m584 49 2 2 4-5" stroke="#c8b25a" stroke-width="1.5"/>
      <rect x="24" y="72" width="54" height="334" fill="#131313"/>
      <g stroke="#858585" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="35" y="90" width="32" height="32" rx="9" fill="#292929" stroke="none"/>
        <path d="M44 100h5v5h-5zM53 100h5v5h-5zM44 109h5v5h-5zM53 109h5v5h-5z" stroke="#ddc561"/>
        <path d="M43 150h16v12H43zM48 147v3M54 147v3M43 154h16M44 198v-11h14v11M48 184h6M46 238h10M46 243h7"/>
        <circle cx="51" cy="288" r="7"/><path d="M47 288h8M51 284v8"/>
      </g>
      {academy ? <g>
        <text x="99" y="105" class="mockup__muted">ÁREA DE MEMBROS</text>
        <text x="99" y="133" class="mockup__heading">Conhecimento que vira operação.</text>
        <text x="99" y="156" class="mockup__small">Sua biblioteca de formações</text>
        {cursos.map((curso,i)=>{
          const x=99+(i%3)*165; const y=178+Math.floor(i/3)*115;
          return <g transform={`translate(${x} ${y})`}>
            <rect width="153" height="103" rx="9" fill={`url(#${id}-capa)`}/>
            <g transform="translate(112 25)" stroke={i===0?'#c9b55c':'#777'} stroke-width="1.5" opacity=".9">
              {i===0?<><path d="m-13 0 13-9 13 9-13 9Z"/><path d="m-13 7 13 9 13-9m-26 7 13 9 13-9"/></>:i===1?<><path d="M-14 10 0-10 14 10ZM-8 15h16"/></>:i===2?<><rect x="-14" y="-10" width="28" height="26" rx="4"/><path d="M-5-10v26M4-4h5M4 3h5"/></>:i===3?<><circle r="14"/><circle r="7"/><path d="M-20 0h8M12 0h8M0-20v8M0 12v8"/></>:<><circle cx="-7" r="8"/><circle cx="7" r="8"/><path d="M-16 18c2-14 30-14 32 0"/></>}
            </g>
            <text x="12" y="64" class="mockup__course">{curso[0]}</text><text x="12" y="83" class="mockup__course">{curso[1]}</text>
            <circle cx="134" cy="85" r="7" fill="#454545"/><path d="m132 82 5 3-5 3Z" fill="#c7c7c7"/>
          </g>;
        })}
        <text x="442" y="321" class="mockup__quote">Aprenda.</text><text x="442" y="347" class="mockup__quote">Aplique.</text><text x="442" y="373" class="mockup__quote" fill="#d7bf5a">Evolua.</text>
      </g> : <g>
        <text x="100" y="105" class="mockup__muted">VISÃO DA JORNADA</text>
        <text x="100" y="133" class="mockup__heading">Do primeiro clique à consulta.</text>
        <rect x="100" y="154" width="488" height="90" rx="10" fill="#101010"/>
        <path d="M169 191H520" stroke="#575757" stroke-width="1.5" stroke-dasharray="3 4"/>
        {['Origem','Contato','Agendamento'].map((label,i)=><g transform={`translate(${167+i*175} 188)`}>
          <rect x="-16" y="-16" width="32" height="32" rx="10" fill={i===2?'#3b3625':'#2c2c2c'}/>
          {i===2?<path d="m-6 0 4 4 8-9" stroke="#d7bf5a" stroke-width="1.7"/>:<circle r="5" stroke="#b6b6b6" stroke-width="1.5"/>}
          <text y="39" text-anchor="middle" class="mockup__small">{label}</text>
        </g>)}
        <text x="101" y="273" class="mockup__subheading">Canais conectados à jornada</text>
        <text x="101" y="301" class="mockup__muted">CANAL DE ORIGEM</text><text x="325" y="301" class="mockup__muted">ACOMPANHAMENTO</text>
        {['Google Ads','Instagram','Busca orgânica'].map((label,i)=><g transform={`translate(100 ${313+i*30})`}>
          <rect width="488" height="25" rx="5" fill={i%2===0?'#242424':'#1b1b1b'}/>
          <circle cx="13" cy="12" r="3" fill="#898989"/><text x="25" y="17" class="mockup__small">{label}</text>
          <path d="M230 12h176" stroke="#454545" stroke-width="2"/>
          {[230,318,406].map((x,j)=><circle cx={x} cy="12" r="3" fill={j===2&&i===0?'#d7bf5a':'#898989'}/>)}
          <path d="m457 12 4 4 7-8" stroke="#adadad" stroke-width="1.3"/>
        </g>)}
      </g>}
    </g>
  </svg>
  <span class="produto-mockup__nota">Prévia conceitual {academy?'da área de membros':'do Renke Connect'}</span>
</div>
<style>
.produto-mockup { width:100%; height:100%; position:relative; background:radial-gradient(ellipse at 50% 38%,#202020 0%,#0a0a0a 66%); display:flex; flex-direction:column; justify-content:center; padding:12px 4px 22px; }
.produto-mockup svg { display:block; width:100%; height:auto; overflow:visible; }
.produto-mockup__janela { transform-origin:center; transform:perspective(1400px) rotateY(-5deg) rotateX(4deg); transition:transform .8s ease; }
.produto-mockup--tools .produto-mockup__janela { transform:perspective(1400px) rotateY(5deg) rotateX(4deg); }
:global(.produto:hover) .produto-mockup__janela { transform:perspective(1400px) rotateY(0) rotateX(0); }
.produto-mockup text { font-family:Inter,sans-serif; fill:#d9d9d9; }
.produto-mockup .mockup__marca { font-size:12px; font-weight:600; letter-spacing:1.5px; }
.produto-mockup .mockup__muted { font-size:9px; fill:#888; letter-spacing:1px; }
.produto-mockup .mockup__heading { font-size:21px; font-weight:400; letter-spacing:-.6px; }
.produto-mockup .mockup__small { font-size:11px; fill:#aaa; }
.produto-mockup .mockup__course { font-size:15px; font-weight:500; letter-spacing:-.2px; }
.produto-mockup .mockup__quote { font-size:23px; font-weight:300; letter-spacing:-.7px; }
.produto-mockup .mockup__quote:last-child { fill:#d7bf5a; }
.produto-mockup .mockup__subheading { font-size:13px; }
.produto-mockup__nota { display:block; position:relative; text-align:center; font-size:10px; letter-spacing:.02em; color:#818181; margin-top:4px; }
@media(prefers-reduced-motion:reduce) { .produto-mockup__janela { transition:none; } }
</style>
