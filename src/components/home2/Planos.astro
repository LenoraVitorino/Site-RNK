---
/**
 * Os planos do Protocolo Revena num trilho preso na tela, como a dobra
 * "Selected work" da referência: primeiro só o título, à esquerda; a
 * página rola e os planos entram pela direita, um a um (Start, Run, Scale,
 * Core, Full), fechando com o convite para falar com a equipe. No fim do
 * curso a próxima dobra entra pela direita por cima desta (ver .cortina).
 * --x é o deslocamento do trilho e --fim o avanço da cortina, ambos
 * calculados no scroll pelo script. Sem JS, no celular ou com menos
 * movimento, tudo fica empilhado e rola normalmente.
 */
import { protocolos } from '../../data/home';
import { existe } from '../../data/rotas';
import FotoSlot from '../ui/FotoSlot.astro';

const ordem = ['START', 'RUN', 'SCALE', 'CORE', 'FULL'];
const planos = ordem.map((n) => protocolos.find((p) => p.label === `REVENA ${n}`)!);
const nome = (label: string) => {
  const n = label.replace('REVENA ', '').toLowerCase();
  return n[0].toUpperCase() + n.slice(1);
};
const fotos = ['Foto · escritório', 'Foto · atendimento', 'Foto · reunião de dados', 'Foto · time', 'Foto · operação'];
---
<section class="planos" id="planos" data-planos aria-label="Os planos do Protocolo Revena">
  <div class="planos__fixo">
    <div class="planos__trilho" data-planos-trilho>
      <div class="planos__abre">
        <p class="rotulo">Protocolo Revena</p>
        <h2 class="planos__titulo">
          Estruturamos sua operação do zero e operamos juntos no longo prazo.
          <strong>Qual é o momento da sua clínica?</strong>
        </h2>
        <p class="planos__dica" aria-hidden="true">Role para ver os planos</p>
      </div>

      {planos.map((p, i) => (
        <article class="plano">
          <div class="plano__foto"><FotoSlot rotulo={fotos[i]} reta /></div>
          <div class="plano__texto">
            <p class="rotulo">Protocolo Revena · <span class="num">0{i + 1}</span></p>
            <h3 class="plano__nome">{nome(p.label)}</h3>
            <p class="plano__fala">"{p.fala}"</p>
            <p>{p.texto}</p>
            <p><a class="link-arrow" href={existe(p.rota) ? p.rota : '#'} class:list={[!existe(p.rota) && 'nav--pendente']} data-rota={p.rota}>Saiba mais</a></p>
          </div>
        </article>
      ))}

      <div class="planos__fecha">
        <p class="planos__fecha__frase">A Renke recomenda o protocolo certo para o momento da sua clínica.</p>
        <a class="link-arrow" href="/contato">Fale com a equipe</a>
      </div>
    </div>
  </div>
</section>

<script>
  /* A página anda para baixo, o trilho anda para o lado. Passado o trilho,
     o último trecho do curso é da cortina: --fim vai de 0 a 1 e a próxima
     dobra (a .cortina que vem logo depois) entra pela direita. */
  const dobra = document.querySelector<HTMLElement>('[data-planos]');
  const trilho = dobra?.querySelector<HTMLElement>('[data-planos-trilho]');
  const cortina = document.querySelector<HTMLElement>('.cortina');
  const largo = matchMedia('(min-width: 900px)');
  if (dobra && trilho && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let agendado = false;
    let sobra = 0;
    const mede = () => {
      if (!largo.matches) { dobra.style.removeProperty('--curso'); return; }
      sobra = Math.max(0, trilho.scrollWidth - dobra.clientWidth);
      dobra.style.setProperty('--curso', sobra.toFixed(0) + 'px');
      anda();
    };
    const anda = () => {
      agendado = false;
      if (!largo.matches) return;
      const passado = -dobra.getBoundingClientRect().top;
      const x = Math.min(sobra, Math.max(0, passado));
      const fim = Math.min(1, Math.max(0, (passado - sobra) / innerHeight));
      dobra.style.setProperty('--x', x.toFixed(1) + 'px');
      dobra.style.setProperty('--fim', fim.toFixed(4));
      cortina?.style.setProperty('--fim', fim.toFixed(4));
    };
    const pede = () => { if (!agendado) { agendado = true; requestAnimationFrame(anda); } };
    addEventListener('scroll', pede, { passive: true });
    addEventListener('resize', mede, { passive: true });
    largo.addEventListener('change', mede);
    mede();
  }
</script>
