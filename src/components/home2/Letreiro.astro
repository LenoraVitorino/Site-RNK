---
import Icone from '../ui/Icone.astro';
import { copyLiteral } from '../../data/versao';
/**
 * Faixa de letras grandes entre "O que a Renke faz" e o Protocolo Revena,
 * como a faixa "Impact + Inspire + Innovate" da referência. Na versão copy,
 * as quatro palavras do briefing (seção Diferencial do Revena Full). Na
 * versão do estúdio, as quatro métricas que a doutora reconhece (Lenora,
 * 20/09). Anda sozinha, devagar; para no hover e com menos movimento. Só as
 * letras sobre o preto, sem marca atrás.
 */
const palavras = copyLiteral
  ? ['Controle', 'Automação', 'Processo', 'Experiência']
  : ['Custo por agendamento', 'Taxa de comparecimento', 'Faturamento por canal', 'Retorno do paciente'];
---
<section class:list={['letreiro', !copyLiteral && 'letreiro--frases']} aria-label={palavras.join(', ')}>
  <div class="letreiro__trilho">
    {[0, 1].map((k) => (
      <div class="letreiro__grupo" aria-hidden={k === 1 ? 'true' : undefined}>
        {palavras.map((p) => (
          <>
            <span class="letreiro__palavra">{p}</span>
            <Icone nome="Plus" class="letreiro__mais" />
          </>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  // O letreiro responde à leitura (26/09, referência CoffeeTech, pins 27 e 90):
  // acelera enquanto a página rola, no sentido da rolagem, e volta devagar ao
  // passo de sempre quando ela para. Com movimento reduzido, nada muda.
  const trilho = document.querySelector<HTMLElement>('.letreiro__trilho');
  const animacao = trilho?.getAnimations()[0];
  if (trilho && animacao && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ultimoY = scrollY, ultimoT = performance.now(), alvo = 1, taxa = 1, quadro = 0, emTela = false;
    const passo = () => {
      quadro = 0;
      taxa += (alvo - taxa) * .08;
      alvo += (1 - alvo) * .06;   // o impulso da rolagem se desfaz sozinho
      animacao.playbackRate = taxa;
      if (emTela && (Math.abs(taxa - 1) > .01 || Math.abs(alvo - 1) > .01)) quadro = requestAnimationFrame(passo);
      else if (!emTela) animacao.playbackRate = 1;
    };
    addEventListener('scroll', () => {
      const agora = performance.now();
      const v = (scrollY - ultimoY) / Math.max(16, agora - ultimoT);   // px por ms
      ultimoY = scrollY; ultimoT = agora;
      if (!emTela) return;
      alvo = Math.max(-2.2, Math.min(3.2, 1 + v * 2.4));
      if (!quadro) quadro = requestAnimationFrame(passo);
    }, { passive: true });
    new IntersectionObserver(([e]) => { emTela = e.isIntersecting; }).observe(trilho);
  }
</script>
