---
/** Método editorial, vídeo com controles e prova em três colunas. Textos por versão. */
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';
import { numerosProva } from '../../data/home';

const numeros = copyLiteral ? numerosProva.copy : numerosProva.estudio;
---
<section class="secao" id="o-que-fazemos" aria-labelledby="o-que-fazemos-titulo" data-metodologia>
  <div class="container">
    <div class:list={['metodo', 'metodo-editorial', 'entra', copyLiteral && 'metodo--copy']}>
      <div class="metodo__texto">
        <h2 class="titulo caps metodo__titulo" id="o-que-fazemos-titulo">{copyLiteral ? 'Nossa metodologia' : 'O que a Renke faz'}</h2>
        <p class="metodo__descricao">
          <span>Utilizamos a metodologia de Revenue Operations</span>{' '}
          <span>para estruturar a operação de receita. Analisamos cada etapa</span>{' '}
          <span>da jornada comercial, identificamos oportunidades e</span>{' '}
          <span>estruturamos processos a partir de dados, CRM e marketing.</span>
        </p>
        {existe('/sobre') && <p><Botao href="/sobre">Ver mais sobre a Renke</Botao></p>}
        <ul class="metodo__numeros" aria-label="Números da Renke">
          {numeros.map((n) => (
            <li class="metodo__numero">
              <p class="metodo__valor num">{n.valor.replace(/ /g, ' ')}</p>
              <p class="metodo__legenda">{n.legenda}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="metodo__midia">
        <Telefone />
        <p class="metodo-editorial__legenda">Por dentro do método <span>01:42</span></p>
      </div>
    </div>
  </div>
</section>
