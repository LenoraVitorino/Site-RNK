---
/** Método editorial, vídeo com controles e prova em três colunas. Textos por versão. */
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';
import { numerosProva } from '../../data/home';

const SOBRE_NA_HOME = false;

const numeros = (copyLiteral ? numerosProva.copy : numerosProva.estudio).map(n => {
  const [, prefixo, valor, sufixo] = n.valor.match(/^(.*?)(\d+)(.*)$/)!;
  return { ...n, prefixo, alvo: Number(valor), sufixo };
});
---
<section class="secao" id="o-que-fazemos" aria-labelledby="o-que-fazemos-titulo" data-metodologia>
  <div class="container">
    <div class:list={['metodo', 'metodo-editorial', 'entra', copyLiteral && 'metodo--copy']}>
      <div class="metodo__texto">
        <h2 class="titulo metodo__titulo" id="o-que-fazemos-titulo">
          {copyLiteral
            ? <><span>Nossa</span>{' '}<span>metodologia</span></>
            : <><span>O que a</span>{' '}<span>Renke faz</span></>}
        </h2>
        <div class="metodo__apresentacao">
          <p class="metodo__descricao">
            <span>Utilizamos a metodologia de Revenue Operations</span>{' '}
            <span>para estruturar a operação de receita. Analisamos cada etapa</span>{' '}
            <span>da jornada comercial, identificamos oportunidades e</span>{' '}
            <span>estruturamos processos a partir de dados, CRM e marketing.</span>
          </p>
          {/* Botão para /sobre desligado (28/09): com a página no ar ele surgia colado ao
              parágrafo e disputava com os números. Religar só com o aval da Lenora. */}
          {SOBRE_NA_HOME && existe('/sobre') && <p><Botao href="/sobre">Ver mais sobre a Renke</Botao></p>}
          <ul class="metodo__numeros" aria-label="Números da Renke">
            {numeros.map((n) => (
              <li class="metodo__numero">
                <p class="metodo__valor num">
                  <span class="visually-hidden">{n.valor}</span>
                  <span class="metodo__valor-reserva" aria-hidden="true">{n.valor}</span>
                  <span class="metodo__valor-contagem" aria-hidden="true" data-metodo-contador data-alvo={n.alvo} data-prefixo={n.prefixo} data-sufixo={n.sufixo}>{n.valor}</span>
                </p>
                <p class="metodo__legenda">{n.legenda}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="metodo__midia">
        <Telefone />
      </div>
    </div>
  </div>
</section>

<script>
  const movimentoReduzido = matchMedia('(prefers-reduced-motion: reduce)');
  const lista = document.querySelector<HTMLElement>('.metodo__numeros');
  if (lista && !movimentoReduzido.matches && 'IntersectionObserver' in window) {
    const contadores = Array.from(lista.querySelectorAll<HTMLElement>('[data-metodo-contador]'));
    let quadro = 0;
    const pintar = (progresso: number) => {
      for (const el of contadores) {
        const valor = Math.floor(Number(el.dataset.alvo) * progresso);
        el.textContent = `${el.dataset.prefixo ?? ''}${valor}${el.dataset.sufixo ?? ''}`;
      }
    };
    const observar = new IntersectionObserver(([entrada]) => {
      if (!entrada.isIntersecting) return;
      observar.disconnect();
      if (movimentoReduzido.matches) return;
      const inicio = performance.now();
      pintar(0);
      const animar = (agora: number) => {
        const tempo = Math.min(1, (agora - inicio) / 1800);
        pintar(1 - Math.pow(1 - tempo, 3));
        if (tempo < 1) quadro = requestAnimationFrame(animar);
      };
      quadro = requestAnimationFrame(animar);
    }, { threshold: .3 });
    observar.observe(lista);
    movimentoReduzido.addEventListener('change', () => {
      if (!movimentoReduzido.matches) return;
      observar.disconnect();
      cancelAnimationFrame(quadro);
      pintar(1);
    });
  }
</script>
