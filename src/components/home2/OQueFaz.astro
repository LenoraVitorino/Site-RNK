---
/**
 * O que a Renke faz — texto à esquerda, o reel vertical à direita, nas
 * duas versões. (A variante só com o reel, e o palco 16:9 no desktop,
 * foram testados em 16/09/2026 e descartados: o vertical com o texto ao
 * lado ficou melhor.) Copy literal.
 *
 * Desktop com JS e movimento permitido (20/09/2026, Lenora): o título vira
 * duas camadas em volta do celular — "Nossa" passa por trás da moldura e
 * "metodologia" por cima — e o vídeo sobe ao entrar na tela. O script só
 * escreve --entra (0→1, entrada) e --par (-1→1, percurso pela tela) na
 * seção; o resto é CSS em .oquefaz--profundo. Sem JS, no celular ou com
 * movimento reduzido, a dobra fica como sempre foi.
 */
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
---
<section class="secao" id="o-que-fazemos" aria-labelledby="o-que-fazemos-titulo" data-metodologia>
  <div class="container oquefaz">
    <div class="oquefaz__texto entra">
      <h2 class="titulo caps oquefaz__titulo" id="o-que-fazemos-titulo">
        <span class="oquefaz__sr">Nossa metodologia</span>
        <span class="oquefaz__palavra oquefaz__palavra--tras" aria-hidden="true">Nossa</span>{' '}
        <span class="oquefaz__palavra oquefaz__palavra--frente" aria-hidden="true">metodologia</span>
      </h2>
      <p class="oquefaz__descricao">
        <span>Utilizamos a metodologia de Revenue Operations para</span>{' '}
        <span>estruturar a operação de receita. Analisamos cada etapa</span>{' '}
        <span>da jornada comercial, identificamos oportunidades e</span>{' '}
        <span>estruturamos processos a partir de dados, CRM e marketing.</span>
      </p>
      {existe('/sobre') && <p><Botao href="/sobre">Ver mais sobre a Renke</Botao></p>}
    </div>
    <div class="oquefaz__midia entra">
      <Telefone />
    </div>
  </div>
</section>

<script>
  const secao = document.querySelector<HTMLElement>('[data-metodologia]');
  if (secao) {
    const media = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
    const midia = secao.querySelector<HTMLElement>('.oquefaz__midia')!;
    const clamp = (x: number) => Math.max(0, Math.min(1, x));
    let quadro = 0;

    const pintar = () => {
      quadro = 0;
      const vh = innerHeight;
      const r = secao.getBoundingClientRect();
      // Longe da tela (mais de 25% de altura para cada lado): só desliga o will-change.
      const perto = r.bottom > -vh * .25 && r.top < vh * 1.25;
      secao.classList.toggle('oquefaz--em-tela', perto);
      if (!perto) return;
      // Topo do celular sem o transform: ele fica centrado na seção (padding simétrico).
      const topoMidia = r.top + (r.height - midia.offsetHeight) / 2;
      // Entrada: o celular parte de 12vh abaixo quando aparece no pé da tela e repousa
      // quando o topo dele chega a 15% da altura. Saída exponencial.
      const entra = 1 - Math.pow(1 - clamp((vh * .95 - topoMidia) / (vh * .8)), 3);
      // Percurso: -1 quando a seção encosta no pé da tela, +1 quando sai por cima.
      const par = clamp((vh - r.top) / (vh + r.height)) * 2 - 1;
      secao.style.setProperty('--entra', entra.toFixed(4));
      secao.style.setProperty('--par', par.toFixed(4));
    };
    const agendar = () => { if (secao.classList.contains('oquefaz--profundo') && !quadro) quadro = requestAnimationFrame(pintar); };

    const ligar = () => {
      secao.classList.toggle('oquefaz--profundo', media.matches);
      if (media.matches) {
        pintar();
      } else {
        cancelAnimationFrame(quadro); quadro = 0;
        secao.classList.remove('oquefaz--em-tela');
        secao.style.removeProperty('--entra');
        secao.style.removeProperty('--par');
      }
    };

    addEventListener('scroll', agendar, { passive: true });
    addEventListener('resize', () => {
      // O change do matchMedia nem sempre chega com o redimensionamento; confere aqui também.
      if (media.matches !== secao.classList.contains('oquefaz--profundo')) ligar(); else agendar();
    }, { passive: true });
    media.addEventListener('change', ligar);
    ligar();
  }
</script>
