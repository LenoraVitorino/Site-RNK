---
/**
 * O que a Renke faz — texto à esquerda, o reel vertical à direita, nas
 * duas versões. (A variante só com o reel, e o palco 16:9 no desktop,
 * foram testados em 16/09/2026 e descartados: o vertical com o texto ao
 * lado ficou melhor.) Copy literal.
 */
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
---
<section class="secao" id="o-que-fazemos">
  <div class="container oquefaz">
    <div class="oquefaz__texto entra">
      <h2 class="titulo caps">Nossa metodologia</h2>
      <p>
        Utilizamos a metodologia de Revenue Operations para estruturar a operação de receita.
        Analisamos cada etapa da jornada comercial, identificamos oportunidades e estruturamos
        processos a partir de dados, CRM e marketing.
      </p>
      <p><Botao href={existe('/sobre') ? '/sobre' : '#'}>Ver mais sobre a Renke</Botao></p>
    </div>
    <div class="oquefaz__midia entra">
      <Telefone />
    </div>
  </div>
</section>
