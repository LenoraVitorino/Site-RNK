---
/**
 * Nossa metodologia: um painel de vidro no molde da seção "Product" da
 * referência PeachWeb "curious" (Lenora, 26/09/2026: a versão com capítulos
 * por scroll "não ficou dinâmica"). Em cima, o título à esquerda e a
 * descrição à direita; embaixo, o sistema conectado ao lado do reel; no pé,
 * os três números.
 *
 * O sistema conectado segue o pin do diagrama de nós que a Lenora mandou:
 * dados, CRM e marketing (as três palavras da descrição) entram no R por
 * fios finos e saem como operação de receita. Pulsos de luz correm nos fios
 * o tempo todo, devagar: é o movimento da dobra, sem trava de scroll. A
 * arte é public/arte/metodologia-sistema.svg; os rótulos são HTML por cima.
 * Vale para as duas versões; só os números mudam (numerosProva).
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';
import { numerosProva } from '../../data/home';

const numeros = copyLiteral ? numerosProva.copy : numerosProva.estudio;
const arquivo = join(process.cwd(), 'public', 'arte', 'metodologia-sistema.svg');
const sistema = existsSync(arquivo) ? readFileSync(arquivo, 'utf8') : '';
const nos = ['Dados', 'CRM', 'Marketing'];
---
<section class="secao" id="o-que-fazemos" aria-labelledby="o-que-fazemos-titulo" data-metodologia>
  <div class="container">
    <div class="metodo vidro entra">
      <div class="metodo__cabeca">
        <h2 class="titulo caps metodo__titulo" id="o-que-fazemos-titulo">Nossa<br />metodologia</h2>
        <div class="metodo__lead">
          <p class="metodo__descricao">
            Utilizamos a metodologia de Revenue Operations para estruturar a operação de receita.
            Analisamos cada etapa da jornada comercial, identificamos oportunidades e estruturamos
            processos a partir de dados, CRM&nbsp;e&nbsp;marketing.
          </p>
          {existe('/sobre') && <p><Botao href="/sobre">Ver mais sobre a Renke</Botao></p>}
        </div>
      </div>

      <div class="metodo__palco">
        <figure class="metodo__sistema" role="img" aria-label="Dados, CRM e marketing entram no método da Renke e saem como operação de receita">
          <Fragment set:html={sistema} />
          <ul class="metodo__nos" aria-hidden="true">
            {nos.map((n, i) => <li class="metodo__no" data-no={i + 1}>{n}</li>)}
            <li class="metodo__no metodo__no--saida" data-no="4">Operação de receita</li>
          </ul>
          <img class="metodo__marca" src="/marca/renke-monograma.png" alt="" width="270" height="270" loading="lazy" aria-hidden="true" />
        </figure>
        <div class="metodo__midia">
          <Telefone />
        </div>
      </div>

      <ul class="metodo__numeros" aria-label="Números da Renke">
        {numeros.map((n) => (
          <li class="metodo__numero">
            <p class="metodo__valor num">{n.valor.replace(/ /g, ' ')}</p>
            <p class="metodo__legenda">{n.legenda}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
