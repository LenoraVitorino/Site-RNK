---
/**
 * O que a Renke faz — texto à esquerda, o reel vertical à direita, nas
 * duas versões. (A variante só com o reel, e o palco 16:9 no desktop,
 * foram testados em 16/09/2026 e descartados: o vertical com o texto ao
 * lado ficou melhor.) Na versão do estúdio, "Nossos números"
 * (Numeros.astro) entra embaixo do texto; na versão copy os números ficam
 * onde estavam, no Sobre. Copy literal.
 */
import Telefone from '../ui/Telefone.astro';
import Numeros from '../ui/Numeros.astro';
import { copyLiteral } from '../../data/versao';
---
<section class="secao" id="o-que-fazemos">
  <div class="container oquefaz">
    <div class="oquefaz__texto entra">
      <p class="rotulo">O que fazemos</p>
      <h2 class="titulo caps">O que a Renke faz?</h2>
      <p>
        A Renke é a primeira assessoria de Revenue Operations para clínicas de alto padrão do
        mundo. Assista e entenda a nova categoria que criamos para revolucionar o setor de saúde
        e estética.
      </p>
      {!copyLiteral && <Numeros />}
    </div>
    <div class="oquefaz__midia entra">
      <Telefone />
    </div>
  </div>
</section>
