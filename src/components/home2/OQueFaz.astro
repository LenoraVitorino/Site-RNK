---
/**
 * Nossa metodologia: o vídeo vertical e, ao lado, o texto e os três números
 * do briefing. Vale para as duas versões; só os textos mudam
 * (numerosProva.copy / .estudio).
 *
 * Refeito em 26/09/2026 (Lenora: "dá um trato" na dobra 2). Referências da
 * curadoria (docs/04-design/curadoria/): pins 12 e 34 (coluna presa e lista
 * que corre) e 11 (números com um fio fino em cima e legenda curta). No
 * desktop o vídeo fica preso à esquerda e, à direita, os capítulos passam um
 * de cada vez: primeiro o título e a descrição, depois cada número, grande. O
 * capítulo no meio da tela acende e ganha um fio amarelo curto; os outros
 * ficam apagados. Rolagem nativa, sem trava. No celular e com movimento
 * reduzido, tudo em fluxo, sem estados.
 */
import Telefone from '../ui/Telefone.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';
import { numerosProva } from '../../data/home';
const numeros = copyLiteral ? numerosProva.copy : numerosProva.estudio;
---
<section class="secao" id="o-que-fazemos" aria-labelledby="o-que-fazemos-titulo" data-metodologia>
  <div class="container oquefaz">
    <div class="oquefaz__midia entra">
      <Telefone />
    </div>
    <div class="oquefaz__texto">
      <div class="oquefaz__capitulo oquefaz__capitulo--abre" data-capitulo>
        <h2 class="titulo caps oquefaz__titulo" id="o-que-fazemos-titulo">Nossa<br />metodologia</h2>
        <p class="oquefaz__descricao">
          Utilizamos a metodologia de Revenue Operations para estruturar a operação de receita.
          Analisamos cada etapa da jornada comercial, identificamos oportunidades e estruturamos
          processos a partir de dados, CRM&nbsp;e&nbsp;marketing.
        </p>
        {existe('/sobre') && <p><Botao href="/sobre">Ver mais sobre a Renke</Botao></p>}
      </div>
      <ul class="oquefaz__numeros" aria-label="Números da Renke">
        {numeros.map((n, i) => (
          <li class="oquefaz__capitulo oquefaz__numero" data-capitulo>
            <span class="oquefaz__fio" aria-hidden="true"><span></span></span>
            <p class="oquefaz__valor num">{n.valor.replace(/ /g, ' ')}</p>
            <p class="oquefaz__legenda">{n.legenda}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Acende o capítulo cujo centro está mais perto do meio da tela.
  const secao = document.querySelector<HTMLElement>('[data-metodologia]');
  if (secao) {
    const media = matchMedia('(min-width: 1080px) and (prefers-reduced-motion: no-preference)');
    const caps = [...secao.querySelectorAll<HTMLElement>('[data-capitulo]')];
    let quadro = 0;
    const marcar = () => {
      quadro = 0;
      if (!media.matches) return;
      const meio = innerHeight / 2;
      let melhor = 0, dist = Infinity;
      caps.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - meio);
        if (d < dist) { dist = d; melhor = i; }
      });
      caps.forEach((c, i) => c.classList.toggle('oquefaz__capitulo--ativo', i === melhor));
    };
    const ligar = () => {
      secao.classList.toggle('oquefaz--viva', media.matches);
      if (!media.matches) caps.forEach((c) => c.classList.remove('oquefaz__capitulo--ativo'));
      marcar();
    };
    addEventListener('scroll', () => { if (!quadro) quadro = requestAnimationFrame(marcar); }, { passive: true });
    media.addEventListener('change', ligar);
    ligar();
  }
</script>
