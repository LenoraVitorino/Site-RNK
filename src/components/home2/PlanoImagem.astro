---
interface Props { plano: string }
const { plano } = Astro.props;
const imagens: Record<string, string> = {
  start: 'seringa', run: 'maos', scale: 'tesoura', core: 'maos', full: 'protese-dentaria',
};
---
<div class:list={['plano-editorial', `plano-editorial--${plano}`]} aria-hidden="true">
  <img class="plano-editorial__foto" src={`/imagens/planos-editoriais/${imagens[plano] ?? 'seringa'}.webp`} alt="" width="1254" height="1254" loading="lazy" decoding="async" />
  <span class="plano-editorial__simbolo" style={`--simbolo: url('/icones/plano-${plano}-dark.svg')`}></span>
</div>
