---
/** História, fotos da sede e indicadores, compartilhados pelas duas versões. */
import { Image } from 'astro:assets';
import Botao from '../ui/Botao.astro';
import Numeros from '../ui/Numeros.astro';
import { existe } from '../../data/rotas';
import operacao from '../../assets/sede/operacao.jpg';
import conexao from '../../assets/sede/conexao.jpg';
import reuniao from '../../assets/sede/reuniao.jpg';
---
<section class="secao sobre-editorial" id="sobre" aria-labelledby="sobre-titulo">
  <div class="container">
    <div class="sobre-editorial__grade">
      <div class="sobre-editorial__texto entra">
        <p class="rotulo">Por dentro da Renke</p>
        <h2 class="sobre__declaracao" id="sobre-titulo">Conheça a história da Renke</h2>
        <p class="sobre-editorial__descricao">
          Há mais de quatro anos, percebemos que clínicas com bons resultados ainda perdiam
          oportunidades por falta de conexão entre marketing, comercial{' '}e{' '}operação.
        </p>
        <div><Botao href={existe('/sobre') ? '/sobre' : '#'}>Ver mais sobre a Renke</Botao></div>
      </div>
      <div class="sobre-editorial__mosaico entra">
        <figure class="sobre-editorial__foto sobre-editorial__foto--principal">
          <Image src={operacao} alt="Escritório da Renke com estações de trabalho, equipe e sala envidraçada" format="webp" widths={[360, 720, 1080]} sizes="(max-width: 899px) 55vw, 30vw" loading="lazy" />
          <figcaption>Onde tudo se conecta</figcaption>
        </figure>
        <figure class="sobre-editorial__foto sobre-editorial__foto--conexao">
          <Image src={conexao} alt="Vista da sala de reunião para a operação da Renke" format="webp" widths={[360, 720, 1080]} sizes="(max-width: 899px) 55vw, 30vw" loading="lazy" />
          <figcaption>A operação, de perto</figcaption>
        </figure>
        <figure class="sobre-editorial__foto sobre-editorial__foto--reuniao">
          <Image src={reuniao} alt="Sala de reuniões da Renke com mesa, quadro e tela" format="webp" widths={[360, 720, 1080]} sizes="(max-width: 899px) 55vw, 30vw" loading="lazy" />
          <figcaption>Espaço para construir juntos</figcaption>
        </figure>
      </div>
    </div>
    <div class="sobre-editorial__numeros"><Numeros /></div>
  </div>
</section>
