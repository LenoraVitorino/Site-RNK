---
/**
 * O que a Renke entrega na prática: os cinco pilares da copy, em cartões
 * (Lenora, 21/09 — "insira como card por enquanto"). Grade estática, sem a
 * dobra presa ao scroll; o CSS do palco anterior segue em home2.css, para o
 * caso de voltar. Apresentação compartilhada pelas duas versões; os textos
 * vêm dos recortes do estúdio ou da copy integral.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pilares } from '../../data/home';
import { pilaresEstudio } from '../../data/pilares-estudio';
import { copyLiteral } from '../../data/versao';

const cartas = pilares.map((p, i) => ({
  ...p,
  ...(!copyLiteral ? pilaresEstudio[i] : {}),
  iconeSvg: readFileSync(join(process.cwd(), 'public', 'icones', `pilar-0${i + 1}.svg`), 'utf8'),
}));
---
<section class="secao pilares" id={copyLiteral ? 'protocolo-revena' : 'pilares-revena'} aria-labelledby="pilares-revena-titulo">
  <div class="container">
    <header class="pilares__cabeca entra">
      <p class="rotulo">Para clínicas</p>
      <h2 class="titulo" id="pilares-revena-titulo">Protocolo Revena</h2>
    </header>
    <ul class="pilares__grade entra">
      {cartas.map((p) => (
        <li class="pilar-card">
          <span class="pilar-card__icone" aria-hidden="true" set:html={p.iconeSvg} />
          <h3 class="pilar-card__titulo">{p.titulo}</h3>
          <p class="pilar-card__texto">{p.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
