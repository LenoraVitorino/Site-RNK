---
/** Pilares da copy original, com apresentação compartilhada pelas duas versões. */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pilares } from '../../data/home';
import { copyLiteral } from '../../data/versao';

const cartas = pilares.map((p, i) => ({
  ...p,
  iconeSvg: readFileSync(join(process.cwd(), 'public', 'icones', `pilar-0${i + 1}.svg`), 'utf8'),
}));
---
<section class="secao revena-pilares" id={copyLiteral ? 'protocolo-revena' : 'pilares-revena'} aria-labelledby="pilares-revena-titulo">
  <div class="container">
    <header class="revena-pilares__cabeca entra">
      <p class="rotulo">Para clínicas</p>
      <h2 class="titulo" id="pilares-revena-titulo">Protocolo Revena</h2>
    </header>
    <div class="revena-pilares__lista">
      {cartas.map((p) => (
        <article class="revena-pilar entra">
          <div class="revena-pilar__texto">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
          <div class="revena-pilar__visual" aria-hidden="true">
            <span class="revena-pilar__orbita"></span>
            <span class="revena-pilar__icone" set:html={p.iconeSvg} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
