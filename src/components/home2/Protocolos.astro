---
/**
 * Dobra 3 · Protocolo Revena.
 *
 * A escada em grade amarela: os pilares do método, numerados porque a
 * ordem existe. Os planos vivem em Planos.astro, o trilho que vem em
 * seguida. Copy literal.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { pilares } from '../../data/home';

// Ícone de cada pilar: public/icones/pilar-01.svg … pilar-05.svg. Só entra
// no HTML o que existir na pasta; sem o arquivo, o degrau fica como está.
const icone = (i: number) => {
  const nome = `pilar-0${i + 1}.svg`;
  return existsSync(join(process.cwd(), 'public', 'icones', nome)) ? `/icones/${nome}` : null;
};
---
<section class="secao secao--amarela" id="protocolo-revena">
  <div class="container">
    <div class="cabeca cabeca--larga entra">
      <p class="rotulo rotulo--marca">Para clínicas</p>
      <h2 class="titulo caps">Protocolo Revena</h2>
      <p style="color:rgb(22 22 22 / .8)">Cinco frentes que a Renke opera na sua clínica.</p>
    </div>
    <ol class="escada entra" aria-label="Pilares do Protocolo Revena">
      {pilares.map((p, i) => (
        <li class:list={['degrau', p.excedente && 'degrau--extra']}>
          <span class="degrau__n num">0{i + 1}.</span>
          <div>
            {icone(i) && <img class="degrau__icone" src={icone(i)} alt="" width="32" height="32" loading="lazy" />}
            <p class="degrau__titulo">{p.titulo}</p>
            <p class="degrau__texto">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

