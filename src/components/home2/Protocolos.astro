---
import { pilares } from '../../data/home';
import { pilaresEstudio } from '../../data/pilares-estudio';
import { copyLiteral } from '../../data/versao';
import ArtePilar from './ArtePilar.astro';
import PilarEssencial from './PilarEssencial.astro';
import Selo from '../ui/Selo.astro';
const cartas = pilares.map((p, i) => ({ ...p, ...(!copyLiteral ? pilaresEstudio[i] : {}) }));
const formatos = ['jornada', 'crm', 'automacao', 'decisao', 'posicionamento'];
---
<section class="secao pilares pilares-features" id={copyLiteral ? 'protocolo-revena' : 'pilares-revena'} aria-labelledby="pilares-revena-titulo" data-pilares>
  <div class="container">
    <header class="pilares__cabeca entra">
      {!copyLiteral && <Selo class="cabeca-dobra__selo" marca="revena">Metodologia proprietária</Selo>}
      <h2 class="titulo" id="pilares-revena-titulo">Protocolo Revena</h2>
      {!copyLiteral && <p>Cinco frentes. Uma operação conectada.</p>}
    </header>
    <div class="features-grade features-grade--bento">
      {cartas.map((p, i) => (
        <article class:list={['feature-card', `feature-card--${formatos[i]}`, 'entra']}>
          <div class="feature-card__arte">
            {i === 1 || i === 2 ? <ArtePilar tipo={i} /> : <PilarEssencial tipo={i} />}
          </div>
          <div class="feature-card__texto"><h3>{p.titulo}</h3><p>{p.texto}</p></div>
        </article>
      ))}
    </div>
    {copyLiteral && <div class="pilares-editoriais__ponte">
      <p>A Renke recomenda o protocolo certo para o momento da sua clínica.</p>
      <a class="link-arrow" href="#planos">Ver os planos</a>
    </div>}
  </div>
</section>
