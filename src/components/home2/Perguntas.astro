---
/**
 * O que muda na sua clínica (02/10/2026). Cartões de vidro desfocado sobre
 * o fundo animado (aprovado: "manter essa estética ficou foda"), numa
 * composição da referência "Business Goals": título em cima, em duas linhas,
 * e quatro colunas de cartões quase quadrados em diagrama, uns tocando os
 * outros pelas quinas (X X · X / · · X · / X X · X; "deixa alguns um na
 * ponta do outro"). O cartão de destaque com o número saiu. Ícone fino em anel, título e texto
 * embaixo. A grade se constrói ao entrar (referência Tiwis, 0:15–0:16).
 * Na copy original cada cartão traz a pergunta de dor do briefing (uma
 * frase só) no lugar do ganho; as duas listas casam na mesma ordem.
 */
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';
import { copyLiteral } from '../../data/versao';

/* Ícones Renke, um por ganho (versão em cor: traço claro, losango em amarelo). */
const icones: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
---
<section class="secao ganhos" id="perguntas" aria-labelledby="perguntas-titulo" data-ganhos>
  <div class="container">
    <header class="ganhos__cabeca">
      {copyLiteral ? (
        <h2 class="ancora operacao__titulo" id="perguntas-titulo">
          Clinicamente, você sabe exatamente o que está acontecendo com seu paciente.
          <strong>Mas e com o seu negócio?</strong>
        </h2>
      ) : (
        <>
          <Selo class="cabeca-dobra__selo">O que muda na sua clínica</Selo>
          <h2 class="ancora ancora--revela operacao__titulo" id="perguntas-titulo" data-revena-revela>
            {['Uma operação estruturada muda', 'a forma como sua clínica cresce.'].map((linha) => (
              <span class="ancora__linha">
                {linha.split(' ').map((palavra) => <><span data-palavra>{palavra}</span>{' '}</>)}
              </span>
            ))}
          </h2>
          <p class="cabeca-dobra__apoio">Dados, CRM e marketing conectados para cada etapa da jornada do paciente ser medida e melhorada.</p>
        </>
      )}
    </header>

    {/* Dor e resposta (10/10): as sete perguntas do dono de clínica, da copy
        original, em linhas grandes; a da vez acende e, ao lado, um cartão só
        mostra o que muda com a Renke. Passa sozinha, e o ponteiro ou o toque
        escolhem. Na copy original ficam só as perguntas, sem o cartão. */}
    <div class:list={['dores', { 'dores--so-perguntas': copyLiteral }]} data-dores>
      <ol class="dores__lista" aria-label={copyLiteral ? 'Perguntas' : 'O que muda na sua clínica'}>
        {perguntas.map((p, i) => (
          <li class="dores__item">
            <button type="button" class:list={['dores__pergunta', { 'dores__pergunta--ativa': i === 0 }]} data-dor={i} aria-pressed={i === 0 ? 'true' : 'false'}>{p.pergunta}</button>
            {!copyLiteral && <div class="dores__mob"><h3>{p.titulo}</h3><p>{p.texto}</p></div>}
          </li>
        ))}
      </ol>
      {!copyLiteral && (
        <div class="dores__painel" aria-hidden="true">
          {perguntas.map((p, i) => (
            <article class:list={['dores__resposta', { 'dores__resposta--ativa': i === 0 }]} data-resposta={i}>
              <span class="ganhos__anel"><IconeRenke nome={icones[i]} size={22} class="ganhos__icone" /></span>
              <div class="dores__corpo">
                <p class="dores__com">Com a Renke</p>
                <h3 class="ganhos__nome">{p.titulo}</h3>
                <p class="ganhos__texto">{p.texto}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  /* A pergunta da vez: troca sozinha a cada 4,5 s enquanto a dobra está na
     tela e ninguém está escolhendo; ponteiro, foco e toque escolhem. */
  const dores = document.querySelector<HTMLElement>('[data-dores]');
  if (dores) {
    const perguntas = [...dores.querySelectorAll<HTMLButtonElement>('[data-dor]')];
    const respostas = [...dores.querySelectorAll<HTMLElement>('[data-resposta]')];
    let atual = 0, naTela = false, escolhendo = false;
    const ativar = (i: number) => {
      atual = i;
      perguntas.forEach((b, k) => { b.classList.toggle('dores__pergunta--ativa', k === i); b.setAttribute('aria-pressed', String(k === i)); });
      respostas.forEach((r, k) => r.classList.toggle('dores__resposta--ativa', k === i));
    };
    perguntas.forEach((b, i) => {
      b.addEventListener('pointerenter', () => ativar(i));
      b.addEventListener('focus', () => ativar(i));
      b.addEventListener('click', () => ativar(i));
    });
    dores.addEventListener('pointerenter', () => { escolhendo = true; });
    dores.addEventListener('pointerleave', () => { escolhendo = false; });
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { naTela = e.isIntersecting; }, { threshold: .3 }).observe(dores);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => { if (naTela && !escolhendo && !document.hidden) ativar((atual + 1) % perguntas.length); }, 4500);
    }
  }
</script>
