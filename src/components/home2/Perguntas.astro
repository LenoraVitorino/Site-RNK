---
/**
 * Frase-âncora + perguntas, no bloco escuro que dá ritmo à página.
 * As quatro primeiras ocupam o grid 2×2 que o layout pede; as outras três
 * seguem em linha menor — a D8 (quais quatro) continua em aberto, e
 * esconder copy não resolve decisão.
 * Na versão copy, a .cortina em volta faz esta dobra entrar pela direita,
 * por cima do trilho dos planos, no fim do curso dele: primeiro só a
 * frase-âncora; no scroll seguinte ela sobe e as perguntas aparecem
 * (--fim e --sobe vêm do script de Planos.astro). Na versão do estúdio o
 * trilho não existe e a dobra segue em fluxo, com o revelar .entra.
 */
import { perguntas } from '../../data/home';
import { copyLiteral } from '../../data/versao';
const principais = perguntas.filter((p) => !p.excedente);
const demais = perguntas.filter((p) => p.excedente);
const entra = copyLiteral ? '' : 'entra';
---
<div class:list={[copyLiteral && 'cortina']}>
<section class="secao secao--escura" id="perguntas">
  <div class="container">
    {copyLiteral ? (
      <p class="ancora">
        Clinicamente, você sabe exatamente o que está acontecendo com seu paciente.
        <strong>Mas e com o seu negócio?</strong>
      </p>
    ) : (
      <h2 class="ancora ancora--revela" data-revena-revela>
        {['Operação em', 'alta performance.'].map((linha) => (
          <span class="ancora__linha">
            {linha.split(' ').map((palavra) => <><span data-palavra class:list={[['alta', 'performance.'].includes(palavra) && 'ancora__destaque']}>{palavra}</span>{' '}</>)}
          </span>
        ))}
      </h2>
    )}
    <div class:list={['perguntas', entra]}>
      {principais.map((p, i) => (
        <div class="pergunta">
          <span class="pergunta__n num">0{i + 1}</span>
          <h3 class="pergunta__titulo">{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>
    <div class:list={['perguntas', 'perguntas--mais', entra]}>
      {demais.map((p, i) => (
        <div class="pergunta">
          <span class="pergunta__n num">0{i + 5}</span>
          <h3 class="pergunta__titulo">{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
</div>
