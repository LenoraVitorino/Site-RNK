---
/**
 * O que muda na sua clínica (02/10/2026). Cartões de vidro desfocado sobre
 * o fundo animado (aprovado: "manter essa estética ficou foda"), numa
 * composição da referência "Business Goals": título em cima, em duas linhas,
 * e quatro colunas de cartões quase quadrados em diagrama, uns tocando os
 * outros pelas quinas (X X · X / · · X · / X X · X; "deixa alguns um na
 * ponta do outro"). O cartão de destaque com o número saiu. Ícone fino em anel, título e texto
 * embaixo. A grade se constrói ao entrar (referência Tiwis, 0:15–0:16).
 * Na copy original cada cartão traz a pergunta de dor do briefing (uma
 * frase só) no lugar do ganho; as duas listas casam na mesma ordem.
 */
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';
import { copyLiteral } from '../../data/versao';
import { doresRespostas } from '../../data/dores-respostas';

/* dor: teste (10/10, /laboratorio/dores-solucoes) dos mesmos cartões com a
   pergunta de dor e a resposta da Renke no lugar do ganho solto. */
/* composicao: teste (10/10) de outra composição dos cartões, em bento de
   larguras variadas e sem buracos, no lugar do losango ("meio xadrez",
   "achatado", "compacto"). Referências: pins 10133167906261798 ("What We Do
   Best") e 718535315593728369. */
interface Props { dor?: boolean; composicao?: 'losango' | 'bento' }
const { dor = false, composicao = 'losango' } = Astro.props;

/* Ícones Renke, um por ganho (versão em cor: traço claro, losango em amarelo). */
const icones: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
---
<section class:list={['secao', 'ganhos', composicao === 'bento' && 'ganhos--bento']} id="perguntas" aria-labelledby="perguntas-titulo" data-ganhos>
  <div class="container">
    <header class="ganhos__cabeca">
      {copyLiteral ? (
        <h2 class="ancora operacao__titulo" id="perguntas-titulo">
          Clinicamente, você sabe exatamente o que está acontecendo com seu paciente.
          <strong>Mas e com o seu negócio?</strong>
        </h2>
      ) : (
        <>
          <Selo class="cabeca-dobra__selo">O que muda na sua clínica</Selo>
          <h2 class="ancora ancora--revela operacao__titulo" id="perguntas-titulo" data-revena-revela>
            {['Uma operação estruturada muda', 'a forma como sua clínica cresce.'].map((linha) => (
              <span class="ancora__linha">
                {linha.split(' ').map((palavra) => <><span data-palavra>{palavra}</span>{' '}</>)}
              </span>
            ))}
          </h2>
          <p class="cabeca-dobra__apoio">Dados, CRM e marketing conectados para cada etapa da jornada do paciente ser medida e melhorada.</p>
        </>
      )}
    </header>

    <ol class="ganhos__grade" aria-label="O que muda na sua clínica" data-ganhos-grade>
      {perguntas.map((p, i) => (
        <li class:list={['ganhos__cartao', `ganhos__cartao--${i + 1}`, { 'ganhos__cartao--pergunta': copyLiteral }]} style={`--i:${i}`}>
          <span class="ganhos__anel" aria-hidden="true">
            <IconeRenke nome={icones[i]} size={22} class="ganhos__icone" />
          </span>
          <div class="ganhos__corpo">
            {copyLiteral ? (
              <h3 class="ganhos__nome ganhos__nome--pergunta"><span>{p.pergunta}</span></h3>
            ) : dor ? (
              <>
                <h3 class="ganhos__nome ganhos__nome--pergunta"><span>{doresRespostas[i].q}</span></h3>
                <p class="ganhos__texto ganhos__texto--resposta"><span><strong>{doresRespostas[i].t}</strong> {doresRespostas[i].r}</span></p>
              </>
            ) : (
              <>
                <h3 class="ganhos__nome"><span>{p.titulo}</span></h3>
                <p class="ganhos__texto"><span>{p.texto}</span></p>
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  /* A grade se constrói uma vez, quando um quarto dela entra na tela. */
  const grade = document.querySelector<HTMLElement>('[data-ganhos-grade]');
  if (grade) {
    const construir = () => grade.classList.add('ganhos__grade--construida');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) construir();
    else {
      const obs = new IntersectionObserver((entradas) => {
        if (entradas.some((e) => e.isIntersecting)) { construir(); obs.disconnect(); }
      }, { threshold: .25 });
      obs.observe(grade);
    }
  }
</script>
