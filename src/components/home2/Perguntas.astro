---
/** Coluna de abertura fixa no desktop e sete cards em fluxo normal.
 * Movimento: Solutions do Keen. Escala, ritmo e sombra: cards da seção
 * AI solutions for every team do ClickUp oficial (10/10/2026).
 * No celular, toda a seção segue a rolagem da página, sem conteúdo oculto. */
import { perguntas } from '../../data/home';
import { copyLiteral } from '../../data/versao';
import { doresRespostas } from '../../data/dores-respostas';

interface Props { respostas?: boolean }
const { respostas = false } = Astro.props;
---
<section class="secao perguntas-cartoes" id="perguntas" aria-labelledby="perguntas-titulo">
  <div class="container perguntas-cartoes__layout">
    <header class="perguntas-cartoes__abertura">
      <h2 id="perguntas-titulo">
        {copyLiteral ? <>Clinicamente, você sabe exatamente o que está acontecendo com seu paciente. <strong>Mas e com o seu negócio?</strong></> : <>O que muda na sua clínica</>}
      </h2>
      {!copyLiteral && <p>Uma operação estruturada muda a forma como sua clínica cresce.</p>}
    </header>

    <ol class="perguntas-cartoes__lista" aria-label="Sete perguntas sobre sua clínica">
      {perguntas.map((p, i) => (
        <li class="perguntas-cartoes__cartao">
          <h3>{p.pergunta}</h3>
          {!copyLiteral && respostas && <p>{doresRespostas[i].r}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .perguntas-cartoes { scroll-margin-top: 88px; }
  .perguntas-cartoes__layout { display: grid; grid-template-columns: .78fr 1.22fr; align-items: start; gap: clamp(48px, 6vw, 88px); }
  .perguntas-cartoes__abertura { position: sticky; top: 140px; padding-top: 6px; }
  .perguntas-cartoes__abertura h2 { max-width: 17ch; margin: 0; font-size: clamp(30px, 2.4vw, 36px); font-weight: 400; line-height: 1.2; letter-spacing: -.035em; text-wrap: pretty; }
  .perguntas-cartoes__abertura h2 strong { font-weight: inherit; color: var(--amarelo, #ffd103); }
  .perguntas-cartoes__abertura > p { max-width: 33ch; margin: 18px 0 0; color: #aeada6; font-size: 16px; line-height: 1.55; text-wrap: pretty; }
  .perguntas-cartoes__lista { display: grid; gap: 12px; min-width: 0; padding: 0; margin: 0; list-style: none; }
  /* O ClickUp usa raio e intervalo de 12px, com sombra curta em duas
     camadas. A opacidade é ajustada aqui para a superfície escura da Renke. */
  .perguntas-cartoes__cartao { display: flex; flex-direction: column; justify-content: center; gap: 14px; min-height: 104px; padding: 24px 28px; border: 1px solid rgb(255 255 255 / .065); border-radius: 12px; background: rgb(29 29 28 / .96); box-shadow: 0 1px 3px rgb(0 0 0 / .24), 0 2px 6px -2px rgb(0 0 0 / .2); }
  .perguntas-cartoes__cartao h3 { margin: 0; color: #e7e7e1; font-size: 21px; font-weight: 400; line-height: 1.4; letter-spacing: -.015em; text-wrap: pretty; }
  .perguntas-cartoes__cartao p { margin: 0; color: #aeada6; font-size: 16px; line-height: 1.5; text-wrap: pretty; }
  @media (max-width: 1023.98px) {
    .perguntas-cartoes__layout { grid-template-columns: 1fr; gap: 28px; }
    .perguntas-cartoes__abertura { position: static; padding: 0; }
    .perguntas-cartoes__abertura h2 { max-width: 26ch; font-size: 32px; }
    .perguntas-cartoes__abertura > p { max-width: 42ch; margin-top: 16px; }
    .perguntas-cartoes__cartao { min-height: 0; }
    .perguntas-cartoes__cartao h3 { font-size: 20px; }
  }
  @media (max-width: 599.98px) {
    .perguntas-cartoes__layout { gap: 24px; }
    .perguntas-cartoes__abertura h2 { max-width: 18ch; font-size: 28px; }
    .perguntas-cartoes__abertura > p { font-size: 15px; }
    .perguntas-cartoes__lista { gap: 12px; }
    .perguntas-cartoes__cartao { padding: 20px 22px; }
    .perguntas-cartoes__cartao h3 { font-size: 18px; line-height: 1.45; }
    .perguntas-cartoes__cartao p { font-size: 15px; }
  }
  @media (max-height: 599.98px) { .perguntas-cartoes__abertura { position: static; } }
</style>
