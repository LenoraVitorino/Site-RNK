---
/**
 * Segunda dobra depois da hero, como a referência: cinco colunas largas
 * que intercalam fotos e cartões, saindo da borda esquerda do container e
 * sangrando pela direita. --e vai de -1 a 1 conforme a faixa atravessa a
 * viewport; cada coluna multiplica por seu próprio fator (parallax).
 * As fotos ainda são espaços reservados (a nova sede não chegou).
 */
import FotoSlot from '../ui/FotoSlot.astro';

type Item =
  | { tipo: 'foto'; rotulo: string; prop: string }
  | { tipo: 'cartao'; valor: string; texto: string; escuro?: boolean };

const colunas: Item[][] = [
  [{ tipo: 'cartao', valor: '~30', texto: 'clínicas atendidas', escuro: true }, { tipo: 'foto', rotulo: 'Foto · time', prop: '1 / 1' }],
  [{ tipo: 'foto', rotulo: 'Foto · sede', prop: '3 / 4' }, { tipo: 'cartao', valor: '4 anos', texto: 'de método validado' }],
  [{ tipo: 'foto', rotulo: 'Foto · operação', prop: '9 / 16' }],
  [{ tipo: 'cartao', valor: 'R$42M', texto: 'em faturamento gerado' }, { tipo: 'foto', rotulo: 'Foto · reunião', prop: '4 / 5' }],
  [{ tipo: 'foto', rotulo: 'Foto · detalhe', prop: '3 / 4' }, { tipo: 'foto', rotulo: 'Foto · sede', prop: '1 / 1' }],
];
---
<section class="esteira" data-esteira aria-label="Fotos e números da Renke">
  <div class="esteira__trilho">
    {colunas.map((c) => (
      <div class="esteira__coluna">
        {c.map((f) =>
          f.tipo === 'foto' ? (
            <FotoSlot rotulo={f.rotulo} prop={f.prop} />
          ) : (
            <div class:list={['esteira__cartao', f.escuro && 'esteira__cartao--escuro']} style="aspect-ratio: 4 / 5">
              {f.escuro && <img src="/marca/renke-monograma.png" alt="" width="275" height="275" loading="lazy" />}
              <b>{f.valor}</b>
              <small>{f.texto}</small>
            </div>
          ),
        )}
      </div>
    ))}
  </div>
</section>

<script>
  const faixa = document.querySelector<HTMLElement>('[data-esteira]');
  if (faixa && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let agendado = false;
    const mede = () => {
      agendado = false;
      const r = faixa.getBoundingClientRect();
      // -1 quando a faixa entra por baixo, +1 quando sai por cima
      const e = Math.max(-1, Math.min(1, 1 - (2 * (r.top + r.height)) / (innerHeight + r.height)));
      faixa.style.setProperty('--e', e.toFixed(4));
    };
    const pede = () => { if (!agendado) { agendado = true; requestAnimationFrame(mede); } };
    addEventListener('scroll', pede, { passive: true });
    addEventListener('resize', pede, { passive: true });
    mede();
  }
</script>
