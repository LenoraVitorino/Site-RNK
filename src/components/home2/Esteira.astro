---
/**
 * Segunda dobra, como a referência: um trilho de cartões preso na tela
 * que anda para o lado conforme a página rola. As colunas preenchem a
 * altura da dobra, de ponta a ponta, e intercalam fotos grandes,
 * depoimentos com o logo da clínica, cartões só de logo e os números do
 * briefing (⚠️ D1).
 * --x é o deslocamento horizontal, calculado no scroll pelo script.
 * Sem JS ou com menos movimento, o trilho fica solto e rola no dedo.
 * Fotos, depoimentos e logos ainda são espaços reservados.
 */
import FotoSlot from '../ui/FotoSlot.astro';

type Item =
  | { tipo: 'foto'; rotulo: string; prop: string }
  | { tipo: 'numero'; valor: string; texto: string; escuro?: boolean }
  | { tipo: 'depoimento' }
  | { tipo: 'logo' };

// Cada coluna preenche a altura da dobra; `linhas` divide o espaço entre
// os cartões (proporções desiguais, como na referência).
// Ritmo: cartão escuro largo, duas colunas estreitas, cartão escuro de
// novo. Cada coluna preenche a altura da dobra; `linhas` divide o espaço
// entre os cartões (proporções desiguais, como na referência).
const colunas: { larga?: boolean; linhas?: string; itens: Item[] }[] = [
  { larga: true, itens: [{ tipo: 'numero', valor: '~30', texto: 'clínicas atendidas', escuro: true }] },
  { linhas: '1fr 1.25fr', itens: [{ tipo: 'depoimento' }, { tipo: 'foto', rotulo: 'Time', prop: '3 / 4' }] },
  { itens: [{ tipo: 'foto', rotulo: 'Operação', prop: '9 / 16' }] },
  { larga: true, itens: [{ tipo: 'numero', valor: '4 anos', texto: 'de método validado', escuro: true }] },
  { linhas: '1.3fr 1fr', itens: [{ tipo: 'foto', rotulo: 'Reunião', prop: '4 / 5' }, { tipo: 'logo' }] },
  { linhas: '1fr 1.2fr', itens: [{ tipo: 'depoimento' }, { tipo: 'foto', rotulo: 'Detalhe', prop: '1 / 1' }] },
  { larga: true, itens: [{ tipo: 'numero', valor: 'R$42M', texto: 'em faturamento gerado', escuro: true }] },
  { linhas: '1fr 1.3fr', itens: [{ tipo: 'logo' }, { tipo: 'foto', rotulo: 'Sede', prop: '3 / 4' }] },
  { itens: [{ tipo: 'foto', rotulo: 'Atendimento', prop: '9 / 16' }] },
];
---
<section class="esteira" data-esteira aria-label="Fotos, depoimentos e números da Renke">
  <div class="esteira__fixo">
    <div class="esteira__trilho" data-esteira-trilho>
      {colunas.map((c) => (
        <div class:list={['esteira__coluna', c.larga && 'esteira__coluna--larga']} style={c.linhas ? `grid-template-rows: ${c.linhas}` : undefined}>
          {c.itens.map((f) => {
            if (f.tipo === 'foto') return <FotoSlot rotulo={f.rotulo} prop={f.prop} />;
            if (f.tipo === 'numero')
              return (
                <div class:list={['esteira__cartao', 'esteira__numero', f.escuro && 'esteira__cartao--escuro']}>
                  {f.escuro && <img src="/marca/renke-monograma.png" alt="" width="275" height="275" loading="lazy" />}
                  <b data-contador>{f.valor}</b>
                  <small>{f.texto}</small>
                </div>
              );
            if (f.tipo === 'depoimento')
              return (
                <figure class="esteira__cartao esteira__depoimento">
                  <span class="esteira__logo" aria-label="Espaço para logo da clínica">Logo</span>
                  <blockquote>"Depoimento a coletar."</blockquote>
                  <figcaption>Nome · Especialidade · Cidade</figcaption>
                </figure>
              );
            return (
              <div class="esteira__cartao esteira__somente-logo">
                <span class="esteira__logo esteira__logo--grande" aria-label="Espaço para logo da clínica">Logo</span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  /* Anda para o lado o que a página anda para baixo: --x vai de 0 até o
     que falta do trilho fora da tela, no curso em que a dobra fica presa. */
  const dobra = document.querySelector<HTMLElement>('[data-esteira]');
  const trilho = dobra?.querySelector<HTMLElement>('[data-esteira-trilho]');
  const header = document.getElementById('header');
  if (dobra && trilho && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let agendado = false;
    const mede = () => {
      agendado = false;
      const r = dobra.getBoundingClientRect();
      const topo = header?.offsetHeight ?? 0;
      const curso = dobra.offsetHeight - (innerHeight - topo);
      const p = curso > 0 ? Math.min(1, Math.max(0, (topo - r.top) / curso)) : 1;
      const sobra = Math.max(0, trilho.scrollWidth - (trilho.parentElement?.clientWidth ?? innerWidth));
      dobra.style.setProperty('--x', (p * sobra).toFixed(1) + 'px');
    };
    const pede = () => { if (!agendado) { agendado = true; requestAnimationFrame(mede); } };
    addEventListener('scroll', pede, { passive: true });
    addEventListener('resize', pede, { passive: true });
    mede();
  }
</script>
