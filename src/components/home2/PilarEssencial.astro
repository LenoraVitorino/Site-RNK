---
/** Três ilustrações estáticas para o bento: só a ideia central, sem telas
    cheias de dados ou animações. CRM e automação mantêm suas cenas próprias. */
interface Props { tipo: number }
const { tipo } = Astro.props;
const p = `pilar-essencial-${tipo}`;
---
<svg class="pilar-essencial" viewBox="0 0 400 300" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${p}-papel`} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#292928" /><stop offset="1" stop-color="#181818" />
    </linearGradient>
    <linearGradient id={`${p}-area`} x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="#d6d5cf" stop-opacity=".08" /><stop offset="1" stop-color="#d6d5cf" stop-opacity="0" />
    </linearGradient>
  </defs>
  {tipo === 0 && <>
    {/* RevOps conecta as frentes da operação, sem fluxo ou animação contínua. */}
    <g stroke="#ffffff" stroke-opacity=".16" stroke-width="1.2">
      <path d="M200 59v46M200 193v49" />
      <path d="M150 128h-12q-12 0-12-12v-8q0-12-12-12M250 128h12q12 0 12-12v-8q0-12 12-12" />
      <path d="M150 168h-12q-12 0-12 12v10q0 12-12 12M250 168h12q12 0 12 12v10q0 12 12 12" />
    </g>
    <g fill="#191919" stroke="#ffffff" stroke-opacity=".08">
      <rect x="152" y="15" width="96" height="44" rx="8" />
      <rect x="10" y="75" width="104" height="42" rx="8" />
      <rect x="286" y="75" width="104" height="42" rx="8" />
      <rect x="4" y="181" width="116" height="42" rx="8" />
      <rect x="280" y="181" width="116" height="42" rx="8" />
      <rect x="152" y="242" width="96" height="42" rx="8" />
    </g>
    <g fill="#c3c3bd" font-size="15" font-weight="400" text-anchor="middle" dominant-baseline="middle">
      <text x="200" y="37">CRM</text>
      <text x="62" y="96">Marketing</text>
      <text x="338" y="96">Vendas</text>
      <text x="62" y="202">Atendimento</text>
      <text x="338" y="202">Pós-venda</text>
      <text x="200" y="263">Dados</text>
    </g>
    <rect x="145" y="100" width="110" height="98" rx="12" fill="#111111" stroke="#ffffff" stroke-opacity=".04" />
    <rect x="150" y="105" width="100" height="88" rx="9" fill={`url(#${p}-papel)`} stroke="#ffffff" stroke-opacity=".16" />
    <image href="/marca/renke-monograma.png" x="182" y="115" width="36" height="36" />
    <text x="200" y="175" fill="#e2e2dc" font-size="19" font-weight="450" text-anchor="middle">RevOps</text>
  </>}
  {tipo === 3 && <>
    <path d="M38 221C88 220 95 188 139 191S205 156 246 160 309 122 361 98V259H38Z" fill={`url(#${p}-area)`} />
    <path d="M38 221C88 220 95 188 139 191S205 156 246 160 309 122 361 98" stroke="#c3c3bd" stroke-width="2" stroke-linecap="round" />
    <path d="M38 258h324" stroke="#ffffff" stroke-opacity=".08" />
    <circle cx="246" cy="160" r="5" fill="#1b1b1b" stroke="#d6d5cf" stroke-width="1.5" />
    <circle cx="246" cy="160" r="2" fill="#FFD103" />
  </>}
  {tipo === 4 && <>
    <g transform="rotate(-6 200 150)">
      <rect x="65" y="77" width="224" height="160" rx="10" fill="#121212" stroke="#ffffff" stroke-opacity=".06" />
      <rect x="83" y="61" width="224" height="160" rx="10" fill="#191919" stroke="#ffffff" stroke-opacity=".08" />
      <rect x="101" y="45" width="224" height="160" rx="10" fill={`url(#${p}-papel)`} stroke="#ffffff" stroke-opacity=".13" />
      <path d="M130 72h66M130 87h38" stroke="#ffffff" stroke-opacity=".18" stroke-width="3" stroke-linecap="round" />
      <path d="M188 147v-41m0 0h45l-7 13 7 13h-45" stroke="#d6d5cf" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M178 151h23" stroke="#d6d5cf" stroke-opacity=".4" stroke-width="1.5" stroke-linecap="round" />
      <path d="M130 179h76" stroke="#ffffff" stroke-opacity=".12" stroke-width="3" stroke-linecap="round" />
    </g>
  </>}
</svg>

<style>
  .pilar-essencial { display: block; width: 100%; height: 100%; }
</style>
