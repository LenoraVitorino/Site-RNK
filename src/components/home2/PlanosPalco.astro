---
/**
 * Revena: palco de rolagem inspirado na seção Financial solutions da Tresmares.
 * Camadas sobem com recorte, títulos se alternam e os símbolos permanecem no
 * centro, desmontando e remontando suas peças. Ver docs/04-design/planos-movimento.md.
 * Sem JS, em telas pequenas ou com movimento reduzido: todos os planos em pilha.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { protocolos } from '../../data/home';
import { existe } from '../../data/rotas';
import Botao from '../ui/Botao.astro';

const ordem = ['REVENA START', 'REVENA RUN', 'REVENA SCALE', 'REVENA CORE', 'REVENA FULL'];

const chave = (label: string) => label.replace('REVENA ', '').toLowerCase();
const nome = (label: string) => { const n = chave(label); return n[0].toUpperCase() + n.slice(1); };

/* Lê o SVG oficial e devolve as duas peças do ícone: o lado amarelo
   (class cls-1) e o lado escuro (o resto), cada um com todas as suas
   formas (rect, path, polygon…). O ícone se monta com as duas metades se
   unindo, como a Lenora pediu em 17/09. Os arquivos novos, com cada lado já
   unificado numa forma só, entram com os mesmos nomes. */
type Peca = { formas: string; ouro: boolean };
const pecas = (label: string): Peca[] => {
  const arq = join(process.cwd(), 'public', 'icones', `plano-${chave(label)}-light.svg`);
  if (!existsSync(arq)) return [];
  const svg = readFileSync(arq, 'utf8');
  const lados: Record<'ouro' | 'papel', string[]> = { ouro: [], papel: [] };
  for (const m of svg.matchAll(/<(rect|path|polygon|circle|ellipse)\b([^>]*?)\/?>/g)) {
    const [, tag, attrs] = m;
    const ouro = /class="cls-1"/.test(attrs);
    lados[ouro ? 'ouro' : 'papel'].push(`<${tag} ${attrs.replace(/\s*class="[^"]*"/, '').trim()}/>`);
  }
  return (['ouro', 'papel'] as const).filter((l) => lados[l].length).map((l) => ({ ouro: l === 'ouro', formas: lados[l].join('') }));
};

const planos = ordem.map((label) => {
  const p = protocolos.find((x) => x.label === label)!;
  return {
    id: chave(label),
    nome: nome(label),
    fala: p.fala,
    texto: p.texto,
    rota: p.rota,
    pecas: pecas(label),
  };
});
---
<section class="palcoplanos" id="protocolo-revena" data-palcoplanos style={`--n:${planos.length}`}>
  <!-- Introdução da dobra, antes do palco, como o bloco de texto que antecede
       a "Financial solutions" da referência. -->
  <div class="palcoplanos__intro">
    <div class="container palcoplanos__cabeca">
      <div>
        <h2 class="palcoplanos__titulo">Revena</h2>
      </div>
    </div>
  </div>

  <!-- O container da referência: n telas de altura; o palco (.sticky) fica preso. -->
  <div class="palcoplanos__trilho" data-trilho>
    <div class="palcoplanos__fixo">
      <!-- .anchors: canto superior esquerdo, a atual em destaque; clicar leva ao plano. -->
      <ol class="palcoplanos__ancoras" aria-label="Planos Revena">
        {planos.map((p, i) => (
          <li><button type="button" class:list={['palcoplanos__ancora', i === 0 && 'palcoplanos__ancora--ativa']} data-plano-ir={i} aria-current={i === 0 ? 'true' : undefined}>Revena {p.nome}</button></li>
        ))}
      </ol>

      <!-- Um plano por camada; a próxima camada é revelada de baixo para cima. -->
      {planos.map((p, i) => (
        <article class:list={['plano-palco', i % 2 === 1 && 'plano-palco--tom2', i === 0 && 'plano-palco--ativo']} data-plano={i} >
          <div class="plano-palco__imagem" data-imagem>
            <img class="plano-palco__icone-mob" src={`/icones/plano-${p.id}-light.svg`} alt="" width="160" height="160" loading="lazy" aria-hidden="true" />
          </div>
          <div class="plano-palco__info" data-info>
            <h3 class="plano-palco__nome plano-palco__nome--pilha"><span class="plano-palco__nome__a">Revena</span><span class="plano-palco__nome__b">{p.nome}</span></h3>
            <h3 class="plano-palco__h3">Revena {p.nome}</h3>

            <div class="plano-palco__texto">
              <p class="plano-palco__frase">{p.texto}</p>
              <Botao href={existe(p.rota) ? p.rota : '#'} tamanho="sm">Saiba mais</Botao>
            </div>

            <div class="plano-palco__dados">
              <span class="plano-palco__indice" aria-hidden="true">0{i + 1} / 0{planos.length}</span>
              {p.fala.split(/(?<=\.)\s+/).map((linha) => <p class="plano-palco__fala">{linha}</p>)}
            </div>
          </div>
        </article>
      ))}

      <!-- Símbolos independentes do recorte: as peças atravessam a troca dos fundos. -->
      <div class="palcoplanos__icones" aria-hidden="true">
        {planos.map((p, i) => (
          <svg class="plano-palco__icone" data-icone={i} viewBox="0 0 1080 1080" focusable="false">
            {p.pecas.map((peca, k) => (
              <g class:list={['peca', peca.ouro ? 'peca--ouro' : 'peca--papel']} data-peca={k} set:html={peca.formas} />
            ))}
          </svg>
        ))}
      </div>

      <!-- Os nomes por cima dos ícones: o texto fica na frente (pedido da Lenora, 18/09). -->
      <div class="palcoplanos__nomes" aria-hidden="true">
        {planos.map((p) => (
          <p class="plano-palco__nome" data-nome><span class="plano-palco__nome__a">Revena</span><span class="plano-palco__nome__b">{p.nome}</span></p>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const secao = document.querySelector<HTMLElement>('[data-palcoplanos]');
  const trilho = secao?.querySelector<HTMLElement>('[data-trilho]');
  if (secao && trilho) {
    const media = matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    const layers = [...trilho.querySelectorAll<HTMLElement>('[data-plano]')];
    const icons = [...trilho.querySelectorAll<SVGSVGElement>('[data-icone]')];
    const pieces = icons.map(icon => [...icon.querySelectorAll<SVGGElement>('[data-peca]')]);
    const images = layers.map(layer => layer.querySelector<HTMLElement>('[data-imagem]')!);
    const infos = layers.map(layer => layer.querySelector<HTMLElement>('[data-info]')!);
    const names = [...trilho.querySelectorAll<HTMLElement>('[data-nome]')];
    const anchors = [...trilho.querySelectorAll<HTMLButtonElement>('[data-plano-ir]')];
    const header = document.getElementById('header');
    const clamp = (x: number) => Math.max(0, Math.min(1, x));
    const ease = (x: number) => x * x * (3 - 2 * x);
    const count = layers.length;
    let top = 0, travel = 1, height = 1, current = 0, target = 0;
    let frame = 0, previousTime = 0, snapTimer = 0, scrollFrame = 0;
    let active = -1;
    // Directions in SVG units: each official symbol retains its own composition.
    const directions = [[-150, 150], [-180, 0], [0, 180], [0, -180], [150, -150]];

    function measure() {
      top = trilho!.getBoundingClientRect().top + scrollY;
      height = trilho!.querySelector<HTMLElement>('.palcoplanos__fixo')!.offsetHeight;
      travel = Math.max(1, trilho!.offsetHeight - height);
    }
    function select(index: number) {
      if (index === active) return;
      active = index;
      layers.forEach((layer, i) => {
        const selected = i === index;
        layer.inert = !selected;
        layer.setAttribute('aria-hidden', String(!selected));
        layer.classList.toggle('plano-palco--ativo', selected);
        anchors[i].classList.toggle('palcoplanos__ancora--ativa', selected);
        if (selected) anchors[i].setAttribute('aria-current', 'true');
        else anchors[i].removeAttribute('aria-current');
      });
    }
    function paint(y: number) {
      const position = clamp((y - top) / travel) * (count - 1);
      const pre = clamp(1 + (y - top) / height);
      select(Math.min(count - 1, Math.round(position)));
      header?.classList.toggle('header--oculto', scrollY >= top && scrollY < top + travel + height * .5);
      layers.forEach((layer, i) => {
        const incoming = clamp(position - i + 1);
        const outgoing = clamp(position - i);
        const visible = incoming > 0 && outgoing < 1;
        layer.style.visibility = visible ? 'visible' : 'hidden';
        layer.style.zIndex = String(i + 1);
        layer.style.clipPath = `inset(${(100 * (1 - incoming)).toFixed(3)}% 0 0)`;
        layer.style.opacity = String(1 - outgoing);
        images[i].style.transform = `translate3d(0,${20 * (1 - incoming - outgoing)}%,0)`;
        infos[i].style.transform = `translate3d(0,${30 * (1 - incoming - outgoing)}%,0)`;
        infos[i].style.opacity = String(clamp(1 - outgoing * 2));
        names[i].style.opacity = String(clamp(incoming * 4 - 3) * clamp(1 - outgoing * 4));
        // The title travels with its information layer, independently of the wipe.
        names[i].style.translate = `0 ${30 * (1 - incoming - outgoing)}vh`;
        icons[i].style.visibility = visible ? 'visible' : 'hidden';
        // Continuous silhouette: collapse into a small central form, then unfold.
        // Both forms overlap at mid-transition; there is no blank frame.
        const enter = ease(clamp((incoming - .5) / .5));
        const leave = ease(clamp(outgoing / .5));
        const opacity = clamp((incoming - .38) / .16) * (1 - clamp((outgoing - .46) / .16));
        icons[i].style.opacity = String(opacity);
        const scale = .34 + .66 * enter - .66 * leave;
        icons[i].style.transform = `translate3d(0,${(1 - enter - leave) * 4}%,0) scale(${Math.max(.24, scale)})`;
        pieces[i].forEach((piece, k) => {
          const sign = k === 0 ? 1 : -1;
          const amount = (1 - enter) + leave;
          const [x, y] = directions[i];
          piece.setAttribute('transform', `translate(${sign * x * amount} ${sign * y * amount}) rotate(${sign * amount * 18} 540 540)`);
        });
      });
      if (pre < 1) {
        const arrival = ease(clamp((pre - .3) / .7));
        images[0].style.transform = `translate3d(0,${-10 * (1 - pre)}%,0)`;
        infos[0].style.transform = `translate3d(0,${15 * (1 - pre)}%,0)`;
        infos[0].style.opacity = String(clamp(pre * 4 - 3));
        names[0].style.opacity = String(clamp(pre * 4 - 3));
        names[0].style.translate = `0 ${15 * (1 - pre)}vh`;
        icons[0].style.opacity = String(arrival);
        icons[0].style.transform = `translate3d(0,${12 * (1 - arrival)}%,0) scale(${.65 + .35 * arrival})`;
      }
    }
    function animate(time: number) {
      const dt = previousTime ? Math.min(64, time - previousTime) : 16;
      previousTime = time;
      current += (target - current) * (1 - Math.exp(-dt / 90));
      if (Math.abs(target - current) < .2) current = target;
      paint(current);
      frame = current !== target ? requestAnimationFrame(animate) : 0;
      if (!frame) previousTime = 0;
    }
    function update() {
      if (!media.matches) return;
      target = scrollY;
      if (!frame) frame = requestAnimationFrame(animate);
    }
    function cancelSnap() {
      clearTimeout(snapTimer);
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
    }
    function goTo(y: number, duration = 720) {
      cancelSnap();
      const from = scrollY, start = performance.now();
      if (Math.abs(from - y) < 2) return;
      const tick = (time: number) => {
        const p = clamp((time - start) / duration);
        scrollTo({ top: from + (y - from) * ease(p), behavior: 'instant' });
        scrollFrame = p < 1 ? requestAnimationFrame(tick) : 0;
      };
      scrollFrame = requestAnimationFrame(tick);
    }
    function snap() {
      if (!media.matches || scrollFrame || scrollY < top || scrollY >= top + travel) return;
      const position = (scrollY - top) / travel * (count - 1);
      goTo(top + Math.round(position) / (count - 1) * travel);
    }
    function setup() {
      cancelSnap();
      cancelAnimationFrame(frame); frame = 0; previousTime = 0; active = -1;
      secao!.toggleAttribute('data-animado', media.matches);
      header?.classList.remove('header--oculto');
      if (media.matches) {
        measure(); current = target = scrollY; paint(current);
      } else {
        layers.forEach(layer => { layer.inert = false; layer.removeAttribute('aria-hidden'); layer.removeAttribute('style'); });
      }
    }
    addEventListener('scroll', () => {
      update();
      clearTimeout(snapTimer);
      if (media.matches && !scrollFrame) snapTimer = window.setTimeout(snap, 260);
    }, { passive: true });
    for (const event of ['wheel', 'touchstart', 'pointerdown', 'keydown']) {
      addEventListener(event, cancelSnap, { passive: true });
    }
    anchors.forEach((anchor, i) => anchor.addEventListener('click', () => {
      if (media.matches) goTo(top + i / (count - 1) * travel, 900);
    }));
    addEventListener('resize', setup, { passive: true });
    media.addEventListener('change', setup);
    // Layout above can change after font load; refresh the cached scroll geometry.
    document.fonts.ready.then(setup);
    new ResizeObserver(() => { if (media.matches) { measure(); update(); } }).observe(document.body);
    setup();
  }
</script>
