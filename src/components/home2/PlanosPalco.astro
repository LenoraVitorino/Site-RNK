---
/**
 * Dobra 3 (versão do estúdio) · Protocolo Revena num palco preso na tela,
 * no desenho da dobra "Financial solutions" da referência Tres Mares
 * (tresmarescapital.com, 17/09/2026): a lista dos planos no canto superior
 * esquerdo com o atual em destaque; no centro o ícone do plano, grande e
 * translúcido, se formando peça a peça, com o nome em duas linhas
 * desencontradas por cima; embaixo à esquerda a frase do plano e o "Saiba
 * mais"; à direita a fala da doutora ("o momento da clínica") e o pilar que
 * o plano entrega. A página rola, o palco fica: cada plano ocupa uma tela
 * de scroll. Título e apoio da dobra ficam no topo do palco.
 *
 * Fotos ao fundo (como a planta da referência) entram depois; por ora só o
 * ícone. Os ícones são os oficiais dos planos (public/icones), lidos no
 * build e postos inline para animar peça a peça; quando chegarem os SVGs
 * novos, basta sobrescrever os arquivos.
 *
 * Ordem dos planos: Start, Run, Scale, Core, Full (a ordem que a Lenora
 * usa ao falar deles). Copy literal em todos os textos; o cruzamento
 * plano → pilar é o mesmo de Protocolos.astro, a validar.
 *
 * 18/09/2026: refeito IGUAL à dobra "Financial solutions" da referência,
 * lida do CSS e da timeline GSAP do tema (tresmarescapital.com):
 * container de n × 100vh com o .sticky preso; âncoras a 5vw do topo e da
 * esquerda (0,75vw, opacidade .4, ativa 1); cada plano é um .content
 * absoluto com a imagem de fundo e o .info por cima; texto numa coluna de
 * 10vw no canto inferior esquerdo (1vw, medium), dados numa coluna de
 * 8,333vw à direita (rótulo 0,75vw bold caixa alta, valor 0,917vw medium);
 * título de 50,75vw em mix-blend multiply, linha 1 à esquerda e linha 2 à
 * direita. A transição ocupa o trecho inteiro, sem segurada: o que sai
 * perde opacidade (1→0) com a imagem subindo 20% e o info subindo 30% e
 * sumindo na primeira metade; o título some no primeiro quarto; o que entra
 * é revelado por clip-path inset(100%→0), imagem descendo de 20% e info de
 * 30%, título aparecendo no último quarto. A âncora troca no meio do
 * trecho. Snap nos fins de trecho. O cabeçalho some enquanto a dobra está
 * presa (data-hide-header na referência).
 *
 * Sem JS ou com menos movimento, e abaixo de 900px, vira uma pilha: um
 * bloco por plano.
 */
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { pilares, protocolos } from '../../data/home';
import { existe } from '../../data/rotas';

const ordem = ['REVENA START', 'REVENA RUN', 'REVENA SCALE', 'REVENA CORE', 'REVENA FULL'];
// Pilar → plano que o entrega (ver nota em Protocolos.astro).
const planoDoPilar = ['REVENA CORE', 'REVENA START', 'REVENA FULL', 'REVENA RUN', 'REVENA SCALE'];

const chave = (label: string) => label.replace('REVENA ', '').toLowerCase();
const nome = (label: string) => { const n = chave(label); return n[0].toUpperCase() + n.slice(1); };

/* Lê o SVG oficial e devolve as duas peças do ícone: o lado amarelo
   (class cls-1) e o lado escuro (o resto), cada um com todas as suas
   formas (rect, path, polygon…). O ícone se monta com as duas metades se
   unindo, como a Lenora pediu em 17/09. Os arquivos novos, com cada lado já
   unificado numa forma só, entram com os mesmos nomes. */
type Peca = { formas: string; ouro: boolean };
const pecas = (label: string): Peca[] => {
  const arq = join(process.cwd(), 'public', 'icones', `plano-${chave(label)}-light.svg`);
  if (!existsSync(arq)) return [];
  const svg = readFileSync(arq, 'utf8');
  const lados: Record<'ouro' | 'papel', string[]> = { ouro: [], papel: [] };
  for (const m of svg.matchAll(/<(rect|path|polygon|circle|ellipse)\b([^>]*?)\/?>/g)) {
    const [, tag, attrs] = m;
    const ouro = /class="cls-1"/.test(attrs);
    lados[ouro ? 'ouro' : 'papel'].push(`<${tag} ${attrs.replace(/\s*class="[^"]*"/, '').trim()}/>`);
  }
  return (['ouro', 'papel'] as const).filter((l) => lados[l].length).map((l) => ({ ouro: l === 'ouro', formas: lados[l].join('') }));
};

const planos = ordem.map((label) => {
  const p = protocolos.find((x) => x.label === label)!;
  const iPilar = planoDoPilar.indexOf(label);
  return {
    id: chave(label),
    nome: nome(label),
    fala: p.fala,
    texto: p.texto,
    rota: p.rota,
    pilar: pilares[iPilar],
    numeroPilar: iPilar + 1,
    pecas: pecas(label),
  };
});
---
<section class="palcoplanos" id="protocolo-revena" data-palcoplanos style={`--n:${planos.length}`}>
  <!-- Introdução da dobra, antes do palco, como o bloco de texto que antecede
       a "Financial solutions" da referência. -->
  <div class="palcoplanos__intro">
    <div class="container palcoplanos__cabeca">
      <div>
        <p class="rotulo rotulo--pilula">Para clínicas</p>
        <h2 class="palcoplanos__titulo">Protocolo Revena</h2>
      </div>
      <p class="palcoplanos__apoio">
        Estruturamos sua operação do zero e operamos juntos no longo prazo.
        <strong>Qual é o momento da sua clínica?</strong>
      </p>
    </div>
  </div>

  <!-- O container da referência: n telas de altura; o palco (.sticky) fica preso. -->
  <div class="palcoplanos__trilho" data-trilho>
    <div class="palcoplanos__fixo">
      <!-- .anchors: canto superior esquerdo, a atual em destaque; clicar leva ao plano. -->
      <ol class="palcoplanos__ancoras" aria-label="Planos do Protocolo Revena">
        {planos.map((p, i) => (
          <li><button type="button" class:list={['palcoplanos__ancora', i === 0 && 'palcoplanos__ancora--ativa']} data-plano-ir={i} aria-current={i === 0 ? 'true' : undefined}>Revena {p.nome}</button></li>
        ))}
      </ol>

      <!-- .content: um por plano, tela cheia, com a imagem de fundo e o .info por cima. -->
      {planos.map((p, i) => (
        <article class:list={['plano-palco', i % 2 === 1 && 'plano-palco--tom2', i === 0 && 'plano-palco--ativo']} data-plano={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="plano-palco__imagem" data-imagem>
            <img class="plano-palco__icone-mob" src={`/icones/plano-${p.id}-light.svg`} alt="" width="160" height="160" loading="lazy" aria-hidden="true" />
          </div>
          <div class="plano-palco__info" data-info>
            <p class="plano-palco__nome plano-palco__nome--pilha" aria-hidden="true"><span class="plano-palco__nome__a">Revena</span><span class="plano-palco__nome__b">{p.nome}</span></p>
            <h3 class="plano-palco__h3">Revena {p.nome}</h3>

            <div class="plano-palco__texto">
              <p class="plano-palco__frase">{p.texto}</p>
              <a class="link-arrow" href={existe(p.rota) ? p.rota : '#'} class:list={[!existe(p.rota) && 'nav--pendente']} data-rota={p.rota}>Saiba mais</a>
            </div>

            <dl class="plano-palco__dados">
              <div>
                <dt>Momento da clínica</dt>
                <dd class="plano-palco__fala">“{p.fala}”</dd>
              </div>
              <div>
                <dt>Pilar 0{p.numeroPilar}</dt>
                <dd>{p.pilar.titulo}</dd>
              </div>
            </dl>
          </div>
        </article>
      ))}

      <!-- Os ícones numa camada só, por cima das dobras (como o SVG da referência):
           assim a linha de revelação da dobra que entra não corta o ícone. -->
      <div class="palcoplanos__icones" aria-hidden="true">
        {planos.map((p, i) => (
          <svg class="plano-palco__icone" data-icone={i} viewBox="0 0 1080 1080" focusable="false">
            {p.pecas.map((peca, k) => (
              <g class:list={['peca', peca.ouro ? 'peca--ouro' : 'peca--papel']} data-peca={k} set:html={peca.formas} />
            ))}
          </svg>
        ))}
      </div>

      <!-- Os nomes por cima dos ícones: o texto fica na frente (pedido da Lenora, 18/09). -->
      <div class="palcoplanos__nomes" aria-hidden="true">
        {planos.map((p) => (
          <p class="plano-palco__nome" data-nome><span class="plano-palco__nome__a">Revena</span><span class="plano-palco__nome__b">{p.nome}</span></p>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  /* A timeline da referência, sem biblioteca. Curso = (n − 1) telas; cada
     trecho é uma transição inteira (sem segurada). Pré-trecho (a dobra
     chegando): imagem do primeiro plano desce de −10% a 0, info sobe de 15%
     a 0 e aparece no último quarto. Snap nos fins de trecho quando a
     rolagem para. */
  const secao = document.querySelector<HTMLElement>('[data-palcoplanos]');
  const dobra = secao?.querySelector<HTMLElement>('[data-trilho]') ?? null;
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (dobra && !reduz) {
    const layers = [...dobra.querySelectorAll<HTMLElement>('[data-plano]')];
    const icones = [...dobra.querySelectorAll<SVGSVGElement>('[data-icone]')];
    const imagens = layers.map((l) => l.querySelector<HTMLElement>('[data-imagem]')!);
    const infos = layers.map((l) => l.querySelector<HTMLElement>('[data-info]')!);
    const nomes = [...dobra.querySelectorAll<HTMLElement>('[data-nome]')];   // na camada de nomes, na mesma ordem dos planos
    const itens = [...dobra.querySelectorAll<HTMLElement>('[data-plano-ir]')];
    const header = document.getElementById('header');
    const n = layers.length;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const entraSai = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const desktop = () => !matchMedia('(max-width: 899.98px)').matches;

    const escondido = layers.map(() => true);

    let ativo = -1;
    const marca = (i: number) => {
      if (i === ativo) return;
      ativo = i;
      layers.forEach((l, k) => { l.classList.toggle('plano-palco--ativo', k === i); if (k === i) l.removeAttribute('aria-hidden'); else l.setAttribute('aria-hidden', 'true'); });
      itens.forEach((b, k) => { b.classList.toggle('palcoplanos__ancora--ativa', k === i); if (k === i) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    };

    /* Pinta um plano: dentro = quanto já entrou (0→1), fora = quanto já saiu
       (0→1). Os valores são os da timeline da referência. */
    const pinta = (k: number, dentro: number, fora: number) => {
      const l = layers[k];
      const visivel = dentro > 0 && fora < 1;
      if (!visivel) {
        if (!escondido[k]) { l.style.visibility = 'hidden'; icones[k].style.visibility = 'hidden'; nomes[k].style.opacity = '0'; escondido[k] = true; }
        return;
      }
      if (escondido[k]) { l.style.visibility = 'visible'; icones[k].style.visibility = 'visible'; escondido[k] = false; }
      const corte = (1 - dentro) * 100;
      l.style.clipPath = corte > 0.01 ? `inset(${corte.toFixed(2)}% 0 0 0)` : 'none';
      l.style.opacity = String(clamp(1 - fora));                         // contentsNotLast: 1 → 0
      l.style.zIndex = dentro < 1 ? '3' : '2';
      imagens[k].style.transform = `translate3d(0, ${((1 - dentro) * 20 - fora * 20).toFixed(2)}%, 0)`;   // imgs: 20% → 0 → −20%
      infos[k].style.transform = `translate3d(0, ${((1 - dentro) * 30 - fora * 30).toFixed(2)}%, 0)`;     // infos: 30% → 0 → −30%
      infos[k].style.opacity = String(clamp(1 - fora * 2));                // infosNotLast: 1 → −1 (some na primeira metade)
      nomes[k].style.opacity = String(clamp(dentro * 4 - 3) * clamp(1 - fora * 4));   // titles: −3 → 1 / 1 → −3
      // Ícone inteiro, como a forma da referência: sai esmaecendo na primeira
      // metade e subindo com o info; entra esmaecendo na segunda metade e
      // subindo do fundo, um pouco menor.
      const ic = icones[k];
      ic.style.opacity = String(clamp(dentro * 2 - 1) * clamp(1 - fora * 2));
      ic.style.transform = `translate3d(0, ${((1 - dentro) * 30 - fora * 30).toFixed(2)}%, 0) scale(${(0.92 + 0.08 * dentro - 0.08 * fora).toFixed(3)})`;
    };

    const medidas = () => {
      const r = dobra.getBoundingClientRect();
      const topo = r.top + scrollY;
      const curso = dobra.offsetHeight - innerHeight;
      return { r, topo, curso };
    };
    const posicaoDoPlano = (i: number, topo: number, curso: number) => topo + curso * (i / (n - 1));

    let ticking = false;
    const mede = () => {
      if (!desktop()) return;
      const { r, curso } = medidas();
      // Pré-trecho: a dobra chegando (start "top bottom" → end "top top").
      const pre = r.top > 0 ? clamp(1 - r.top / innerHeight) : 1;
      const t = clamp(-r.top / curso);
      const preso = r.top <= 0 && -r.top < curso;
      header?.classList.toggle('header--oculto', preso);
      const pos = Math.min(n - 1 - 1e-6, t * (n - 1));
      const de = Math.floor(pos);
      const f = pos - de;
      for (let k = 0; k < n; k++) {
        if (k < de) pinta(k, 1, 1);
        else if (k === de) pinta(k, 1, f);
        else if (k === de + 1) pinta(k, f, 0);
        else pinta(k, 0, 0);
      }
      if (de === 0 && pre < 1) {
        // O primeiro plano chega inteiro (sem clip): imagem −10% → 0, info 15% → 0 e opacidade −3 → 1.
        imagens[0].style.transform = `translate3d(0, ${(-(1 - pre) * 10).toFixed(2)}%, 0)`;
        infos[0].style.transform = `translate3d(0, ${((1 - pre) * 15).toFixed(2)}%, 0)`;
        infos[0].style.opacity = String(clamp(pre * 4 - 3));
        nomes[0].style.opacity = String(clamp(pre * 4 - 3));
        icones[0].style.opacity = String(clamp(pre * 4 - 3));
        icones[0].style.transform = `translate3d(0, ${((1 - pre) * 15).toFixed(2)}%, 0) scale(1)`;
      }
      marca(f < 0.5 ? de : de + 1);
    };

    /* Snap: a rolagem parou dentro da dobra → desliza até o fim de trecho
       mais próximo (os pontos "postshow" da referência). Qualquer gesto novo
       cancela. */
    let deslizando: number | null = null;
    let quieto: number | undefined;
    const cancela = () => { if (deslizando !== null) { cancelAnimationFrame(deslizando); deslizando = null; } };
    const deslizaAte = (alvo: number, dur = 900) => {
      cancela();
      const de = scrollY, t0 = performance.now();
      if (Math.abs(alvo - de) < 2) return;
      let esperado = de;
      const quadro = (t: number) => {
        if (Math.abs(scrollY - esperado) > 3) { deslizando = null; return; }
        const k = Math.min(1, (t - t0) / dur);
        esperado = Math.round(de + (alvo - de) * entraSai(k));
        scrollTo({ top: esperado, behavior: 'instant' as ScrollBehavior });
        deslizando = k < 1 ? requestAnimationFrame(quadro) : null;
      };
      deslizando = requestAnimationFrame(quadro);
    };
    const encaixa = () => {
      if (!desktop() || deslizando !== null) return;
      const { r, topo, curso } = medidas();
      if (r.top > 0 || -r.top >= curso) return;
      const i = Math.round((-r.top / curso) * (n - 1));
      deslizaAte(posicaoDoPlano(i, topo, curso));
    };
    for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(ev, cancela, { passive: true });

    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(() => { mede(); ticking = false; }); }
      clearTimeout(quieto);
      quieto = setTimeout(encaixa, 140);
    }, { passive: true });
    addEventListener('resize', mede, { passive: true });
    mede();

    /* Clicar numa âncora desliza até o plano (a referência salta direto; aqui um deslize curto). */
    itens.forEach((b, i) => b.addEventListener('click', () => {
      const { topo, curso } = medidas();
      deslizaAte(posicaoDoPlano(i, topo, curso), 1000);
    }));
  }
</script>
