---
/**
 * Dobra 1 · palco centralizado em três passos, como a hero da referência.
 *
 *  1. Ao carregar: "Isso não é marketing para clínicas." no centro, com a
 *     seta para baixo.
 *  2. No primeiro gesto de rolar: a frase é riscada e some; "Isso é
 *     RevOps." entra suave, no amarelo original, e segura enquanto o
 *     reflexo atravessa a palavra.
 *  3. Em seguida, sozinho: ele sai e entram título, subtítulo e CTA. Só
 *     então a página rola de verdade.
 *
 * Nada é ligado à posição do scroll: a cena é tocada por tempo, de uma
 * vez. Sem JS ou com menos movimento, tudo nasce no estado final. Copy
 * literal.
 */
import { hero } from '../../data/home';
import Botao from '../ui/Botao.astro';

const palavras = ['Isso', 'não', 'é'];
// O lead quebra em duas linhas no desktop, na fronteira das frases.
const corte = hero.lead.indexOf('caem. ') + 'caem. '.length;
const leadLinhas = [hero.lead.slice(0, corte), hero.lead.slice(corte)];
---
<section class="palco" data-palco aria-label="Apresentação">
  <div class="palco__fixo">
    <div class="hero__centro">
      <div class="hero__cena">
        <h1 class="hero__h1" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
          <span class="tomada tomada--1" aria-hidden="true">
            {palavras.map((p, i) => <><span class="palavra" style={`--i:${i}`}>{p}</span>{' '}</>)}
            <span class="palavra riscado" style="--i:3">marketing para clínicas.</span>
          </span>
          <span class="tomada tomada--2" aria-hidden="true">
            <span class="revops"><span class="revops__isso">Isso é</span><span class="revops__marca">RevOps.</span></span>
          </span>
        </h1>

        <div class="hero__copy">
          <p class="hero__titulo">Revenue Operations estratégico para transformar clínicas médicas em negócios de <span class="brilho">alta performance.</span></p>
          <p class="hero__lead">{leadLinhas[0]}<br class="quebra-desktop" />{leadLinhas[1]}</p>
          <p class="hero__acoes"><Botao href="/contato" variante="claro">{hero.cta}</Botao></p>
        </div>
      </div>

      <p class="hero__seta" aria-hidden="true"><span>↓</span></p>
    </div>

    <div class="hero__confianca">
      <div class="hero__confianca__inner">
        <p class="hero__confianca__frase">Doutores que <strong>confiam na Renke</strong></p>
        <svg class="hero__mapa" viewBox="0 0 132 150" width="132" height="150" fill="var(--amarelo)" aria-hidden="true" role="presentation"><circle cx="3" cy="3" r="1.35" /><circle cx="9" cy="3" r="1.35" /><circle cx="3" cy="9" r="1.35" /><circle cx="9" cy="9" r="1.35" /><circle cx="15" cy="9" r="1.35" /><circle cx="21" cy="9" r="1.35" /><circle cx="27" cy="9" r="1.35" /><circle cx="9" cy="15" r="1.35" /><circle cx="15" cy="15" r="1.35" /><circle cx="21" cy="15" r="1.35" /><circle cx="27" cy="15" r="1.35" /><circle cx="33" cy="15" r="1.35" /><circle cx="39" cy="15" r="1.35" /><circle cx="21" cy="21" r="1.35" /><circle cx="27" cy="21" r="1.35" /><circle cx="33" cy="21" r="1.35" /><circle cx="39" cy="21" r="1.35" /><circle cx="45" cy="21" r="1.35" /><circle cx="51" cy="21" r="1.35" /><circle cx="33" cy="27" r="1.35" /><circle cx="39" cy="27" r="1.35" /><circle cx="45" cy="27" r="1.35" /><circle cx="51" cy="27" r="1.35" /><circle cx="69" cy="27" r="1.35" /><circle cx="81" cy="27" r="1.35" /><circle cx="39" cy="33" r="1.35" /><circle cx="45" cy="33" r="1.35" /><circle cx="51" cy="33" r="1.35" /><circle cx="57" cy="33" r="1.35" /><circle cx="75" cy="33" r="1.35" /><circle cx="81" cy="33" r="1.35" /><circle cx="45" cy="39" r="1.35" /><circle cx="51" cy="39" r="1.35" /><circle cx="57" cy="39" r="1.35" /><circle cx="63" cy="39" r="1.35" /><circle cx="51" cy="45" r="1.35" /><circle cx="57" cy="45" r="1.35" /><circle cx="63" cy="45" r="1.35" /><circle cx="69" cy="45" r="1.35" /><circle cx="75" cy="45" r="1.35" /><circle cx="51" cy="51" r="1.35" /><circle cx="57" cy="51" r="1.35" /><circle cx="63" cy="51" r="1.35" /><circle cx="69" cy="51" r="1.35" /><circle cx="75" cy="51" r="1.35" /><circle cx="81" cy="51" r="1.35" /><circle cx="87" cy="51" r="1.35" /><circle cx="93" cy="51" r="1.35" /><circle cx="99" cy="51" r="1.35" /><circle cx="105" cy="51" r="1.35" /><circle cx="111" cy="51" r="1.35" /><circle cx="45" cy="57" r="1.35" /><circle cx="51" cy="57" r="1.35" /><circle cx="57" cy="57" r="1.35" /><circle cx="63" cy="57" r="1.35" /><circle cx="69" cy="57" r="1.35" /><circle cx="75" cy="57" r="1.35" /><circle cx="81" cy="57" r="1.35" /><circle cx="87" cy="57" r="1.35" /><circle cx="93" cy="57" r="1.35" /><circle cx="99" cy="57" r="1.35" /><circle cx="105" cy="57" r="1.35" /><circle cx="111" cy="57" r="1.35" /><circle cx="117" cy="57" r="1.35" /><circle cx="45" cy="63" r="1.35" /><circle cx="51" cy="63" r="1.35" /><circle cx="57" cy="63" r="1.35" /><circle cx="63" cy="63" r="1.35" /><circle cx="69" cy="63" r="1.35" /><circle cx="75" cy="63" r="1.35" /><circle cx="81" cy="63" r="1.35" /><circle cx="87" cy="63" r="1.35" /><circle cx="93" cy="63" r="1.35" /><circle cx="99" cy="63" r="1.35" /><circle cx="105" cy="63" r="1.35" /><circle cx="111" cy="63" r="1.35" /><circle cx="117" cy="63" r="1.35" /><circle cx="123" cy="63" r="1.35" /><circle cx="51" cy="69" r="1.35" /><circle cx="57" cy="69" r="1.35" /><circle cx="63" cy="69" r="1.35" /><circle cx="69" cy="69" r="1.35" /><circle cx="75" cy="69" r="1.35" /><circle cx="81" cy="69" r="1.35" /><circle cx="87" cy="69" r="1.35" /><circle cx="93" cy="69" r="1.35" /><circle cx="99" cy="69" r="1.35" /><circle cx="105" cy="69" r="1.35" /><circle cx="111" cy="69" r="1.35" /><circle cx="117" cy="69" r="1.35" /><circle cx="123" cy="69" r="1.35" /><circle cx="129" cy="69" r="1.35" /><circle cx="51" cy="75" r="1.35" /><circle cx="57" cy="75" r="1.35" /><circle cx="63" cy="75" r="1.35" /><circle cx="69" cy="75" r="1.35" /><circle cx="75" cy="75" r="1.35" /><circle cx="81" cy="75" r="1.35" /><circle cx="87" cy="75" r="1.35" /><circle cx="93" cy="75" r="1.35" /><circle cx="99" cy="75" r="1.35" /><circle cx="105" cy="75" r="1.35" /><circle cx="111" cy="75" r="1.35" /><circle cx="117" cy="75" r="1.35" /><circle cx="123" cy="75" r="1.35" /><circle cx="57" cy="81" r="1.35" /><circle cx="63" cy="81" r="1.35" /><circle cx="69" cy="81" r="1.35" /><circle cx="75" cy="81" r="1.35" /><circle cx="81" cy="81" r="1.35" /><circle cx="87" cy="81" r="1.35" /><circle cx="93" cy="81" r="1.35" /><circle cx="99" cy="81" r="1.35" /><circle cx="105" cy="81" r="1.35" /><circle cx="111" cy="81" r="1.35" /><circle cx="117" cy="81" r="1.35" /><circle cx="57" cy="87" r="1.35" /><circle cx="63" cy="87" r="1.35" /><circle cx="69" cy="87" r="1.35" /><circle cx="75" cy="87" r="1.35" /><circle cx="81" cy="87" r="1.35" /><circle cx="87" cy="87" r="1.35" /><circle cx="93" cy="87" r="1.35" /><circle cx="99" cy="87" r="1.35" /><circle cx="105" cy="87" r="1.35" /><circle cx="111" cy="87" r="1.35" /><circle cx="63" cy="93" r="1.35" /><circle cx="69" cy="93" r="1.35" /><circle cx="75" cy="93" r="1.35" /><circle cx="81" cy="93" r="1.35" /><circle cx="87" cy="93" r="1.35" /><circle cx="93" cy="93" r="1.35" /><circle cx="99" cy="93" r="1.35" /><circle cx="105" cy="93" r="1.35" /><circle cx="111" cy="93" r="1.35" /><circle cx="63" cy="99" r="1.35" /><circle cx="69" cy="99" r="1.35" /><circle cx="75" cy="99" r="1.35" /><circle cx="81" cy="99" r="1.35" /><circle cx="87" cy="99" r="1.35" /><circle cx="93" cy="99" r="1.35" /><circle cx="99" cy="99" r="1.35" /><circle cx="105" cy="99" r="1.35" /><circle cx="69" cy="105" r="1.35" /><circle cx="75" cy="105" r="1.35" /><circle cx="81" cy="105" r="1.35" /><circle cx="87" cy="105" r="1.35" /><circle cx="93" cy="105" r="1.35" /><circle cx="99" cy="105" r="1.35" /><circle cx="69" cy="111" r="1.35" /><circle cx="75" cy="111" r="1.35" /><circle cx="81" cy="111" r="1.35" /><circle cx="87" cy="111" r="1.35" /><circle cx="93" cy="111" r="1.35" /><circle cx="69" cy="117" r="1.35" /><circle cx="75" cy="117" r="1.35" /><circle cx="81" cy="117" r="1.35" /><circle cx="87" cy="117" r="1.35" /><circle cx="69" cy="123" r="1.35" /><circle cx="75" cy="123" r="1.35" /><circle cx="81" cy="123" r="1.35" /><circle cx="87" cy="123" r="1.35" /><circle cx="75" cy="129" r="1.35" /><circle cx="81" cy="129" r="1.35" /><circle cx="87" cy="129" r="1.35" /><circle cx="75" cy="135" r="1.35" /><circle cx="81" cy="135" r="1.35" /><circle cx="87" cy="135" r="1.35" /><circle cx="75" cy="141" r="1.35" /><circle cx="81" cy="141" r="1.35" /><circle cx="81" cy="147" r="1.35" /></svg>
        <!-- Carrossel contínuo como o da referência: dois grupos idênticos e
             translateX(-50%) em loop, com máscara nas bordas. Exemplo com a
             assinatura da Renke em cinza; entram os logos dos clientes
             (marvee.com.br) quando os arquivos chegarem. -->
        <div class="hero__clientes">
          <p class="rotulo hero__clientes__rotulo">Clínicas</p>
        <div class="rolo" aria-label="Logos de clientes (a definir)">
          <div class="rolo__trilho">
            {[0, 1].map((copia) => (
              <ul class="rolo__grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
                {[1, 2, 3, 4, 5, 6].map(() => (
                  <li><img src="/marca/renke-assinatura.png" alt="" width="299" height="62" loading="lazy" /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* Cena em três tempos, tocada de uma vez só pelo primeiro gesto de rolar:
       0  "Isso não é marketing para clínicas."
       1  "Isso é RevOps." (segura enquanto o reflexo atravessa a palavra)
       2  título, subtítulo e CTA
     Do 0 ao 2 é automático; só depois a página rola de verdade. --p
     continua sendo o que o CSS lê; aqui ele é animado por tempo. */
  const palco = document.querySelector<HTMLElement>('[data-palco]');
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (palco) {
    const copy = palco.querySelector<HTMLElement>('.hero__copy');
    const T_REVOPS = 3400;   // até o RevOps entrar
    const T_SEGURA = 3000;   // RevOps parado, reflexo passando
    const T_HERO = 2600;     // RevOps sai, título/subtítulo/CTA entram
    let p = 0, livre = false, comecou = false;
    const aplica = (v: number) => {
      p = v;
      palco.style.setProperty('--p', v.toFixed(4));
      copy?.classList.toggle('hero__copy--ativo', v >= 0.84);
    };
    const anima = (para: number, dur: number) => new Promise<void>((fim) => {
      const de = p, t0 = performance.now();
      const quadro = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const e = k < .5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        aplica(de + (para - de) * e);
        if (k < 1) requestAnimationFrame(quadro); else fim();
      };
      requestAnimationFrame(quadro);
    });
    const espera = (ms: number) => new Promise<void>((fim) => setTimeout(fim, ms));
    const toca = async () => {
      if (comecou) return;
      comecou = true;
      palco.classList.add('palco--revops');
      await anima(0.6, T_REVOPS);
      await espera(T_SEGURA);
      await anima(1, T_HERO);
      livre = true;
    };
    if (semMovimento || scrollY > 8) { livre = true; comecou = true; palco.classList.add('palco--revops'); aplica(1); }
    else {
      const segura = (e: Event) => { if (!livre) { e.preventDefault(); toca(); } };
      addEventListener('wheel', segura, { passive: false });
      addEventListener('touchmove', segura, { passive: false });
      addEventListener('keydown', (e) => {
        if (!livre && ['ArrowDown', 'PageDown', ' ', 'End'].includes(e.key)) { e.preventDefault(); toca(); }
      });
      aplica(0);
    }
  }
</script>
