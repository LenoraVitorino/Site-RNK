---
/**
 * Dobra 1 · palco centralizado em três tempos, como a hero da referência.
 *
 *  1. Ao carregar: "Isso não é marketing para clínicas." no centro, com a
 *     seta para baixo.
 *  2. No scroll: a frase é riscada e some; "Isso é RevOps." entra em
 *     contorno amarelo e vai sendo preenchido da esquerda para a direita.
 *  3. Preenchido, ele encolhe e vira a chamada do bloco: título, subtítulo
 *     e CTA aparecem embaixo. Depois o palco solta e a página segue.
 *
 * O bloco fica preso ~1,6 telas de scroll; --p vai de 0 a 1 nesse curso.
 * Sem JS ou com menos movimento, tudo nasce no estado final. Copy literal.
 */
import { hero } from '../../data/home';
import Botao from '../ui/Botao.astro';

const palavras = ['Isso', 'não', 'é'];
---
<section class="palco" data-palco aria-label="Apresentação">
  <div class="palco__fixo">
    <img class="hero__monograma" src="/marca/renke-monograma.png" alt="" width="275" height="275" loading="lazy" />
    <div class="hero__centro">
      <p class="rotulo hero__rotulo">Revenue Operations para clínicas de alto padrão</p>

      <h1 class="hero__h1" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
        <span class="tomada tomada--1" aria-hidden="true">
          {palavras.map((p, i) => <><span class="palavra" style={`--i:${i}`}>{p}</span>{' '}</>)}
          <span class="palavra riscado" style="--i:3">marketing para clínicas.</span>
        </span>
        <span class="tomada tomada--2" aria-hidden="true">
          <span class="revops revops--borda">Isso é RevOps.</span>
          <span class="revops revops--furo">Isso é RevOps.</span>
          <span class="revops revops--cheio">Isso é RevOps.</span>
        </span>
      </h1>

      <p class="hero__seta" aria-hidden="true"><span>↓</span></p>

      <div class="hero__copy" data-copy>
        <div class="hero__copy__miolo">
          <p class="hero__titulo">Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.</p>
          <p class="hero__lead">{hero.lead}</p>
          <p class="hero__acoes"><Botao href="/contato" variante="claro">{hero.cta}</Botao></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* --p = progresso do scroll dentro do palco, de 0 a 1. O CSS deriva dele
     cada tempo da cena. --copy-h é a altura natural do bloco final, para
     ele crescer em fluxo e o conjunto se manter centralizado. */
  const palco = document.querySelector<HTMLElement>('[data-palco]');
  const header = document.getElementById('header');
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (palco) {
    const copy = palco.querySelector<HTMLElement>('[data-copy]');
    const miolo = copy?.firstElementChild as HTMLElement | null;
    if (semMovimento) palco.style.setProperty('--p', '1');
    let agendado = false;
    const mede = () => {
      agendado = false;
      const r = palco.getBoundingClientRect();
      if (!semMovimento) {
        // O palco gruda logo abaixo do cabeçalho: o curso começa quando o
        // topo dele encosta ali e termina quando o fundo chega ao fim da tela.
        const topo = header?.offsetHeight ?? 0;
        const curso = palco.offsetHeight - (innerHeight - topo);
        const p = curso > 0 ? Math.min(1, Math.max(0, (topo - r.top) / curso)) : 1;
        palco.style.setProperty('--p', p.toFixed(4));
      }
    };
    const medeCopy = () => { if (miolo) palco.style.setProperty('--copy-h', miolo.offsetHeight + 'px'); };
    const pede = () => { if (!agendado) { agendado = true; requestAnimationFrame(mede); } };
    addEventListener('scroll', pede, { passive: true });
    addEventListener('resize', () => { medeCopy(); pede(); }, { passive: true });
    medeCopy();
    mede();
    // Fontes carregando depois mudam a altura do bloco final.
    document.fonts?.ready.then(medeCopy);
  }
</script>
