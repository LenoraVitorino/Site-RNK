---
/** Hero compartilhada: frase riscada, transição para RevOps e fundo gráfico próprio. */
import { hero } from '../../data/home';
import { copyLiteral } from '../../data/versao';
import Botao from '../ui/Botao.astro';

const lead = copyLiteral ? hero.lead :
  'Estratégia, tecnologia e operação para clínicas de alto padrão que exigem sofisticação e resultados concretos.';
---
<section class="hero" aria-label="Apresentação">
  <div class="hero__fundo" aria-hidden="true">
    <img class="hero__ondas" src="/imagens/hero-ondas.svg" alt="" width="1600" height="900" />
    <span class="hero__brilho"></span>
  </div>

  <div class="hero__grade">
    <div class="hero__intro">
      <p class="hero__rotulo"><span class="hero__quadrado"></span>Revenue Operations</p>
      <p class="hero__lead">{lead}</p>
    </div>
    <div class="hero__palco">
      <h1 class="hero__h1" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
        <span class="hero__mensagem hero__mensagem--antes" aria-hidden="true">
          <span>Isso</span>
          <span><span class="hero__risco">não é marketing</span></span>
          <span><span class="hero__risco hero__risco--segundo">para clínicas.</span></span>
        </span>
        <span class="hero__mensagem hero__mensagem--depois" aria-hidden="true">
          <span>Isso é</span>
          <span class="hero__revops">RevOps.</span>
        </span>
      </h1>
    </div>
    <div class="hero__base">
      <p class="hero__selo"><span aria-hidden="true">✦</span>{copyLiteral ? 'Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.' : 'Estratégia e tecnologia para clínicas de alta performance'}</p>
      <p class="hero__acoes"><Botao href="/contato">{copyLiteral ? 'Descubra se faz sentido para sua clínica' : 'Conhecer solução'}</Botao></p>
    </div>
  </div>

  <a class="hero__scroll" href="#o-que-fazemos"><span class="hero__fio"></span>Role para baixo</a>

    {copyLiteral && (
      <!-- Barra de prova social só na versão copy. Na do estúdio ela sai por
           enquanto: os logos dos clientes ainda não chegaram, e a barra com a
           assinatura da Renke repetida era só um exemplo. -->
    <div class="hero__confianca">
      <div class="hero__confianca__inner">
        <p class="hero__confianca__frase">Doutores que <strong>confiam na Renke</strong></p>
        <!-- Como a barra da referência: a frase à esquerda, um fio vertical e
             o carrossel de logos ocupando o resto da largura. Dois grupos
             idênticos e translateX(-50%) em loop, com máscara nas bordas.
             Exemplo com a assinatura da Renke em cinza; entram os logos dos
             clientes (marvee.com.br) quando os arquivos chegarem. -->
        <div class="hero__clientes">
        <div class="rolo" aria-label="Logos de clientes (a definir)">
          <div class="rolo__trilho">
            {[0, 1].map((copia) => (
              <ul class="rolo__grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
                {[1, 2, 3, 4, 5, 6].map(() => (
                  <li><img src="/marca/renke-assinatura.png" alt="" width="299" height="62" loading="lazy" /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        </div>
      </div>
    </div>
    )}
</section>
