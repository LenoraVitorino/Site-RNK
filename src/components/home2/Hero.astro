---
/**
 * Dobra 1 · palco centralizado em três tempos, como a hero da referência.
 *
 *  1. Ao carregar: "Isso não é marketing para clínicas." no centro, com a
 *     seta para baixo.
 *  2. No scroll: a frase é riscada e some; "Isso é RevOps." entra suave,
 *     no amarelo original, com um reflexo de luz que vai e volta.
 *  3. Depois ele sai e, no lugar, entram título, subtítulo e CTA. Aí o
 *     palco solta e a página segue.
 *
 * O bloco fica preso ~1,6 telas de scroll; --p vai de 0 a 1 nesse curso.
 * Sem JS ou com menos movimento, tudo nasce no estado final. Copy literal.
 */
import { hero } from '../../data/home';
import Botao from '../ui/Botao.astro';

const palavras = ['Isso', 'não', 'é'];
// O lead quebra em duas linhas no desktop, na fronteira das frases.
const corte = hero.lead.indexOf('caem. ') + 'caem. '.length;
const leadLinhas = [hero.lead.slice(0, corte), hero.lead.slice(corte)];
---
<section class="palco" data-palco aria-label="Apresentação">
  <div class="palco__fixo">
    <div class="hero__centro">
      <div class="hero__cena">
        <h1 class="hero__h1" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
          <span class="tomada tomada--1" aria-hidden="true">
            {palavras.map((p, i) => <><span class="palavra" style={`--i:${i}`}>{p}</span>{' '}</>)}
            <span class="palavra riscado" style="--i:3">marketing para clínicas.</span>
          </span>
          <span class="tomada tomada--2" aria-hidden="true">
            <span class="revops">Isso é RevOps.</span>
          </span>
        </h1>

        <div class="hero__copy">
          <p class="hero__titulo">Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.</p>
          <p class="hero__lead">{leadLinhas[0]}<br class="quebra-desktop" />{leadLinhas[1]}</p>
          <p class="hero__acoes"><Botao href="/contato" variante="claro">{hero.cta}</Botao></p>
        </div>
      </div>

      <p class="hero__seta" aria-hidden="true"><span>↓</span></p>
    </div>

    <div class="hero__confianca">
      <div class="hero__confianca__inner">
        <p class="hero__confianca__frase">Doutores que <strong>confiam na Renke</strong></p>
        <svg class="hero__mapa" viewBox="0 0 84 102" width="84" height="102" fill="var(--destaque)" aria-hidden="true" role="presentation"><circle cx="33" cy="3" r="1.7" /><circle cx="39" cy="3" r="1.7" /><circle cx="45" cy="3" r="1.7" /><circle cx="15" cy="9" r="1.7" /><circle cx="21" cy="9" r="1.7" /><circle cx="27" cy="9" r="1.7" /><circle cx="33" cy="9" r="1.7" /><circle cx="39" cy="9" r="1.7" /><circle cx="45" cy="9" r="1.7" /><circle cx="51" cy="9" r="1.7" /><circle cx="57" cy="9" r="1.7" /><circle cx="9" cy="15" r="1.7" /><circle cx="15" cy="15" r="1.7" /><circle cx="21" cy="15" r="1.7" /><circle cx="27" cy="15" r="1.7" /><circle cx="33" cy="15" r="1.7" /><circle cx="39" cy="15" r="1.7" /><circle cx="45" cy="15" r="1.7" /><circle cx="51" cy="15" r="1.7" /><circle cx="57" cy="15" r="1.7" /><circle cx="63" cy="15" r="1.7" /><circle cx="69" cy="15" r="1.7" /><circle cx="9" cy="21" r="1.7" /><circle cx="15" cy="21" r="1.7" /><circle cx="21" cy="21" r="1.7" /><circle cx="27" cy="21" r="1.7" /><circle cx="33" cy="21" r="1.7" /><circle cx="39" cy="21" r="1.7" /><circle cx="45" cy="21" r="1.7" /><circle cx="51" cy="21" r="1.7" /><circle cx="57" cy="21" r="1.7" /><circle cx="63" cy="21" r="1.7" /><circle cx="69" cy="21" r="1.7" /><circle cx="75" cy="21" r="1.7" /><circle cx="81" cy="21" r="1.7" /><circle cx="3" cy="27" r="1.7" /><circle cx="9" cy="27" r="1.7" /><circle cx="15" cy="27" r="1.7" /><circle cx="21" cy="27" r="1.7" /><circle cx="27" cy="27" r="1.7" /><circle cx="33" cy="27" r="1.7" /><circle cx="39" cy="27" r="1.7" /><circle cx="45" cy="27" r="1.7" /><circle cx="51" cy="27" r="1.7" /><circle cx="57" cy="27" r="1.7" /><circle cx="63" cy="27" r="1.7" /><circle cx="69" cy="27" r="1.7" /><circle cx="75" cy="27" r="1.7" /><circle cx="81" cy="27" r="1.7" /><circle cx="3" cy="33" r="1.7" /><circle cx="9" cy="33" r="1.7" /><circle cx="15" cy="33" r="1.7" /><circle cx="21" cy="33" r="1.7" /><circle cx="27" cy="33" r="1.7" /><circle cx="33" cy="33" r="1.7" /><circle cx="39" cy="33" r="1.7" /><circle cx="45" cy="33" r="1.7" /><circle cx="51" cy="33" r="1.7" /><circle cx="57" cy="33" r="1.7" /><circle cx="63" cy="33" r="1.7" /><circle cx="69" cy="33" r="1.7" /><circle cx="75" cy="33" r="1.7" /><circle cx="81" cy="33" r="1.7" /><circle cx="3" cy="39" r="1.7" /><circle cx="9" cy="39" r="1.7" /><circle cx="15" cy="39" r="1.7" /><circle cx="21" cy="39" r="1.7" /><circle cx="27" cy="39" r="1.7" /><circle cx="33" cy="39" r="1.7" /><circle cx="39" cy="39" r="1.7" /><circle cx="45" cy="39" r="1.7" /><circle cx="51" cy="39" r="1.7" /><circle cx="57" cy="39" r="1.7" /><circle cx="63" cy="39" r="1.7" /><circle cx="69" cy="39" r="1.7" /><circle cx="75" cy="39" r="1.7" /><circle cx="81" cy="39" r="1.7" /><circle cx="9" cy="45" r="1.7" /><circle cx="15" cy="45" r="1.7" /><circle cx="21" cy="45" r="1.7" /><circle cx="27" cy="45" r="1.7" /><circle cx="33" cy="45" r="1.7" /><circle cx="39" cy="45" r="1.7" /><circle cx="45" cy="45" r="1.7" /><circle cx="51" cy="45" r="1.7" /><circle cx="57" cy="45" r="1.7" /><circle cx="63" cy="45" r="1.7" /><circle cx="69" cy="45" r="1.7" /><circle cx="75" cy="45" r="1.7" /><circle cx="81" cy="45" r="1.7" /><circle cx="9" cy="51" r="1.7" /><circle cx="15" cy="51" r="1.7" /><circle cx="21" cy="51" r="1.7" /><circle cx="27" cy="51" r="1.7" /><circle cx="33" cy="51" r="1.7" /><circle cx="39" cy="51" r="1.7" /><circle cx="45" cy="51" r="1.7" /><circle cx="51" cy="51" r="1.7" /><circle cx="57" cy="51" r="1.7" /><circle cx="63" cy="51" r="1.7" /><circle cx="69" cy="51" r="1.7" /><circle cx="15" cy="57" r="1.7" /><circle cx="21" cy="57" r="1.7" /><circle cx="27" cy="57" r="1.7" /><circle cx="33" cy="57" r="1.7" /><circle cx="39" cy="57" r="1.7" /><circle cx="45" cy="57" r="1.7" /><circle cx="51" cy="57" r="1.7" /><circle cx="57" cy="57" r="1.7" /><circle cx="63" cy="57" r="1.7" /><circle cx="69" cy="57" r="1.7" /><circle cx="15" cy="63" r="1.7" /><circle cx="21" cy="63" r="1.7" /><circle cx="27" cy="63" r="1.7" /><circle cx="33" cy="63" r="1.7" /><circle cx="39" cy="63" r="1.7" /><circle cx="45" cy="63" r="1.7" /><circle cx="51" cy="63" r="1.7" /><circle cx="57" cy="63" r="1.7" /><circle cx="63" cy="63" r="1.7" /><circle cx="21" cy="69" r="1.7" /><circle cx="27" cy="69" r="1.7" /><circle cx="33" cy="69" r="1.7" /><circle cx="39" cy="69" r="1.7" /><circle cx="45" cy="69" r="1.7" /><circle cx="51" cy="69" r="1.7" /><circle cx="57" cy="69" r="1.7" /><circle cx="63" cy="69" r="1.7" /><circle cx="21" cy="75" r="1.7" /><circle cx="27" cy="75" r="1.7" /><circle cx="33" cy="75" r="1.7" /><circle cx="39" cy="75" r="1.7" /><circle cx="45" cy="75" r="1.7" /><circle cx="51" cy="75" r="1.7" /><circle cx="57" cy="75" r="1.7" /><circle cx="27" cy="81" r="1.7" /><circle cx="33" cy="81" r="1.7" /><circle cx="39" cy="81" r="1.7" /><circle cx="45" cy="81" r="1.7" /><circle cx="51" cy="81" r="1.7" /><circle cx="27" cy="87" r="1.7" /><circle cx="33" cy="87" r="1.7" /><circle cx="39" cy="87" r="1.7" /><circle cx="45" cy="87" r="1.7" /><circle cx="33" cy="93" r="1.7" /><circle cx="39" cy="93" r="1.7" /><circle cx="45" cy="93" r="1.7" /><circle cx="33" cy="99" r="1.7" /><circle cx="39" cy="99" r="1.7" /></svg>
        <!-- Carrossel contínuo como o da referência: dois grupos idênticos e
             translateX(-50%) em loop, com máscara nas bordas. Exemplo com a
             assinatura da Renke em cinza; entram os logos dos clientes
             (marvee.com.br) quando os arquivos chegarem. -->
        <div class="rolo" aria-label="Logos de clientes (a definir)">
          <div class="rolo__trilho">
            {[0, 1].map((copia) => (
              <ul class="rolo__grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
                {[1, 2, 3, 4, 5, 6].map(() => (
                  <li><img src="/marca/renke-assinatura.png" alt="" width="299" height="62" loading="lazy" /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* --p = progresso do scroll dentro do palco, de 0 a 1. O CSS deriva dele
     cada tempo da cena. */
  const palco = document.querySelector<HTMLElement>('[data-palco]');
  const header = document.getElementById('header');
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (palco) {
    const copy = palco.querySelector<HTMLElement>('.hero__copy');
    if (semMovimento) { palco.style.setProperty('--p', '1'); copy?.classList.add('hero__copy--ativo'); }
    let agendado = false;
    const mede = () => {
      agendado = false;
      if (semMovimento) return;
      // O palco gruda logo abaixo do cabeçalho: o curso começa quando o
      // topo dele encosta ali e termina quando o fundo chega ao fim da tela.
      const r = palco.getBoundingClientRect();
      const topo = header?.offsetHeight ?? 0;
      const curso = palco.offsetHeight - (innerHeight - topo);
      const p = curso > 0 ? Math.min(1, Math.max(0, (topo - r.top) / curso)) : 1;
      palco.style.setProperty('--p', p.toFixed(4));
      copy?.classList.toggle('hero__copy--ativo', p >= 0.9);
    };
    const pede = () => { if (!agendado) { agendado = true; requestAnimationFrame(mede); } };
    addEventListener('scroll', pede, { passive: true });
    addEventListener('resize', pede, { passive: true });
    mede();
  }
</script>
