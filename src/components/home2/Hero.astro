---
/**
 * Dobra 1 · hero no desenho da referência (print da Lenora, 18/09/2026):
 * fundo preto com duas curvas escuras e um brilho amarelo no pé; à esquerda
 * o rótulo e o título em três linhas (a primeira em papel, as outras no
 * amarelo); no centro o objeto (o monograma da Renke, com brilho, até
 * chegar a arte 3D); à direita o ano, o lead e o segundo título ("Isso é
 * RevOps."), com o CTA; no pé, o fio e "Role para baixo". Sem cena por
 * tempo e sem trava de rolagem. Copy literal.
 */
import { hero } from '../../data/home';
import { copyLiteral } from '../../data/versao';
import Botao from '../ui/Botao.astro';

// Versão do estúdio: o lead enxugado por corte de palavras (decisão da
// Lenora em 16/09/2026). A versão copy segue com o lead íntegro.
const leadCurto =
  'Sua clínica fatura bem, mas não sabe de onde vem cada real nem onde trava. ' +
  'Esse é o problema que resolvemos. Do anúncio ao retorno do paciente, tudo conectado e rastreado.';
const lead = copyLiteral ? hero.lead : leadCurto;
---
<section class="hero" aria-label="Apresentação">
  <div class="hero__fundo" aria-hidden="true">
    <span class="hero__curva hero__curva--1"></span>
    <span class="hero__curva hero__curva--2"></span>
    <span class="hero__brilho"></span>
  </div>

  <div class="hero__grade">
    <div class="hero__esq">
      <p class="hero__rotulo"><span class="hero__quadrado"></span>RevOps para clínicas</p>
      <h1 class="hero__h1">
        <span class="hero__linha">Isso não é</span>
        <span class="hero__linha hero__linha--destaque">marketing</span>
        <span class="hero__linha hero__linha--destaque">para clínicas.</span>
      </h1>
    </div>

    <div class="hero__objeto" aria-hidden="true">
      <img src="/marca/renke-monograma.png" alt="" width="270" height="270" />
    </div>

    <div class="hero__dir">
      <p class="hero__ano"><span class="hero__c">©</span> 2026</p>
      <p class="hero__lead">{lead}</p>
      <p class="hero__titulo">
        <span class="hero__linha">Isso é</span>
        <span class="hero__linha hero__linha--destaque">RevOps.</span>
      </p>
      <p class="hero__acoes"><Botao href="/contato">{hero.cta}</Botao></p>
    </div>
  </div>

  <a class="hero__scroll" href="#o-que-fazemos"><span class="hero__fio"></span>Role para baixo</a>

    {copyLiteral && (
      <!-- Barra de prova social só na versão copy. Na do estúdio ela sai por
           enquanto: os logos dos clientes ainda não chegaram, e a barra com a
           assinatura da Renke repetida era só um exemplo. -->
    <div class="hero__confianca">
      <div class="hero__confianca__inner">
        <p class="hero__confianca__frase">Doutores que <strong>confiam na Renke</strong></p>
        <!-- Como a barra da referência: a frase à esquerda, um fio vertical e
             o carrossel de logos ocupando o resto da largura. Dois grupos
             idênticos e translateX(-50%) em loop, com máscara nas bordas.
             Exemplo com a assinatura da Renke em cinza; entram os logos dos
             clientes (marvee.com.br) quando os arquivos chegarem. -->
        <div class="hero__clientes">
        <div class="rolo" aria-label="Logos de clientes (a definir)">
          <div class="rolo__trilho">
            {[0, 1].map((copia) => (
              <ul class="rolo__grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
                {[1, 2, 3, 4, 5, 6].map(() => (
                  <li><img src="/marca/renke-assinatura.png" alt="" width="299" height="62" loading="lazy" /></li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        </div>
      </div>
    </div>
    )}
</section>
