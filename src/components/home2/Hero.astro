---
import Icone from '../ui/Icone.astro';
/** Hero compartilhada: frase riscada, transição para RevOps e fundo gráfico próprio. */
import { hero } from '../../data/home';
import { copyLiteral } from '../../data/versao';
import Botao from '../ui/Botao.astro';
import ConfiancaHero from './ConfiancaHero.astro';

const lead = copyLiteral ? hero.lead :
  'Estratégia, tecnologia e operação para clínicas de alto padrão que exigem sofisticação e resultados concretos.';
---
<section class="hero" aria-label="Apresentação">
  <div class="hero__fundo" aria-hidden="true">
    <img class="hero__ondas" src="/imagens/hero-ondas.svg" alt="" width="1600" height="900" />
    <span class="hero__brilho"></span>
  </div>

  <div class="hero__grade">
    <div class="hero__palco">
      <p class="hero__selo"><span aria-hidden="true"><Icone nome="Sparkles" size={18} /></span>{copyLiteral ? 'Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.' : 'Estratégia e tecnologia para clínicas de alta performance'}</p>
      <h1 class="hero__h1" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
        <span class="hero__mensagem hero__mensagem--antes" aria-hidden="true">
          <span>Isso</span>
          <span><span class="hero__risco">não é marketing</span></span>
          <span><span class="hero__risco hero__risco--segundo">para clínicas.</span></span>
        </span>
        <span class="hero__mensagem hero__mensagem--depois" aria-hidden="true">
          <span>Isso é</span>
          <span class="hero__revops">RevOps.</span>
        </span>
      </h1>
      <p class="hero__lead">{lead}</p>
    </div>
    <div class="hero__base">
      <p class="hero__acoes"><Botao href="/contato">{copyLiteral ? 'Descubra se faz sentido para sua clínica' : 'Conhecer solução'}</Botao></p>
      <ConfiancaHero />
    </div>
  </div>

  <a class="hero__scroll" href="#o-que-fazemos"><Icone nome="ArrowDown" size={20} />Role para baixo</a>

</section>
