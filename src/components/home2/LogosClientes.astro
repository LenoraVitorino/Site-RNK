---
/** Referências temporárias de layout, sem atribuir a Renke a clientes.
    Trocar os itens pelos arquivos originais das marcas quando disponíveis;
    o cinza e o hover são tratados por CSS, sem alterar os arquivos. */
const logos = Array.from({ length: 10 }, () => ({
  nome: 'Renke Studio',
  arquivo: '/marca/renke-assinatura.png',
  largura: 299,
  altura: 62,
}));
---
<ul class="logos-clientes" aria-label="Logos demonstrativos da Renke, temporários até a inclusão dos clientes">
  {logos.map((logo) => (
    <li class="logos-clientes__item">
      <img
        src={logo.arquivo}
        alt={logo.nome}
        width={logo.largura}
        height={logo.altura}
        loading="lazy"
        decoding="async"
      />
    </li>
  ))}
</ul>

<style>
  .logos-clientes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / .07);
    border-left: 1px solid rgb(255 255 255 / .07);
    background: rgb(8 8 8 / .88);
  }
  .logos-clientes__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    aspect-ratio: 1.2;
    padding: 24px;
    border-right: 1px solid rgb(255 255 255 / .07);
    border-bottom: 1px solid rgb(255 255 255 / .07);
  }
  .logos-clientes__item img {
    display: block;
    width: 100%;
    max-width: 128px;
    height: auto;
    max-height: 48px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: .58;
    transition: filter .7s var(--easing-suave), opacity .7s var(--easing-suave);
  }
  @media (hover: hover) and (pointer: fine) {
    .logos-clientes__item:hover img { filter: grayscale(0); opacity: 1; }
  }
  @media (max-width: 699.98px) {
    .logos-clientes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .logos-clientes__item { aspect-ratio: 1.6; padding: 22px; }
    .logos-clientes__item img { max-width: 116px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos-clientes__item img { transition: none; }
  }
</style>
