---
/** Provas em mosaico editorial. Valores e textos vêm da fonte compartilhada. */
import { resultados, hero } from '../../data/home';
import Botao from '../ui/Botao.astro';
---
<section class="secao resultados-editoriais" id="resultados" aria-labelledby="resultados-titulo">
  <div class="container">
    <header class="secao-indice entra">
      <p class="rotulo"><span>04 /</span> Resultados</p>
      <h2 class="titulo" id="resultados-titulo">O que muda quando<br />a operação tem estrutura.</h2>
    </header>
    <ol class="resultados-mosaico" aria-label="Resultados por especialidade">
      {resultados.map((r, i) => (
        <li class:list={['resultado-ficha', i === 0 && 'resultado-ficha--destaque', 'entra']}>
          <div class="resultado-ficha__topo"><h3>{r.especialidade}</h3><span aria-hidden="true">0{i + 1}</span></div>
          {i === 0 && <div class="resultado-ficha__orbita" aria-hidden="true"><span></span></div>}
          <p class="resultado-ficha__numero num">{r.numero}</p>
          <p class="resultado-ficha__texto">{r.texto}</p>
        </li>
      ))}
    </ol>
    <div class="resultados-editoriais__rodape"><Botao href="/contato">{hero.cta}</Botao></div>
  </div>
</section>
