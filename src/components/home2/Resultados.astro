---
/**
 * Resultados como um extrato de ponta a ponta, no desenho da referência:
 * cada linha com o número gigante em amarelo à esquerda e, na metade
 * direita, a especialidade e o antes → depois. Fios de uma borda à outra
 * da tela. Copy literal do briefing (⚠️ D1: números ilustrativos até os
 * cases serem autorizados).
 */
import { resultados, hero } from '../../data/home';
import Botao from '../ui/Botao.astro';
---
<section class="secao secao--extrato" id="resultados">
  <div class="container">
    <header class="extrato__cabeca entra">
      <p class="rotulo">Resultados</p>
      <h2 class="titulo">O que muda quando a operação tem estrutura.</h2>
    </header>
  </div>
  <ol class="extrato" aria-label="Resultados por especialidade">
    {resultados.map((r) => (
      <li class="extrato__linha">
        <div class="container extrato__grade">
          <p class="extrato__num num" data-contador>{r.numero}</p>
          <div class="extrato__texto entra">
            <h3 class="extrato__titulo">{r.especialidade}</h3>
            <p>Antes: {r.antes}. Depois: {r.depois}.</p>
          </div>
        </div>
      </li>
    ))}
  </ol>
  <div class="container">
    <p class="extrato__acao"><Botao href="/contato" class="botao--lg">{hero.cta}</Botao></p>
  </div>
</section>

<script>
  /* Números que carregam: cada inteiro dentro de [data-contador] sobe de 0
     até o valor quando o elemento entra na tela (uma vez). Texto em volta
     ("%", "dias", "→") fica parado. Com movimento reduzido, nada anima. */
  const alvos = document.querySelectorAll<HTMLElement>('[data-contador]');
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (alvos.length && !reduzido) {
    const fmt = (n: number) => String(n);
    alvos.forEach((el) => {
      const texto = el.textContent ?? '';
      el.textContent = '';
      texto.split(/(\d+)/).forEach((parte) => {
        if (/^\d+$/.test(parte)) {
          const s = document.createElement('span');
          s.dataset.fim = parte; s.textContent = fmt(0); s.className = 'contador';
          el.appendChild(s);
        } else el.appendChild(document.createTextNode(parte));
      });
    });
    const anima = (el: HTMLElement) => {
      const spans = el.querySelectorAll<HTMLElement>('.contador');
      const dur = 1400; const t0 = performance.now();
      const passo = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const e = 1 - Math.pow(1 - k, 3);
        spans.forEach((s) => { s.textContent = fmt(Math.round(Number(s.dataset.fim) * e)); });
        if (k < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const obs = new IntersectionObserver((ents) => {
      for (const e of ents) if (e.isIntersecting) { anima(e.target as HTMLElement); obs.unobserve(e.target); }
    }, { threshold: 0.6 });
    alvos.forEach((a) => obs.observe(a));
  }
</script>
