---
/**
 * Resultados, na dobra clara. Layout compartilhado pelas versões estudio e copy.
 *
 * Refeito em 26/09/2026 (Lenora: "dá um trato" na dobra 7). Referências da
 * curadoria (docs/04-design/curadoria/): pin 46 (a frase fica e o número
 * troca ao lado conforme a leitura avança) e pin 234 (números que sobem da
 * linha de base). No desktop a coluna da esquerda fica presa com o título e
 * um número grande por vez; à direita passam as especialidades, e a que está
 * no alto da tela acende e troca o número. Sem contagem animada (o doc de
 * direção veta): o número entra como bloco. Rolagem nativa, sem trava.
 *
 * A foto da área no hover (mockup de 21/09) sai por ora: sem as fotos
 * reais, o slot vazio fica com cara de inacabado. Volta no placar quando
 * as fotos existirem.
 */
import { resultados, hero } from '../../data/home';
import Botao from '../ui/Botao.astro';
const dois = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="secao secao--extrato" id="resultados" aria-labelledby="resultados-titulo" data-resultados>
  <div class="container resultados">
    <div class="resultados__fixo">
      <h2 class="titulo entra" id="resultados-titulo">O que muda quando a operação tem <strong class="extrato__destaque">estrutura</strong>.</h2>
      <div class="resultados__placar" aria-hidden="true">
        <p class="resultados__contagem num"><span data-res-n>01</span> / {dois(resultados.length - 1)}</p>
        <div class="resultados__numeros">
          {resultados.map((r, i) => (
            <p class="resultados__num num" data-res-num={i} data-estado={i === 0 ? 'ativo' : 'depois'}>{r.numero}</p>
          ))}
        </div>
        <p class="resultados__area" data-res-area>{resultados[0].especialidade}</p>
      </div>
      <p class="extrato__acao"><Botao href="/contato" class="botao--lg">{hero.cta}</Botao></p>
    </div>

    <ol class="resultados__lista" aria-label="Resultados por especialidade">
      {resultados.map((r, i) => (
        <li class="resultados__linha" data-res={i}>
          <p class="resultados__num-linha num">{r.numero}</p>
          <h3 class="extrato__titulo">{r.especialidade}</h3>
          <p class="resultados__texto">{r.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // A linha que está na faixa de cima da tela vira a ativa: o placar troca o
  // número (sobe da linha de base) e a especialidade.
  const secao = document.querySelector<HTMLElement>('[data-resultados]');
  if (secao) {
    const media = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
    const linhas = [...secao.querySelectorAll<HTMLElement>('[data-res]')];
    const numeros = [...secao.querySelectorAll<HTMLElement>('[data-res-num]')];
    const contagem = secao.querySelector<HTMLElement>('[data-res-n]')!;
    const area = secao.querySelector<HTMLElement>('[data-res-area]')!;
    const nomes = linhas.map((l) => l.querySelector('h3')!.textContent ?? '');
    let ativo = -1, quadro = 0;
    const marcar = () => {
      quadro = 0;
      if (!media.matches) return;
      let i = 0;
      linhas.forEach((l, k) => { if (l.getBoundingClientRect().top < innerHeight * .5) i = k; });
      if (i === ativo) return;
      ativo = i;
      linhas.forEach((l, k) => l.classList.toggle('resultados__linha--ativa', k === i));
      numeros.forEach((n, k) => { n.dataset.estado = k === i ? 'ativo' : k < i ? 'antes' : 'depois'; });
      contagem.textContent = String(i + 1).padStart(2, '0');
      area.textContent = nomes[i];
    };
    const ligar = () => { secao.classList.toggle('resultados--vivo', media.matches); ativo = -1; marcar(); };
    addEventListener('scroll', () => { if (!quadro) quadro = requestAnimationFrame(marcar); }, { passive: true });
    media.addEventListener('change', ligar);
    ligar();
  }
</script>
