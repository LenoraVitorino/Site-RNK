---
/** Resultados por especialidade (04/10/2026, 2ª versão do dia). A Lenora
    reprovou a vitrine com a foto que trocava sozinha e mandou a referência
    "Services Section Animation" (details.so): uma lista numerada em que
    cada linha gruda no topo ao rolar e as seguintes vão se empilhando
    embaixo dela. Aqui cada especialidade é uma linha, sem numeração ("não
    gosto de numeração"): a área; embaixo, a frase com o resultado grande logo abaixo dela (Lenora,
    04/10: "embaixo do texto, não em cima da foto") e uma foto da área.
    Só CSS (position: sticky); no celular a lista fica corrida. A foto de
    cada linha começa no topo das letras do título e some quando a linha
    seguinte a cobre.
    A dobra segue como o painel claro chanfrado, agora opaco, para cada
    linha cobrir a de baixo sem emenda. Valores, textos e fotos vêm da
    fonte compartilhada. As fotos saíram por enquanto (10/10): no lugar,
    o quadro com um ícone de imagem e a legenda da especialidade. */
import { resultados } from '../../data/home';
import Selo from '../ui/Selo.astro';
import { copyLiteral } from '../../data/versao';

const partes = (numero: string) => {
  const [, antes, valor, depois] = numero.match(/^(.*?)(\d+)(.*)$/) ?? ['', '', numero, ''];
  return { antes, valor, depois };
};
---
<section class="secao resultados-editoriais" id="resultados" data-tom="claro" aria-labelledby="resultados-titulo">
  <div class="container">
    <header class="resultados-editoriais__cabeca entra">
      {!copyLiteral && <Selo class="cabeca-dobra__selo">Resultados por especialidade</Selo>}
      <h2 class="titulo" id="resultados-titulo">O que muda quando a <span class="resultados-editoriais__enfase">operação tem estrutura</span>.</h2>
      {!copyLiteral && <p class="cabeca-dobra__apoio">Clínicas de especialidades diferentes, com a operação estruturada pela Renke.</p>}
    </header>

    <ol class="res-pilha" style={`--res-n:${resultados.length}`} aria-label="Resultados por especialidade">
      {resultados.map((r, i) => {
        const { antes, valor, depois } = partes(r.numero);
        return (
          <li class="res-etapa" style={`--i:${i}`}>
            <div class="res-etapa__cabeca">
              <h3 class="res-etapa__area">{r.especialidade}</h3>
            </div>
            <div class="res-etapa__corpo">
              <div class="res-etapa__dados">
                <p class="res-etapa__texto">{r.texto}</p>
                <p class="res-etapa__numero num">
                  <span class="visually-hidden">{r.numero}</span>
                  <span class="res-etapa__reserva" aria-hidden="true">{r.numero}</span>
                  <span class="res-etapa__contagem" aria-hidden="true" data-contador data-alvo={valor} data-antes={antes} data-depois={depois}>{r.numero}</span>
                </p>
              </div>
              {/* Sem foto por enquanto (Lenora, 10/10): ícone de imagem e legenda
                  no mesmo quadro, até chegarem as fotos de cada especialidade. */}
              <figure class="res-etapa__foto res-etapa__foto--vaga" aria-label={`Espaço para foto: ${r.especialidade}`}>
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2.5" /><circle cx="8.6" cy="9.8" r="1.6" /><path d="M3.6 17.2l4.9-4.6 3.6 3.2 2.7-2.4 5.6 4.6" /></svg>
                <figcaption>Foto de {r.especialidade.toLowerCase()}</figcaption>
              </figure>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  /* Pilha: a linha coberta pela seguinte esconde a foto (data-coberta). */
  const etapas = [...document.querySelectorAll<HTMLElement>('#resultados .res-etapa')];
  const largo = matchMedia('(min-width: 900px)');
  let pedido = 0;
  const medir = () => {
    pedido = 0;
    etapas.forEach((el, i) => {
      const prox = etapas[i + 1];
      const coberta = largo.matches && !!prox && prox.getBoundingClientRect().top - el.getBoundingClientRect().top < el.offsetHeight * .55;
      el.toggleAttribute('data-coberta', coberta);
    });
  };
  const agendar = () => { if (!pedido) pedido = requestAnimationFrame(medir); };
  addEventListener('scroll', agendar, { passive: true });
  addEventListener('resize', agendar);
  medir();

  /* Cada número conta de zero até o valor quando a linha entra na tela. */
  const numeros = document.querySelectorAll<HTMLElement>('#resultados [data-contador]');
  const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (numeros.length && !parado && 'IntersectionObserver' in window) {
    const escrever = (el: HTMLElement, v: number) => { el.textContent = `${el.dataset.antes ?? ''}${v}${el.dataset.depois ?? ''}`; };
    numeros.forEach((el) => escrever(el, 0));
    const contar = (el: HTMLElement) => {
      const alvo = Number(el.dataset.alvo), t0 = performance.now(), dur = 1600;
      const passo = (agora: number) => {
        const t = Math.min(1, (agora - t0) / dur);
        escrever(el, Math.round(alvo * (1 - Math.pow(1 - t, 4))));
        if (t < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        contar(e.target as HTMLElement);
        obs.unobserve(e.target);
      }
    }, { threshold: .6 });
    numeros.forEach((el) => obs.observe(el));
  }
</script>
