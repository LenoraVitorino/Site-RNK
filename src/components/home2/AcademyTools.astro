---
/**
 * Ecossistema Renke (02/10/2026): as duas frentes em painéis grandes, um
 * embaixo do outro, no molde da dobra "Features" do template Tidy que a
 * Lenora mandou. De um lado o público, a marca, o texto e o botão; do
 * outro, o quadro prateado com o desenho da frente (EcossistemaArte), com
 * o lado alternando a cada painel. A cabeça segue centrada em uma linha.
 */
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';
import Selo from '../ui/Selo.astro';
import EcossistemaArte from './EcossistemaArte.astro';

const produtos = [
  {
    chave: 'academy',
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto: 'Método, processos e ferramentas para donos de agências estruturarem uma operação mais eficiente.',
    rota: '/academy',
  },
  {
    chave: 'tools',
    eyebrow: copyLiteral ? 'Tecnologia' : 'Tecnologia para sua clínica',
    titulo: 'Renke Tools',
    texto: 'Tecnologias proprietárias que transformam nossa metodologia em ferramentas para acelerar resultados.',
    rota: '/tools',
  },
];
// Logos secundárias das BUs (R + nome), em public/marca/bu-<chave>-escuro.png: largura × altura.
const medidasMarca: Record<string, [number, number]> = { studio: [773, 150], academy: [953, 152], tools: [715, 151] };
---
<section class="secao ecossistema ecossistema-editorial" id="academy-tools" aria-labelledby="ecossistema-titulo" data-ecossistema>
  <div class="container">
    <div class="ecossistema__box">
      <header class="ecossistema__cabeca entra">
        {copyLiteral
          ? <h2 class="visually-hidden" id="ecossistema-titulo">Renke Academy e Renke Tools</h2>
          : <><Selo class="cabeca-dobra__selo">Ecossistema Renke</Selo><h2 class="titulo" id="ecossistema-titulo">O mesmo método, em outras frentes.</h2></>}
      </header>

      <div class="ecossistema__paineis">
        {produtos.map((p, i) => (
          <article class:list={['eco-painel', `eco-painel--${p.chave}`, { 'eco-painel--invertido': i % 2 === 1 }, 'entra']} data-produto={i}>
            <div class="eco-painel__corpo">
              <p class="eco-painel__rotulo">{p.eyebrow}</p>
              <h3 class="eco-painel__nome"><img class="eco-painel__marca" src={`/marca/bu-${p.chave}-escuro.png`} alt={p.titulo} width={medidasMarca[p.chave][0]} height={medidasMarca[p.chave][1]} loading="lazy" /></h3>
              <p class="eco-painel__texto">{p.texto}</p>
              <p class="eco-painel__acao"><Botao href={existe(p.rota) ? p.rota : '/contato'} tamanho="sm">Conhecer {p.titulo}</Botao></p>
            </div>
            <EcossistemaArte tipo={p.chave as 'academy' | 'tools'} numero={String(i + 1).padStart(2, '0')} />
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
