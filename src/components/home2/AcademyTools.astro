---
/**
 * Academy e Tools: dois cartões limpos com espaço de foto. Copy literal.
 */
import FotoSlot from '../ui/FotoSlot.astro';
import { existe } from '../../data/rotas';

const blocos = [
  {
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto: 'Você é dono de agência? O Renke Academy abre os bastidores da nossa operação para você modelar. Método, processos e ferramentas.',
    cta: 'Conhecer a Renke Academy',
    rota: '/academy',
    foto: 'Foto · Academy',
  },
  {
    eyebrow: 'Tecnologia',
    titulo: 'Renke Tools',
    texto: 'Tecnologias proprietárias construídas por quem está nas trincheiras todo dia. Nosso método produtizado em softwares.',
    cta: 'Conhecer a Renke Tools',
    rota: '/tools',
    foto: 'Foto · Produto',
  },
];
---
<section class="secao" id="academy-tools">
  <div class="container duo">
    {blocos.map((b) => (
      <article class="cartao entra">
        <FotoSlot rotulo={b.foto} prop="16 / 10" />
        <p class="rotulo">{b.eyebrow}</p>
        <h3 class="caps">{b.titulo}</h3>
        <p>{b.texto}</p>
        <p><a href={existe(b.rota) ? b.rota : '#'} class:list={['link-arrow', !existe(b.rota) && 'nav--pendente']} data-rota={b.rota}>{b.cta}</a></p>
      </article>
    ))}
  </div>
</section>
