---
/** Duas frentes com espaço reservado para arte e apresentação breve. */
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';
import { copyLiteral } from '../../data/versao';

const produtos = [
  {
    chave: 'academy',
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto: 'Método, processos e ferramentas para donos de agências estruturarem uma operação mais eficiente.',
    rota: '/academy',
  },
  {
    chave: 'tools',
    eyebrow: 'Tecnologia',
    titulo: 'Renke Tools',
    texto: 'Tecnologias proprietárias que transformam nossa metodologia em ferramentas para acelerar resultados.',
    rota: '/tools',
  },
];
---
<section class="secao ecossistema ecossistema-editorial" id="academy-tools" aria-labelledby="ecossistema-titulo" data-ecossistema>
  <div class="container">
    <div class="ecossistema__box">
      <header class="ecossistema__cabeca entra">
        {copyLiteral
          ? <h2 class="visually-hidden" id="ecossistema-titulo">Renke Academy e Renke Tools</h2>
          : <h2 class="titulo" id="ecossistema-titulo">O mesmo método,<br />em outras frentes.</h2>}
      </header>

      <div class="ecossistema__paineis entra">
        {produtos.map((p, i) => (
          <article class:list={['produto', `produto--${p.chave}`, 'produto--aberto']} data-produto={i}>
            <div class="produto__arte" aria-hidden="true"></div>
            <div class="produto__corpo" id={`produto-miolo-${i}`}>
              <p class="rotulo">{p.eyebrow}</p>
              <h3 class="produto__nome">{p.titulo}</h3>
              <p class="produto__texto">{p.texto}</p>
              {existe(p.rota) && <p class="produto__acao"><Botao href={p.rota} tamanho="sm">Conhecer {p.titulo}</Botao></p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
