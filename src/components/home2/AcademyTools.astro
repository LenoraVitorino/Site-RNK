---
/**
 * Academy e Tools: dois cartões limpos com espaço de foto. Copy literal.
 */
import FotoSlot from '../ui/FotoSlot.astro';
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';

const blocos = [
  {
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto: 'Método, processos e ferramentas para donos de agências estruturarem uma operação mais eficiente.',
    cta: 'Conhecer',
    rota: '/academy',
    foto: 'Foto · Academy',
  },
  {
    eyebrow: 'Tecnologia',
    titulo: 'Renke Tools',
    texto: 'Tecnologias proprietárias que transformam nossa metodologia em ferramentas para otimizar a operação e acelerar resultados.',
    cta: 'Conhecer',
    rota: '/tools',
    foto: 'Foto · Produto',
  },
];
---
<section class="secao" id="academy-tools">
  <div class="container duo">
    {blocos.map((b) => (
      <article class="cartao entra">
        <FotoSlot rotulo={b.foto} prop="16 / 10" />
        <p class="rotulo">{b.eyebrow}</p>
        <h3 class="caps">{b.titulo}</h3>
        <p>{b.texto}</p>
        <p><Botao href={existe(b.rota) ? b.rota : '#'} tamanho="sm">{b.cta}</Botao></p>
      </article>
    ))}
  </div>
</section>
