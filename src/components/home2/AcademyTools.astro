---
/** Academy e Tools: composições gráficas em CSS, sem fotos provisórias. */
import Botao from '../ui/Botao.astro';
import { existe } from '../../data/rotas';

const blocos = [
  {
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto: 'Método, processos e ferramentas para donos de agências estruturarem uma operação mais eficiente.',
    cta: 'Conhecer',
    rota: '/academy',
  },
  {
    eyebrow: 'Tecnologia',
    titulo: 'Renke Tools',
    texto: 'Tecnologias proprietárias que transformam nossa metodologia em ferramentas para acelerar resultados.',
    cta: 'Conhecer',
    rota: '/tools',
  },
];
---
<section class="secao" id="academy-tools" aria-label="Renke Academy e Renke Tools">
  <div class="container duo">
    {blocos.map((b, i) => (
      <article class:list={['cartao', 'entra', i === 0 ? 'cartao--academy' : 'cartao--tools']}>
        <div class="cartao__arte" aria-hidden="true">
          {i === 0 ? (
            <div class="academy-marca"><span>R</span><span>A</span><i></i></div>
          ) : (
            <div class="tools-marca"><span>CRM</span><i></i><span>Marketing</span><i></i><span>Vendas</span></div>
          )}
        </div>
        <h3 class="caps">{b.titulo}</h3>
        <p>{b.texto}</p>
        {existe(b.rota) ? <p><Botao href={b.rota} tamanho="sm">{b.cta}</Botao></p> : <p class="cartao__pendente">Em breve</p>}
      </article>
    ))}
  </div>
</section>
