---
/**
 * Crescimento replicável: à esquerda, o processo que deu certo, um cartão
 * encaixado num poço ("Jornada de avaliação", com as três etapas numa
 * trilha vertical) e o selo "Validado" por cima do canto. Dele sai um
 * conector que se abre em três e chega a três cópias exatas do cartão, em
 * miniatura, cada uma no seu destino e no seu tempo: Nova unidade (em
 * março), Nova especialidade (em julho) e Novo time (agora). Em laço, a
 * última cópia sai da vaga, um pulso desce pelo ramo dela e a cópia é
 * carimbada de novo. Pose estática = pose final; o movimento só parte dela.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Matriz: poço de 184 × 136 (x 24, y 57) e cartão de 168 × 120, vão de 8,
   cantos concêntricos (14 + 8 = 22). O eixo da cena é y 125. */
const M = { x: 32, y: 65, w: 168, h: 120 };
/* Etapas do processo, numa trilha vertical (x 52), a cada 19, a partir de
   13,5 abaixo da divisória. O eixo do cartão (y 125) cai entre a primeira
   e a segunda etapa: o conector entra nas cópias entre duas linhas, sem
   quase-encontro com um ponto. */
const etapas = [
  { y: 115.5, nome: 'Primeiro contato' },
  { y: 134.5, nome: 'Agendamento' },
  { y: 153.5, nome: 'Avaliação' },
];
/* Cópias: o mesmo cartão em escala .5 (84 × 60), em x 272, com os centros
   em y 55, 125 e 195. A vaga tracejada tem a mesma forma e fica por baixo:
   só aparece quando a cópia sai. O destino fica ao lado, a 16. */
const CX = 272, CW = M.w / 2, CH = M.h / 2;
const copias = [
  { y: 55, destino: 'Nova unidade', quando: 'em março' },
  { y: 125, destino: 'Nova especialidade', quando: 'em julho' },
  { y: 195, destino: 'Novo time', quando: 'agora' },
];
/* Conectores: o tronco sai do anel na borda do poço (x 208) e se abre em
   x 228; os ramos de cima e de baixo dobram duas vezes (raio 12) pelo
   x 240 e chegam à vaga em x 272. */
const ramo = (y: number, de = 208) => {
  if (y === 125) return `M${de} 125H${CX}`;
  const s = y < 125 ? -1 : 1;
  return `M${de} 125H228C234.6 125 240 ${125 + s * 5.4} 240 ${125 + s * 12}V${y - s * 12}C240 ${y - s * 5.4} 245.4 ${y} 252 ${y}H${CX}`;
};
/* Selo "Validado": pílula de 92 × 24 pendurada no canto de baixo do
   cartão (centrada na borda, y 185), alinhada à direita com o poço. */
const SELO = { x: 116, y: 173, w: 92, h: 24 };
/* O cartão é desenhado uma vez por posição: na matriz (escala 1) e nas
   cópias (escala .5, com o fio em 2 para continuar com 1 unidade). */
const moldes = [
  { k: 'matriz', x: M.x, y: M.y, s: 1 },
  ...copias.map(({ y }, i) => ({ k: `copia copia-${i}`, x: CX, y: y - CH / 2, s: 0.5 })),
];
---
<g class="replicavel">
  {/* Conectores (entram direto na borda das cópias) e o pulso do laço. */}
  <path class="replicavel__ramo" d="M208 125H228" />
  {copias.map(({ y }) => <path class="replicavel__ramo" d={ramo(y, 228)} />)}
  <path class="replicavel__pulso" d={ramo(195)} pathLength="100" />

  {/* Vagas tracejadas (por baixo das cópias) e os destinos. */}
  {copias.map(({ y, destino, quando }, i) => (
    <g>
      <rect class="replicavel__vaga" x={CX + 0.5} y={y - CH / 2 + 0.5} width={CW - 1} height={CH - 1} rx="7" />
      <text x={CX + CW + 16} y={y - 3} class="replicavel__destino">{destino}</text>
      <text x={CX + CW + 16} y={y + 13} class:list={['replicavel__quando', i === 2 && 'replicavel__quando--agora']}>{quando}</text>
      {/* A cópia mais nova está no ar: ponto amarelo pendurado antes do "agora". */}
      {i === 2 && <circle cx={CX + CW + 8} cy={y + 9} r="2.25" class="a-destaque replicavel__agora-ponto" />}
    </g>
  ))}

  {/* Matriz: o poço onde o processo validado está encaixado. */}
  <rect x={M.x - 8} y={M.y - 8} width={M.w + 16} height={M.h + 16} rx="22" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />
  {/* Anel de ancoragem na borda do poço: a saída do processo validado, com
      o miolo amarelo. */}
  <circle class="replicavel__anel" cx="208" cy="125" r="3.5" />
  <circle class="a-destaque" cx="208" cy="125" r="1.75" />

  {/* O cartão do processo e as suas cópias exatas. */}
  {moldes.map(({ k, x, y, s }) => (
    <g class:list={k.split(' ').map((c) => `replicavel__${c}`)}>
      <g transform={`translate(${x} ${y}) scale(${s})`}>
        <rect width={M.w} height={M.h} rx="14" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} class="replicavel__cartao" />
        <rect x="20" y="0.5" width={M.w - 40} height="1" fill={`url(#${p}-fio-h)`} />
        <text x="16" y="24" class="replicavel__titulo">Jornada de avaliação</text>
        <rect x="1" y="37" width={M.w - 2} height="1" class="replicavel__divisa" />
        {etapas.slice(0, -1).map(({ y: ey }, i) => (
          <path class="replicavel__trilha" d={`M20 ${ey - M.y + 5}V${etapas[i + 1].y - M.y - 5}`} />
        ))}
        {etapas.map(({ y: ey, nome }, i) => (
          <>
            <circle cx="20" cy={ey - M.y} r="3" class:list={['replicavel__no', i === etapas.length - 1 && 'replicavel__no--fim']} />
            <text x="32" y={ey - M.y + 4.5} class="replicavel__etapa">{nome}</text>
          </>
        ))}
      </g>
    </g>
  ))}

  {/* Selo "Validado": flutua sobre o canto do cartão, com a sombra. */}
  <rect x={SELO.x} y={SELO.y} width={SELO.w} height={SELO.h} rx={SELO.h / 2} fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} filter={`url(#${p}-sombra)`} />
  <rect x={SELO.x + 16} y={SELO.y + 0.5} width={SELO.w - 32} height="1" fill={`url(#${p}-fio-h)`} />
  <path class="a-destaque-traco replicavel__selo-visto" d={`M${SELO.x + 12} ${SELO.y + 12.2}l2.6 2.6l5.2-5.6`} />
  <text x={SELO.x + 27} y={SELO.y + 16.5} class="replicavel__selo">Validado</text>

</g>

<style>
  .replicavel__ramo { fill: none; stroke: #ffffff; stroke-opacity: .16; }
  .replicavel__vaga { fill: none; stroke: #ffffff; stroke-opacity: .24; stroke-dasharray: 2 3; }
  .replicavel__anel { fill: #0e0e0e; stroke: #ffffff; stroke-opacity: .3; }
  .replicavel__titulo { font-size: 13.5px; font-weight: 500; letter-spacing: -.01em; fill: #ecece8; }
  .replicavel__divisa { fill: #ffffff; fill-opacity: .06; }
  .replicavel__trilha { fill: none; stroke: #ffffff; stroke-opacity: .14; }
  .replicavel__no { fill: none; stroke: #9d9d98; stroke-width: 1.2; }
  .replicavel__no--fim { fill: #d6d6d1; stroke: none; }
  .replicavel__etapa { font-size: 12.5px; letter-spacing: -.005em; fill: #b9b9b4; }
  /* Nas cópias (escala .5), os fios dobram para continuar com 1 unidade. */
  .replicavel__copia .replicavel__cartao, .replicavel__copia .replicavel__trilha { stroke-width: 2; }
  .replicavel__copia .replicavel__no { stroke-width: 2.4; }
  .replicavel__destino { font-size: 13px; letter-spacing: -.005em; fill: #d6d6d1; }
  .replicavel__quando { font-size: 11px; fill: #8a8a85; font-variant-numeric: tabular-nums; }
  .replicavel__selo { font-size: 13px; font-weight: 500; letter-spacing: -.005em; fill: #d6d6d1; }
  .replicavel .replicavel__selo-visto { stroke-width: 1.5; }
  .replicavel__pulso {
    fill: none; stroke: #ecece8; stroke-width: 1.5; stroke-linecap: round;
    stroke-dasharray: 10 190; stroke-dashoffset: -112;
  }

  /* Movimento, em laço de 12 s (tempos do ciclo):
     0–0,8 s   repouso na pose final;
     0,8–1,2   a última cópia ("agora") sai da vaga, que fica tracejada;
     1,4–2,6   um pulso sai da matriz e desce pelo ramo dela;
     2,5–3,5   a cópia é carimbada: aparece descendo 4 unidades;
     3,2–3,8   o "agora" volta, com o ponto amarelo.
     O resto (≈ 75% do ciclo) é repouso. O 0% de cada keyframe é a pose
     final. */
  .replicavel__copia-2, .replicavel__quando--agora, .replicavel__agora-ponto, .replicavel__pulso {
    animation-duration: 12s; animation-delay: .4s; animation-iteration-count: infinite;
    animation-timing-function: var(--a-vai-vem); animation-fill-mode: both;
  }
  .replicavel__copia-2 { animation-name: replicavel-carimbo; transform-box: fill-box; }
  .replicavel__quando--agora, .replicavel__agora-ponto { animation-name: replicavel-agora; transform-box: fill-box; }
  .replicavel__pulso { animation-name: replicavel-pulso; }

  @keyframes replicavel-carimbo {
    0%, 6.67% { opacity: 1; transform: none; }
    10% { opacity: 0; transform: none; }
    10.01%, 20.83% { opacity: 0; transform: translateY(-4px); animation-timing-function: var(--a-entra); }
    29.17%, 100% { opacity: 1; transform: none; }
  }
  @keyframes replicavel-agora {
    0%, 6.67% { opacity: 1; transform: none; }
    10% { opacity: 0; transform: none; }
    10.01%, 26.67% { opacity: 0; transform: translateY(3px); animation-timing-function: var(--a-entra); }
    31.67%, 100% { opacity: 1; transform: none; }
  }
  /* Pulso: em repouso, o traço fica além do fim do caminho, com folga para
     a ponta redonda não aparecer; parte de antes do começo, sob o anel. */
  @keyframes replicavel-pulso {
    0%, 11.66% { stroke-dashoffset: 12; }
    21.67%, 100% { stroke-dashoffset: -112; }
  }
</style>
