---
/**
 * Investimento mais inteligente: uma mesa de controle da verba, com um
 * fader por canal (Busca, Instagram, Indicação, Reativação). Cada canal
 * mostra o potencial num sinal de três barras, e o trilho tem a escala fina
 * de uma mesa de som. A "Renke" acabou de baixar um pouco o Instagram e
 * subir a Indicação, o canal de maior potencial: uma marca tracejada guarda
 * onde cada fader estava, e o aviso "Verba remanejada" confirma. O gesto
 * principal (subir a Indicação) vem por último, para o quadro parado
 * mostrar o cursor nele. Em laço, a cena volta um passo e repete o gesto.
 * Pose estática = pose final; o movimento só parte dela.
 */
import Cursor from '../Cursor.astro';

interface Props { p: string }
const { p } = Astro.props;

/* Painel de 440 × 204 (x 24 a 464, y 18 a 222), cabeçalho de 44. Quatro
   canais de 110: nome e sinal de potencial no alto, e o trilho no centro,
   de y 114 a 206. O botão tem 30 × 16. `antes` é a altura do botão antes
   do gesto, para a marca tracejada. */
const PX = 24, PY = 18, PW = 440, PH = 204;
const T0 = 114, T1 = 206;
const canais = [
  { nome: 'Busca', potencial: 2, y: 152 },
  { nome: 'Instagram', potencial: 1, y: 176, antes: 136 },
  { nome: 'Indicação', potencial: 3, y: 128, antes: 184, foco: true },
  { nome: 'Reativação', potencial: 2, y: 168 },
].map((c, i) => ({ ...c, x0: PX + i * 110, c: PX + i * 110 + 55 }));
const [, insta, indic] = canais;

/* Escala do trilho, impressa à esquerda como numa mesa de som: marcas de
   5 a cada 8 e de 9 a cada 32, de y 116 a 204. Ficam no meio entre as
   posições dos botões (múltiplos de 8), para o fio de índice e a marca de
   "antes" nunca encostarem numa delas. */
const marcas = (c: number, maior: boolean) => {
  let d = '';
  for (let y = T0 + 2, k = 0; y <= T1 - 2; y += 8, k++) {
    if ((k % 4 === 0) !== maior) continue;
    d += `M${c - 11 - (maior ? 9 : 5)} ${y + 0.5}H${c - 11}`;
  }
  return d;
};

/* Potencial: três barras que sobem (3 de largura, 4, 6 e 8 de altura, vão
   de 2), como um sinal; acesas conforme o potencial do canal. */
const barras = (x: number, base: number) => [4, 6, 8].map((h, k) => ({ x: x + k * 5, y: base - h, h }));

/* Aviso: 174 × 48, no canto de baixo, saindo do painel pela direita. */
const AX = 322, AY = 190, AW = 174, AH = 48;
/* Cursor: fica sobre o botão da Indicação, no canto direito, onde o pegou
   (12 à direita do centro e 4 abaixo do meio). A etiqueta começa em x 322,
   na mesma vertical do aviso, e fica 21 acima dele. */
const RX = indic.c + 12, RY = indic.y + 4;
---
<g class="investimento">
  {/* Painel da mesa. */}
  <rect x={PX} y={PY} width={PW} height={PH} rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x={PX + 16} y={PY + 0.5} width="330" height="1" fill={`url(#${p}-fio-h)`} />
  <text x={PX + 20} y={PY + 27} class="investimento__titulo">Distribuição da verba</text>
  {/* Legenda do potencial, à direita do cabeçalho. */}
  <g class="investimento__legenda">
    {barras(PX + PW - 20 - 47.3 - 7 - 13, PY + 26.5).map(({ x, y, h }) => <rect x={x} y={y} width="3" height={h} rx="1" class="investimento__ponto investimento__ponto--aceso" />)}
    <text x={PX + PW - 20} y={PY + 26.5} text-anchor="end" class="investimento__legenda-nome">Potencial</text>
  </g>
  <rect x={PX} y={PY + 44} width={PW} height="1" class="investimento__divisa" />

  {/* O canal escolhido fica marcado de leve, como uma faixa selecionada. */}
  <rect x={indic.x0} y={PY + 45} width="110" height={PH - 45} class="investimento__selecao" />
  {canais.slice(1).map(({ x0 }) => <rect x={x0} y={PY + 45} width="1" height={PH - 45} class="investimento__divisa" />)}

  {canais.map(({ nome, potencial, x0, c, foco }) => (
    <g>
      <text x={c} y="88" text-anchor="middle" class:list={['investimento__canal', { 'investimento__canal--foco': foco }]}>{nome}</text>
      {barras(c - 6.5, 104).map(({ x, y, h }, k) => (
        <rect x={x} y={y} width="3" height={h} rx="1"
          class:list={['investimento__ponto', { 'investimento__ponto--aceso': k < potencial, 'investimento__ponto--foco': foco && k < potencial }]} />
      ))}
      <path d={marcas(c, false)} class="investimento__marca" />
      <path d={marcas(c, true)} class="investimento__marca investimento__marca--maior" />
      <rect x={c - 3} y={T0} width="6" height={T1 - T0} rx="3" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />
    </g>
  ))}

  {/* Nível de cada canal: um fio claro no fundo do trilho, do botão até a
      base. Nos dois que a Renke move, ele cresce ou encolhe com o botão. */}
  {canais.map(({ nome, c, y, foco }) => (
    <rect x={c - 1} y={y} width="2" height={T1 - 3 - y} rx="1"
      class:list={['investimento__nivel', { 'investimento__nivel--foco': foco, 'investimento__nivel--insta': nome === 'Instagram', 'investimento__nivel--indic': foco }]} />
  ))}

  {/* Onde os dois faders estavam antes do gesto: o fio de índice do botão,
      tracejado (18 de largura, livre da escala, que termina em c − 11). */}
  {[insta, indic].map(({ c, antes }, i) => (
    <path d={`M${c - 9} ${antes! + 0.5}H${c + 9}`} class:list={['investimento__marca-antes', `investimento__antes--${i ? 'indic' : 'insta'}`]} />
  ))}

  {/* Botões dos faders. Os dois que a Renke move têm um <g> próprio. */}
  {canais.map(({ nome, c, y, foco }) => (
    <g class:list={['investimento__fader', { 'investimento__fader--insta': nome === 'Instagram', 'investimento__fader--indic': foco }]}>
      <rect x={c - 15} y={y - 8} width="30" height="16" rx="5" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
      <rect x={c - 9} y={y - 7.5} width="18" height="1" fill={`url(#${p}-fio-h)`} />
      <rect x={c - 8} y={y - 0.5} width="16" height="1" class:list={['investimento__indice', { 'investimento__indice--foco': foco }]} />
    </g>
  ))}

  {/* Aviso de que a verba foi remanejada. */}
  <g class="investimento__aviso">
    <rect x={AX} y={AY} width={AW} height={AH} rx="10" fill="#000000" filter={`url(#${p}-sombra)`} />
    <rect x={AX} y={AY} width={AW} height={AH} rx="10" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
    <rect x={AX + 20} y={AY + 0.5} width={AW - 40} height="1" fill={`url(#${p}-fio-h)`} />
    <circle cx={AX + 22} cy={AY + 24} r="7" class="investimento__visto-anel" />
    <path d={`M${AX + 19} ${AY + 24}l2 2l3.6-4`} class="investimento__visto" />
    <text x={AX + 38} y={AY + 20.5} class="investimento__aviso-titulo">Verba remanejada</text>
    <text x={AX + 38} y={AY + 36} class="investimento__aviso-texto">Instagram → Indicação</text>
  </g>

  {/* Cursor da Renke, ainda no botão que acabou de subir. */}
  <g class="investimento__cursor">
    <g class="investimento__cursor-x">
      <g class="investimento__cursor-y">
        <g transform={`translate(${RX} ${RY})`}><Cursor nome="Renke" /></g>
      </g>
    </g>
  </g>
</g>

<style>
  .investimento__titulo { font-size: 13.5px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .investimento__legenda-nome { font-size: 11px; fill: #8a8a85; }
  .investimento__divisa { fill: #ffffff; fill-opacity: .06; }
  .investimento__selecao { fill: #ffffff; fill-opacity: .022; }
  .investimento__canal { font-size: 13px; font-weight: 500; fill: #b9b9b4; letter-spacing: -.005em; }
  .investimento__canal--foco { fill: #ecece8; }
  .investimento__ponto { fill: #ffffff; fill-opacity: .12; }
  .investimento__ponto--aceso { fill: #8a8a85; fill-opacity: 1; }
  .investimento__ponto--foco { fill: #ecece8; }
  .investimento__marca { fill: none; stroke: #ffffff; stroke-opacity: .08; }
  .investimento__marca--maior { stroke-opacity: .16; }
  .investimento__marca-antes { fill: none; stroke: #ffffff; stroke-opacity: .4; stroke-dasharray: 2 2; }
  .investimento__indice { fill: #ffffff; fill-opacity: .45; }
  .investimento__nivel { fill: #ffffff; fill-opacity: .16; transform-box: fill-box; transform-origin: 50% 100%; }
  .investimento__nivel--foco { fill-opacity: .5; }
  .investimento__indice--foco { fill: #ecece8; fill-opacity: 1; }
  .investimento__visto-anel { fill: none; stroke: #ffffff; stroke-opacity: .22; }
  .investimento__visto { fill: none; stroke: #ecece8; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .investimento__aviso-titulo { font-size: 13px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .investimento__aviso-texto { font-size: 11px; fill: #8a8a85; }

  /* Movimento, em laço de 12 s (tempos do ciclo):
     0–0,6 s   repouso na pose final;
     0,6–1,0   a cena volta um passo: cursor, aviso, marcas e os dois
               faders somem;
     1,05–1,45 os faders reaparecem onde estavam (Instagram alto,
               Indicação baixa);
     1,4–2,4   o cursor entra por baixo, numa curva, até o Instagram;
     2,4–2,6   clique; 2,55–3,15 desce o Instagram; a marca aparece;
     3,2–3,9   o cursor vai até a Indicação;
     3,9–4,1   clique; 4,05–5,05 sobe a Indicação com o cursor, que
               fica no botão; a marca aparece;
     5,3–5,8   o aviso sobe.
     O resto (≈ 57% do ciclo) é repouso. O 0% de cada keyframe é a pose
     final. */
  .investimento__fader--insta, .investimento__fader--indic, .investimento__nivel--insta, .investimento__nivel--indic, .investimento__antes--insta, .investimento__antes--indic, .investimento__aviso,
  .investimento__cursor, .investimento__cursor-x, .investimento__cursor-y, .investimento :global(.a-cursor__seta) {
    animation-duration: 12s; animation-delay: .4s; animation-iteration-count: infinite;
    animation-timing-function: var(--a-vai-vem); animation-fill-mode: both;
  }
  .investimento__fader--insta { animation-name: investimento-insta; }
  .investimento__fader--indic { animation-name: investimento-indic; }
  .investimento__nivel--insta { animation-name: investimento-nivel-insta; }
  .investimento__nivel--indic { animation-name: investimento-nivel-indic; }
  .investimento__antes--insta { animation-name: investimento-antes-insta; }
  .investimento__antes--indic { animation-name: investimento-antes-indic; }
  .investimento__aviso { animation-name: investimento-aviso; }
  .investimento__cursor { animation-name: investimento-cursor; }
  .investimento__cursor-x { animation-name: investimento-cursor-x; }
  .investimento__cursor-y { animation-name: investimento-cursor-y; }
  .investimento :global(.a-cursor__seta) { animation-name: investimento-clique; }

  @keyframes investimento-insta {
    0%, 5% { transform: translateY(0); opacity: 1; }
    8.33% { transform: translateY(0); opacity: 0; }
    8.34%, 8.75% { transform: translateY(-40px); opacity: 0; }
    12.08%, 21.25% { transform: translateY(-40px); opacity: 1; }
    26.25%, 100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes investimento-indic {
    0%, 5% { transform: translateY(0); opacity: 1; }
    8.33% { transform: translateY(0); opacity: 0; }
    8.34%, 8.75% { transform: translateY(56px); opacity: 0; }
    12.08%, 33.75% { transform: translateY(56px); opacity: 1; }
    42.08%, 100% { transform: translateY(0); opacity: 1; }
  }
  /* O nível acompanha o botão: Instagram tinha 67 de trilho aceso e fica
     com 27; Indicação tinha 19 e fica com 75. */
  @keyframes investimento-nivel-insta {
    0%, 5% { transform: scaleY(1); opacity: 1; }
    8.33% { transform: scaleY(1); opacity: 0; }
    8.34%, 8.75% { transform: scaleY(2.4815); opacity: 0; }
    12.08%, 21.25% { transform: scaleY(2.4815); opacity: 1; }
    26.25%, 100% { transform: scaleY(1); opacity: 1; }
  }
  @keyframes investimento-nivel-indic {
    0%, 5% { transform: scaleY(1); opacity: 1; }
    8.33% { transform: scaleY(1); opacity: 0; }
    8.34%, 8.75% { transform: scaleY(.2533); opacity: 0; }
    12.08%, 33.75% { transform: scaleY(.2533); opacity: 1; }
    42.08%, 100% { transform: scaleY(1); opacity: 1; }
  }
  /* Cada marca aparece quando o fader dela é solto. */
  @keyframes investimento-antes-insta {
    0%, 5% { opacity: 1; }
    8.33%, 26.25% { opacity: 0; }
    28.75%, 100% { opacity: 1; }
  }
  @keyframes investimento-antes-indic {
    0%, 5% { opacity: 1; }
    8.33%, 42.08% { opacity: 0; }
    44.58%, 100% { opacity: 1; }
  }
  @keyframes investimento-aviso {
    0%, 5% { transform: translateY(0); opacity: 1; }
    8.33%, 44.17% { transform: translateY(8px); opacity: 0; }
    48.33%, 100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes investimento-cursor {
    0%, 5% { opacity: 1; }
    8.33%, 11.67% { opacity: 0; }
    15%, 100% { opacity: 1; }
  }
  /* Entrada em curva: o X corre no começo e o Y vai por igual. A ponta
     pega os dois botões no mesmo ponto (12 à direita do centro, 4 abaixo
     do meio) e arrasta com os mesmos tempos e a mesma curva deles; entre um
     e outro, um arco leve de 6 para cima. */
  @keyframes investimento-cursor-x {
    0%, 8.33% { transform: translateX(0); }
    8.34%, 11.67% { transform: translateX(-139px); animation-timing-function: cubic-bezier(.25, .6, .3, 1); }
    20%, 26.67% { transform: translateX(-110px); }
    32.5%, 100% { transform: translateX(0); }
  }
  @keyframes investimento-cursor-y {
    0%, 8.33% { transform: translateY(0); }
    8.34%, 11.67% { transform: translateY(158px); animation-timing-function: cubic-bezier(.55, 0, .35, 1); }
    20%, 21.25% { transform: translateY(8px); }
    26.25%, 26.67% { transform: translateY(48px); }
    29.58% { transform: translateY(46px); }
    32.5%, 33.75% { transform: translateY(56px); }
    42.08%, 100% { transform: translateY(0); }
  }
  @keyframes investimento-clique {
    0%, 20% { transform: scale(1); }
    20.83% { transform: scale(.88); }
    21.67%, 32.5% { transform: scale(1); }
    33.33% { transform: scale(.88); }
    34.17%, 100% { transform: scale(1); }
  }
</style>
