---
/**
 * Investimento mais inteligente: um painel "Verba por canal" com um controle
 * segmentado (Atual | Recomendado) e quatro canais, cada um com trilho e
 * barra. Em laço, o controle vai a Atual e volta a Recomendado, e as barras
 * se reequilibram devagar: a verba sai de Busca e de Redes sociais e vai para
 * Indicação, que acende o sinal. Pose estática = pose final (Recomendado);
 * o movimento só parte dela.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Painel de 424 × 200 (x 48 a 472) com um poço de 392 × 124 embaixo.
   Trilhos de 240 × 4 (x 196 a 436), linhas a cada 28. A verba total é a
   mesma nas duas posições. `de` é o deslocamento da barra na posição Atual. */
const X0 = 196, W = 240;
const canais = [
  { rotulo: 'Busca', y: 104, atual: 184, rec: 140 },
  { rotulo: 'Redes sociais', y: 132, atual: 148, rec: 96 },
  { rotulo: 'Indicação', y: 160, atual: 76, rec: 156, foco: true },
  { rotulo: 'Reativação', y: 188, atual: 64, rec: 80 },
].map((c, i) => ({ ...c, de: c.atual - c.rec, atraso: (0.6 + i * 0.14).toFixed(2) }));
const foco = canais.find((c) => c.foco)!;

/* Controle segmentado: 230 × 28 no canto (x 226 a 456, rente ao poço),
   polegar de 112 com folga de 3 (raio 11, concêntrico ao 14 da canaleta). */
const CX = 226, CY = 40, SEG = 112;
---
<g class="investimento">
  <defs>
    {/* As barras só aparecem dentro dos trilhos. */}
    <clipPath id={`${p}-trilhos`}>
      {canais.map(({ y }) => <rect x={X0} y={y - 2} width={W} height="4" rx="2" />)}
    </clipPath>
  </defs>

  <rect width="520" height="250" fill={`url(#${p}-pontos)`} mask={`url(#${p}-esmaece)`} />

  {/* Painel e poço. */}
  <rect x="48" y="24" width="424" height="200" rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x="140" y="24" width="240" height="1" fill={`url(#${p}-fio-h)`} />
  <rect x="64" y="84" width="392" height="124" rx="12" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />

  <text x="64" y="58" class="a-micro investimento__titulo">Verba por canal</text>

  {/* Controle segmentado: canaleta rebaixada e o polegar elevado. O texto
      ativo é um segundo texto por cima, que troca com o polegar. */}
  <rect x={CX} y={CY} width="230" height="28" rx="14" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />
  <g class="investimento__polegar">
    <rect x={CX + 3 + SEG} y={CY + 3} width={SEG} height="22" rx="11" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
    <rect x={CX + 3 + SEG + 26} y={CY + 3.5} width="60" height="1" fill={`url(#${p}-fio-h)`} />
  </g>
  <text x={CX + 3 + SEG / 2} y={CY + 18.5} text-anchor="middle" class="a-rotulo investimento__opcao">Atual</text>
  <text x={CX + 3 + SEG / 2} y={CY + 18.5} text-anchor="middle" class="a-rotulo investimento__opcao investimento__opcao--ativa investimento__opcao-atual">Atual</text>
  <text x={CX + 3 + SEG * 1.5} y={CY + 18.5} text-anchor="middle" class="a-rotulo investimento__opcao">Recomendado</text>
  <text x={CX + 3 + SEG * 1.5} y={CY + 18.5} text-anchor="middle" class="a-rotulo investimento__opcao investimento__opcao--ativa investimento__opcao-rec">Recomendado</text>

  {/* Canais: rótulo, trilho e barra. */}
  {canais.map(({ rotulo, y, foco }) => (
    <g>
      <text x="84" y={y + 5} class:list={['a-rotulo', 'investimento__rotulo', { 'investimento__rotulo--foco': foco }]}>{rotulo}</text>
      <rect x={X0} y={y - 2} width={W} height="4" rx="2" class="investimento__trilho" />
    </g>
  ))}
  <g clip-path={`url(#${p}-trilhos)`}>
    {canais.map(({ y, rec, de, atraso, foco }) => (
      <rect x={X0 - W} y={y - 2} width={W + rec} height="4" rx="2"
        class:list={['investimento__barra', { 'investimento__barra--foco': foco }]}
        style={`--de:${de}px;--atraso:${atraso}s`} />
    ))}
  </g>

  {/* Sinal do canal que mais cresce: anda com a ponta da barra. */}
  <g class="investimento__sinal-anda" style={`--de:${foco.de}px;--atraso:${foco.atraso}s`}>
    <circle cx={X0 + foco.rec + 10} cy={foco.y} r="2.25" class="a-destaque investimento__sinal" style={`--atraso:${foco.atraso}s`} />
  </g>
</g>

<style>
  .investimento .investimento__titulo { font-size: 11px; }
  .investimento .investimento__rotulo { font-size: 14px; }
  .investimento .investimento__rotulo--foco { fill: #ecece8; }
  /* O controle recua: o foco da cena é o canal que cresce, não o botão. */
  .investimento .investimento__opcao { font-size: 13px; fill: #6f6f6b; }
  .investimento .investimento__opcao--ativa { fill: #b9b9b4; }
  .investimento__opcao-atual { opacity: 0; }
  .investimento__trilho { fill: #ffffff; fill-opacity: .06; }
  .investimento__barra { fill: #ffffff; fill-opacity: .3; }
  .investimento__barra--foco { fill-opacity: .72; }

  /* Movimento (laço de 10 s): parte de Recomendado, a pose final. Depois de
     um repouso, o polegar vai a Atual (1,3 s) e as barras voltam à verba de
     hoje, em cascata, cada uma deslizando dentro do seu trilho (a ponta
     redonda não se deforma). Uma pausa curta e tudo volta a Recomendado; o
     sinal acende quando a barra de Indicação assenta. Repouso de ~5 s em
     Recomendado; movimento em ~32% do ciclo. */
  .investimento__polegar { animation: investimento-polegar 10s var(--a-vai-vem) .6s infinite both; }
  .investimento__opcao-atual { animation: investimento-atual 10s var(--a-vai-vem) .6s infinite both; }
  .investimento__opcao-rec { animation: investimento-rec 10s var(--a-vai-vem) .6s infinite both; }
  .investimento__barra,
  .investimento__sinal-anda { animation: investimento-reequilibra 10s var(--a-vai-vem) var(--atraso) infinite both; }
  .investimento__sinal { animation: investimento-acende 10s var(--a-vai-vem) var(--atraso) infinite both; }

  @keyframes investimento-polegar {
    0%, 28% { transform: translateX(0); }
    41%, 56% { transform: translateX(-112px); }
    69%, 100% { transform: translateX(0); }
  }
  @keyframes investimento-rec {
    0%, 29% { opacity: 1; }
    38%, 58% { opacity: 0; }
    67%, 100% { opacity: 1; }
  }
  @keyframes investimento-atual {
    0%, 31% { opacity: 0; }
    40%, 57% { opacity: 1; }
    66%, 100% { opacity: 0; }
  }
  @keyframes investimento-reequilibra {
    0%, 28% { transform: translateX(0); }
    42%, 56% { transform: translateX(var(--de)); }
    70%, 100% { transform: translateX(0); }
  }
  @keyframes investimento-acende {
    0%, 26% { opacity: 1; }
    34%, 70% { opacity: 0; }
    82%, 100% { opacity: 1; }
  }
</style>
