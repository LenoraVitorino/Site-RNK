---
/**
 * Peças comuns das ilustrações dos cartões (Protocolo Revena e "O que muda na
 * sua clínica"), 28/09/2026. Cada cena chama este componente dentro do seu
 * <svg> com um prefixo próprio, e os ids não se repetem na página.
 *
 * Linguagem (docs em src/styles/ilustracoes.css): superfícies escuras com
 * gradiente mínimo de cima para baixo, fio fino que clareia no alto, poços
 * rebaixados, grade de pontos que some nas bordas e uma sombra escura e
 * macia só para o que flutua. Nada de brilho nem de halo de luz.
 */
interface Props { p: string }
const { p } = Astro.props;
---
<defs>
  {/* Superfície de painel: cinza quase preto, um tom mais claro no alto. */}
  <linearGradient id={`${p}-sup`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#1c1c1c" /><stop offset="1" stop-color="#131313" />
  </linearGradient>
  {/* Superfície elevada (chips, cartões sobre o painel). */}
  <linearGradient id={`${p}-alto`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#262626" /><stop offset="1" stop-color="#191919" />
  </linearGradient>
  {/* Poço (soquete rebaixado): mais escuro no alto; na borda, o fio de baixo
      pega a luz. É onde os chips, cartões e pílulas se encaixam. */}
  <linearGradient id={`${p}-poco`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#070707" /><stop offset="1" stop-color="#101010" />
  </linearGradient>
  <linearGradient id={`${p}-borda-poco`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#ffffff" stop-opacity=".04" /><stop offset="1" stop-color="#ffffff" stop-opacity=".11" />
  </linearGradient>
  {/* Fio de contorno: mais visível na borda de cima, quase some embaixo. */}
  <linearGradient id={`${p}-fio`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#ffffff" stop-opacity=".16" /><stop offset="1" stop-color="#ffffff" stop-opacity=".05" />
  </linearGradient>
  {/* Fio horizontal que nasce e morre no escuro (linhas de fundo, eixos). */}
  <linearGradient id={`${p}-fio-h`} x1="0" y1="0" x2="1" y2="0">
    <stop stop-color="#ffffff" stop-opacity="0" /><stop offset=".5" stop-color="#ffffff" stop-opacity=".14" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
  </linearGradient>
  {/* Preenchimento de área sob uma linha de gráfico: cinza que desce ao preto. */}
  <linearGradient id={`${p}-area`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="#ffffff" stop-opacity=".09" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
  </linearGradient>
  {/* Grade de pontos do fundo e a máscara que a apaga nas bordas. */}
  <pattern id={`${p}-pontos`} width="16" height="16" patternUnits="userSpaceOnUse">
    <circle cx="8" cy="8" r=".75" fill="#ffffff" fill-opacity=".09" />
  </pattern>
  <radialGradient id={`${p}-vinheta`} cx=".5" cy=".5" r=".5">
    <stop stop-color="#ffffff" /><stop offset=".55" stop-color="#ffffff" stop-opacity=".55" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
  </radialGradient>
  <mask id={`${p}-esmaece`} maskContentUnits="objectBoundingBox">
    <rect width="1" height="1" fill={`url(#${p}-vinheta)`} />
  </mask>
  {/* Sombra de apoio para o que flutua: escura, larga e sem cor. */}
  <filter id={`${p}-sombra`} x="-30%" y="-30%" width="160%" height="190%" color-interpolation-filters="sRGB">
    <feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#000000" flood-opacity=".55" />
  </filter>
</defs>
