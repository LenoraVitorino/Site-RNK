---
/**
 * Vamos além do tráfego pago: a conversa no WhatsApp do comercial, contada
 * como acontece, uma mensagem de cada vez (Lenora, 29/09: sem os dois
 * cartões lado a lado nem os fios ligando; "fazer acontecer" em vez de
 * deixar tudo exposto). Uma janela só, em grafite, que segue além da borda
 * de baixo: no cabeçalho, "Novo contato · via anúncio" e o logo do WhatsApp
 * em cinza. A primeira mensagem chega citando o anúncio ("Agende sua
 * avaliação · Anúncio · Instagram"), a resposta do comercial sobe e, por
 * fim, o cartão "Consulta agendada · qui, 14:00", que flutua
 * sobre a conversa e passa da borda da janela, como o aviso da Automação
 * (29/09: "deixa mais destacado, mais dinâmico, faltou detalhe amarelo").
 * O amarelo fica nos detalhes do cartão: o visto do calendário e o fio do
 * alto. Em laço, a conversa recomeça: some, a primeira mensagem aparece
 * embaixo, cada nova empurra as anteriores para cima, como no app; o
 * cartão sobe, o fio amarelo se abre do centro, o visto se desenha e um
 * anel fino se expande uma vez do calendário. Pose estática = pose final;
 * o movimento só parte dela.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Janela: canto em (36, 28), 328 de largura, centrada no cartão; sai por
   baixo. Cabeçalho de 52. */
const W = { x: 36, y: 28, w: 328 };
const CAB = W.y + 52;
/* Balões do WhatsApp: raio 8 e a pontinha no alto, do lado de quem fala. */
const balao = (x: number, y: number, w: number, h: number, lado: 'esq' | 'dir') => {
  const r = 8;
  return lado === 'esq'
    ? `M${x - 5} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + 9}C${x} ${y + 6} ${x - 2} ${y + 3.5} ${x - 5.2} ${y + 1.5}Q${x - 6.6} ${y} ${x - 5} ${y}Z`
    : `M${x + r} ${y}H${x + w + 5}Q${x + w + 6.6} ${y} ${x + w + 5.2} ${y + 1.5}C${x + w + 2} ${y + 3.5} ${x + w} ${y + 6} ${x + w} ${y + 9}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
};
/* A conversa, de baixo para cima, com a base em y 284 e vão de 10:
   mensagem recebida com a citação do anúncio (texto em Inter 13 de 183,6
   mais a hora), resposta (145,6 mais hora e visto) e o cartão da consulta,
   que sai 20 pela direita da janela. D2 e D3 são quanto a pilha desce
   enquanto a resposta e a consulta ainda não chegaram. */
const M1 = { x: 52, y: 98, w: 244, h: 78 };
const M2 = { x: 122, y: 186, w: 226, h: 36 };
const C = { x: 140, y: 232, w: 244, h: 52 };
/* No cartão: poço de 32 com o calendário, a 10 da borda; o centro dele é
   o do anel que se expande. */
const IC = { x: C.x + 26, y: C.y + 26 };
const D3 = C.h + 10, D2 = M2.h + 10;
const WHATSAPP = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---
<g class="jornada" style={`--d2:${D2}px; --d3:${D3}px`}>
  <defs>
    <linearGradient id={`${p}-perfil`} x1=".8" y1="0" x2=".2" y2="1">
      <stop stop-color="#5a5a55" /><stop offset="1" stop-color="#232322" />
    </linearGradient>
    {/* A resposta do comercial é um tom mais clara que a recebida. */}
    <linearGradient id={`${p}-enviada`} x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="#323230" /><stop offset="1" stop-color="#282827" />
    </linearGradient>
    {/* Fio amarelo do alto do cartão: nasce e morre no escuro. */}
    <linearGradient id={`${p}-fio-amarelo`} x1="0" y1="0" x2="1" y2="0">
      <stop style="stop-color: var(--destaque, #FFD103)" stop-opacity="0" />
      <stop offset=".5" style="stop-color: var(--destaque, #FFD103)" stop-opacity=".9" />
      <stop offset="1" style="stop-color: var(--destaque, #FFD103)" stop-opacity="0" />
    </linearGradient>
  </defs>

  {/* Janela, recortada pela borda de baixo. */}
  <rect x={W.x} y={W.y} width={W.w} height="320" rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x={W.x + 16} y={W.y + 0.5} width="240" height="1" fill={`url(#${p}-fio-h)`} />
  <circle cx="64" cy={W.y + 26} r="13" fill={`url(#${p}-perfil)`} />
  <text x="86" y={W.y + 23} class="jornada__nome">Novo contato</text>
  <text x="86" y={W.y + 38} class="jornada__secundario">via anúncio</text>
  <path transform={`translate(329 ${W.y + 17}) scale(.75)`} class="jornada__logo" d={WHATSAPP} />
  <rect x={W.x} y={CAB} width={W.w} height="1" class="jornada__divisa" />

  {/* A conversa: tudo sobe junto quando chega uma mensagem nova. */}
  <g class="jornada__pilha">
    {/* Recebida, com a citação do anúncio no alto, como o WhatsApp mostra
        quando a conversa vem de um anúncio. */}
    <g>
      <path d={balao(M1.x, M1.y, M1.w, M1.h, 'esq')} fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
      <rect x={M1.x + 4} y={M1.y + 4} width={M1.w - 8} height="42" rx="6" class="jornada__citacao" />
      <rect x={M1.x + 4} y={M1.y + 4} width="2.5" height="42" rx="1.25" class="jornada__citacao-fio" />
      <text x={M1.x + 16} y={M1.y + 21} class="jornada__citacao-titulo">Agende sua avaliação</text>
      <text x={M1.x + 16} y={M1.y + 37} class="jornada__secundario">Anúncio · Instagram</text>
      <g class="a-icone jornada__icone" transform={`translate(${M1.x + M1.w - 30} ${M1.y + 17}) scale(.6667)`}>
        <rect x="2" y="2" width="20" height="20" rx="5.5" />
        <circle cx="12" cy="12" r="4.2" />
        <path d="M17.5 6.5h.01" />
      </g>
      <text x={M1.x + 12} y={M1.y + 66} class="jornada__texto">Quero agendar uma avaliação</text>
      <text x={M1.x + M1.w - 10} y={M1.y + 66} text-anchor="end" class="jornada__hora">10:42</text>
    </g>

    {/* A resposta do comercial, com a hora e o visto duplo em cinza. */}
    <g class="jornada__resposta">
      <path d={balao(M2.x, M2.y, M2.w, M2.h, 'dir')} fill={`url(#${p}-enviada)`} stroke={`url(#${p}-fio)`} />
      <text x={M2.x + 12} y={M2.y + 23} class="jornada__texto">Claro! Quinta, às 14:00?</text>
      <text x={M2.x + M2.w - 28} y={M2.y + 23} text-anchor="end" class="jornada__hora">10:43</text>
      <path class="jornada__lido" d={`M${M2.x + M2.w - 24} ${M2.y + 19.5}l2.4 2.4l4.6-5.2M${M2.x + M2.w - 19} ${M2.y + 21.4}l.5.5l4.6-5.2`} />
    </g>

    {/* A consulta marcada: cartão que flutua, com a sombra, o fio amarelo
        no alto e o calendário com o visto amarelo. */}
    <g class="jornada__consulta">
      <rect x={C.x} y={C.y} width={C.w} height={C.h} rx="12" fill="#000000" filter={`url(#${p}-sombra)`} />
      <rect x={C.x} y={C.y} width={C.w} height={C.h} rx="12" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
      <rect x={C.x + 24} y={C.y - 0.25} width={C.w - 48} height="1.25" fill={`url(#${p}-fio-amarelo)`} class="jornada__fio" />
      <circle cx={IC.x} cy={IC.y} r="16" class="jornada__anel" />
      <rect x={C.x + 10} y={C.y + 10} width="32" height="32" rx="9" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />
      <g class="a-icone jornada__calendario" transform={`translate(${IC.x - 9} ${IC.y - 9}) scale(.75)`}>
        <path d="M8 2v4M16 2v4" />
        <rect x="3" y="4" width="18" height="18" rx="2" />
        <path d="M3 10h18" />
        <path class="jornada__visto" d="m9 16 2 2 4-4" pathLength="1" />
      </g>
      <text x={C.x + 54} y={C.y + 23} class="jornada__consulta-nome">Consulta agendada</text>
      <text x={C.x + 54} y={C.y + 38.5} class="jornada__quando">qui, 14:00</text>
    </g>
  </g>
</g>

<style>
  .jornada__nome { font-size: 13.5px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .jornada__secundario { font-size: 11px; fill: #8a8a85; letter-spacing: -.005em; }
  .jornada__logo { fill: #8a8a85; }
  .jornada__divisa { fill: #ffffff; fill-opacity: .06; }
  .jornada__citacao { fill: #ffffff; fill-opacity: .04; }
  .jornada__citacao-fio { fill: #8a8a85; }
  .jornada__citacao-titulo { font-size: 12.5px; font-weight: 500; fill: #d6d6d1; letter-spacing: -.005em; }
  .jornada .jornada__icone { stroke: #8a8a85; stroke-width: 2.1; }
  .jornada__texto { font-size: 13px; fill: #ecece8; letter-spacing: -.005em; }
  .jornada__hora { font-size: 10.5px; fill: #8a8a85; font-variant-numeric: tabular-nums; }
  .jornada__lido { fill: none; stroke: #8a8a85; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .jornada .jornada__calendario { stroke: #ecece8; stroke-width: 2.1; }
  .jornada .jornada__visto { stroke: var(--destaque, #FFD103); stroke-width: 2.6; stroke-dasharray: 1 2; stroke-dashoffset: 0; }
  .jornada__consulta-nome { font-size: 13px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .jornada__quando { font-size: 11px; fill: #8a8a85; font-variant-numeric: tabular-nums; }
  /* O anel só aparece no movimento; parado, fica apagado. */
  .jornada__anel { fill: none; stroke: var(--destaque, #FFD103); stroke-opacity: .45; stroke-width: 1; opacity: 0; }
  .jornada__consulta, .jornada__fio, .jornada__anel { transform-box: fill-box; transform-origin: center; }

  /* Movimento, em laço de 14 s (tempos do ciclo):
     0–0,6 s   repouso na pose final;
     0,6–1,2   a conversa some;
     1,4–2,4   a primeira mensagem aparece embaixo, subindo 8;
     4,2–5,2   a resposta chega e empurra a primeira para cima;
     7,0–8,0   o cartão da consulta sobe 10, com fade, e empurra as duas;
     7,7–8,8   o fio amarelo do alto se abre do centro;
     8,0–8,6   o visto amarelo se desenha;
     8,2–9,8   um anel fino se expande do calendário e se apaga.
     O resto (≈ 30% do ciclo) é repouso. O 0% de cada keyframe é a pose
     final. */
  .jornada__pilha, .jornada__resposta, .jornada__consulta, .jornada__fio, .jornada__visto, .jornada__anel {
    animation-duration: 14s; animation-delay: .4s; animation-iteration-count: infinite;
    animation-timing-function: var(--a-vai-vem); animation-fill-mode: both;
  }
  .jornada__pilha { animation-name: jornada-pilha; }
  .jornada__resposta { animation-name: jornada-resposta; }
  .jornada__consulta { animation-name: jornada-consulta; }
  .jornada__fio { animation-name: jornada-fio; }
  .jornada__visto { animation-name: jornada-visto; }
  .jornada__anel { animation-name: jornada-anel; animation-timing-function: var(--a-entra); }

  @keyframes jornada-pilha {
    0%, 4.29% { opacity: 1; transform: translateY(0); }
    8.57% { opacity: 0; transform: translateY(0); }
    8.58%, 10% { opacity: 0; transform: translateY(calc(var(--d2) + var(--d3) + 8px)); }
    17.14%, 30% { opacity: 1; transform: translateY(calc(var(--d2) + var(--d3))); }
    37.14%, 50% { opacity: 1; transform: translateY(var(--d3)); }
    57.14%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes jornada-resposta {
    0%, 8.57% { opacity: 1; transform: translateY(0); }
    8.58%, 30% { opacity: 0; transform: translateY(8px); }
    37.14%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes jornada-consulta {
    0%, 8.57% { opacity: 1; transform: translateY(0) scale(1); }
    8.58%, 50% { opacity: 0; transform: translateY(10px) scale(.98); }
    57.14%, 100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes jornada-fio {
    0%, 8.57% { transform: scaleX(1); }
    8.58%, 55% { transform: scaleX(0); }
    62.86%, 100% { transform: scaleX(1); }
  }
  @keyframes jornada-visto {
    0%, 8.57% { stroke-dashoffset: 0; }
    8.58%, 57.14% { stroke-dashoffset: 1; }
    61.43%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes jornada-anel {
    0%, 58.57% { opacity: 0; transform: scale(1); }
    60% { opacity: 1; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.7); }
  }
</style>
