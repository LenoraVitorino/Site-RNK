---
/**
 * Vamos além do tráfego pago: a jornada contada com os objetos dela, em
 * diagonal e sobrepostos. Atrás, o anúncio ("Agende sua avaliação", com o
 * botão "Enviar mensagem"); no meio, a conversa do comercial, que segue
 * além da borda de baixo; na frente, o cartão "Consulta agendada · qui,
 * 14:00". Um fio fino liga o anúncio à consulta. Em laço, a cena volta um
 * passo: o comercial digita, a resposta aparece, a consulta sobe, o fio se
 * fecha e o ponto amarelo acende. Pose estática = pose final; o movimento
 * só parte dela.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Anúncio (atrás): 144 × 168 em (24, 32), o mesmo alto das janelas dos
   outros pilares, com a foto de 92 e a faixa do botão. Conversa (plano
   principal): canto em (148, 76), 236 de largura, sai por baixo. Consulta
   (na frente): 204 × 52 em (96, 236), por cima da borda esquerda da
   conversa, embaixo da resposta que a gerou. */
const A = { x: 24, y: 32, w: 144, h: 168 };
const B = { x: 148, y: 76, w: 236 };
const C = { x: 96, y: 236, w: 204, h: 52 };
const FOTO = { y: 68, h: 92 };
/* Bolhas: raio 12, com o canto de quem fala em 4. */
const bolha = (x: number, y: number, w: number, h: number, lado: 'esq' | 'dir') => {
  const r = 12, q = 4;
  const [bl, br] = lado === 'esq' ? [q, r] : [r, q];
  return `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - br}A${br} ${br} 0 0 1 ${x + w - br} ${y + h}H${x + bl}A${bl} ${bl} 0 0 1 ${x} ${y + h - bl}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
};
const RECEBIDA = { x: B.x + 12, y: 132, w: 188, h: 32 };
const ENVIADA = { x: 222, y: 172, w: 150, h: 48 };
const DIGITA = { x: 316, y: 172, w: 56, h: 28 };
/* O fio sai da base do anúncio e entra na consulta pela esquerda. */
const FY = C.y + C.h / 2;
---
<g class="jornada">
  <defs>
    {/* Foto do anúncio: grafite, mais clara no alto à direita. */}
    <linearGradient id={`${p}-foto`} x1="1" y1="0" x2="0" y2="1">
      <stop stop-color="#353532" /><stop offset=".6" stop-color="#1d1d1c" /><stop offset="1" stop-color="#151515" />
    </linearGradient>
    <linearGradient id={`${p}-perfil`} x1=".8" y1="0" x2=".2" y2="1">
      <stop stop-color="#5a5a55" /><stop offset="1" stop-color="#232322" />
    </linearGradient>
    <linearGradient id={`${p}-bolha`} x1="0" y1="0" x2="0" y2="1">
      <stop stop-color="#2b2b2a" /><stop offset="1" stop-color="#222221" />
    </linearGradient>
  </defs>

  {/* Anúncio, no plano de trás, um pouco recuado. A foto de perfil da
      clínica é um disco em gradiente, como a imagem de uma página. */}
  <g class="jornada__anuncio" opacity=".88">
    <rect x={A.x} y={A.y} width={A.w} height={A.h} rx="12" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
    <circle cx="41" cy="50" r="8.5" fill={`url(#${p}-perfil)`} class="jornada__marca-borda" />
    <text x="56" y="47.5" class="jornada__marca">Sua clínica</text>
    <text x="56" y="60.5" class="jornada__secundario">Patrocinado</text>
    <rect x={A.x + 0.5} y={FOTO.y} width={A.w - 1} height={FOTO.h} fill={`url(#${p}-foto)`} />
    <text x="36" y="128" class="jornada__chamada">Agende sua</text>
    <text x="36" y="146" class="jornada__chamada">avaliação</text>
    {/* Faixa do botão, como nos anúncios de verdade: logo abaixo da foto. */}
    <path d={`M${A.x + 0.5} ${FOTO.y + FOTO.h}H${A.x + A.w - 0.5}V${A.y + A.h - 12}a11.5 11.5 0 0 1 -11.5 11.5H${A.x + 12}a11.5 11.5 0 0 1 -11.5 -11.5Z`} class="jornada__faixa" />
    <text x="36" y="184.5" class="jornada__botao">Enviar mensagem</text>
  </g>

  {/* Fio da jornada: da base do anúncio até a consulta. */}
  <path class="jornada__fio" d={`M40.5 ${A.y + A.h}V${FY - 10}a10 10 0 0 0 10 10H${C.x}`} pathLength="1" />
  <circle class="jornada__anel" cx="40.5" cy={A.y + A.h} r="3.5" />
  <circle class="jornada__miolo" cx="40.5" cy={A.y + A.h} r="1.25" />

  {/* Conversa do comercial: o plano principal. */}
  <rect x={B.x} y={B.y} width={B.w} height="300" rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x={B.x + 16} y={B.y + 0.5} width="180" height="1" fill={`url(#${p}-fio-h)`} />
  <circle cx={B.x + 24} cy="98" r="11" class="jornada__avatar" />
  <circle cx={B.x + 24} cy="95" r="3.2" class="jornada__silhueta" />
  <path d={`M${B.x + 17.5} 105.5a6.5 6.5 0 0 1 13 0`} class="jornada__silhueta" />
  <text x={B.x + 42} y="95" class="jornada__titulo">Nova conversa</text>
  <text x={B.x + 42} y="109.5" class="jornada__secundario">via anúncio</text>
  <rect x={B.x} y="120" width={B.w} height="1" class="jornada__divisa" />

  <path d={bolha(RECEBIDA.x, RECEBIDA.y, RECEBIDA.w, RECEBIDA.h, 'esq')} class="jornada__recebida" />
  <text x={RECEBIDA.x + 12} y={RECEBIDA.y + 20.5} class="jornada__texto">Vi o anúncio, quero agendar</text>

  {/* "Digitando": três pontos que só mudam de opacidade. */}
  <g class="jornada__digita">
    <path d={bolha(DIGITA.x, DIGITA.y, DIGITA.w, DIGITA.h, 'dir')} class="jornada__recebida" />
    <circle cx="332" cy="186" r="2.2" class="jornada__ponto jornada__ponto--1" />
    <circle cx="344" cy="186" r="2.2" class="jornada__ponto jornada__ponto--2" />
    <circle cx="356" cy="186" r="2.2" class="jornada__ponto jornada__ponto--3" />
  </g>

  <g class="jornada__enviada">
    <path d={bolha(ENVIADA.x, ENVIADA.y, ENVIADA.w, ENVIADA.h, 'dir')} fill={`url(#${p}-bolha)`} stroke={`url(#${p}-fio)`} />
    <text x={ENVIADA.x + 12} y={ENVIADA.y + 19} class="jornada__texto jornada__texto--enviada">Temos quinta às 14h.</text>
    <text x={ENVIADA.x + 12} y={ENVIADA.y + 36} class="jornada__texto jornada__texto--enviada">Confirmo?</text>
    <text x="344" y={ENVIADA.y + 36} text-anchor="end" class="jornada__hora">09:14</text>
    <path d="M347.5 204.5l2.2 2.2l4.3-4.8M352.5 206.2l0.5 0.5l4.3-4.8" class="jornada__lido" />
  </g>

  {/* Consulta agendada, na frente, com a sombra e a ponta do fio. */}
  <g class="jornada__consulta">
    <rect x={C.x} y={C.y} width={C.w} height={C.h} rx="10" fill="#000000" filter={`url(#${p}-sombra)`} />
    <rect x={C.x} y={C.y} width={C.w} height={C.h} rx="10" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
    <rect x={C.x + 20} y={C.y + 0.5} width={C.w - 40} height="1" fill={`url(#${p}-fio-h)`} />
    <rect x={C.x + 12} y={C.y + 12} width="28" height="28" rx="8" fill={`url(#${p}-poco)`} stroke={`url(#${p}-borda-poco)`} />
    <g class="a-icone jornada__icone" transform={`translate(${C.x + 19} ${C.y + 19}) scale(.5833)`}>
      <path d="M8 2v4M16 2v4" />
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <path d="M3 10h18" />
    </g>
    <text x={C.x + 52} y={C.y + 23} class="jornada__consulta-nome">Consulta agendada</text>
    <text x={C.x + 52} y={C.y + 38} class="jornada__hora">qui, 14:00</text>
    <circle cx={C.x + C.w - 18} cy={FY} r="3" class="jornada__apagado" />
    <circle class="jornada__anel" cx={C.x} cy={FY} r="3.5" />
    <circle class="jornada__miolo" cx={C.x} cy={FY} r="1.25" />
  </g>
  <circle cx={C.x + C.w - 18} cy={FY} r="3" class="a-destaque jornada__acende" />
</g>

<style>
  .jornada__marca { font-size: 12px; font-weight: 500; fill: #d6d6d1; letter-spacing: -.005em; }
  .jornada__marca-borda { stroke: #ffffff; stroke-opacity: .12; }
  .jornada__secundario { font-size: 11px; fill: #8a8a85; }
  .jornada__faixa { fill: #ffffff; fill-opacity: .035; }
  .jornada__chamada { font-size: 15px; font-weight: 300; fill: #ecece8; letter-spacing: -.02em; }
  .jornada__botao { font-size: 12px; font-weight: 500; fill: #d6d6d1; letter-spacing: -.005em; }
  .jornada__titulo { font-size: 13.5px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .jornada__avatar { fill: #262626; stroke: #ffffff; stroke-opacity: .1; }
  .jornada__silhueta { fill: none; stroke: #8a8a85; stroke-width: 1.2; stroke-linecap: round; }
  .jornada__divisa { fill: #ffffff; fill-opacity: .06; }
  .jornada__recebida { fill: #ffffff; fill-opacity: .045; stroke: #ffffff; stroke-opacity: .08; }
  .jornada__texto { font-size: 12.5px; fill: #b9b9b4; letter-spacing: -.005em; }
  .jornada__texto--enviada { fill: #ecece8; }
  .jornada__hora { font-size: 11px; fill: #8a8a85; font-variant-numeric: tabular-nums; }
  .jornada__lido { fill: none; stroke: #8a8a85; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .jornada__ponto { fill: #8a8a85; }
  .jornada__digita { opacity: 0; }
  .jornada .jornada__icone { stroke: #ecece8; stroke-width: 2.4; }
  .jornada__consulta-nome { font-size: 13px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .jornada__fio { fill: none; stroke: #ffffff; stroke-opacity: .18; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .jornada__anel { fill: #0e0e0e; stroke: #ffffff; stroke-opacity: .3; }
  .jornada__miolo { fill: #d6d6d1; }
  .jornada__apagado { fill: #3a3a38; }

  /* Movimento, em laço de 12 s (tempos do ciclo):
     0–0,6 s   repouso na pose final;
     0,6–1,0   a cena volta um passo: somem a resposta, a consulta, o fio
               e o ponto amarelo;
     1,1–1,4   o comercial começa a digitar (três pontos em opacidade);
     2,9–3,5   os pontos saem e a resposta aparece, subindo 4;
     3,9–4,7   a consulta sobe 8, com fade;
     4,5–5,2   o fio se fecha do anúncio até ela;
     5,1–5,6   o ponto amarelo acende.
     O resto (≈ 58% do ciclo) é repouso. O 0% de cada keyframe é a pose
     final. */
  .jornada__digita, .jornada__ponto, .jornada__enviada, .jornada__consulta,
  .jornada__fio, .jornada__acende {
    animation-duration: 12s; animation-delay: .4s; animation-iteration-count: infinite;
    animation-timing-function: var(--a-vai-vem); animation-fill-mode: both;
  }
  .jornada__digita { animation-name: jornada-digita; }
  .jornada__ponto--1 { animation-name: jornada-ponto-1; }
  .jornada__ponto--2 { animation-name: jornada-ponto-2; }
  .jornada__ponto--3 { animation-name: jornada-ponto-3; }
  .jornada__enviada { animation-name: jornada-enviada; }
  .jornada__consulta { animation-name: jornada-consulta; }
  .jornada__fio { animation-name: jornada-fio; }
  .jornada__acende { animation-name: jornada-acende; }

  @keyframes jornada-digita {
    0%, 9.17% { opacity: 0; }
    11.67%, 24.17% { opacity: 1; }
    26.67%, 100% { opacity: 0; }
  }
  @keyframes jornada-ponto-1 {
    0%, 11.67% { opacity: .3; }
    13.33% { opacity: 1; }
    16.67% { opacity: .3; }
    20% { opacity: 1; }
    23.33%, 100% { opacity: .3; }
  }
  @keyframes jornada-ponto-2 {
    0%, 13.33% { opacity: .3; }
    15% { opacity: 1; }
    18.33% { opacity: .3; }
    21.67% { opacity: 1; }
    25%, 100% { opacity: .3; }
  }
  @keyframes jornada-ponto-3 {
    0%, 15% { opacity: .3; }
    16.67% { opacity: 1; }
    20% { opacity: .3; }
    23.33% { opacity: 1; }
    26.67%, 100% { opacity: .3; }
  }
  @keyframes jornada-enviada {
    0%, 5% { opacity: 1; transform: translateY(0); }
    8.33%, 25% { opacity: 0; transform: translateY(4px); }
    29.17%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes jornada-consulta {
    0%, 5% { opacity: 1; transform: translateY(0); }
    8.33%, 32.5% { opacity: 0; transform: translateY(8px); }
    39.17%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes jornada-fio {
    0%, 5% { opacity: 1; stroke-dashoffset: 0; }
    8.33% { opacity: 0; stroke-dashoffset: 0; }
    8.34%, 37.5% { opacity: 1; stroke-dashoffset: 1; }
    43.33%, 100% { opacity: 1; stroke-dashoffset: 0; }
  }
  @keyframes jornada-acende {
    0%, 5% { opacity: 1; }
    8.33%, 42.5% { opacity: 0; }
    46.67%, 100% { opacity: 1; }
  }
</style>
