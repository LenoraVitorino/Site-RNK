---
/**
 * Construímos seu posicionamento: a análise de concorrência, como uma
 * tabela de verdade. Três clínicas da região (anônimas), com o que cada uma
 * comunica e onde investe. As mensagens delas estão grifadas juntas, com a
 * nota "Todos falam de preço"; logo abaixo, a linha hachurada da brecha,
 * "Ninguém fala de resultado". Sobre ela, a tese da clínica, com o ponto
 * amarelo. Na entrada, as linhas aparecem em cascata, o grifo se desenha, a
 * brecha aparece e a tese sobe. Pose estática = pose final; o movimento só
 * parte dela.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Janela: canto em (96, 28), segue além do viewBox pela direita e por
   baixo. Cabeçalho de 44. Conteúdo a 24 da borda (x 120), dentro da área
   segura do celular (x 80 a 560). */
const WX = 96, WY = 28;
/* Colunas: "Concorrente", "Comunica" e "Investe em". Linhas de 40 a
   partir de y 112. Pílulas de 24 (raio 12), largura = texto medido em
   Inter 13 / 500 mais 12 de cada lado. A coluna "Investe em" começa no
   mesmo eixo do cartão da tese (x 396). */
const C0 = 120, C1 = 216, C2 = 396;
const L0 = 112, LH = 40;
const largura: Record<string, number> = {
  'Preço baixo': 72.5, Pacotes: 49.5, 'Promoção': 62.7, Instagram: 61.6, Google: 44,
};
const pilula = (t: string) => Math.round(largura[t] + 24);
const linhas = [
  { nome: 'Clínica A', fala: 'Preço baixo', canal: 'Instagram' },
  { nome: 'Clínica B', fala: 'Pacotes', canal: 'Google' },
  { nome: 'Clínica C', fala: 'Promoção', canal: 'Instagram' },
];
const centro = (i: number) => L0 + LH * i + LH / 2;
/* Grifo: um contorno só em volta das três mensagens, a 5 das pílulas
   (raio concêntrico 17). */
const G = { x: C1 - 5, y: centro(0) - 17, w: pilula('Preço baixo') + 10, h: centro(2) - centro(0) + 34 };
/* Desenhado como path (e não rect) para o pathLength valer em todo
   navegador; começa no alto, à esquerda, e corre no sentido horário. */
const grifo = (() => {
  const x = G.x + 0.5, y = G.y + 0.5, w = G.w - 1, h = G.h - 1, r = 16.5;
  return `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;
})();
/* Brecha: a linha que falta na tabela, hachurada e tracejada. */
const B = { x: 108, y: 270, w: 420, h: 40 };
/* Tese: o cartão pousado sobre o fim da brecha, centrado na altura dela
   (o alto dele na linha de base de "Todos falam de preço"), no eixo da
   coluna "Investe em" e a 16 da borda da área segura. */
const T = { x: C2, y: 248, w: 148, h: 84 };
---
<g class="posicionamento">
  <defs>
    {/* Hachura da brecha (a mesma do espaço aberto do Mercado), vazada em
        volta dos textos. */}
    <pattern id={`${p}-hachura`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width=".8" height="6" fill="#ffffff" fill-opacity=".08" />
    </pattern>
    <mask id={`${p}-vazado`} maskUnits="userSpaceOnUse" x="0" y="0" width="640" height="360">
      <rect width="640" height="360" fill="#ffffff" />
      <rect x={C0 - 4} y={B.y + 9} width="52" height="22" rx="4" fill="#000000" />
      <rect x={C1 - 4} y={B.y + 9} width="170" height="22" rx="4" fill="#000000" />
    </mask>
  </defs>

  {/* Janela do produto, recortada pela borda. */}
  <rect x={WX} y={WY} width="600" height="400" rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x={WX + 16} y={WY + 0.5} width="400" height="1" fill={`url(#${p}-fio-h)`} />
  <text x={C0} y="55" class="posicionamento__trilha">Posicionamento</text>
  <text x="225" y="55" class="posicionamento__barra">/</text>
  <text x="237" y="55" class="posicionamento__titulo">Análise de concorrência</text>
  <text x={T.x + T.w} y="55" text-anchor="end" class="posicionamento__quando">Atualizada hoje</text>
  <rect x={WX} y={WY + 44} width="600" height="1" class="posicionamento__divisa" />

  {/* Cabeçalho da tabela. */}
  <text x={C0} y="96.5" class="posicionamento__coluna">Concorrente</text>
  <text x={C1} y="96.5" class="posicionamento__coluna">Comunica</text>
  <text x={C2} y="96.5" class="posicionamento__coluna">Investe em</text>
  <rect x={WX} y={L0} width="600" height="1" class="posicionamento__divisa" />

  {/* Concorrentes. */}
  {linhas.map(({ nome, fala, canal }, i) => {
    const c = centro(i);
    return (
      <g class="posicionamento__linha" style={`--i:${i}`}>
        {i > 0 && <rect x={WX} y={L0 + LH * i} width="600" height="1" class="posicionamento__divisa posicionamento__divisa--fina" />}
        <text x={C0} y={c + 4.8} class="posicionamento__nome">{nome}</text>
        <rect x={C1} y={c - 12} width={pilula(fala)} height="24" rx="12" class="posicionamento__pilula" />
        <text x={C1 + pilula(fala) / 2} y={c + 4.5} text-anchor="middle" class="posicionamento__pilula-texto">{fala}</text>
        {/* O canal é contexto: fica um tom abaixo das mensagens. */}
        <rect x={C2} y={c - 12} width={pilula(canal)} height="24" rx="12" class="posicionamento__pilula posicionamento__pilula--canal" />
        <text x={C2 + pilula(canal) / 2} y={c + 4.5} text-anchor="middle" class="posicionamento__pilula-texto posicionamento__pilula-texto--canal">{canal}</text>
      </g>
    );
  })}

  {/* O padrão: as três mensagens grifadas juntas. */}
  <path d={grifo} pathLength="1" class="posicionamento__grifo" />
  <text x={C1} y={T.y} class="posicionamento__nota">Todos falam de preço</text>

  {/* A brecha. */}
  <g class="posicionamento__brecha">
    <rect x={B.x} y={B.y} width={B.w} height={B.h} rx="10" fill={`url(#${p}-hachura)`} mask={`url(#${p}-vazado)`} />
    <rect x={B.x + 0.5} y={B.y + 0.5} width={B.w - 1} height={B.h - 1} rx="10" class="posicionamento__brecha-borda" />
    <text x={C0} y={B.y + 24.5} class="posicionamento__brecha-nome">Brecha</text>
    <text x={C1} y={B.y + 24.8} class="posicionamento__brecha-frase">Ninguém fala de resultado</text>
  </g>

  {/* A tese, sobre a brecha. */}
  <g class="posicionamento__tese">
    <rect x={T.x} y={T.y} width={T.w} height={T.h} rx="10" fill="#000000" filter={`url(#${p}-sombra)`} />
    <rect x={T.x} y={T.y} width={T.w} height={T.h} rx="10" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
    <rect x={T.x + 20} y={T.y + 0.5} width={T.w - 40} height="1" fill={`url(#${p}-fio-h)`} />
    <circle cx={T.x + 18} cy={T.y + 21.5} r="3" class="a-destaque posicionamento__ponto" />
    <text x={T.x + 28} y={T.y + 26} class="posicionamento__tese-nome">Sua tese</text>
    <text x={T.x + 14} y={T.y + 52} class="posicionamento__tese-frase">Referência em</text>
    <text x={T.x + 14} y={T.y + 72} class="posicionamento__tese-frase">resultado natural</text>
  </g>
</g>

<style>
  /* Corpos pensados para o cartão largo recortado no celular. */
  .posicionamento__trilha { font-size: 13px; fill: #8a8a85; letter-spacing: -.005em; }
  .posicionamento__barra { font-size: 13px; fill: #4d4d49; }
  .posicionamento__titulo { font-size: 13.5px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }
  .posicionamento__quando { font-size: 11.5px; fill: #8a8a85; font-variant-numeric: tabular-nums; }
  .posicionamento__divisa { fill: #ffffff; fill-opacity: .06; }
  .posicionamento__divisa--fina { fill-opacity: .04; }
  /* Hierarquia: o que cada clínica comunica é o assunto (pílulas claras,
     grifadas); nomes e canais ficam um tom abaixo. */
  .posicionamento__coluna { font-size: 12.5px; font-weight: 500; fill: #8a8a85; letter-spacing: -.005em; }
  .posicionamento__nome { font-size: 13px; font-weight: 500; fill: #b9b9b4; letter-spacing: -.005em; }
  .posicionamento__pilula { fill: #ffffff; fill-opacity: .05; stroke: #ffffff; stroke-opacity: .09; }
  .posicionamento__pilula--canal { fill-opacity: .03; stroke-opacity: .06; }
  .posicionamento__pilula-texto { font-size: 13px; font-weight: 500; fill: #d6d6d1; letter-spacing: -.005em; }
  .posicionamento__pilula-texto--canal { fill: #8a8a85; }
  .posicionamento__grifo { fill: none; stroke: #ecece8; stroke-opacity: .5; stroke-dasharray: 1 2; stroke-dashoffset: 0; }
  .posicionamento__nota { font-size: 13px; font-weight: 500; fill: #d6d6d1; letter-spacing: -.005em; }
  .posicionamento__brecha-borda { fill: none; stroke: #ffffff; stroke-opacity: .3; stroke-dasharray: 3 3; }
  .posicionamento__brecha-nome { font-size: 13px; font-weight: 500; fill: #8a8a85; letter-spacing: -.005em; }
  .posicionamento__brecha-frase { font-size: 13px; font-weight: 500; fill: #ecece8; letter-spacing: -.005em; }
  .posicionamento__tese-nome { font-size: 12.5px; font-weight: 500; fill: #8a8a85; letter-spacing: -.005em; }
  .posicionamento__tese-frase { font-size: 15px; font-weight: 500; fill: #ecece8; letter-spacing: -.01em; }

  /* Movimento, uma vez, na entrada:
     0,3–1,6 s  as três linhas de concorrentes aparecem em cascata (fade e
                4 de subida);
     1,7–2,6    o grifo se desenha em volta das mensagens;
     2,4–3,0    a nota "Todos falam de preço" aparece;
     2,9–3,8    a brecha aparece;
     3,7–4,7    a tese sobe 8 com fade;
     4,4–4,9    o ponto amarelo acende.
     Depois, nada se move. */
  .posicionamento__linha { animation: posicionamento-surge 1s var(--a-entra) calc(.3s + var(--i) * .16s) both; }
  .posicionamento__grifo { animation: posicionamento-desenha .9s var(--a-vai-vem) 1.7s both; }
  .posicionamento__nota { animation: posicionamento-aparece .6s var(--a-entra) 2.4s both; }
  .posicionamento__brecha { animation: posicionamento-aparece .9s var(--a-entra) 2.9s both; }
  .posicionamento__tese { animation: posicionamento-sobe 1s var(--a-entra) 3.7s both; }
  .posicionamento__ponto { animation: posicionamento-aparece .5s var(--a-entra) 4.4s both; }
  @keyframes posicionamento-surge { from { opacity: 0; transform: translateY(4px); } }
  @keyframes posicionamento-desenha { from { stroke-dashoffset: 1; } }
  @keyframes posicionamento-aparece { from { opacity: 0; } }
  @keyframes posicionamento-sobe { from { opacity: 0; transform: translateY(8px); } }
</style>
