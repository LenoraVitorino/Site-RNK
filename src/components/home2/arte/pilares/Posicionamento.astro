---
/**
 * Construímos seu posicionamento: o estudo de concorrência como uma tabela
 * limpa, no molde do relatório de setembro (Lenora, 29/09: sem produto nem
 * serviço, minimalista, "igual os de cima"). A página "Concorrência" segue
 * além da borda direita e da de baixo. Nas linhas, o que o mercado
 * comunica (Preço baixo, Promoção, Parcelamento, Resultado natural); nas
 * colunas, três clínicas da região, anônimas (A, B e C), com um ponto onde
 * cada uma fala daquilo. Todas se amontoam em preço, e a linha "Resultado
 * natural" fica vazia: a brecha. Por cima da tabela, a coluna "Sua
 * clínica", o único elemento que flutua, com um ponto só, amarelo, na
 * linha vazia. Na entrada, os pontos aparecem coluna a coluna, a coluna da
 * clínica sobe e o ponto amarelo acende. Pose estática = pose final.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Página: canto em (104, 32), como a do relatório, sangrando pela direita
   e por baixo. Conteúdo de x 128 a 544, 16 dentro da área segura do celular
   (x 80 a 560). */
const PX = 104, PY = 32;
/* Tabela: cabeçalho centrado em y 140; linhas a cada 36, com o centro da
   primeira em 180. Colunas das concorrentes a cada 44, a partir de 318. A
   coluna da clínica é um cartão de 88 centrado em 500. */
const HY = 140, L0 = 180, LH = 36;
const colunas = [
  { nome: 'A', x: 318 },
  { nome: 'B', x: 362 },
  { nome: 'C', x: 406 },
];
const linhas = [
  { tema: 'Preço baixo', quem: ['A', 'B', 'C'] },
  { tema: 'Promoção', quem: ['A', 'C'] },
  { tema: 'Parcelamento', quem: ['A', 'B'] },
  { tema: 'Resultado natural', quem: [], brecha: true },
].map((l, i) => ({ ...l, y: L0 + i * LH }));
const S = { x: 456, y: 116, w: 88, cx: 500 };
const SH = linhas[linhas.length - 1].y + 24 - S.y;
const BY = linhas[linhas.length - 1].y;
---
<g class="posicionamento">
  {/* Página. */}
  <rect x={PX} y={PY} width="600" height="400" rx="16" fill={`url(#${p}-sup)`} stroke={`url(#${p}-fio)`} />
  <rect x={PX + 16} y={PY + 0.5} width="420" height="1" fill={`url(#${p}-fio-h)`} />
  <text x="128" y="84" class="posicionamento__titulo">Concorrência</text>
  <text x={S.x + S.w} y="84" text-anchor="end" class="posicionamento__meta">Anúncios ativos</text>
  <rect x={PX} y="108" width="600" height="1" class="posicionamento__divisa" />

  {/* A linha vazia, um tom acima do fundo: a brecha. */}
  <rect x={PX + 0.5} y={BY - LH / 2} width="599" height={LH} class="posicionamento__faixa" />

  {/* Cabeçalho: o que comunicam e as três concorrentes. */}
  <text x="128" y={HY + 4} class="posicionamento__meta">O que comunicam</text>
  {colunas.map(({ nome, x }) => (
    <g>
      <circle cx={x} cy={HY} r="11" class="posicionamento__avatar" />
      <text x={x} y={HY + 4} text-anchor="middle" class="posicionamento__inicial">{nome}</text>
    </g>
  ))}

  {/* Linhas. */}
  {linhas.map(({ tema, quem, brecha, y }) => (
    <g>
      <rect x="128" y={y - LH / 2} width={S.x - 128} height="1" class="posicionamento__divisa" />
      <text x="128" y={y + 4.5} class:list={['posicionamento__tema', { 'posicionamento__tema--brecha': brecha }]}>{tema}</text>
      {colunas.map(({ nome, x }, c) => quem.includes(nome)
        ? <circle cx={x} cy={y} r="3.5" class="posicionamento__ponto" style={`--c:${c}`} />
        : <rect x={x - 4} y={y - 0.5} width="8" height="1" class="posicionamento__vazio" />)}
    </g>
  ))}
  <rect x="128" y={BY + LH / 2} width={S.x - 128} height="1" class="posicionamento__divisa" />

  {/* A coluna da clínica, por cima da tabela. */}
  <g class="posicionamento__sua">
    <rect x={S.x} y={S.y} width={S.w} height={SH} rx="12" fill="#000000" filter={`url(#${p}-sombra)`} />
    <rect x={S.x} y={S.y} width={S.w} height={SH} rx="12" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
    <rect x={S.x + 14} y={S.y + 0.5} width={S.w - 28} height="1" fill={`url(#${p}-fio-h)`} />
    <text x={S.cx} y={HY + 4} text-anchor="middle" class="posicionamento__sua-nome">Sua clínica</text>
    {linhas.map(({ brecha, y }) => brecha
      ? <circle cx={S.cx} cy={y} r="4" class="a-destaque posicionamento__acende" />
      : <rect x={S.cx - 4} y={y - 0.5} width="8" height="1" class="posicionamento__vazio" />)}
  </g>
</g>

<style>
  /* Corpos pensados para o cartão largo recortado no celular (escala ≈ .68):
     rótulos em 13 e secundários em 11,5. */
  .posicionamento__titulo { font-size: 32px; font-weight: 300; fill: #efefeb; letter-spacing: -.03em; }
  .posicionamento__meta { font-size: 11.5px; fill: #8a8a85; letter-spacing: -.005em; }
  .posicionamento__divisa { fill: #ffffff; fill-opacity: .06; }
  .posicionamento__faixa { fill: #ffffff; fill-opacity: .02; }
  .posicionamento__avatar { fill: #262626; stroke: #ffffff; stroke-opacity: .1; }
  .posicionamento__inicial { font-size: 11px; font-weight: 500; fill: #8a8a85; }
  .posicionamento__tema { font-size: 13px; fill: #b9b9b4; letter-spacing: -.005em; }
  .posicionamento__tema--brecha { font-weight: 500; fill: #ecece8; }
  .posicionamento__ponto { fill: #b9b9b4; }
  .posicionamento__vazio { fill: #ffffff; fill-opacity: .14; }
  .posicionamento__sua-nome { font-size: 12.5px; font-weight: 500; fill: #ecece8; letter-spacing: -.005em; }

  /* Movimento, uma vez, na entrada:
     0,4–1,6 s  os pontos das concorrentes aparecem, coluna a coluna;
     1,6–2,6    a coluna da clínica sobe 8, com fade;
     2,6–3,2    o ponto amarelo acende na linha vazia.
     Depois, nada se move. */
  .posicionamento__ponto { animation: posicionamento-aparece .6s var(--a-entra) calc(.4s + var(--c) * .3s) both; }
  .posicionamento__sua { animation: posicionamento-sobe 1s var(--a-entra) 1.6s both; }
  .posicionamento__acende { animation: posicionamento-aparece .6s var(--a-entra) 2.6s both; }
  @keyframes posicionamento-aparece { from { opacity: 0; } }
  @keyframes posicionamento-sobe { from { opacity: 0; transform: translateY(8px); } }
</style>
