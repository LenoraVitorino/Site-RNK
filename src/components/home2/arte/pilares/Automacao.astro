---
/**
 * Automatizamos o seu atendimento (01/10/2026, refeita): o lembrete da
 * consulta acabou de sair sozinho. Em cima, a mensagem enviada, num cartão
 * flutuante; embaixo, a sequência em pílulas ligadas por um fio: a
 * confirmação já saiu, o lembrete é a etapa atual e a pesquisa espera a
 * vez, um tom abaixo. O fio é contínuo até a etapa atual e tracejado depois
 * dela, e segue além da pesquisa até se apagar: a sequência continua.
 * Especificação em docs/04-design/protocolo-ilustracoes-prompts.md.
 *
 * A cena ocupa x 24 a 372 e y 4 a 130 do viewBox de 400 × 300, e não se
 * move: o bento já tem o gesto do CRM. O amarelo fica no visto duplo da
 * mensagem e no ponto da etapa atual.
 */
interface Props { p: string }
const { p } = Astro.props;

/* Mensagem: 348 × 80 a partir de (24, 4). */
const M = { x: 24, y: 4, w: 348, h: 80 };
const DIR = M.x + M.w - 16;
/* Sequência: pílulas de 30 em y 100, com vão de 16. Largura do nome em
   Inter 12 / 450 (medida no navegador); 28 antes do nome e 13 depois. */
const PY = 100, PH = 30, VAO = 16;
const etapas = [
  { nome: 'Confirmação', t: 73, estado: 'feita' },
  { nome: 'Lembrete', t: 53.5, estado: 'atual' },
  { nome: 'Pesquisa', t: 51, estado: 'depois' },
];
let px = M.x;
const pilulas = etapas.map((e) => { const w = Math.round(28 + e.t + 13); const x = px; px += w + VAO; return { ...e, x, w }; });
const atual = pilulas[1];
const CY = PY + PH / 2;
const AX = atual.x + atual.w / 2;
---
<g class="automacao">
  <defs>
    {/* O fio se apaga antes da borda do cartão: a sequência continua. */}
    <linearGradient id={`${p}-apaga`} gradientUnits="userSpaceOnUse" x1="360" y1="0" x2="400" y2="0">
      <stop stop-color="#ffffff" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <mask id={`${p}-borda`} maskUnits="userSpaceOnUse" x="0" y="86" width="600" height="60">
      <rect x="0" y="86" width="600" height="60" fill={`url(#${p}-apaga)`} />
    </mask>
    <radialGradient id={`${p}-luz`} gradientUnits="userSpaceOnUse" cx="90" cy="4" r="240">
      <stop stop-color="#ffffff" stop-opacity=".07" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`${p}-halo`}>
      <stop stop-color="#FFD103" stop-opacity=".3" /><stop offset="1" stop-color="#FFD103" stop-opacity="0" />
    </radialGradient>
  </defs>

  {/* Sequência: o fio por trás e as pílulas por cima. */}
  <g mask={`url(#${p}-borda)`}>
    <path d={`M${pilulas[0].x + pilulas[0].w} ${CY}H${atual.x}`} class="automacao__fio" />
    <path d={`M${atual.x + atual.w} ${CY}H404`} class="automacao__fio automacao__fio--depois" />
    {pilulas.map(({ nome, estado, x, w }) => (
      <g class={`automacao__etapa automacao__etapa--${estado}`}>
        <rect x={x} y={PY} width={w} height={PH} rx={PH / 2} fill={`url(#${p}-${estado === 'atual' ? 'alto' : 'sup'})`} stroke={`url(#${p}-fio)`} />
        {estado === 'feita' && <path d={`M${x + 12} ${CY + 0.3}l2.4 2.4l4.6-5`} class="automacao__feito" />}
        {estado === 'atual' && <>
          <circle cx={x + 16} cy={CY} r="10" fill={`url(#${p}-halo)`} />
          <circle cx={x + 16} cy={CY} r="2.8" class="a-destaque" />
        </>}
        {estado === 'depois' && <circle cx={x + 16} cy={CY} r="2.8" class="automacao__espera" />}
        <text x={x + 28} y={CY + 4.2} class="automacao__nome">{nome}</text>
      </g>
    ))}
  </g>

  {/* A mensagem sai da etapa atual. */}
  <path d={`M${AX} ${M.y + M.h}V${PY}`} class="automacao__haste" />
  <circle cx={AX} cy={PY} r="2.2" class="automacao__haste-ponta" />

  {/* Mensagem enviada, flutuando sobre a cena. */}
  <rect x={M.x} y={M.y + 4} width={M.w} height={M.h} rx="14" fill="#000000" filter={`url(#${p}-sombra)`} opacity=".8" />
  <rect x={M.x} y={M.y} width={M.w} height={M.h} rx="14" fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
  <rect x={M.x} y={M.y} width={M.w} height={M.h} rx="14" fill={`url(#${p}-luz)`} />
  <rect x={M.x + 24} y={M.y + 0.5} width={M.w - 48} height="1" fill={`url(#${p}-fio-h)`} />
  <path class="a-icone automacao__icone" transform={`translate(${M.x + 16} ${M.y + 12}) scale(.625)`} d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" />
  <text x={M.x + 39} y={M.y + 24}><tspan class="automacao__titulo">Lembrete</tspan><tspan dx="8" class="automacao__canal">WhatsApp</tspan></text>
  <text x={DIR} y={M.y + 24} text-anchor="end" class="automacao__quando">agora</text>
  <text x={M.x + 16} y={M.y + 47} class="automacao__texto">Sua avaliação facial é amanhã, às 14:00.</text>
  <text x={M.x + 16} y={M.y + 64} class="automacao__texto">Podemos confirmar a sua presença?</text>
  {/* Visto duplo: entregue e lido. O detalhe de cor da mensagem. */}
  <path d={`M${DIR - 12.6} ${M.y + 60.5}l2.4 2.4l4.6-5.2M${DIR - 7.6} ${M.y + 62.4}l.5.5l4.6-5.2`} class="a-destaque-traco automacao__visto" />
</g>

<style>
  .automacao__titulo { font-size: 12.5px; font-weight: 500; fill: #f2f2ee; letter-spacing: -.01em; }
  .automacao__canal { font-size: 11.5px; fill: #8a8a85; }
  .automacao__quando { font-size: 11px; fill: #8a8a85; }
  .automacao__texto { font-size: 12px; fill: #c9c9c4; letter-spacing: -.005em; }
  .automacao .automacao__icone { stroke: #b9b9b4; stroke-width: 2.2; }
  .automacao .automacao__visto { stroke-width: 1.4; }

  .automacao__fio { stroke: #ffffff; stroke-opacity: .26; }
  .automacao__fio--depois { stroke-opacity: .18; stroke-dasharray: 2 4; }
  .automacao__haste { stroke: #ffffff; stroke-opacity: .26; }
  .automacao__haste-ponta { fill: #d6d6d1; }

  .automacao__nome { font-size: 12px; font-weight: 450; fill: #b9b9b4; letter-spacing: -.005em; }
  .automacao__etapa--atual .automacao__nome { fill: #f2f2ee; }
  .automacao__etapa--depois .automacao__nome { fill: #8a8a85; }
  .automacao__feito { stroke: #8a8a85; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .automacao__espera { stroke: #ffffff; stroke-opacity: .3; }
</style>
