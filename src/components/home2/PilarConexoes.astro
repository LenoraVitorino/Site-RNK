---
/**
 * Vamos além do tráfego pago (01/10/2026): o subtítulo desenhado. O lead
 * entra pelo marketing (à esquerda), passa pela Renke (o núcleo) e sai no
 * comercial (à direita) como consulta marcada. Um caminho só fica aceso:
 * Anúncios → Renke → Consulta, e a Consulta leva o visto amarelo.
 * Especificação em docs/04-design/protocolo-ilustracoes-prompts.md.
 *
 * Duas cenas com os mesmos dados: a larga (620 × 268), a partir de 600px,
 * e a alta (320 × 326), no celular, com as pílulas só com o nome. Pose
 * estática = pose final; o movimento toca uma vez e só parte dela.
 */
import '../../styles/ilustracoes.css';
import Defs from './arte/Defs.astro';
import Movimento from './arte/Movimento.astro';
import { desenhoRenke, type NomeIconeRenke } from '../../data/icones-renke';

/* Ícones do conjunto Renke (02/10/2026), em grade de 24; o Instagram segue
   com o desenho da marca. */
const RENKE: Record<string, NomeIconeRenke> = { anuncios: 'anuncios', google: 'google', atendimento: 'atendimento', agenda: 'agenda', consulta: 'consulta' };
const INSTAGRAM = 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zM16 11.4A4 4 0 1 1 12.6 8a4 4 0 0 1 3.4 3.4zM17.5 6.5h.01';
const ICONES: Record<string, { traco: string; pontos: string; marca?: boolean }> = Object.fromEntries([
  ...Object.entries(RENKE).map(([k, n]) => [k, desenhoRenke(n)]),
  ['instagram', { traco: INSTAGRAM, pontos: '', marca: true }],
]);
/* Largura de cada nome em Inter 13 / 450 (medida no navegador). */
const NOMES = [
  { nome: 'Anúncios', icone: 'anuncios', t: 57 },
  { nome: 'Instagram', icone: 'instagram', t: 61 },
  { nome: 'Google', icone: 'google', t: 44 },
  { nome: 'Atendimento', icone: 'atendimento', t: 77.5 },
  { nome: 'Agenda', icone: 'agenda', t: 47.5 },
  { nome: 'Consulta', icone: 'consulta', t: 54.5 },
];
/* O caminho aceso: da primeira origem à última etapa. */
const ENTRA = 0, SAI = 2;

type No = { nome: string; icone: string; x: number; y: number; w: number; h: number; tx: number; fim: boolean };
function cena(alta: boolean) {
  const p = alta ? 'conexoes-alta' : 'conexoes-larga';
  const vb = alta ? [320, 326] : [620, 268];
  const hub = alta ? { x: 160, y: 163, s: 72 } : { x: 298, y: 152, s: 84 };
  const H = alta ? 34 : 40;
  const escala = alta ? 12.5 / 13 : 1;
  /* Pílula: 14 + ícone 16 + 8 + nome + 16 na larga; 13 + nome + 13 na alta.
     A última etapa reserva 22 para o visto. */
  const largura = (i: number) => Math.round((alta ? 26 : 54) + NOMES[i].t * escala + (i === 5 ? 22 : 0));
  const nos: No[] = [];
  if (alta) {
    for (const [linha, y] of [[0, 4], [1, 288]] as const) {
      const ws = [0, 1, 2].map((i) => largura(linha * 3 + i));
      let x = (vb[0] - ws.reduce((a, b) => a + b, 0) - 20) / 2;
      ws.forEach((w, i) => { nos.push({ ...NOMES[linha * 3 + i], x, y, w, h: H, tx: x + 13, fim: linha === 1 && i === 2 }); x += w + 10; });
    }
  } else {
    [72, 152, 232].forEach((cy, i) => nos.push({ ...NOMES[i], x: 0, y: cy - H / 2, w: largura(i), h: H, tx: 38, fim: false }));
    [72, 152, 232].forEach((cy, i) => nos.push({ ...NOMES[i + 3], x: 480, y: cy - H / 2, w: largura(i + 3), h: H, tx: 518, fim: i === 2 }));
  }
  /* Fios: da pílula à porta do núcleo (leque de 12 em 12) e da porta à pílula. */
  const m = hub.s / 2;
  const curva = (x0: number, y0: number, x1: number, y1: number) => {
    if (alta) { const k = (y1 - y0) / 2; return `M${x0} ${y0}C${x0} ${y0 + k} ${x1} ${y1 - k} ${x1} ${y1}`; }
    const k = (x1 - x0) / 2; return `M${x0} ${y0}C${x0 + k} ${y0} ${x1 - k} ${y1} ${x1} ${y1}`;
  };
  const fios = nos.map((n, i) => {
    const d = (i % 3 - 1) * 12, entra = i < 3;
    const no = alta ? { x: n.x + n.w / 2, y: entra ? n.y + n.h : n.y } : { x: entra ? n.x + n.w : n.x, y: n.y + n.h / 2 };
    const porta = alta ? { x: hub.x + d, y: hub.y + (entra ? -m : m) } : { x: hub.x + (entra ? -m : m), y: hub.y + d };
    return { entra, no, porta, d: entra ? curva(no.x, no.y, porta.x, porta.y) : curva(porta.x, porta.y, no.x, no.y), aceso: i === ENTRA || i === SAI + 3 };
  });
  /* Degradês ao longo do eixo do diagrama: do nó (fraco) ao núcleo (claro). */
  const eixo = (a: number, b: number) => (alta ? { x1: 0, y1: a, x2: 0, y2: b } : { x1: a, y1: 0, x2: b, y2: 0 });
  const pe = alta ? [38, hub.y - m] : [98, hub.x - m], ps = alta ? [hub.y + m, 288] : [hub.x + m, 480];
  return { p, vb, hub, nos, fios, alta, ge: eixo(pe[0], pe[1]), gs: eixo(ps[0], ps[1]), corpo: alta ? 12.5 : 13 };
}
const cenas = [cena(false), cena(true)];
---
{cenas.map(({ p, vb, hub, nos, fios, alta, ge, gs, corpo }) => (
  <svg class:list={['arte', 'cx', alta ? 'cx--alta' : 'cx--larga']} viewBox={`0 0 ${vb[0]} ${vb[1]}`} fill="none" aria-hidden="true" focusable="false">
    <Defs p={p} />
    <defs>
      <linearGradient id={`${p}-fio-e`} gradientUnits="userSpaceOnUse" {...ge}>
        <stop stop-color="#ffffff" stop-opacity=".1" /><stop offset="1" stop-color="#ffffff" stop-opacity=".3" />
      </linearGradient>
      <linearGradient id={`${p}-fio-s`} gradientUnits="userSpaceOnUse" {...gs}>
        <stop stop-color="#ffffff" stop-opacity=".3" /><stop offset="1" stop-color="#ffffff" stop-opacity=".1" />
      </linearGradient>
      <linearGradient id={`${p}-aceso-e`} gradientUnits="userSpaceOnUse" {...ge}>
        <stop stop-color="#ffffff" stop-opacity=".34" /><stop offset="1" stop-color="#ffffff" stop-opacity=".72" />
      </linearGradient>
      {/* O fio aceso puxa para o amarelo ao chegar na consulta. */}
      <linearGradient id={`${p}-aceso-s`} gradientUnits="userSpaceOnUse" {...gs}>
        <stop stop-color="#ffffff" stop-opacity=".72" /><stop offset=".55" stop-color="#f4ecd0" stop-opacity=".7" /><stop offset="1" stop-color="#FFD103" stop-opacity=".85" />
      </linearGradient>
      <radialGradient id={`${p}-luz`} gradientUnits="userSpaceOnUse" cx={hub.x} cy={hub.y} r={alta ? 130 : 170}>
        <stop stop-color="#ffffff" stop-opacity=".075" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`${p}-some`} gradientUnits="userSpaceOnUse" cx={hub.x} cy={hub.y} r={alta ? 120 : 165}>
        <stop offset=".3" stop-color="#ffffff" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <mask id={`${p}-aneis`} maskUnits="userSpaceOnUse" x="0" y="0" width={vb[0]} height={vb[1]}>
        <rect width={vb[0]} height={vb[1]} fill={`url(#${p}-some)`} />
      </mask>
      <linearGradient id={`${p}-nucleo`} x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#2c2c2c" /><stop offset="1" stop-color="#151515" />
      </linearGradient>
      <radialGradient id={`${p}-halo`}>
        <stop stop-color="#FFD103" stop-opacity=".26" /><stop offset="1" stop-color="#FFD103" stop-opacity="0" />
      </radialGradient>
      <filter id={`${p}-desfoque`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.2" /></filter>
    </defs>

    {/* Luz fraca e contornos concêntricos atrás do núcleo. */}
    <rect width={vb[0]} height={vb[1]} fill={`url(#${p}-luz)`} />
    <g mask={`url(#${p}-aneis)`} class="cx__aneis">
      {(alta ? [58, 84, 112] : [64, 94, 128]).map((r, i) => (
        <rect x={hub.x - r} y={hub.y - r} width={r * 2} height={r * 2} rx={r * 0.46} stroke-opacity={[0.1, 0.075, 0.055][i]} />
      ))}
    </g>

    {!alta && <>
      <text x="0" y="14" class="cx__grupo">Marketing</text>
      <text x="480" y="14" class="cx__grupo">Comercial</text>
    </>}

    {/* Fios, e por cima o caminho aceso com a luz que o percorre. */}
    {fios.map((f) => <path d={f.d} stroke={`url(#${p}-fio-${f.entra ? 'e' : 's'})`} class="cx__fio" />)}
    {fios.filter((f) => f.aceso).map((f) => (<>
      <path d={f.d} pathLength="1" stroke={`url(#${p}-aceso-${f.entra ? 'e' : 's'})`} class:list={['cx__aceso', f.entra ? 'cx__aceso--entra' : 'cx__aceso--sai']} />
      <path d={f.d} pathLength="1" filter={`url(#${p}-desfoque)`} class:list={['cx__luz', 'cx__luz--halo', f.entra ? 'cx__luz--entra' : 'cx__luz--sai']} />
      <path d={f.d} pathLength="1" class:list={['cx__luz', f.entra ? 'cx__luz--entra' : 'cx__luz--sai']} />
    </>))}

    {/* Pílulas. */}
    {nos.map((n) => (
      <g class:list={['cx__no', { 'cx__no--fim': n.fim }]}>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.h / 2} fill={`url(#${p}-alto)`} stroke={`url(#${p}-fio)`} />
        {!alta && <g transform={`translate(${n.x + 14} ${n.y + n.h / 2 - 8}) scale(.6667)`}>
          <path d={ICONES[n.icone].traco} class:list={['a-icone', 'cx__icone', { 'cx__icone--renke': !ICONES[n.icone].marca }]} />
          {ICONES[n.icone].pontos && <path d={ICONES[n.icone].pontos} class="cx__icone-ponto" />}
        </g>}
        <text x={n.tx} y={n.y + n.h / 2 + corpo * 0.35} class="cx__nome" style={`font-size:${corpo}px`}>{n.nome}</text>
        {n.fim && <g transform={`translate(${n.x + n.w - (alta ? 17 : 20)} ${n.y + n.h / 2})`}>
          <circle r="15" fill={`url(#${p}-halo)`} class="cx__halo" />
          <circle r="4.5" class="cx__pendente" />
          <path d="M-3.6 .3l2.5 2.5l4.8-5.2" pathLength="1" class="a-destaque-traco cx__visto" />
        </g>}
      </g>
    ))}
    {/* O ponto onde cada fio encosta na pílula. */}
    {fios.map((f) => <circle cx={f.no.x} cy={f.no.y} r="2.6" class:list={['cx__ponto', { 'cx__ponto--aceso': f.aceso }]} />)}

    {/* Núcleo: moldura, peça com o monograma e as portas dos fios. */}
    <g class="cx__nucleo">
      <rect x={hub.x - hub.s / 2 - 10} y={hub.y - hub.s / 2 - 10} width={hub.s + 20} height={hub.s + 20} rx={hub.s * 0.26 + 8} class="cx__moldura" />
      <rect x={hub.x - hub.s / 2 - 10} y={hub.y - hub.s / 2 - 10} width={hub.s + 20} height={hub.s + 20} rx={hub.s * 0.26 + 8} class="cx__pulso" />
      <rect x={hub.x - hub.s / 2 + 10} y={hub.y - hub.s / 2 + 10} width={hub.s - 20} height={hub.s - 20} rx={hub.s * 0.2} fill="#000000" filter={`url(#${p}-sombra)`} opacity=".85" />
      <rect x={hub.x - hub.s / 2} y={hub.y - hub.s / 2} width={hub.s} height={hub.s} rx={hub.s * 0.26} fill={`url(#${p}-nucleo)`} stroke={`url(#${p}-fio)`} />
      <rect x={hub.x - hub.s / 2 + 18} y={hub.y - hub.s / 2 + 0.5} width={hub.s - 36} height="1" fill={`url(#${p}-fio-h)`} />
      <image href="/marca/renke-monograma.png" x={hub.x - hub.s * 0.22} y={hub.y - hub.s * 0.22} width={hub.s * 0.44} height={hub.s * 0.44} />
      {fios.map((f) => <circle cx={f.porta.x} cy={f.porta.y} r="1.8" class:list={['cx__porta', { 'cx__porta--acesa': f.aceso }]} />)}
    </g>
  </svg>
))}
<Movimento />

<style>
  .cx { height: auto; }
  .cx--alta { display: none; }
  @media (max-width: 599.98px) {
    .cx--larga { display: none; }
    .cx--alta { display: block; }
  }

  .cx__grupo { font-size: 12px; fill: #7c7c78; letter-spacing: -.005em; }
  .cx__aneis rect { stroke: #ffffff; }
  .cx__fio { stroke-width: 1; }
  .cx__aceso { stroke-width: 1.2; stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* A luz é um traço curto que percorre o fio; em repouso já passou. */
  .cx__luz { stroke: #ffffff; stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: .16 1; stroke-dashoffset: -1; }
  .cx__luz--halo { stroke-width: 4; stroke-opacity: .5; }
  .cx__luz--sai { stroke: #ffe9a3; }

  .cx__nome { font-weight: 450; fill: #cfcfca; letter-spacing: -.005em; }
  .cx__no--fim .cx__nome { fill: #f2f2ee; }
  .cx .cx__icone { stroke: #8f8f8a; stroke-width: 2; }
  .cx .cx__no--fim .cx__icone { stroke: #c9c9c4; }
  .cx .cx__icone--renke { stroke-width: 2.25; stroke-linejoin: miter; stroke-linecap: butt; }
  .cx .cx__icone-ponto { fill: #8f8f8a; stroke: none; }
  .cx .cx__no--fim .cx__icone-ponto { fill: var(--destaque, #FFD103); }
  .cx__ponto { fill: #101010; stroke: #ffffff; stroke-opacity: .32; }
  .cx__ponto--aceso { fill: #d6d6d1; stroke-opacity: 0; }
  .cx__pendente { stroke: #ffffff; stroke-opacity: .3; opacity: 0; }
  .cx .cx__visto { stroke-width: 1.7; stroke-dasharray: 1; stroke-dashoffset: 0; }

  .cx__moldura { fill: #ffffff; fill-opacity: .022; stroke: #ffffff; stroke-opacity: .08; }
  .cx__pulso { stroke: #ffffff; stroke-opacity: .34; opacity: 0; }
  .cx__porta { fill: #6f6f6b; }
  .cx__porta--acesa { fill: #ecece8; }

  /* Movimento, uma vez, em 5 s (tempos do ciclo):
     0,5–1,8  a luz vai de Anúncios ao núcleo e o fio acende atrás dela;
     1,7–2,6  a moldura do núcleo clareia e volta;
     2,4–3,7  a luz segue do núcleo até a Consulta;
     3,7–4,4  o visto amarelo se desenha, com o halo. */
  .cx__aceso, .cx__luz, .cx__pulso, .cx__pendente, .cx__visto, .cx__halo {
    animation-duration: 5s; animation-delay: .5s; animation-iteration-count: 1;
    animation-timing-function: var(--a-vai-vem); animation-fill-mode: both;
  }
  .cx__aceso--entra { animation-name: cx-aceso-entra; }
  .cx__aceso--sai { animation-name: cx-aceso-sai; }
  .cx__luz--entra { animation-name: cx-luz-entra; }
  .cx__luz--sai { animation-name: cx-luz-sai; }
  .cx__pulso { animation-name: cx-pulso; }
  .cx__pendente { animation-name: cx-pendente; }
  .cx__visto { animation-name: cx-visto; }
  .cx__halo { animation-name: cx-halo; }

  @keyframes cx-aceso-entra { 0%, 10% { stroke-dashoffset: 1; } 36%, 100% { stroke-dashoffset: 0; } }
  @keyframes cx-aceso-sai { 0%, 48% { stroke-dashoffset: 1; } 74%, 100% { stroke-dashoffset: 0; } }
  @keyframes cx-luz-entra { 0%, 10% { stroke-dashoffset: .16; } 38%, 100% { stroke-dashoffset: -1; } }
  @keyframes cx-luz-sai { 0%, 48% { stroke-dashoffset: .16; } 76%, 100% { stroke-dashoffset: -1; } }
  @keyframes cx-pulso { 0%, 33% { opacity: 0; } 42% { opacity: 1; } 56%, 100% { opacity: 0; } }
  @keyframes cx-pendente { 0%, 72% { opacity: 1; } 77%, 100% { opacity: 0; } }
  @keyframes cx-visto { 0%, 74% { stroke-dashoffset: 1; } 88%, 100% { stroke-dashoffset: 0; } }
  @keyframes cx-halo { 0%, 74% { opacity: 0; } 92%, 100% { opacity: 1; } }
</style>
