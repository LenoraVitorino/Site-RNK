---
/**
 * Segunda versão das artes do Protocolo Revena (10/10/2026). A Lenora achou
 * a primeira "muito tecnológica", com cara de quem vende sistema: a Renke
 * vende o processo, feito por gente. Aqui cada peça mostra o trabalho
 * (um lead acompanhado, uma conversa, o plano do mês, o estudo feito pelo
 * time), com as fotos reais da equipe, em cor. Só o quadro do CRM é claro; as
 * outras telas são escuras com detalhes em amarelo claro. O quadro do CRM segue o da primeira versão.
 * Sem métricas nem pacientes inventados; o amarelo fica num ponto por peça.
 */
import { Image } from 'astro:assets';
import '../../../styles/protocolo-v2.css';
import isa from '../../../assets/equipe/isa.jpg';
import lari from '../../../assets/equipe/lari.jpg';
import julio from '../../../assets/equipe/julio-caldeira.jpg';
import maria from '../../../assets/equipe/maria.jpg';
import pedro from '../../../assets/equipe/pedro-packness.jpg';
import milena from '../../../assets/equipe/milena.jpg';
import sede from '../../../assets/sede/operacao.jpg';

interface Props { peca: 'conexoes' | 'crm' | 'automacao' | 'decisao' | 'posicionamento' }
const { peca } = Astro.props;

/* 1. Do marketing ao paciente em três telas (10/10: "mostra a tela, não a
   etapa, não o timeline"): a tela do marketing publicando a campanha, a do
   comercial conversando e agendando, a da clínica recebendo o paciente.
   Cada tela entra pela direita e sai pela esquerda; quem trabalha aparece
   no cursor, com foto e nome. As telas são inventadas: representam o
   processo, não um sistema à venda. Laço de 18 s, 6 s por tela; os tempos
   de cada cena vão de 0 a 1 e viram % do laço em g(). */
const g = (k: number, t: number) => +(((k + t) / 3) * 100).toFixed(2);
const q: string[] = [];
const cena = (k: number) => q.push(`@keyframes p2-cena-${k}{0%,${g(k, 0)}%{opacity:0;transform:translateX(44px)}${g(k, .09)}%,${g(k, .93)}%{opacity:1;transform:none}${g(k, 1)}%,100%{opacity:0;transform:translateX(-44px)}}`);
const entra = (n: string, k: number, t: number, de = 'translateY(10px)') => q.push(`@keyframes ${n}{0%,${g(k, t)}%{opacity:0;transform:${de}}${g(k, t + .07)}%,100%{opacity:1;transform:none}}`);
const troca = (n: string, k: number, t: number) => q.push(
  `@keyframes ${n}-a{0%,${g(k, t)}%{opacity:1}${g(k, t + .03)}%,100%{opacity:0}}`,
  `@keyframes ${n}-b{0%,${g(k, t)}%{opacity:0}${g(k, t + .03)}%,100%{opacity:1}}`);
const aperta = (n: string, k: number, t: number) => q.push(`@keyframes ${n}{0%,${g(k, t - .02)}%{transform:none}${g(k, t)}%{transform:scale(.95)}${g(k, t + .04)}%,100%{transform:none}}`);
/* Cursor: pontos [tempo, left, top]; some antes do primeiro e depois do último. */
const mouse = (n: string, k: number, pts: [number, string, string][]) => {
  const [p0, pf] = [pts[0], pts[pts.length - 1]];
  q.push(`@keyframes ${n}{0%,${g(k, p0[0] - .08)}%{opacity:0;left:${p0[1]};top:${p0[2]}}${pts.map(([t, x, y]) => `${g(k, t)}%{opacity:1;left:${x};top:${y}}`).join('')}${g(k, pf[0] + .1)}%,100%{opacity:0;left:${pf[1]};top:${pf[2]}}}`);
};
[0, 1, 2].forEach(cena);
// Tela 1, marketing: liga o Google, publica a campanha, chega o lead.
mouse('p2-m1', 0, [[.16, '70%', '150px'], [.3, 'calc(100% - 30px)', '90px'], [.4, 'calc(100% - 30px)', '90px'], [.56, '56%', '152px'], [.7, '56%', '152px']]);
q.push(`@keyframes p2-chave{0%,${g(0, .34)}%{background:#3d3d3b}${g(0, .38)}%,100%{background:#FFE27A}}`,
  `@keyframes p2-chave-pino{0%,${g(0, .34)}%{transform:none}${g(0, .39)}%,100%{transform:translateX(12px)}}`);
aperta('p2-publica', 0, .6); troca('p2-botao', 0, .62); entra('p2-aviso', 0, .74, 'translate(16px,-10px) scale(.96)');
// Tela 2, comercial: conversa com o lead e marca a avaliação.
entra('p2-fala-1', 1, .1); entra('p2-fala-2', 1, .26); entra('p2-fala-3', 1, .42); entra('p2-vagas', 1, .5);
mouse('p2-m2', 1, [[.56, '62%', '70px'], [.68, '44px', '22px'], [.84, '44px', '22px']]);
aperta('p2-vaga', 1, .72);
q.push(`@keyframes p2-vaga-cor{0%,${g(1, .72)}%{background:#2b2b2a;color:#F2F2EE}${g(1, .76)}%,100%{background:#F2F2EE;color:#161616}}`);
troca('p2-estado-lead', 1, .76);
// Tela 3, clínica: o paciente confirma, chega e fecha o tratamento.
entra('p2-ok-1', 2, .16, 'scale(.4)'); entra('p2-ok-2', 2, .34, 'scale(.4)'); entra('p2-ok-3', 2, .52, 'scale(.4)');
q.push(...[.16, .34, .52].map((t, i) => `@keyframes p2-item-${i + 1}{0%,${g(2, t)}%{opacity:.36}${g(2, t + .06)}%,100%{opacity:1}}`));
entra('p2-fim', 2, .68, 'translateY(8px) scale(.94)');
const quadros = q.join('');

/* 3. A conversa do lembrete, em % de um laço de 12 s. */
const quadrosZap = [
  '@keyframes p2-z-corpo{0%{opacity:0}4%,93%{opacity:1}100%{opacity:0}}',
  '@keyframes p2-z-1{0%,6%{opacity:0;transform:translateY(10px) scale(.97)}11%,100%{opacity:1;transform:none}}',
  '@keyframes p2-z-lido{0%,26%{stroke:rgb(22 22 22 / .32)}30%,100%{stroke:#161616}}',
  '@keyframes p2-z-dig{0%,34%{opacity:0;transform:translateY(8px)}38%,50%{opacity:1;transform:none}53%,100%{opacity:0;transform:none}}',
  '@keyframes p2-z-2{0%,52%{opacity:0;transform:translateY(8px) scale(.97)}57%,100%{opacity:1;transform:none}}',
  '@keyframes p2-z-3{0%,68%{opacity:0;transform:translateY(8px)}73%,100%{opacity:1;transform:none}}',
].join('');

/* 4. O plano do mês virando entrega (10/10, "fez isso, isso, isso e
   finalizou"): cada pendência tem a área e a pessoa do time que cuida dela.
   `em` é quando entra em andamento e `feito` quando conclui, em % de 14 s. */
const tarefas = [
  { titulo: 'Mais verba no Google', area: 'Mídia paga', dono: julio, em: 10, feito: 24 },
  { titulo: 'Novo roteiro para a recepção', area: 'Comercial', dono: lari, em: 34, feito: 48 },
  { titulo: 'Reativar pacientes antigos', area: 'CRM e automação', dono: milena, em: 58, feito: 72 },
];
const quadrosPlano = tarefas.map((t, k) => [
  `@keyframes p2-tar-${k}{0%,${t.em}%{opacity:.34}${t.em + 3}%,94%{opacity:1}100%{opacity:.34}}`,
  `@keyframes p2-tar-dono-${k}{0%,${t.em}%{opacity:0;transform:scale(.7)}${t.em + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
  `@keyframes p2-tar-ponto-${k}{0%,${t.em}%{opacity:0}${t.em + 3}%,${t.feito}%{opacity:1}${t.feito + 2}%,100%{opacity:0}}`,
  `@keyframes p2-tar-visto-${k}{0%,${t.feito}%{opacity:0;transform:scale(.5)}${t.feito + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
].join('')).join('') + '@keyframes p2-plano-fim{0%,80%{opacity:0;transform:translateY(6px)}84%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}';

const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const, class: 'p2-rosto' };
---
{peca === 'conexoes' && (
  <div class="p2 p2-tela" aria-hidden="true" data-p2 style="--d:0">
    <style is:inline set:html={quadros}></style>

    <section class="p2-cena p2-anim" style="--a:p2-cena-0">
      <header class="p2-cena__topo"><span class="p2-rostos"><Image src={isa} {...rosto} /><Image src={julio} {...rosto} /></span><b>Marketing</b><span>Campanha de outubro</span></header>
      <div class="p2-cena__corpo">
        <div class="p2-cena__principal">
          <div class="p2-bloco">
            <span class="p2-legenda">Onde a campanha roda</span>
            <div class="p2-linha">Instagram<span class="p2-chave p2-chave--ligada"><i></i></span></div>
            <div class="p2-linha">Google<span class="p2-chave p2-anim" style="--a:p2-chave"><i class="p2-anim" style="--a:p2-chave-pino"></i></span></div>
          </div>
          <div class="p2-botao p2-anim" style="--a:p2-publica">
            <span class="p2-anim" style="--a:p2-botao-a">Publicar campanha</span>
            <span class="p2-botao__depois p2-anim" style="--a:p2-botao-b"><i></i>Campanha no ar</span>
          </div>
          <div class="p2-mouse p2-anim" style="--a:p2-m1">
            <svg viewBox="0 0 16 16" focusable="false"><path d="M1.5 1.5l12 4.6-5.2 2.2-2.2 5.2z" /></svg>
            <span class="p2-mouse__quem"><Image src={isa} {...rosto} />Isa</span>
          </div>
        </div>
        <div class="p2-bloco p2-anuncio p2-cena__extra">
          <img src="/imagens/planos-editoriais/seringa.webp" alt="" loading="lazy" />
          <strong>Harmonização facial</strong><span>Agende sua avaliação</span>
        </div>
        <div class="p2-bloco p2-aviso p2-anim" style="--a:p2-aviso"><i></i><div><strong>Novo lead</strong><span>Harmonização facial, agora</span></div></div>
      </div>
    </section>

    <section class="p2-cena p2-anim" style="--a:p2-cena-1">
      <header class="p2-cena__topo"><span class="p2-rostos"><Image src={lari} {...rosto} /><Image src={pedro} {...rosto} /></span><b>Comercial</b><span>Conversa com o lead</span></header>
      <div class="p2-cena__corpo">
        <div class="p2-cena__principal">
          <div class="p2-conversa2">
            <span class="p2-fala p2-anim" style="--a:p2-fala-1">Oi! Vi o anúncio de harmonização.</span>
            <span class="p2-fala p2-fala--nossa p2-anim" style="--a:p2-fala-2">Oi! Posso agendar sua avaliação?</span>
            <span class="p2-fala p2-anim" style="--a:p2-fala-3">Pode ser na sexta.</span>
          </div>
          <div class="p2-vagas p2-anim" style="--a:p2-vagas">
            <span class="p2-vaga p2-vaga--escolhida p2-anim" style="--a:p2-vaga"><b class="p2-anim" style="--a:p2-vaga-cor">Sex, 09:30</b></span>
            <span class="p2-vaga"><b>Sex, 11:00</b></span>
            <span class="p2-vaga"><b>Sex, 15:30</b></span>
            <div class="p2-mouse p2-anim" style="--a:p2-m2">
              <svg viewBox="0 0 16 16" focusable="false"><path d="M1.5 1.5l12 4.6-5.2 2.2-2.2 5.2z" /></svg>
              <span class="p2-mouse__quem"><Image src={lari} {...rosto} />Lari</span>
            </div>
          </div>
        </div>
        <div class="p2-bloco p2-cena__extra">
          <span class="p2-legenda">Lead</span>
          <strong>Harmonização facial</strong>
          <div class="p2-linha p2-linha--fina">Origem<span>Instagram</span></div>
          <div class="p2-linha p2-linha--fina">Situação<span class="p2-pilha"><b class="p2-anim" style="--a:p2-estado-lead-a">Em contato</b><b class="p2-pilha__depois p2-anim" style="--a:p2-estado-lead-b">Agendado</b></span></div>
        </div>
      </div>
    </section>

    <section class="p2-cena p2-cena--fim p2-anim" style="--a:p2-cena-2">
      <header class="p2-cena__topo"><span class="p2-cena__clinica"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 6.5v11M6.5 12h11" /></svg></span><b>Clínica</b><span>Sexta, 09:30</span></header>
      <div class="p2-cena__corpo">
        <div class="p2-cena__principal">
          <div class="p2-bloco">
            <strong>Avaliação de harmonização facial</strong>
            <ul class="p2-itens">
              {['Confirmou a presença', 'Chegou à clínica', 'Fechou o tratamento'].map((t, i) => (
                <li class="p2-item p2-anim" style={`--a:p2-item-${i + 1}`}><i><b class="p2-anim" style={`--a:p2-ok-${i + 1}`}></b></i>{t}</li>
              ))}
            </ul>
          </div>
          <div class="p2-fim p2-anim" style="--a:p2-fim"><i></i>Lead virou paciente</div>
        </div>
        <div class="p2-bloco p2-cena__extra">
          <span class="p2-legenda">Quem cuidou</span>
          <div class="p2-quem"><span class="p2-rostos"><Image src={isa} {...rosto} /><Image src={julio} {...rosto} /></span>Marketing trouxe o lead</div>
          <div class="p2-quem"><span class="p2-rostos"><Image src={lari} {...rosto} /><Image src={pedro} {...rosto} /></span>Comercial agendou</div>
        </div>
      </div>
    </section>
  </div>
)}

{peca === 'crm' && (
  /* 2. O quadro do CRM em tela clara sobre o cartão escuro (10/10, referências
     "Pipeline Tracking" e "Progress Tracking"): a recepção da clínica pega um
     lead em contato, leva para "Agendado" e a ficha ganha dia e hora. */
  <div class="p2 p2-crm" aria-hidden="true" data-p2 style="--d:0">
    <div class="p2-crm__fundo">
    <div class="p2-crm__topo">
      <strong>Pipeline</strong>
      <span class="p2-crm__time"><i>C</i><i>R</i></span>
    </div>
    <div class="p2-crm__quadro">
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Em contato<span class="p2-crm__conta"><b class="p2-anim" style="--a:p2-crm-antes">3</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">2</b></span></div>
        <div class="p2-ficha"><strong>Fios de PDO</strong><span><i></i>Instagram<em>há 5 h</em></span></div>
        <div class="p2-ficha p2-ficha--vaga"></div>
        <div class="p2-ficha p2-crm__sobe p2-anim" style="--a:p2-crm-sobe"><strong>Consulta</strong><span><i></i>Indicação<em>ontem</em></span></div>
        <div class="p2-ficha p2-crm__sobe p2-anim" style="--a:p2-crm-sobe"><strong>Botox</strong><span><i></i>Instagram<em>seg</em></span></div>
      </div>
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Agendado<span class="p2-crm__conta"><b class="p2-anim" style="--a:p2-crm-antes">1</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">2</b></span></div>
        <div class="p2-ficha"><strong>Retorno</strong><span><i></i>Site<em>sex, 09:30</em></span></div>
        <div class="p2-ficha p2-ficha--destino p2-anim" style="--a:p2-crm-destino"></div>
      </div>
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Atendido<span class="p2-crm__conta"><b>2</b></span></div>
        <div class="p2-ficha"><strong>Laser</strong><span><i></i>Site<em>ter</em></span></div>
        <div class="p2-ficha"><strong>Peeling</strong><span><i></i>Google<em>seg</em></span></div>
        <div class="p2-ficha"><strong>Preenchimento</strong><span><i></i>Indicação<em>sex</em></span></div>
      </div>
    </div>
    </div>
    {/* A ficha solta e o cursor ficam fora da camada que se apaga nas bordas. */}
    <div class="p2-crm__solto">
      <div class="p2-crm__mover p2-anim" style="--a:p2-crm-mover">
        <div class="p2-ficha p2-ficha--solta p2-anim" style="--a:p2-crm-ergue">
          <strong>Harmonização</strong>
          <span><i></i>Google<em class="p2-crm__hora"><b class="p2-anim" style="--a:p2-crm-antes">há 2 h</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">qui, 14:00</b></em></span>
        </div>
        <div class="p2-crm__cursor p2-anim" style="--a:p2-crm-cursor">
          <svg viewBox="0 0 16 16" focusable="false"><path d="M1.5 1.5l12 4.6-5.2 2.2-2.2 5.2z" /></svg>
          <span class="p2-crm__etiqueta"><b>Recepção</b><span><i class="p2-anim" style="--a:p2-crm-fala-1">Agendando a avaliação…</i><i class="p2-anim" style="--a:p2-crm-fala-2">Agendada: quinta, 14:00</i></span></span>
        </div>
      </div>
    </div>
  </div>
)}

{peca === 'automacao' && (
  /* 3. A automação como conversa de WhatsApp (10/10: "não parece uma
     conversa, faltam elementos do WhatsApp"): janela com contato, dia,
     balões com hora e vistos, "digitando" e o campo de mensagem. O lembrete
     sai sozinho, é lido, a paciente responde e a agenda se atualiza. */
  <div class="p2 p2-zap" aria-hidden="true" data-p2 style="--d:0">
    <style is:inline set:html={quadrosZap}></style>
    <header class="p2-zap__topo">
      <span class="p2-cena__clinica"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 6.5v11M6.5 12h11" /></svg></span>
      <div><strong>Sua clínica</strong><span>Conta comercial</span></div>
      <svg class="p2-zap__icone" viewBox="0 0 24 24" focusable="false"><path d="M6.6 3.8h3l1.4 4-2 1.5a12 12 0 0 0 5.7 5.7l1.5-2 4 1.4v3c0 1.1-.9 2-2 2A15.6 15.6 0 0 1 4.6 5.800c0-1.1.9-2 2-2z" /></svg>
    </header>
    <div class="p2-zap__corpo p2-anim" style="--a:p2-z-corpo">
      <span class="p2-zap__dia">Hoje</span>
      <div class="p2-zap__balao p2-zap__balao--clinica p2-anim" style="--a:p2-z-1">
        Sua avaliação é amanhã, às 14:00. Podemos confirmar a sua presença?
        <span class="p2-zap__hora">08:00<svg class="p2-anim" style="--a:p2-z-lido" viewBox="0 0 18 12" focusable="false"><path d="M1 6.5l3.5 3.5L11 2.5M7 9l1 1 6.5-7.5" /></svg></span>
      </div>
      <div class="p2-zap__vez">
        <div class="p2-zap__balao p2-zap__digitando p2-anim" style="--a:p2-z-dig"><i></i><i></i><i></i></div>
        <div class="p2-zap__balao p2-anim" style="--a:p2-z-2">Confirmado, obrigada!<span class="p2-zap__hora">08:12</span></div>
      </div>
      <span class="p2-zap__dia p2-zap__dia--sistema p2-anim" style="--a:p2-z-3"><i></i>Presença confirmada na agenda</span>
    </div>
    <footer class="p2-zap__campo"><span>Mensagem</span><i><svg viewBox="0 0 24 24" focusable="false"><path d="M12 4.5v9M8.5 8v2.5a3.5 3.5 0 0 0 7 0V8M12 16.5v3" /></svg></i></footer>
  </div>
)}

{peca === 'decisao' && (
  <div class="p2 p2-cartao p2-plano" aria-hidden="true" data-p2 style="--d:0">
    <style is:inline set:html={quadrosPlano}></style>
    <div class="p2-plano__topo">
      <Image src={maria} {...rosto} />
      <div><strong>Plano de outubro</strong><span>Reunião mensal com a Renke</span></div>
    </div>
    <ul class="p2-plano__lista">
      {tarefas.map((t, k) => (
        <li class="p2-tarefa p2-anim" style={`--a:p2-tar-${k}`}>
          <span class="p2-tarefa__marca"><b class="p2-tarefa__ponto p2-anim" style={`--a:p2-tar-ponto-${k}`}></b><b class="p2-tarefa__visto p2-anim" style={`--a:p2-tar-visto-${k}`}></b></span>
          <span class="p2-tarefa__texto">{t.titulo}<span>{t.area}</span></span>
          <Image src={t.dono} {...rosto} class="p2-rosto p2-anim" style={`--a:p2-tar-dono-${k}`} />
        </li>
      ))}
    </ul>
    <div class="p2-plano__fim p2-anim" style="--a:p2-plano-fim"><i></i>Plano de outubro entregue</div>
  </div>
)}

{peca === 'posicionamento' && (
  <div class="p2 p2-estudo" aria-hidden="true">
    <Image src={sede} alt="" class="p2-estudo__foto" format="webp" quality={76} widths={[480, 800, 1100]} sizes="(min-width: 1100px) 30vw, 100vw" loading="lazy" />
    <div class="p2-cartao p2-estudo__nota" data-p2 style="--d:200">
      <span class="p2-rostos"><Image src={milena} {...rosto} /><Image src={julio} {...rosto} /></span>
      <div><strong>Estudo de concorrentes</strong><span>Feito pelo nosso time</span></div>
    </div>
  </div>
)}
