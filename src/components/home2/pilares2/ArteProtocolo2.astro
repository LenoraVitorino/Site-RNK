---
/**
 * Segunda versão das artes do Protocolo Revena (10/10/2026). A Lenora achou
 * a primeira "muito tecnológica", com cara de quem vende sistema: a Renke
 * vende o processo, feito por gente. Aqui cada peça mostra o trabalho
 * (um lead acompanhado, uma conversa, o plano do mês, o estudo feito pelo
 * time), em recortes claros sobre o cartão escuro e com as fotos reais da
 * equipe, em preto e branco. O quadro do CRM segue o da primeira versão.
 * Sem métricas nem pacientes inventados; o amarelo fica num ponto por peça.
 */
import { Image } from 'astro:assets';
import '../../../styles/protocolo-v2.css';
import isa from '../../../assets/equipe/isa.jpg';
import lari from '../../../assets/equipe/lari.jpg';
import julio from '../../../assets/equipe/julio-caldeira.jpg';
import maria from '../../../assets/equipe/maria.jpg';
import pedro from '../../../assets/equipe/pedro-packness.jpg';
import milena from '../../../assets/equipe/milena.jpg';
import sede from '../../../assets/sede/operacao.jpg';

interface Props { peca: 'conexoes' | 'crm' | 'automacao' | 'decisao' | 'posicionamento' }
const { peca } = Astro.props;

/* 1. A história do processo (10/10, "contar um processo, não uma tela
   estática"): o marketing faz a parte dele, o lead passa para o comercial, o
   comercial conduz e o lead vira paciente. Três estações que acendem em
   ordem, com o que cada time faz aparecendo embaixo, e um marcador que
   percorre o caminho. Os tempos estão em % de um laço de 16 s. */
const estacoes = [
  { nome: 'Marketing', de: 3, ate: 30, rostos: [isa, julio], passos: [
    { em: 6, titulo: 'Campanha no ar', detalhe: 'Instagram e Google' },
    { em: 17, titulo: 'Chegou um lead', detalhe: 'Harmonização facial' },
  ] },
  { nome: 'Comercial', de: 36, ate: 62, rostos: [lari, pedro], passos: [
    { em: 40, titulo: 'Primeiro contato', detalhe: 'Pelo WhatsApp' },
    { em: 51, titulo: 'Avaliação agendada', detalhe: 'Sexta, 09:30' },
  ] },
  { nome: 'Clínica', de: 68, ate: 94, rostos: [], passos: [
    { em: 72, titulo: 'Veio à avaliação', detalhe: 'Presença confirmada' },
    { em: 82, titulo: 'Virou paciente', detalhe: 'Tratamento iniciado' },
  ] },
];
const quadros = [
  ...estacoes.map((e, i) => `@keyframes p2-est-${i}{0%,${e.de}%{opacity:.34}${e.de + 3}%,${e.ate}%{opacity:1}${Math.min(e.ate + 4, 97)}%,94%{opacity:${i === 2 ? 1 : .6}}100%{opacity:.34}}`),
  ...estacoes.flatMap((e, i) => e.passos.map((p, k) => `@keyframes p2-passo-${i}-${k}{0%,${p.em}%{opacity:0;transform:translateY(10px)}${p.em + 4}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`)),
].join('');

/* 4. O plano do mês virando entrega (10/10, "fez isso, isso, isso e
   finalizou"): cada pendência tem a área e a pessoa do time que cuida dela.
   `em` é quando entra em andamento e `feito` quando conclui, em % de 14 s. */
const tarefas = [
  { titulo: 'Mais verba no Google', area: 'Mídia paga', dono: julio, em: 10, feito: 24 },
  { titulo: 'Novo roteiro para a recepção', area: 'Comercial', dono: lari, em: 34, feito: 48 },
  { titulo: 'Reativar pacientes antigos', area: 'CRM e automação', dono: milena, em: 58, feito: 72 },
];
const quadrosPlano = tarefas.map((t, k) => [
  `@keyframes p2-tar-${k}{0%,${t.em}%{opacity:.34}${t.em + 3}%,94%{opacity:1}100%{opacity:.34}}`,
  `@keyframes p2-tar-dono-${k}{0%,${t.em}%{opacity:0;transform:scale(.7)}${t.em + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
  `@keyframes p2-tar-ponto-${k}{0%,${t.em}%{opacity:0}${t.em + 3}%,${t.feito}%{opacity:1}${t.feito + 2}%,100%{opacity:0}}`,
  `@keyframes p2-tar-visto-${k}{0%,${t.feito}%{opacity:0;transform:scale(.5)}${t.feito + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
].join('')).join('') + '@keyframes p2-plano-fim{0%,80%{opacity:0;transform:translateY(6px)}84%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}';

const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const, class: 'p2-rosto' };
---
{peca === 'conexoes' && (
  <div class="p2 p2-fluxo" aria-hidden="true" data-p2 style="--d:0">
    <style is:inline set:html={quadros}></style>
    <div class="p2-fluxo__trilho">
      {estacoes.map((_, i) => <i style={`left:${i * 50}%`}></i>)}
      <span class="p2-fluxo__marca p2-anim" style="--a:p2-marca">
        <span class="p2-fluxo__rotulo p2-anim" style="--a:p2-rotulo-lead"><b></b>Lead</span>
        <span class="p2-fluxo__rotulo p2-fluxo__rotulo--paciente p2-anim" style="--a:p2-rotulo-paciente"><b></b>Paciente</span>
      </span>
    </div>
    {estacoes.map((e, i) => (
      <div class="p2-fluxo__estacao">
        <div class="p2-fluxo__quem p2-anim" style={`--a:p2-est-${i}`}>
          <span class="p2-rotulo">{e.nome}</span>
          {e.rostos.length
            ? <span class="p2-rostos">{e.rostos.map((r) => <Image src={r} {...rosto} />)}</span>
            : <span class="p2-fluxo__clinica"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 6.5v11M6.5 12h11" /></svg></span>}
        </div>
        <ul class="p2-fluxo__passos">
          {e.passos.map((p, k) => (
            <li class="p2-cartao p2-fluxo__passo p2-anim" style={`--a:p2-passo-${i}-${k}`}><strong>{p.titulo}</strong><span>{p.detalhe}</span></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

{peca === 'crm' && (
  /* 2. O quadro do CRM em tela clara sobre o cartão escuro (10/10, referências
     "Pipeline Tracking" e "Progress Tracking"): a recepção da clínica pega um
     lead em contato, leva para "Agendado" e a ficha ganha dia e hora. */
  <div class="p2 p2-crm" aria-hidden="true" data-p2 style="--d:0">
    <div class="p2-crm__topo">
      <strong>Pipeline</strong>
      <span class="p2-crm__time"><i>C</i><i>R</i></span>
    </div>
    <div class="p2-crm__quadro">
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Em contato<span class="p2-crm__conta"><b class="p2-anim" style="--a:p2-crm-antes">3</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">2</b></span></div>
        <div class="p2-ficha"><strong>Fios de PDO</strong><span><i></i>Instagram<em>há 5 h</em></span></div>
        <div class="p2-ficha p2-ficha--vaga"></div>
        <div class="p2-ficha p2-crm__sobe p2-anim" style="--a:p2-crm-sobe"><strong>Consulta</strong><span><i></i>Indicação<em>ontem</em></span></div>
        <div class="p2-ficha p2-crm__sobe p2-anim" style="--a:p2-crm-sobe"><strong>Botox</strong><span><i></i>Instagram<em>seg</em></span></div>
      </div>
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Agendado<span class="p2-crm__conta"><b class="p2-anim" style="--a:p2-crm-antes">1</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">2</b></span></div>
        <div class="p2-ficha"><strong>Retorno</strong><span><i></i>Site<em>sex, 09:30</em></span></div>
        <div class="p2-ficha p2-ficha--destino p2-anim" style="--a:p2-crm-destino"></div>
      </div>
      <div class="p2-crm__coluna">
        <div class="p2-crm__cabeca">Atendido<span class="p2-crm__conta"><b>2</b></span></div>
        <div class="p2-ficha"><strong>Laser</strong><span><i></i>Site<em>ter</em></span></div>
        <div class="p2-ficha"><strong>Peeling</strong><span><i></i>Google<em>seg</em></span></div>
        <div class="p2-ficha"><strong>Preenchimento</strong><span><i></i>Indicação<em>sex</em></span></div>
      </div>
      <div class="p2-crm__mover p2-anim" style="--a:p2-crm-mover">
        <div class="p2-ficha p2-ficha--solta p2-anim" style="--a:p2-crm-ergue">
          <strong>Harmonização</strong>
          <span><i></i>Google<em class="p2-crm__hora"><b class="p2-anim" style="--a:p2-crm-antes">há 2 h</b><b class="p2-crm__depois p2-anim" style="--a:p2-crm-depois">qui, 14:00</b></em></span>
        </div>
        <div class="p2-crm__cursor p2-anim" style="--a:p2-crm-cursor">
          <svg viewBox="0 0 16 16" focusable="false"><path d="M1.5 1.5l12 4.6-5.2 2.2-2.2 5.2z" /></svg>
          <span class="p2-crm__etiqueta"><b>Recepção</b><span><i class="p2-anim" style="--a:p2-crm-fala-1">Agendando a avaliação…</i><i class="p2-anim" style="--a:p2-crm-fala-2">Agendada: quinta, 14:00</i></span></span>
        </div>
      </div>
    </div>
  </div>
)}

{peca === 'automacao' && (
  <div class="p2 p2-conversa" aria-hidden="true">
    <div class="p2-conversa__linha" data-p2 style="--d:0">
      <span class="p2-cartao p2-balao">Sua avaliação é amanhã, às 14:00. Podemos confirmar a sua presença?</span>
      <span class="p2-meta">Lembrete enviado pelo WhatsApp</span>
    </div>
    <div class="p2-conversa__linha p2-conversa__linha--resposta" data-p2 style="--d:500">
      <span class="p2-balao p2-balao--resposta">Confirmado, obrigada!</span>
    </div>
    <div class="p2-estado" data-p2 style="--d:900"><i></i>Presença confirmada na agenda</div>
  </div>
)}

{peca === 'decisao' && (
  <div class="p2 p2-cartao p2-plano" aria-hidden="true" data-p2 style="--d:0">
    <style is:inline set:html={quadrosPlano}></style>
    <div class="p2-plano__topo">
      <Image src={maria} {...rosto} />
      <div><strong>Plano de outubro</strong><span>Reunião mensal com a Renke</span></div>
    </div>
    <ul class="p2-plano__lista">
      {tarefas.map((t, k) => (
        <li class="p2-tarefa p2-anim" style={`--a:p2-tar-${k}`}>
          <span class="p2-tarefa__marca"><b class="p2-tarefa__ponto p2-anim" style={`--a:p2-tar-ponto-${k}`}></b><b class="p2-tarefa__visto p2-anim" style={`--a:p2-tar-visto-${k}`}></b></span>
          <span class="p2-tarefa__texto">{t.titulo}<span>{t.area}</span></span>
          <Image src={t.dono} {...rosto} class="p2-rosto p2-anim" style={`--a:p2-tar-dono-${k}`} />
        </li>
      ))}
    </ul>
    <div class="p2-plano__fim p2-anim" style="--a:p2-plano-fim"><i></i>Outubro entregue. Próxima reunião em novembro.</div>
  </div>
)}

{peca === 'posicionamento' && (
  <div class="p2 p2-estudo" aria-hidden="true">
    <Image src={sede} alt="" class="p2-estudo__foto" format="webp" quality={76} widths={[480, 800, 1100]} sizes="(min-width: 1100px) 30vw, 100vw" loading="lazy" />
    <div class="p2-cartao p2-estudo__nota" data-p2 style="--d:200">
      <span class="p2-rostos"><Image src={milena} {...rosto} /><Image src={julio} {...rosto} /></span>
      <div><strong>Estudo de concorrentes</strong><span>Feito pelo nosso time</span></div>
    </div>
  </div>
)}
