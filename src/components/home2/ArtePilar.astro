---
/**
 * Cenas dos cinco pilares do Protocolo Revena (28/09/2026): interfaces
 * conceituais do serviço, sem métricas nem dados de pacientes fictícios.
 * Cada cena mora em arte/pilares/; a linguagem comum está em
 * src/styles/ilustracoes.css e arte/Defs.astro.
 *
 * Os três primeiros cartões são 4:3 (viewBox 400 × 300). Os dois últimos
 * são largos (16:9) no desktop e voltam a 4:3 no celular: a cena tem
 * 640 × 360 e é recortada ao centro (slice), com o essencial numa área
 * segura de x 80 a 560. Nas duas medidas, uma unidade do viewBox dá quase
 * um pixel no desktop de 1600px, e os textos saem no mesmo corpo.
 */
import '../../styles/ilustracoes.css';
import Defs from './arte/Defs.astro';
import Jornada from './arte/pilares/Jornada.astro';
import Crm from './arte/pilares/Crm.astro';
import Automacao from './arte/pilares/Automacao.astro';
import Decisao from './arte/pilares/Decisao.astro';
import Posicionamento from './arte/pilares/Posicionamento.astro';

interface Props { tipo: number }
const { tipo } = Astro.props;
const cenas = [Jornada, Crm, Automacao, Decisao, Posicionamento];
const Cena = cenas[tipo];
const p = `pilar-${tipo}`;
const larga = tipo >= 3;
---
{Cena && (
  <svg
    class:list={['arte', 'arte-pilar', `arte-pilar--${tipo}`]}
    viewBox={larga ? '0 0 640 360' : '0 0 400 300'}
    preserveAspectRatio={larga ? 'xMidYMid slice' : 'xMidYMid meet'}
    fill="none" aria-hidden="true" focusable="false"
  >
    <Defs p={p} />
    <Cena p={p} />
  </svg>
)}
