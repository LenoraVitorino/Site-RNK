---
/**
 * Cenas dos sete ganhos de "O que muda na sua clínica" (28/09/2026):
 * ilustrações conceituais, sem indicadores fictícios. Cada cena mora em
 * arte/beneficios/ (viewBox 520 × 250); a linguagem comum está em
 * src/styles/ilustracoes.css e arte/Defs.astro.
 */
import '../../styles/ilustracoes.css';
import Defs from './arte/Defs.astro';
import Aquisicao from './arte/beneficios/Aquisicao.astro';
import Conversao from './arte/beneficios/Conversao.astro';
import Processos from './arte/beneficios/Processos.astro';
import Investimento from './arte/beneficios/Investimento.astro';
import Dados from './arte/beneficios/Dados.astro';
import Replicavel from './arte/beneficios/Replicavel.astro';
import Mercado from './arte/beneficios/Mercado.astro';

interface Props { tipo: number }
const { tipo } = Astro.props;
const cenas = [Aquisicao, Conversao, Processos, Investimento, Dados, Replicavel, Mercado];
const Cena = cenas[tipo];
const p = `beneficio-${tipo}`;
---
{Cena && (
  <svg class:list={['arte', 'arte-beneficio', `arte-beneficio--${tipo}`]} viewBox="0 0 520 250" fill="none" aria-hidden="true" focusable="false">
    <Defs p={p} />
    <g class="arte-beneficio__cena"><Cena p={p} /></g>
  </svg>
)}
<style>
  .arte-beneficio { height: auto; }
  .arte-beneficio__cena { transition: transform .9s var(--a-entra); }
  :global(.operacao__cartao:hover) .arte-beneficio__cena { transform: translateY(-3px); }
  @media (prefers-reduced-motion: reduce) { .arte-beneficio__cena { transition: none; } }
</style>
