---
/**
 * Dizemos o que fazer todo mês (02/10/2026): um mini gráfico desenhado em
 * grafite direto sobre o amarelo, sem fundo nem moldura. A Lenora reprovou
 * a palavra "Decisão" ao fundo, as barras com a etiqueta "Investir mais",
 * os indicadores em linhas e o painel de fundo escuro ("não quero fundo
 * escuro, deixe sem fundo, mais minimalista"). Ficam só duas linhas de
 * quatro meses (o faturamento de dois canais), o ponto do mês atual, a
 * linha de base e os meses. Sem números. Estático.
 * Especificação em docs/04-design/protocolo-ilustracoes-prompts.md.
 */
import '../../styles/ilustracoes.css';

const meses = ['jul', 'ago', 'set', 'out'];
/* Gráfico de x 0 a 216 (4 de folga para o ponto); os meses caem em passos iguais. */
const X0 = 0, X1 = 216, BASE = 62;
const xs = meses.map((_, i) => X0 + (i * (X1 - X0)) / (meses.length - 1));
const principal = 'M0 50C24 49 46 36 72 38S114 23 144 24S190 8 216 4';
const apoio = 'M0 55C26 55 48 47 72 48S116 41 144 42S192 35 216 36';
---
<svg class="arte grafico-decisao" viewBox="0 0 220 80" fill="none" aria-hidden="true" focusable="false">
  <path d={`M${X0} ${BASE + 0.5}H220`} class="grafico-decisao__base" />
  <path d={apoio} class="grafico-decisao__linha grafico-decisao__linha--apoio" />
  <path d={principal} class="grafico-decisao__linha" />
  <circle cx="216" cy="4" r="3.5" class="grafico-decisao__ponto" />
  {meses.map((m, i) => (
    <text x={xs[i]} y="78" text-anchor={i === 0 ? 'start' : i === meses.length - 1 ? 'end' : 'middle'} class:list={['grafico-decisao__mes', { 'grafico-decisao__mes--atual': i === meses.length - 1 }]}>{m}</text>
  ))}
</svg>

<style>
  .grafico-decisao { height: auto; overflow: visible; }
  .grafico-decisao__base { stroke: #161616; stroke-opacity: .22; }
  .grafico-decisao__linha { stroke: #161616; stroke-width: 1.8; stroke-linecap: round; }
  .grafico-decisao__linha--apoio { stroke-opacity: .28; stroke-width: 1.4; }
  .grafico-decisao__ponto { fill: #161616; }
  .grafico-decisao__mes { font-size: 10px; fill: #161616; fill-opacity: .55; }
  .grafico-decisao__mes--atual { fill-opacity: 1; font-weight: 500; }
</style>
