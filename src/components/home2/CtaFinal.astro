---
/** Chamada de contato centralizada, com logos abaixo do botão nas duas
    versões. A marca Renke ocupa os espaços enquanto os clientes não têm
    seus arquivos disponíveis (Lenora, 01/10). */
import Botao from '../ui/Botao.astro';
import Selo from '../ui/Selo.astro';
import LogosClientes from './LogosClientes.astro';
import { copyLiteral } from '../../data/versao';
---
<section class="secao secao--amarela" id="fale" aria-labelledby="fale-titulo">
  <div class="container chamada">
    <div class="chamada__miolo entra">
      {!copyLiteral && <Selo class="cabeca-dobra__selo">Vagas limitadas</Selo>}
      <h2 class="titulo caps" id="fale-titulo">Limitado a 1 nova clínica por mês.</h2>
      <p>Cada projeto começa com diagnóstico. Não usamos template. Não terceirizamos.</p>
      <Botao href="/contato" class="botao--lg">Converse com a equipe</Botao>
    </div>
    <div class="chamada__logos entra"><LogosClientes /></div>
  </div>
</section>
