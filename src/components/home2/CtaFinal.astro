---
/** Chamada de contato: composição tipográfica com o número de vagas. */
import Botao from '../ui/Botao.astro';
---
<section class="secao secao--amarela" id="fale" aria-labelledby="fale-titulo">
  <div class="container chamada">
    <span class="chamada__numero" aria-hidden="true">01</span>
    <div class="chamada__miolo entra">
      <h2 class="titulo caps" id="fale-titulo">Limitado a 1 nova clínica por mês.</h2>
      <p>Cada projeto começa com diagnóstico. Não usamos template. Não terceirizamos.</p>
      <Botao href="/contato" class="botao--lg">Converse com a equipe</Botao>
    </div>

  </div>
</section>
