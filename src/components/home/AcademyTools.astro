---
import Tag from '../anotacoes/Tag.astro';
import Media from '../anotacoes/Media.astro';

const blocos = [
  {
    eyebrow: 'Para Agências',
    titulo: 'Renke Academy',
    texto:
      'Você é dono de agência? O Renke Academy abre os bastidores da nossa operação para você ' +
      'modelar. Método, processos e ferramentas.',
    cta: '→ Conhecer a Renke Academy',
    rota: '/academy',
    slot: '06',
  },
  {
    eyebrow: 'Tecnologia',
    titulo: 'Renke Tools',
    texto:
      'Tecnologias proprietárias construídas por quem está nas trincheiras todo dia. Nosso ' +
      'método produtizado em softwares.',
    cta: '→ Conhecer a Renke Tools',
    rota: '/tools',
    slot: '07',
  },
];
---
<section class="section section--alt">
  <Tag texto="SEÇÃO 6 · ACADEMY + TOOLS" />
  <div class="container">
    <div class="duo">
      {blocos.map((b) => (
        <article class="duo__col vidro vidro--claro entra">
          <p class="eyebrow">{b.eyebrow}</p>
          <h3>{b.titulo}</h3>
          <Media id={b.slot} />
          <p>{b.texto}</p>
          <a href="#" class="link-arrow" data-rota={b.rota}>{b.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>
