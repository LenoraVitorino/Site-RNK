---
import { resultados, hero } from '../../data/home';
import Botao from '../ui/Botao.astro';
---
<section class="section">
  <div class="container">
    <p class="eyebrow">Resultados</p>
    <h2>O que muda quando a operação tem estrutura.</h2>

    <div class="cards cards--results">
      {resultados.map((r) => (
        <article class="result vidro entra">
          <p class="result__specialty">{r.especialidade}</p>
          <p class="result__before">{r.antes}</p>
          <p class="result__number">{r.numero}</p>
          <p class="result__after">{r.depois}</p>
        </article>
      ))}
    </div>

    <div class="cards cards--testimonials">
      {[1, 2].map(() => (
        <article class="testimonial vidro entra">
          <span class="testimonial__photo">05<br />FOTO</span>
          <p class="testimonial__quote"><em>"[depoimento pendente]"</em></p>
          <p class="testimonial__author">Nome · Especialidade · Cidade</p>
        </article>
      ))}
    </div>

    <p><Botao variante="relevo" href="#">{hero.cta}</Botao></p>
  </div>
</section>
