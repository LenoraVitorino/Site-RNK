---
import { resultados, hero } from '../../data/home';
import Tag from '../wf/Tag.astro';
import Note from '../wf/Note.astro';
---
<section class="section">
  <Tag texto="SEÇÃO 4 · RESULTADOS" />
  <div class="container">
    <p class="eyebrow">Resultados</p>
    <h2>O que muda quando a operação tem estrutura.</h2>

    <Note>⚠️ Números são placeholder — serão substituídos por dados reais (nota do próprio briefing).</Note>

    <div class="cards cards--results">
      {resultados.map((r) => (
        <article class="result">
          <p class="result__specialty">{r.especialidade}</p>
          <p class="result__before">{r.antes}</p>
          <p class="result__number">{r.numero}</p>
          <p class="result__after">{r.depois}</p>
        </article>
      ))}
    </div>

    <div class="cards cards--testimonials">
      {[1, 2].map(() => (
        <article class="testimonial">
          <span class="testimonial__photo">FOTO<br />real</span>
          <p class="testimonial__quote"><em>"[depoimento pendente]"</em></p>
          <p class="testimonial__author">Nome · Especialidade · Cidade</p>
        </article>
      ))}
    </div>
    <Note>⚠️ Depoimentos não fornecidos no briefing.</Note>

    <p><a href="#" class="btn btn--primary">{hero.cta}</a></p>
  </div>
</section>
