---
import { hero } from '../../data/home';
import Media from '../ui/Media.astro';
import Botao from '../ui/Botao.astro';

/*
 * Diagramação em duas colunas: o argumento à esquerda, o visual à direita.
 *
 * Antes era tudo empilhado — H1, sub, números, CTA, texto, logos e um visual
 * 16:9 de largura cheia. O hero passava de 1.500px e o visual só aparecia
 * depois de rolar. Lado a lado, argumento e prova entram juntos na mesma tela.
 *
 * Os números viraram chips: em linha corrida eles liam como legenda, e são
 * prova social — o segundo elemento mais importante do bloco.
 */
---
<section class="section section--hero fundo-vivo">
  <div class="container">
    <div class="hero">

      <div class="hero__texto">
        <h1 class="hero__title">
          Isso não é <s>marketing para clínicas</s>.<br />
          <strong>É RevOps</strong>
        </h1>

        <p class="hero__sub callout">
          Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.
        </p>

        <ul class="chips">
          {hero.numeros.map((n) => <li class="chip vidro vidro--claro">{n}</li>)}
        </ul>

        <p class="hero__lead">{hero.lead}</p>

        <div class="hero__acoes">
          <Botao variante="brilho" href="#">{hero.cta}</Botao>
        </div>
      </div>

      <figure class="hero__visual entra">
        <Media id="01" />
        <figcaption class="hero__caption"><em>{hero.legenda}</em></figcaption>
      </figure>

    </div>
  </div>

  <div class="prova">
    <p class="proof__title">Doutores que confiam na Renke</p>
    <div class="faixa">
      <ul class="faixa__trilho logos">
        {[1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6].map((n) => <li class="logos__item">LOGO {n}</li>)}
      </ul>
    </div>
  </div>
</section>
