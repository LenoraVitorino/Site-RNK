---
import { hero } from '../../data/home';
import Tag from '../wf/Tag.astro';
import Note from '../wf/Note.astro';
import Media from '../wf/Media.astro';

/*
 * Ordem conforme as notas do designer:
 * H1 → sub → números → CTA → logos → visual → legenda.
 * O parágrafo de apoio vem da copy e entra depois do CTA.
 *
 * Um único visual no hero: as notas pedem o mockup de dashboard e oferecem o
 * motion/GIF como alternativa para o MESMO slot, não como um segundo bloco.
 */
---
<section class="section section--hero">
  <Tag texto="SEÇÃO 1 · HERO" />
  <div class="container">
    <h1 class="hero__title">
      Isso não é <s>marketing para clínicas</s>.<br />
      <strong>É RevOps</strong>
    </h1>

    <p class="hero__sub callout">
      Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.
    </p>

    <ul class="stats">
      {hero.numeros.map((n) => <li>{n}</li>)}
    </ul>
    <Note>⚠️ Conflita com "+140 clínicas" usado na Seção 7 e nas metatags. Decisão D1 pendente.</Note>

    <p><a href="#" class="btn btn--primary">{hero.cta}</a></p>

    <p class="hero__lead">{hero.lead}</p>

    <div class="proof">
      <p class="proof__title">Doutores que confiam na Renke</p>
      <ul class="logos">
        {[1, 2, 3, 4, 5, 6].map((n) => <li class="logos__item">LOGO {n}</li>)}
      </ul>
      <Note>Opacidade reduzida, leve sobreposição, tooltip no hover com nome + especialidade.</Note>
    </div>

    <Media
      label="[VISUAL] Mockup de dashboard com dados de performance"
      hint="desktop ou tablet, dados borrados por confidencialidade · alternativa: motion 3–5s do fluxo do dado (anúncio → CRM → agendamento → venda)"
      variante="wide"
    />

    <p class="hero__caption"><em>{hero.legenda}</em></p>
  </div>
</section>
