---
import { hero } from '../../data/home';
import Botao from '../ui/Botao.astro';

/*
 * Coluna única, centrada. O mockup do dashboard saiu, e com ele a segunda
 * coluna — um hero em duas colunas com um lado vazio fica torto.
 *
 * A legenda "Você não controla o que não enxerga" era do visual. Sobreviveu
 * porque funciona sozinha, agora como fecho do bloco.
 */
---
<section class="section section--hero">
  <div class="container">
    <div class="hero">
      <h1 class="hero__title">
        Isso não é <s>marketing para clínicas</s>.<br />
        <strong>É RevOps</strong>
      </h1>

      <p class="hero__sub">
        Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.
      </p>

      <p class="hero__lead">{hero.lead}</p>

      <ul class="chips">
        {hero.numeros.map((n) => <li class="chip vidro">{n}</li>)}
      </ul>

      <div class="hero__acoes">
        <Botao variante="brilho" href="#">{hero.cta}</Botao>
      </div>

      <p class="hero__caption"><em>{hero.legenda}</em></p>
    </div>
  </div>
</section>
