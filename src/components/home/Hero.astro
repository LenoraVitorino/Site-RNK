---
import { hero } from '../../data/home';
import Botao from '../ui/Botao.astro';

/*
 * Coluna única, centrada. O mockup do dashboard saiu, e com ele a segunda
 * coluna — um hero em duas colunas com um lado vazio fica torto.
 *
 * A legenda "Você não controla o que não enxerga" era do visual. Sobreviveu
 * porque funciona sozinha, agora como fecho do bloco.
 */
---
<section class="section section--hero">
  <div class="container">
    <div class="hero">
      <!--
        Duas tomadas empilhadas na mesma célula de grid, então a largura é a
        da maior e a troca não empurra nada. O aria-label entrega a frase
        inteira e limpa para leitor de tela; as duas tomadas seguem no DOM,
        o que mantém "marketing para clínicas" indexável.
      -->
      <h1 class="hero__title" aria-label="Isso não é marketing para clínicas. Isso é RevOps.">
        <span class="tomadas">
          <span class="tomada tomada--sai" aria-hidden="true">Isso não é</span>
          <span class="tomada tomada--entra" aria-hidden="true">Isso é</span>
        </span>
        <span class="tomadas tomadas--eixo">
          <span class="tomada tomada--sai riscado" aria-hidden="true">marketing para clínicas.</span>
          <span class="tomada tomada--entra realce" aria-hidden="true">RevOps</span>
        </span>
      </h1>

      <p class="hero__sub">
        Revenue Operations estratégico para transformar clínicas médicas em negócios de alta performance.
      </p>

      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__acoes">
        <Botao variante="brilho" href="#">{hero.cta}</Botao>
      </div>

      <!-- Provisório: os números seguem abaixo do CTA até definirmos se vão
           para a lateral ou para a faixa de prova social. -->
      <ul class="chips">
        {hero.numeros.map((n) => <li class="chip vidro">{n}</li>)}
      </ul>

      <p class="hero__caption"><em>{hero.legenda}</em></p>
    </div>
  </div>
</section>
