---
import Icone from './ui/Icone.astro';
import { menu, acaoHeader } from '../data/nav';
import { existe } from '../data/rotas';
import Botao from './ui/Botao.astro';

// Mostrar somente destinos existentes; os cards promocionais estão suspensos.
const temPagina = (rota: string) => existe(rota.split('#')[0] || '/');
const itensMenu = menu.flatMap((item) => {
  if (!('grupos' in item)) return temPagina(item.rota) ? [item] : [];
  const grupos = item.grupos
    .map((g) => ({ ...g, itens: g.itens.filter((sub) => temPagina(sub.rota)) }))
    .filter((g) => g.itens.length);
  if (!grupos.length) return [];
  return [{ ...item, grupos }];
});
---
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

<header class="header" id="header">
  <div class="header__inner">
    <a href="/" class="logo" aria-label="Grupo RNK — página inicial">
      <img class="logo__img" src="/marca/grupo-rnk-branco.png" alt="Grupo RNK" width="875" height="120" />
    </a>

    <!-- A ação de conversão fica fora do menu: visível no celular, sem abrir o drawer. -->
    <div class="header__acao">
      <Botao variante="relevo" href={acaoHeader.rota}>{acaoHeader.rotulo}</Botao>
    </div>

    <button
      type="button" class="nav-toggle" id="navToggle"
      aria-expanded="false" aria-controls="navPrincipal" aria-label="Abrir menu">
<Icone nome="Menu" class="nav-icone-menu" /><Icone nome="X" class="nav-icone-fechar" />
    </button>

    <!-- Desktop: pílula única que desliza até o item sob o cursor ou com o painel aberto. -->
    <span class="nav__realce" aria-hidden="true"></span>

    <nav class="nav" id="navPrincipal" aria-label="Navegação principal">
      <ul class="nav__list">
        {itensMenu.map((item) =>
          'grupos' in item ? (
            <li class="nav__item nav__item--has-menu">
              <button
                type="button" class="nav__link nav__trigger"
                aria-expanded="false" aria-controls={item.id}>
                {item.rotulo} <Icone nome="ChevronDown" class="nav-chevron" size={16} />
              </button>
              <div class="megamenu" id={item.id} hidden>
                <div class="megamenu__inner">
                  <span class="megamenu__realce" aria-hidden="true"></span>
                  {item.grupos.map((grupo) => (
                    <div class="megamenu__coluna">
                      <ul class="megamenu__list">
                        {grupo.itens.map((sub, i) => (
                          <li style={`--i: ${i}`}>
                            {temPagina(sub.rota)
                              ? <a href={sub.rota}>
                                  {sub.plano && <span class="megamenu__plano" aria-hidden="true"><img class="megamenu__plano--escuro" src={`/icones/plano-${sub.plano}-dark.svg`} alt="" width="24" height="24" loading="lazy" /><img class="megamenu__plano--claro" src={`/icones/plano-${sub.plano}-light.svg`} alt="" width="24" height="24" loading="lazy" /></span>}
                                  <span class="megamenu__rotulo">{sub.rotulo}{sub.sufixo && <em> {sub.sufixo}</em>}</span>
                                  <Icone nome="ArrowRight" class="megamenu__seta" size={16} />
                                </a>
                              : <span class="nav--pendente">{sub.rotulo} <em>em breve</em></span>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}

                </div>
              </div>
            </li>
          ) : (
            <li class="nav__item">
              {temPagina(item.rota)
                ? <a href={item.rota} class="nav__link" aria-current={item.atual ? 'page' : undefined}>{item.rotulo}</a>
                : <span class="nav__link nav--pendente">{item.rotulo} <em>em breve</em></span>}
            </li>
          )
        )}
      </ul>
    </nav>
  </div>
</header>

<div class="nav-overlay" id="navOverlay" hidden></div>


<script>
  /* Desktop: mega-menu no hover e no foco. Mobile: drawer com acordeão. */
  const DESKTOP = window.matchMedia('(min-width: 1024px)');

  const header = document.getElementById('header')!;
  const navToggle = document.getElementById('navToggle')!;
  const nav = document.getElementById('navPrincipal')!;
  const overlay = document.getElementById('navOverlay')!;
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav__trigger'));

  const panelOf = (t: HTMLElement) =>
    document.getElementById(t.getAttribute('aria-controls') || '');

  // Dropdowns independentes; o cabeçalho mantém sua altura.
  const caixa = header.querySelector<HTMLElement>('.header__inner')!;
  let fechar = 0;

  // Pílula e realce: posicionados por variáveis CSS; na primeira aparição
  // saltam para o lugar sem animar e só então aparecem.
  const realceTopo = header.querySelector<HTMLElement>('.nav__realce')!;
  const expandido = () => triggers.find((x) => x.getAttribute('aria-expanded') === 'true') || null;
  header.classList.add('tem-realce');

  function posiciona(realce: HTMLElement, x: number, y: number, w: number, h: number) {
    const surgindo = !realce.classList.contains('is-visivel');
    if (surgindo) realce.classList.add('mm-salto');
    realce.style.setProperty('--x', `${x}px`);
    realce.style.setProperty('--y', `${y}px`);
    realce.style.setProperty('--w', `${w}px`);
    realce.style.setProperty('--h', `${h}px`);
    if (surgindo) { void realce.offsetWidth; realce.classList.remove('mm-salto'); }
    realce.classList.add('is-visivel');
  }

  let alvoTopo: HTMLElement | null = null;
  function moveTopo(el: HTMLElement | null) {
    alvoTopo = el;
    if (!el || !DESKTOP.matches) { realceTopo.classList.remove('is-visivel'); return; }
    const r = el.getBoundingClientRect();
    const c = caixa.getBoundingClientRect();
    posiciona(realceTopo, r.left - c.left - caixa.clientLeft, r.top - c.top - caixa.clientTop, r.width, r.height);
  }

  function openSubmenu(t: HTMLElement) {
    const panel = panelOf(t);
    if (!panel) return;
    if (DESKTOP.matches) {
      // O painel novo entra do lado de onde o cursor veio; o anterior sai pelo outro.
      const i = triggers.indexOf(t as HTMLButtonElement);
      const anterior = expandido();
      const j = anterior && anterior !== t ? triggers.indexOf(anterior) : -1;
      if (panel.hidden) {
        panel.classList.add('mm-salto');
        panel.dataset.de = j < 0 ? 'cima' : j < i ? 'direita' : 'esquerda';
        void panel.offsetWidth;
        panel.classList.remove('mm-salto');
      }
      const painelAnterior = anterior && anterior !== t ? panelOf(anterior) : null;
      if (painelAnterior) painelAnterior.dataset.de = j < i ? 'esquerda' : 'direita';
      closeAllSubmenus(t);
      clearTimeout(fechar);
      header.classList.add('header--menu');
      moveTopo(t);
    }
    t.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
  }

  function closeSubmenu(t: HTMLElement) {
    const panel = panelOf(t);
    if (!panel) return;
    t.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    panel.querySelector('.megamenu__realce')?.classList.remove('is-visivel');
    if (!expandido()) {
      header.classList.remove('header--menu');
      if (!sobreLista && alvoTopo === t) moveTopo(null);
    }
  }

  const closeAllSubmenus = (except?: HTMLElement) =>
    triggers.forEach((t) => t !== except && closeSubmenu(t));

  triggers.forEach((trigger) => {
    const item = trigger.closest('.nav__item') as HTMLElement;

    trigger.addEventListener('click', (e) => {
      e.preventDefault();

      // Desktop: o hover já abre o painel, então o clique nunca fecha — se
      // alternasse, clicar no item sob o cursor fecharia o menu recém-aberto.
      if (DESKTOP.matches) {
        openSubmenu(trigger);
        return;
      }

      trigger.getAttribute('aria-expanded') === 'true'
        ? closeSubmenu(trigger)
        : openSubmenu(trigger);
    });

    trigger.addEventListener('mouseenter', () => {
      if (!DESKTOP.matches) return;
      openSubmenu(trigger);
    });

    item.addEventListener('focusout', (e) => {
      if (!DESKTOP.matches) return;
      if (!item.contains(e.relatedTarget as Node)) closeSubmenu(trigger);
    });
  });

  // A pílula segue o cursor pelos itens do topo e volta ao painel aberto ao sair.
  const lista = nav.querySelector<HTMLElement>('.nav__list')!;
  let sobreLista = false;
  nav.querySelectorAll<HTMLElement>('.nav__link').forEach((link) => {
    link.addEventListener('mouseenter', () => { if (DESKTOP.matches) moveTopo(link); });
    link.addEventListener('focus', () => { if (DESKTOP.matches) moveTopo(link); });
  });
  lista.addEventListener('mouseenter', () => { sobreLista = true; });
  lista.addEventListener('mouseleave', () => { sobreLista = false; moveTopo(expandido()); });
  lista.addEventListener('focusout', (e) => {
    if (!lista.contains(e.relatedTarget as Node)) moveTopo(expandido());
  });

  // Dentro do painel, um realce desliza até o item sob o cursor ou com foco.
  document.querySelectorAll<HTMLElement>('.megamenu__inner').forEach((inner) => {
    const realce = inner.querySelector<HTMLElement>('.megamenu__realce');
    if (!realce) return;
    // Soma os deslocamentos até a caixa (o li é posicionado), sem ler transformações.
    const leva = (a: HTMLElement) => {
      if (!DESKTOP.matches) return;
      let x = 0, y = 0, n: HTMLElement | null = a;
      while (n && n !== inner) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      posiciona(realce, x, y, a.offsetWidth, a.offsetHeight);
    };
    inner.querySelectorAll<HTMLElement>('.megamenu__list a').forEach((a) => {
      a.addEventListener('mouseenter', () => leva(a));
      a.addEventListener('focus', () => leva(a));
    });
    inner.addEventListener('mouseleave', () => realce.classList.remove('is-visivel'));
    inner.addEventListener('focusout', (e) => {
      if (!inner.contains(e.relatedTarget as Node)) realce.classList.remove('is-visivel');
    });
  });

  // Passar o mouse pelos itens sem painel também fecha o que estiver aberto.
  document.querySelectorAll<HTMLElement>('.nav__item:not(.nav__item--has-menu)').forEach((item) =>
    item.addEventListener('mouseenter', () => { if (DESKTOP.matches) closeAllSubmenus(); }));
  caixa.addEventListener('mouseleave', () => {
    if (!DESKTOP.matches) return;
    clearTimeout(fechar);
    fechar = window.setTimeout(() => closeAllSubmenus(), 160);
  });
  caixa.addEventListener('mouseenter', () => clearTimeout(fechar));

  function openNav() {
    navToggle.setAttribute('aria-expanded', 'true');
    navToggle.setAttribute('aria-label', 'Fechar menu');
    nav.classList.add('is-open');
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeNav() {
    navToggle.setAttribute('aria-expanded', 'false');
    navToggle.setAttribute('aria-label', 'Abrir menu');
    nav.classList.remove('is-open');
    overlay.hidden = true;
    document.body.style.overflow = '';
    closeAllSubmenus();
  }

  navToggle.addEventListener('click', () =>
    nav.classList.contains('is-open') ? closeNav() : openNav()
  );
  overlay.addEventListener('click', closeNav);
  nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNav));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const aberto = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (aberto) {
      closeSubmenu(aberto);
      aberto.focus();
    } else if (nav.classList.contains('is-open')) {
      closeNav();
      navToggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!DESKTOP.matches) return;
    if (caixa.contains(e.target as Node)) return;
    closeAllSubmenus();
  });

  const onBreakpoint = () => {
    closeAllSubmenus();
    moveTopo(null);
    if (DESKTOP.matches) closeNav();
  };
  DESKTOP.addEventListener('change', onBreakpoint);

  let ticking = false;
  /* Cabeçalho camaleão: lê a cor de fundo do que está logo abaixo dele e
     assume o mesmo tom (escuro, claro ou amarelo). Sem lista de seções:
     funciona em qualquer página. */
  const TONS = ['header--escuro', 'header--claro', 'header--amarelo'];
  const tomDeCor = (cor: string) => {
    const m = cor.match(/[\d.]+/g);
    if (!m || m.length < 3) return null;
    const [r, g, b] = m.map(Number);
    if (m.length > 3 && Number(m[3]) < 0.9) return null;   // transparente ou translúcido: vale o fundo de trás
    const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    if (lum < 110) return 'header--escuro';
    if (r > 200 && g > 180 && b < 170) return 'header--amarelo';
    return 'header--claro';
  };
  const tomAbaixo = () => {
    const y = header.offsetHeight + 2;
    // Com o painel do menu aberto, o ponto de leitura cai em cima dele; sem
    // pular o cabeçalho inteiro a subida ia do painel direto ao body (escuro)
    // e o menu virava escuro sobre dobra clara (10/10/2026).
    let n: Element | null = document.elementsFromPoint(Math.round(window.innerWidth / 2), y).find((e) => !header.contains(e)) ?? null;
    // Só os fundos de dobra contam: botões e links (mesmo os de largura
    // total no celular), cartões e fichas (mais estreitos que 60% da tela)
    // são pulados, senão o cabeçalho piscava de tom a cada ficha clara ou
    // botão papel que passava por baixo dele (auditoria mobile, 28/09/2026).
    const minimo = window.innerWidth * 0.6;
    while (n && n !== document.documentElement) {
      const dobra = !n.closest('a, button') && n.getBoundingClientRect().width >= minimo;
      if (!header.contains(n) && dobra) {
        // Dobras de fundo translúcido (vidro claro) declaram o tom: data-tom.
        const dica = (n as HTMLElement).dataset?.tom;
        if (dica) return `header--${dica}`;
        const t = tomDeCor(getComputedStyle(n).backgroundColor);
        if (t) return t;
      }
      n = n.parentElement;
    }
    return tomDeCor(getComputedStyle(document.body).backgroundColor) ?? 'header--claro';
  };
  /* A caixa do cabeçalho só aparece quando a primeira dobra (a hero, ou o
     que estiver no topo) já passou por baixo dele. */
  const primeira = document.querySelector<HTMLElement>('main > :first-child');
  const aplicaCaixa = () => {
    const fim = primeira ? primeira.getBoundingClientRect().bottom : Infinity;
    header.classList.toggle('header--caixa', primeira ? fim <= header.offsetHeight : window.scrollY > 8);
  };
  const aplicaTom = () => {
    if (nav.classList.contains('is-open')) return;   // com o drawer aberto, o tom congela
    const t = tomAbaixo();
    if (header.classList.contains(t)) return;
    header.classList.remove(...TONS);
    header.classList.add(t);
  };
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header.classList.toggle('is-stuck', window.scrollY > 8);
      aplicaCaixa();
      aplicaTom();
      ticking = false;
    });
  }, { passive: true });
  window.addEventListener('resize', () => { aplicaCaixa(); aplicaTom(); }, { passive: true });
  aplicaCaixa();
  aplicaTom();
  // A hero anima sem rolar a página: checa de novo por um tempo depois do carregamento.
  let checagens = 0;
  const cadencia = setInterval(() => { aplicaTom(); if (++checagens > 40) clearInterval(cadencia); }, 500);
</script>
