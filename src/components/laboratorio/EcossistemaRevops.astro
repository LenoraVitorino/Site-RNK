---
/**
 * RASCUNHO (10/10/2026), em /laboratorio/home-clickup: a dobra do ecossistema
 * de RevOps que a Lenora pediu ("um ecossisteminha simulando o que é RevOps").
 * Molde: a grade de ecossistema do ClickUp e o pin do núcleo com seis peças
 * (…614311). Um núcleo, a operação da clínica, e seis frentes em volta,
 * ligadas por fios finos. Amarelo só no núcleo.
 * As frentes e os textos são provisórios: saem das cinco frentes do
 * Protocolo; trocar pelo material dela quando chegar.
 */
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';

const frentes: { nome: string; faz: string; icone: NomeIconeRenke }[] = [
  { nome: 'Marketing', faz: 'Traz o paciente certo', icone: 'mira' },
  { nome: 'Comercial', faz: 'Leva o lead até a consulta', icone: 'funil' },
  { nome: 'CRM', faz: 'Guarda cada contato', icone: 'camadas' },
  { nome: 'Atendimento', faz: 'Responde e confirma', icone: 'fluxo' },
  { nome: 'Dados', faz: 'Mostram onde agir', icone: 'dados' },
  { nome: 'Posicionamento', faz: 'Sustenta o valor', icone: 'bussola' },
];
/* Quadro de 1000 × 560: núcleo no centro, três frentes de cada lado. */
const ys = [92, 280, 468];
const fio = (lado: -1 | 1, y: number) => {
  const x0 = 500 + lado * 62, x1 = 500 + lado * 262;
  return `M${x0} 280 C ${500 + lado * 170} 280, ${500 + lado * 150} ${y}, ${x1} ${y}`;
};
---
<section class="er" aria-labelledby="er-titulo" data-er>
  <div class="container">
    <header class="er__cabeca">
      <Selo>RevOps</Selo>
      <h2 class="er__titulo" id="er-titulo">A clínica inteira <strong>numa operação só.</strong></h2>
      <p class="er__apoio">Cada frente alimenta a outra. A Renke conecta todas e mede o caminho do paciente de ponta a ponta.</p>
    </header>

    <div class="er__quadro">
      <svg class="er__fios" viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {ys.map((y, i) => (
          <>
            <path d={fio(-1, y)} />
            <path d={fio(1, y)} />
            <path class="er__pulso" style={`--d:${i * 1.4}s`} d={fio(-1, y)} pathLength="100" />
            <path class="er__pulso" style={`--d:${i * 1.4 + .7}s`} d={fio(1, y)} pathLength="100" />
          </>
        ))}
      </svg>
      <div class="er__nucleo">
        <span class="er__marca" aria-hidden="true"><i></i></span>
        <strong>Operação da clínica</strong>
      </div>
      <ul class="er__frentes">
        {frentes.map((f, i) => (
          <li class:list={['er__frente', i % 2 === 0 ? 'er__frente--e' : 'er__frente--d']} style={`--y:${ys[Math.floor(i / 2)] / 5.6}%;--i:${i}`}>
            <span class="er__icone" aria-hidden="true"><IconeRenke nome={f.icone} size={22} /></span>
            <span class="er__texto"><strong>{f.nome}</strong><span>{f.faz}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const er = document.querySelector<HTMLElement>('[data-er]');
  if (er && 'IntersectionObserver' in window) new IntersectionObserver(([e], o) => { if (e.isIntersecting) { er.classList.add('er--visto'); o.disconnect(); } }, { threshold: .3 }).observe(er);
  else er?.classList.add('er--visto');
</script>

<style>
  .er { --s: cubic-bezier(.22, 1, .36, 1); --am: var(--amarelo-marca, #FFD103); padding-block: var(--esp-secao, 112px); color: #f2f2ee; }
  .er__cabeca { display: grid; justify-items: center; text-align: center; gap: 20px; margin-bottom: clamp(36px, 4.5vw, 72px); }
  .er__titulo { margin: 0; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(34px, 3.4vw, 52px); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .er__titulo strong { font-weight: 500; }
  .er__apoio { margin: 0; max-width: 52ch; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; color: #aaa; text-wrap: pretty; }

  .er__quadro { position: relative; max-width: 1000px; margin-inline: auto; aspect-ratio: 1000 / 560; }
  .er__fios { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .er__fios path { fill: none; stroke: rgb(242 242 238 / .16); stroke-width: 1; vector-effect: non-scaling-stroke; }
  /* Um ponto de luz corre cada fio, devagar, da frente para o núcleo. */
  .er__fios .er__pulso { stroke: var(--am); stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 5 95; stroke-dashoffset: 5; opacity: 0; }
  .er__nucleo { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: grid; justify-items: center; gap: 12px; text-align: center; }
  .er__marca { display: grid; place-items: center; width: clamp(84px, 9vw, 124px); aspect-ratio: 1; border-radius: 26%; background: linear-gradient(160deg, #1d1d1c, #0e0e0e); box-shadow: 0 0 0 1px rgb(242 242 238 / .12) inset, 0 30px 60px -30px #000; }
  .er__marca i { width: 28%; aspect-ratio: 1; border-radius: 3px; background: var(--am); transform: rotate(45deg); }
  .er__nucleo strong { position: absolute; top: calc(100% + 12px); white-space: nowrap; font-size: 14px; font-weight: 500; letter-spacing: -.01em; }
  .er__frentes { list-style: none; margin: 0; padding: 0; }
  .er__frente { position: absolute; top: var(--y); display: flex; align-items: center; gap: 14px; width: 23%; transform: translateY(-50%); }
  .er__frente--e { left: 0; flex-direction: row-reverse; text-align: right; }
  .er__frente--d { right: 0; }
  .er__icone { flex: none; display: grid; place-items: center; width: clamp(48px, 4.6vw, 60px); aspect-ratio: 1; border-radius: 28%; background: linear-gradient(160deg, #1b1b1a, #101010); box-shadow: 0 0 0 1px rgb(242 242 238 / .1) inset; color: #f2f2ee; }
  .er__texto { display: grid; gap: 3px; min-width: 0; }
  .er__texto strong { font-size: clamp(15px, 1.2vw, 17px); font-weight: 500; letter-spacing: -.015em; }
  .er__texto span { font-size: clamp(13px, 1vw, 14.5px); line-height: 1.35; color: rgb(242 242 238 / .56); }

  @keyframes er-pulso { 0% { stroke-dashoffset: 5; opacity: 0; } 12% { opacity: .9; } 88% { opacity: .9; } 100% { stroke-dashoffset: -95; opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .er__frente, .er__nucleo { opacity: 0; transition: opacity 1s var(--s), translate 1s var(--s); transition-delay: calc(var(--i, 0) * 90ms); }
    .er__frente { translate: 0 12px; }
    .er--visto :is(.er__frente, .er__nucleo) { opacity: 1; translate: none; }
    /* Corre do núcleo para a frente no desenho; invertido para parecer que a frente alimenta o núcleo. */
    .er--visto .er__pulso { animation: er-pulso 5.6s linear var(--d) infinite reverse; }
  }
  @media (max-width: 859.98px) {
    .er__quadro { aspect-ratio: auto; display: grid; justify-items: center; gap: 40px; }
    .er__fios { display: none; }
    .er__nucleo { position: static; transform: none; }
    .er__nucleo strong { position: static; }
    .er__frentes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 16px; width: 100%; }
    .er__frente { position: static; width: auto; transform: none; flex-direction: row; text-align: left; }
  }
</style>
