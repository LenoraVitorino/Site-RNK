---
/**
 * TESTE (10/10/2026), em /laboratorio/home-clickup: "O que muda na sua
 * clínica" no molde das pílulas com painel do ClickUp e dos pins "Smart,
 * seamless debt recovery" e Polymet. À esquerda, as sete perguntas em lista
 * (a ativa acesa); à direita, um painel só, com a conversa daquela pergunta e
 * um recorte de dados. Os números dos recortes são fictícios. Os textos são
 * os da home (PerguntasConversa.astro).
 */
import { Image } from 'astro:assets';
import Selo from '../ui/Selo.astro';
import lari from '../../assets/equipe/lari.jpg';
import julio from '../../assets/equipe/julio-caldeira.jpg';
import isa from '../../assets/equipe/isa.jpg';

type Linha = { r: string; v: string; p?: number; d?: boolean };
const conversa: { q: string; t: string; r: string; rec: { titulo: string; linhas: Linha[] } }[] = [
  { q: 'Quanto custa, de verdade, um paciente novo pra sua clínica?', t: 'Você passa a saber.', r: 'A gente mostra o custo por paciente e o retorno de cada canal.',
    rec: { titulo: 'Custo por paciente', linhas: [{ r: 'Instagram', v: 'R$ 184', p: 62, d: true }, { r: 'Google', v: 'R$ 236', p: 80 }, { r: 'Indicação', v: 'R$ 41', p: 14 }] } },
  { q: 'Dos leads que chegam, quantos sentam na cadeira do consultório?', t: 'Dá pra saber um por um.', r: 'A gente acompanha cada lead até o agendamento.',
    rec: { titulo: 'Do lead à consulta', linhas: [{ r: 'Leads', v: '120', p: 100 }, { r: 'Agendados', v: '46', p: 38 }, { r: 'Compareceram', v: '31', p: 26, d: true }] } },
  { q: 'Se sua secretária sai amanhã, o processo continua?', t: 'Continua.', r: 'A gente estrutura o comercial para a clínica não depender de uma só pessoa.',
    rec: { titulo: 'Rotina do comercial', linhas: [{ r: 'Primeiro contato', v: 'em 5 min', d: true }, { r: 'Retorno ao lead', v: 'automático' }, { r: 'Confirmação da consulta', v: 'automática' }] } },
  { q: 'Você sabe qual canal trouxe seus melhores pacientes este mês?', t: 'Com a gente, sabe.', r: 'Você vê de onde veio cada paciente e põe a verba no canal certo.',
    rec: { titulo: 'Receita por canal', linhas: [{ r: 'Indicação', v: '41%', p: 82, d: true }, { r: 'Instagram', v: '33%', p: 66 }, { r: 'Google', v: '26%', p: 52 }] } },
  { q: 'No mês ruim, você encontra o motivo nos dados, com facilidade?', t: 'Encontra.', r: 'Os indicadores mostram em que ponto a clínica perdeu e onde agir.',
    rec: { titulo: 'Onde o mês perdeu', linhas: [{ r: 'Leads', v: '+4%', p: 70 }, { r: 'Agendamentos', v: '−18%', p: 34, d: true }, { r: 'Comparecimento', v: '−2%', p: 62 }] } },
  { q: 'E no mês bom, você sabe o porquê para repetir o resultado?', t: 'Sabe, e repete.', r: 'O que deu certo vira processo e o resultado deixa de ser sorte.',
    rec: { titulo: 'O que deu certo', linhas: [{ r: 'Retorno no mesmo dia', v: 'virou regra', d: true }, { r: 'Lembrete na véspera', v: 'virou regra' }, { r: 'Reativação da base', v: 'em teste' }] } },
  { q: 'Você sabe o que seus concorrentes comunicam e que espaço deixam aberto?', t: 'A gente mapeia pra você.', r: 'O que a concorrência comunica e os espaços que ela deixa livres.',
    rec: { titulo: 'O que o mercado comunica', linhas: [{ r: 'Preço e promoção', v: '6 clínicas', p: 86 }, { r: 'Antes e depois', v: '4 clínicas', p: 58 }, { r: 'Acompanhamento', v: 'espaço livre', p: 8, d: true }] } },
];
const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const };
---
<section class="cl" id="perguntas" aria-labelledby="perguntas-titulo" data-cl>
  <div class="container cl__grade">
    <div class="cl__esquerda">
      <Selo>O que muda na sua clínica</Selo>
      <h2 class="cl__titulo" id="perguntas-titulo">Do seu paciente, você sabe tudo. <strong>E do seu negócio?</strong></h2>
      <ol class="cl__lista" role="tablist" aria-label="Perguntas">
        {conversa.map((p, i) => (
          <li><button class:list={['cl__pergunta', i === 0 && 'is-ativo']} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-aba={i}><span>{p.q}</span><i aria-hidden="true"></i></button></li>
        ))}
      </ol>
    </div>

    <div class="cl__painel">
      <div class="cl__topo">
        <span class="cl__rostos"><Image src={lari} {...rosto} /><Image src={julio} {...rosto} /><Image src={isa} {...rosto} /></span>
        <span class="cl__quem"><strong>Renke<i aria-hidden="true"></i></strong><span>Responde o que a sua clínica precisa saber</span></span>
      </div>
      <div class="cl__pilha" aria-live="polite">
        {conversa.map((p, i) => (
          <div class:list={['cl__par', i === 0 && 'is-ativo']} data-painel={i}>
            <p class="cl__balao cl__balao--dono">{p.q}</p>
            <p class="cl__balao cl__balao--renke"><strong><i aria-hidden="true"></i>{p.t}</strong> {p.r}</p>
            <div class="cl__recorte" aria-hidden="true">
              <span class="cl__recorte-titulo">{p.rec.titulo}</span>
              {p.rec.linhas.map((l) => (
                <span class:list={['cl__linha', l.d && 'cl__linha--d']}>
                  <span>{l.r}</span>
                  {l.p !== undefined && <span class="cl__barra"><i style={`--p:${l.p}%`}></i></span>}
                  <b>{l.v}</b>
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-cl]');
  if (raiz) {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-aba]')];
    const paineis = [...raiz.querySelectorAll<HTMLElement>('[data-painel]')];
    let atual = 0, manual = false, relogio = 0;
    const ir = (n: number) => {
      atual = (n + paineis.length) % paineis.length;
      paineis.forEach((p, i) => p.classList.toggle('is-ativo', i === atual));
      abas.forEach((a, i) => { a.classList.toggle('is-ativo', i === atual); a.setAttribute('aria-selected', String(i === atual)); });
    };
    abas.forEach((a, i) => a.addEventListener('click', () => { manual = true; clearInterval(relogio); raiz.classList.remove('cl--auto'); ir(i); }));
    // Anda sozinha só com a dobra na tela e enquanto ninguém escolheu uma pergunta.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        clearInterval(relogio);
        const anda = e.isIntersecting && !manual;
        raiz.classList.toggle('cl--auto', anda);
        if (anda) { ir(atual); relogio = window.setInterval(() => ir(atual + 1), 8000); }
      }, { threshold: .4 }).observe(raiz);
    }
  }
</script>

<style>
  .cl { --s: cubic-bezier(.22, 1, .36, 1); --am: var(--amarelo-marca, #FFD103); position: relative; padding-block: var(--esp-secao, 112px); color: #f2f2ee; }
  .cl__grade { display: grid; gap: clamp(32px, 4vw, 72px); align-items: center; }
  .cl__esquerda { display: grid; justify-items: start; gap: 20px; min-width: 0; }
  .cl__titulo { margin: 0; max-width: 20ch; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(34px, 3.4vw, 52px); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .cl__titulo strong { display: block; font-weight: 500; }

  /* As sete perguntas são a coluna: fio fino entre elas, a ativa acesa. */
  .cl__lista { list-style: none; margin: clamp(8px, 1vw, 16px) 0 0; padding: 0; display: grid; width: 100%; max-width: 580px; border-top: 1px solid rgb(242 242 238 / .1); }
  .cl__lista li { border-bottom: 1px solid rgb(242 242 238 / .1); }
  .cl__pergunta { position: relative; display: block; width: 100%; padding: 15px 0; border: 0; background: none; color: rgb(242 242 238 / .44); font: inherit; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.3; letter-spacing: -.02em; text-align: left; text-wrap: pretty; cursor: pointer; transition: color .5s var(--s); }
  .cl__pergunta:hover { color: rgb(242 242 238 / .8); }
  .cl__pergunta:focus-visible { outline: 2px solid #f2f2ee; outline-offset: 2px; }
  .cl__pergunta.is-ativo { color: #f2f2ee; }
  /* Único amarelo da coluna: o fio sob a pergunta ativa, que enche enquanto a conversa anda sozinha. */
  .cl__pergunta i { position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--am); transform: scaleX(0); transform-origin: 0 50%; }
  .cl__pergunta.is-ativo i { transform: scaleX(1); }
  .cl--auto .cl__pergunta.is-ativo i { animation: cl-tempo 8s linear both; }
  @keyframes cl-tempo { from { transform: scaleX(0); } }

  .cl__painel {
    display: grid; gap: clamp(14px, 1.3vw, 18px); min-width: 0; width: 100%; max-width: 600px; justify-self: end; padding: clamp(18px, 1.7vw, 26px); border-radius: clamp(22px, 1.9vw, 28px);
    background: radial-gradient(120% 130% at 0% 0%, #262625 0%, #171716 60%);
    box-shadow: 0 1px 0 rgb(255 255 255 / .1) inset, 0 0 0 1px rgb(255 255 255 / .06) inset, 0 60px 80px -50px rgb(0 0 0 / .95);
  }
  .cl__topo { display: flex; align-items: center; gap: 14px; padding-bottom: clamp(12px, 1.1vw, 16px); border-bottom: 1px solid rgb(242 242 238 / .08); }
  .cl__rostos { display: flex; flex: none; }
  .cl__rostos :global(img) { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #1f1f1e; }
  .cl__rostos :global(img + img) { margin-left: -10px; }
  .cl__quem { display: grid; min-width: 0; line-height: 1.25; }
  .cl__quem strong { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; }
  .cl__quem strong i { width: 7px; height: 7px; border-radius: 50%; background: var(--am); }
  .cl__quem span { font-size: 13px; color: rgb(242 242 238 / .6); }

  .cl__pilha { display: grid; }
  .cl__par { grid-area: 1 / 1; display: grid; align-content: start; gap: 14px; padding-block: 6px 2px; visibility: hidden; }
  .cl__par.is-ativo { visibility: visible; }
  .cl__balao { margin: 0; max-width: 86%; }
  .cl__balao--dono { justify-self: start; padding: 12px 16px 14px; border-radius: 18px 18px 18px 6px; background: #2c2c2b; box-shadow: 0 1px 0 rgb(255 255 255 / .08) inset; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; transform-origin: 0 100%; }
  .cl__balao--renke { justify-self: end; padding: 12px 16px 14px; border-radius: 18px 18px 6px 18px; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; font-size: clamp(14.5px, 1.05vw, 15.5px); line-height: 1.45; letter-spacing: -.01em; text-wrap: pretty; transform-origin: 100% 100%; }
  .cl__balao--renke strong { font-weight: 600; }
  .cl__balao--renke strong i { display: inline-block; width: 8px; height: 8px; margin-right: 9px; border-radius: 1px; background: var(--am); box-shadow: 0 0 0 1px rgb(22 22 22 / .28); transform: rotate(45deg) translateY(-1px); }
  .cl__recorte { justify-self: end; display: grid; gap: 10px; width: min(86%, 400px); padding: 14px 16px 16px; border-radius: 16px 16px 6px 16px; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; transform-origin: 100% 0; }
  .cl__recorte-titulo { font-size: 12px; color: rgb(22 22 22 / .56); }
  .cl__linha { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto; align-items: center; gap: 12px; font-size: 13.5px; letter-spacing: -.01em; color: rgb(22 22 22 / .72); }
  .cl__linha:not(:has(.cl__barra)) { grid-template-columns: minmax(0, 1fr) auto; }
  .cl__linha b { font-variant-numeric: tabular-nums; font-weight: 500; color: #161616; }
  .cl__barra { height: 6px; border-radius: 3px; background: rgb(22 22 22 / .08); overflow: hidden; }
  .cl__barra i { display: block; height: 100%; width: var(--p); border-radius: 3px; background: rgb(22 22 22 / .34); transform-origin: 0 50%; }
  .cl__linha--d { color: #161616; }
  .cl__linha--d .cl__barra i { background: #161616; }

  @keyframes cl-entra { from { opacity: 0; transform: translateY(14px) scale(.96); } }
  @keyframes cl-barra { from { transform: scaleX(0); } }
  @media (prefers-reduced-motion: no-preference) {
    .cl__par.is-ativo .cl__balao--dono { animation: cl-entra .7s var(--s) both; }
    .cl__par.is-ativo .cl__balao--renke { animation: cl-entra .8s var(--s) .9s both; }
    .cl__par.is-ativo .cl__recorte { animation: cl-entra .8s var(--s) 1.4s both; }
    .cl__par.is-ativo .cl__barra i { animation: cl-barra 1.1s var(--s) 1.8s both; }
  }

  @media (min-width: 1000px) {
    .cl__grade { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 699.98px) {
    .cl__titulo { max-width: none; font-size: clamp(1.9rem, 7.5vw, 2.8rem); }
    .cl__painel { max-width: none; }
    .cl__balao { max-width: 94%; }
    .cl__recorte { width: 94%; }
    .cl__quem span { display: none; }
  }
</style>
