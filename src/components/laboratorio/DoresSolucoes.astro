---
/**
 * TESTE (10/10/2026), fora da home: a dobra "O que muda na sua clínica" como
 * conversa. Das cinco versões testadas, a Lenora aprovou esta ("cirúrgico"):
 * o dono de clínica pergunta (a dor da copy original, docs/03-copy/home.md,
 * seção 3) e a Renke responde (o ganho da versão ajustada). Pedidos dela para
 * fechar: título à esquerda e conversa à direita, animação acabada e um jeito
 * de a pessoa trocar a pergunta.
 * A troca é feita por sugestões no pé da conversa, como as respostas rápidas
 * de um aplicativo de mensagens: tocar numa sugestão envia aquela pergunta.
 * A conversa também avança sozinha, devagar, até a pessoa interagir.
 * Os rótulos curtos das sugestões são rascunho e precisam de validação.
 */
import { Image } from 'astro:assets';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';
import lari from '../../assets/equipe/lari.jpg';
import julio from '../../assets/equipe/julio-caldeira.jpg';
import isa from '../../assets/equipe/isa.jpg';

const icones: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
const atalhos = ['Custo por paciente', 'Leads que viram consulta', 'Processo sem depender de uma pessoa', 'Melhor canal', 'Mês ruim', 'Mês bom', 'Concorrentes'];
const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const };
---
<section class="dc" aria-labelledby="dc-titulo" data-dc>
  <div class="container dc__grade">
    <header class="dc__cabeca">
      <Selo>O que muda na sua clínica</Selo>
      <h2 class="dc__titulo" id="dc-titulo">Clinicamente, você sabe exatamente o que está acontecendo com seu paciente. <strong>Mas e com o seu negócio?</strong></h2>
    </header>

    <div class="dc__cartao">
      <div class="dc__topo">
        <span class="dc__rostos"><Image src={lari} {...rosto} /><Image src={julio} {...rosto} /><Image src={isa} {...rosto} /></span>
        <span class="dc__quem"><strong>Renke</strong><span>Responde o que a sua clínica precisa saber</span></span>
      </div>

      <div class="dc__conversa" aria-live="polite">
        {perguntas.map((p, i) => (
          <div class:list={['dc__par', i === 0 && 'dc__par--ativo']} data-par={i}>
            <p class="dc__balao dc__balao--dono">{p.pergunta}</p>
            <div class="dc__vez">
              <span class="dc__digitando" aria-hidden="true"><i></i><i></i><i></i></span>
              <p class="dc__balao dc__balao--renke"><strong>{p.titulo}.</strong> {p.texto}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="dc__pe">
        <span class="dc__pe-rotulo">Outras perguntas</span>
        <div class="dc__atalhos" role="tablist" aria-label="Perguntas">
          {perguntas.map((p, i) => (
            <button class:list={['dc__atalho', i === 0 && 'dc__atalho--ativo']} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} title={p.pergunta} data-atalho={i}>
              <IconeRenke nome={icones[i]} size={18} />{atalhos[i]}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-dc]');
  if (raiz) {
    const atalhos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-atalho]')];
    const pares = [...raiz.querySelectorAll<HTMLElement>('[data-par]')];
    let atual = 0, manual = false, relogio = 0;
    const ir = (n: number, rolar = false) => {
      atual = (n + pares.length) % pares.length;
      pares.forEach((p, i) => p.classList.toggle('dc__par--ativo', i === atual));
      atalhos.forEach((a, i) => { a.classList.toggle('dc__atalho--ativo', i === atual); a.setAttribute('aria-selected', String(i === atual)); });
      // No celular as sugestões rolam de lado: centraliza a escolhida sem mexer na rolagem da página.
      const trilho = atalhos[atual].parentElement!;
      if (rolar && trilho.scrollWidth > trilho.clientWidth) trilho.scrollTo({ left: atalhos[atual].offsetLeft - (trilho.clientWidth - atalhos[atual].offsetWidth) / 2, behavior: 'smooth' });
    };
    atalhos.forEach((a, i) => a.addEventListener('click', () => { manual = true; clearInterval(relogio); ir(i, true); }));
    // Avança sozinha só com a dobra na tela e enquanto ninguém escolheu uma pergunta.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        clearInterval(relogio);
        if (e.isIntersecting && !manual) relogio = window.setInterval(() => ir(atual + 1), 7000);
      }, { threshold: .45 }).observe(raiz);
    }
  }
</script>

<style>
  .dc { --s: cubic-bezier(.22, 1, .36, 1); position: relative; padding-block: clamp(80px, 8vw, 132px); background: #0c0c0c; color: #f2f2ee; }
  .dc__grade { display: grid; gap: clamp(32px, 4vw, 72px); align-items: center; }
  .dc__cabeca { display: grid; justify-items: start; gap: 24px; }
  .dc__titulo { margin: 0; max-width: 17ch; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(30px, 3.2vw, 50px); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .dc__titulo strong { font-weight: 500; }

  /* A conversa mora num cartão só: superfície escura com luz no canto e sombra longa. */
  .dc__cartao {
    display: grid; gap: clamp(18px, 1.8vw, 26px); min-width: 0; padding: clamp(18px, 2vw, 30px); border-radius: clamp(24px, 2.2vw, 34px);
    background: radial-gradient(120% 130% at 0% 0%, #262625 0%, #171716 60%);
    box-shadow: 0 1px 0 rgb(255 255 255 / .1) inset, 0 0 0 1px rgb(255 255 255 / .06) inset, 0 60px 80px -50px rgb(0 0 0 / .95);
  }
  .dc__topo { display: flex; align-items: center; gap: 14px; padding-bottom: clamp(14px, 1.4vw, 20px); border-bottom: 1px solid rgb(242 242 238 / .08); }
  .dc__rostos { display: flex; flex: none; }
  .dc__rostos :global(img) { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #1f1f1e; }
  .dc__rostos :global(img + img) { margin-left: -10px; }
  .dc__quem { display: grid; min-width: 0; line-height: 1.25; }
  .dc__quem strong { font-size: 15px; font-weight: 500; }
  .dc__quem span { font-size: 13px; color: rgb(242 242 238 / .6); }

  /* Todos os pares ocupam a mesma célula: a altura é a do maior e nada pula na troca. */
  .dc__conversa { display: grid; }
  .dc__par { grid-area: 1 / 1; display: grid; align-content: start; gap: 12px; visibility: hidden; }
  .dc__par--ativo { visibility: visible; }
  .dc__balao { margin: 0; max-width: min(86%, 520px); }
  .dc__balao--dono { justify-self: start; padding: 15px 20px 17px; border-radius: 22px 22px 22px 6px; background: #2c2c2b; box-shadow: 0 1px 0 rgb(255 255 255 / .08) inset; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(18px, 1.55vw, 23px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; transform-origin: 0 100%; }
  .dc__vez { display: grid; justify-items: end; }
  .dc__vez > * { grid-area: 1 / 1; }
  .dc__balao--renke { padding: 15px 20px 17px; border-radius: 22px 22px 6px 22px; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; box-shadow: 0 24px 34px -22px rgb(0 0 0 / .8); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.45; letter-spacing: -.01em; text-wrap: pretty; transform-origin: 100% 100%; }
  .dc__balao--renke strong { font-weight: 600; }
  .dc__digitando { align-self: start; display: flex; gap: 5px; padding: 15px 16px; border-radius: 18px 18px 6px 18px; background: #2c2c2b; opacity: 0; }
  .dc__digitando i { width: 6px; height: 6px; border-radius: 50%; background: rgb(242 242 238 / .7); }

  /* A vez de cada um: a pergunta chega, a Renke digita, a resposta entra. */
  @media (prefers-reduced-motion: no-preference) {
    .dc__par--ativo .dc__balao--dono { animation: dc-entra .7s var(--s) both; }
    .dc__par--ativo .dc__digitando { animation: dc-digita 1.5s var(--s) .45s both; }
    .dc__par--ativo .dc__digitando i { animation: dc-ponto 1s ease-in-out infinite; }
    .dc__par--ativo .dc__digitando i:nth-child(2) { animation-delay: .15s; }
    .dc__par--ativo .dc__digitando i:nth-child(3) { animation-delay: .3s; }
    .dc__par--ativo .dc__balao--renke { animation: dc-entra .8s var(--s) 1.75s both; }
  }
  @keyframes dc-entra { from { opacity: 0; transform: translateY(14px) scale(.96); } }
  @keyframes dc-digita { 0% { opacity: 0; transform: translateY(8px); } 20%, 82% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
  @keyframes dc-ponto { 0%, 100% { transform: none; opacity: .5; } 40% { transform: translateY(-3px); opacity: 1; } }

  /* Sugestões no pé: tocar numa envia aquela pergunta. */
  .dc__pe { display: grid; gap: 10px; min-width: 0; padding-top: clamp(14px, 1.4vw, 20px); border-top: 1px solid rgb(242 242 238 / .08); }
  .dc__pe-rotulo { font-size: 13px; color: rgb(242 242 238 / .56); }
  .dc__atalhos { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
  .dc__atalho { flex: none; display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 15px 0 11px; border: 0; border-radius: 19px; background: rgb(242 242 238 / .06); box-shadow: 0 0 0 1px rgb(242 242 238 / .09) inset; color: rgb(242 242 238 / .82); font: inherit; font-size: 14px; letter-spacing: -.01em; white-space: nowrap; cursor: pointer; transition: background-color .4s var(--s), color .4s var(--s), box-shadow .4s var(--s); }
  .dc__atalho:hover { background: rgb(242 242 238 / .1); color: #f2f2ee; }
  .dc__atalho:focus-visible { outline: 2px solid #f2f2ee; outline-offset: 2px; }
  .dc__atalho--ativo, .dc__atalho--ativo:hover { background: #f2f2ee; color: #161616; box-shadow: none; }

  @media (min-width: 1000px) {
    .dc__grade { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
  @media (max-width: 699.98px) {
    .dc__titulo { max-width: none; font-size: 30px; }
    .dc__balao { max-width: 94%; }
    .dc__quem span { display: none; }
    /* No celular as sugestões rolam de lado, numa linha só. */
    .dc__atalhos { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * clamp(18px, 2vw, 30px)); padding-inline: clamp(18px, 2vw, 30px); scrollbar-width: none; }
    .dc__atalhos::-webkit-scrollbar { display: none; }
  }
</style>
