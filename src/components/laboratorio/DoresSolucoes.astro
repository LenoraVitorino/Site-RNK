---
/**
 * TESTE (10/10/2026), fora da home: a dobra "O que muda na sua clínica" como
 * par dor → solução, em cinco versões para escolher. As tentativas anteriores
 * foram reprovadas por excesso de texto (sete cartões grandes; lista de
 * perguntas à esquerda com cartão à direita; recortes ilustrados). Regra das
 * cinco: pouco texto por vez, em cartões, e fácil de entender no celular.
 *   A · um par por vez num cartão único, com os ícones como seletor
 *   B · sete cartões pequenos com a pergunta; ao passar o mouse ou tocar, viram a resposta
 *   C · conversa: a pergunta do dono de clínica e a resposta da Renke em balões
 *   D · sete cartões com tudo à vista: pergunta em cima, resposta em uma linha embaixo
 *   E · baralho: o cartão da frente traz pergunta e resposta; clicar passa para o próximo
 * A barra da página troca a versão (ou ?v=a…e). As perguntas vêm da copy
 * original (docs/03-copy/home.md, seção 3) e as respostas, dos ganhos da versão ajustada.
 */
import { Image } from 'astro:assets';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';
import lari from '../../assets/equipe/lari.jpg';

const icones: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const total = n2(perguntas.length - 1);
---
<section class="dorsol" aria-labelledby="dorsol-titulo" data-dorsol data-ver="a">
  <div class="container">
    <header class="dorsol__cabeca">
      <Selo>O que muda na sua clínica</Selo>
      <h2 class="dorsol__titulo" id="dorsol-titulo">Clinicamente, você sabe exatamente o que está acontecendo com seu paciente. <strong>Mas e com o seu negócio?</strong></h2>
    </header>

    {/* A · um par por vez */}
    <div class="dv dv--a" data-v="a" data-grupo data-auto>
      <div class="dv-a__cartao">
        <div class="dv-a__seletor">
          {perguntas.map((p, i) => (
            <button class:list={['pastilha', i === 0 && 'ativo']} type="button" aria-label={p.titulo} data-aba={i}><IconeRenke nome={icones[i]} size={22} /></button>
          ))}
        </div>
        <div class="pares">
          {perguntas.map((p, i) => (
            <div class:list={['par', i === 0 && 'ativo']} data-par={i}>
              <p class="dv-a__pergunta">{p.pergunta}</p>
              <p class="resposta"><span class="rotulo"><i></i>Com a Renke</span><strong>{p.titulo}</strong><span class="texto">{p.texto}</span></p>
            </div>
          ))}
        </div>
        <span class="conta"><b data-conta>01</b> / {total}</span>
      </div>
    </div>

    {/* B · cartões que viram */}
    <ol class="dv dv--b grade7" data-v="b">
      {perguntas.map((p, i) => (
        <li>
          <button class="dv-b__cartao" type="button" data-vira>
            <span class="dv-b__frente">
              <span class="pastilha pastilha--fixa"><IconeRenke nome={icones[i]} size={22} /></span>
              <span class="dv-b__pergunta">{p.pergunta}</span>
            </span>
            <span class="dv-b__verso">
              <span class="rotulo rotulo--tinta"><i></i>Com a Renke</span>
              <strong>{p.titulo}</strong>
              <span class="dv-b__texto">{p.texto}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    {/* C · conversa */}
    <div class="dv dv--c" data-v="c" data-grupo data-auto>
      <div class="dv-c__cartao">
        <div class="pares">
          {perguntas.map((p, i) => (
            <div class:list={['par', 'dv-c__par', i === 0 && 'ativo']} data-par={i}>
              <p class="dv-c__balao dv-c__balao--dono"><span class="dv-c__quem">Dono de clínica</span>{p.pergunta}</p>
              <p class="dv-c__balao dv-c__balao--renke">
                <Image src={lari} width={96} height={96} format="webp" quality={80} alt="" loading="lazy" class="dv-c__rosto" />
                <span><span class="dv-c__quem">Renke</span><strong>{p.titulo}.</strong> {p.texto}</span>
              </p>
            </div>
          ))}
        </div>
        <div class="dv-c__pontos">
          {perguntas.map((p, i) => <button class:list={['ponto', i === 0 && 'ativo']} type="button" aria-label={`Pergunta ${i + 1}`} data-aba={i}></button>)}
        </div>
      </div>
    </div>

    {/* D · tudo à vista, enxuto */}
    <ol class="dv dv--d grade7" data-v="d">
      {perguntas.map((p, i) => (
        <li class="dv-d__cartao">
          <span class="pastilha pastilha--fixa"><IconeRenke nome={icones[i]} size={22} /></span>
          <p class="dv-d__pergunta">{p.pergunta}</p>
          <p class="dv-d__resposta"><i></i>{p.titulo}</p>
        </li>
      ))}
    </ol>

    {/* E · baralho */}
    <div class="dv dv--e" data-v="e">
      <div class="dv-e__baralho" data-baralho>
        {perguntas.map((p, i) => (
          <article class="dv-e__carta" style={`--pos:${i}`} data-carta>
            <header><span class="pastilha pastilha--fixa"><IconeRenke nome={icones[i]} size={22} /></span><span class="conta conta--solta"><b>{n2(i)}</b> / {total}</span></header>
            <p class="dv-e__pergunta">{p.pergunta}</p>
            <p class="resposta"><span class="rotulo"><i></i>Com a Renke</span><strong>{p.titulo}</strong><span class="texto">{p.texto}</span></p>
          </article>
        ))}
      </div>
      <button class="dv-e__proxima" type="button" data-proxima>Próxima pergunta<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4" /></svg></button>
    </div>
  </div>

  <div class="dorsol__barra" data-barra>
    <span>Versão</span>
    <button type="button" data-ir="a">A · Um por vez</button>
    <button type="button" data-ir="b">B · Cartões que viram</button>
    <button type="button" data-ir="c">C · Conversa</button>
    <button type="button" data-ir="d">D · Tudo à vista</button>
    <button type="button" data-ir="e">E · Baralho</button>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-dorsol]');
  if (raiz) {
    // Barra de versões.
    const botoes = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const versao = (v: string) => {
      raiz.dataset.ver = v;
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ir === v)));
      const url = new URL(location.href); url.searchParams.set('v', v); history.replaceState(null, '', url);
    };
    botoes.forEach((b) => b.addEventListener('click', () => versao(b.dataset.ir!)));
    const pedida = new URLSearchParams(location.search).get('v');
    versao(pedida && 'abcde'.includes(pedida) ? pedida : 'a');

    // A e C: um par por vez; troca sozinha, devagar, até a pessoa mexer.
    raiz.querySelectorAll<HTMLElement>('[data-grupo]').forEach((grupo) => {
      const abas = [...grupo.querySelectorAll<HTMLElement>('[data-aba]')];
      const pares = [...grupo.querySelectorAll<HTMLElement>('[data-par]')];
      const conta = grupo.querySelector<HTMLElement>('[data-conta]');
      let atual = 0, manual = false;
      const ir = (n: number) => {
        atual = (n + abas.length) % abas.length;
        abas.forEach((a, i) => a.classList.toggle('ativo', i === atual));
        pares.forEach((p, i) => p.classList.toggle('ativo', i === atual));
        if (conta) conta.textContent = String(atual + 1).padStart(2, '0');
      };
      abas.forEach((a, i) => {
        a.addEventListener('click', () => { manual = true; ir(i); });
        a.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { manual = true; ir(i); } });
      });
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(() => { if (!manual && grupo.offsetParent && grupo.getBoundingClientRect().top < innerHeight * .8) ir(atual + 1); }, 5200);
      }
    });

    // B: no toque, o cartão vira e desvira.
    raiz.querySelectorAll<HTMLElement>('[data-vira]').forEach((c) => c.addEventListener('click', () => c.classList.toggle('virado')));

    // E: clicar no baralho ou no botão passa o cartão da frente para trás.
    const baralho = raiz.querySelector<HTMLElement>('[data-baralho]');
    if (baralho) {
      const cartas = [...baralho.querySelectorAll<HTMLElement>('[data-carta]')];
      let frente = 0;
      const passar = () => { frente = (frente + 1) % cartas.length; cartas.forEach((c, i) => c.style.setProperty('--pos', String((i - frente + cartas.length) % cartas.length))); };
      baralho.addEventListener('click', passar);
      raiz.querySelector('[data-proxima]')?.addEventListener('click', passar);
    }
  }
</script>

<style>
  .dorsol { --s: cubic-bezier(.22, 1, .36, 1); position: relative; padding-block: clamp(80px, 8vw, 132px); background: #0c0c0c; color: #f2f2ee; }
  .dorsol__cabeca { display: grid; justify-items: center; gap: 22px; margin-bottom: clamp(32px, 3.4vw, 52px); text-align: center; }
  .dorsol__titulo { margin: 0; max-width: 30ch; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(26px, 2.6vw, 40px); line-height: 1.12; letter-spacing: -.03em; text-wrap: balance; }
  .dorsol__titulo strong { font-weight: 500; }
  .dorsol__barra { position: fixed; z-index: 300; right: 14px; top: 92px; display: grid; gap: 2px; padding: 6px; border-radius: 18px; background: #f2f2ee; color: #161616; box-shadow: 0 18px 40px -16px rgb(0 0 0 / .7); font-size: 13px; }
  .dorsol__barra span { padding: 6px 12px 4px; opacity: .6; }
  .dorsol__barra button { height: 32px; padding: 0 12px; border: 0; border-radius: 999px; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .dorsol__barra button[aria-pressed="true"] { background: #161616; color: #f2f2ee; }
  .dv { display: none; }
  .dorsol[data-ver="a"] .dv--a, .dorsol[data-ver="c"] .dv--c, .dorsol[data-ver="e"] .dv--e { display: block; }
  .dorsol[data-ver="b"] .dv--b, .dorsol[data-ver="d"] .dv--d { display: grid; }

  /* Peças comuns: superfície de cartão, pastilha do ícone, rótulo e resposta. */
  .dv-a__cartao, .dv-b__cartao, .dv-c__cartao, .dv-d__cartao, .dv-e__carta {
    border-radius: clamp(22px, 2vw, 30px); background: radial-gradient(120% 130% at 0% 0%, #262625 0%, #171716 60%);
    box-shadow: 0 1px 0 rgb(255 255 255 / .1) inset, 0 0 0 1px rgb(255 255 255 / .06) inset, 0 50px 70px -44px rgb(0 0 0 / .95);
  }
  .pastilha { flex: none; display: grid; place-items: center; width: 46px; height: 46px; padding: 0; border: 0; border-radius: 14px; cursor: pointer; color: #f2f2ee; background: linear-gradient(180deg, #303030, #1f1f1e); box-shadow: 0 1px 0 rgb(255 255 255 / .16) inset, 0 0 0 1px rgb(255 255 255 / .05) inset, 0 14px 22px -12px rgb(0 0 0 / .85); opacity: .6; transition: opacity .5s var(--s), transform .6s var(--s), box-shadow .5s var(--s); }
  .pastilha--fixa { opacity: 1; cursor: inherit; }
  .pastilha.ativo { opacity: 1; transform: translateY(-3px); box-shadow: 0 1px 0 rgb(255 255 255 / .22) inset, 0 0 0 1.5px rgb(242 242 238 / .8) inset, 0 16px 24px -12px rgb(0 0 0 / .9); }
  .rotulo { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 400; letter-spacing: -.01em; text-transform: none; color: rgb(242 242 238 / .6); }
  .rotulo i, .dv-d__resposta i { flex: none; width: 7px; height: 7px; border-radius: 1px; background: var(--amarelo-marca, #FFD103); transform: rotate(45deg); }
  .rotulo--tinta { color: rgb(22 22 22 / .6); }
  .rotulo--tinta i { box-shadow: 0 0 0 1px rgb(22 22 22 / .3); }
  .resposta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin: 0; padding-top: clamp(16px, 1.6vw, 22px); border-top: 1px solid rgb(242 242 238 / .1); }
  .resposta strong { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(18px, 1.5vw, 22px); letter-spacing: -.02em; }
  .texto { flex-basis: 100%; max-width: 60ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.5; color: rgb(242 242 238 / .66); }
  .conta { position: absolute; right: clamp(22px, 2.6vw, 40px); bottom: clamp(22px, 2.6vw, 40px); font-size: 13px; font-variant-numeric: tabular-nums; color: rgb(242 242 238 / .45); }
  .conta b { font-weight: 400; color: #f2f2ee; }
  .conta--solta { position: static; }
  .pares { display: grid; }
  .par { grid-area: 1 / 1; display: grid; align-content: space-between; gap: clamp(26px, 3vw, 46px); opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity .5s var(--s), transform .8s var(--s), visibility 0s .5s; }
  .par.ativo { opacity: 1; visibility: visible; transform: none; transition-delay: .12s, .12s, 0s; }
  .grade7 { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(10px, 1vw, 16px); margin: 0; padding: 0; list-style: none; }
  .grade7 > li { grid-column: span 3; }
  .grade7 > li:nth-child(n + 5) { grid-column: span 4; }

  /* A */
  .dv-a__cartao { position: relative; display: grid; gap: clamp(34px, 3.8vw, 60px); max-width: 1040px; margin-inline: auto; padding: clamp(22px, 2.6vw, 40px); }
  .dv-a__seletor { display: flex; gap: clamp(6px, .7vw, 10px); }
  .dv-a__pergunta, .dv-e__pergunta { margin: 0; max-width: 24ch; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(27px, 3.3vw, 52px); line-height: 1.1; letter-spacing: -.035em; text-wrap: balance; }
  .dv-a__cartao .resposta { padding-right: 70px; }

  /* B */
  .dv-b__cartao { position: relative; display: grid; width: 100%; height: 100%; min-height: clamp(210px, 17vw, 250px); padding: 0; border: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; overflow: hidden; }
  .dv-b__frente, .dv-b__verso { grid-area: 1 / 1; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: clamp(18px, 1.6vw, 24px); transition: opacity .5s var(--s), transform .7s var(--s); }
  .dv-b__pergunta { font-family: var(--font-titulo); font-weight: 300; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; }
  .dv-b__verso { justify-content: flex-end; gap: 10px; border-radius: inherit; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; opacity: 0; transform: translateY(14px); }
  .dv-b__verso strong { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(20px, 1.6vw, 24px); line-height: 1.15; letter-spacing: -.025em; }
  .dv-b__verso .rotulo { margin-bottom: auto; }
  .dv-b__texto { font-size: 14.5px; line-height: 1.45; color: rgb(22 22 22 / .7); }
  .dv-b__cartao.virado .dv-b__verso { opacity: 1; transform: none; }
  @media (hover: hover) { .dv-b__cartao:hover .dv-b__verso, .dv-b__cartao:focus-visible .dv-b__verso { opacity: 1; transform: none; } }

  /* C */
  .dv-c__cartao { display: grid; gap: clamp(20px, 2vw, 30px); max-width: 880px; margin-inline: auto; padding: clamp(22px, 2.6vw, 40px); }
  .dv-c__par { align-content: start; gap: 14px; }
  .dv-c__balao { margin: 0; max-width: min(84%, 560px); padding: 16px 20px 18px; border-radius: 22px 22px 22px 6px; background: #2b2b2a; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.25; letter-spacing: -.02em; }
  .dv-c__quem { display: block; margin-bottom: 6px; font-family: var(--font-corpo, inherit); font-size: 12.5px; font-weight: 400; letter-spacing: 0; opacity: .6; }
  .dv-c__balao--renke { justify-self: end; display: flex; gap: 14px; align-items: flex-start; border-radius: 22px 22px 6px 22px; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; font-size: clamp(15px, 1.2vw, 17px); font-weight: 400; line-height: 1.45; letter-spacing: -.01em; font-family: inherit; }
  .dv-c__balao--renke strong { font-weight: 600; }
  .dv-c__rosto { flex: none; width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .dv-c__pontos { display: flex; gap: 6px; justify-content: center; }
  .ponto { width: 22px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; }
  .ponto::before { content: ''; display: block; width: 6px; height: 6px; margin: auto; border-radius: 3px; background: rgb(242 242 238 / .3); transition: width .5s var(--s), background .5s var(--s); }
  .ponto.ativo::before { width: 20px; background: #f2f2ee; }

  /* D */
  .dv-d__cartao { display: flex; flex-direction: column; gap: 18px; min-height: clamp(210px, 17vw, 250px); padding: clamp(18px, 1.6vw, 24px); }
  .dv-d__pergunta { margin: auto 0 0; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; }
  .dv-d__resposta { display: flex; align-items: center; gap: 10px; margin: 0; padding-top: 14px; border-top: 1px solid rgb(242 242 238 / .1); font-size: 15px; font-weight: 500; letter-spacing: -.01em; }

  /* E */
  .dv--e { max-width: 760px; margin-inline: auto; }
  .dv-e__baralho { position: relative; display: grid; padding-top: 44px; cursor: pointer; }
  .dv-e__carta { grid-area: 1 / 1; display: grid; align-content: space-between; gap: clamp(24px, 2.6vw, 40px); padding: clamp(22px, 2.4vw, 36px); transform-origin: 50% 0; z-index: calc(10 - var(--pos)); transform: translateY(calc(var(--pos) * -22px)) scale(calc(1 - var(--pos) * .06)); filter: brightness(calc(1 - var(--pos) * .3)); opacity: calc(3 - var(--pos)); transition: transform .8s var(--s), filter .8s var(--s), opacity .5s var(--s); }
  .dv-e__carta header { display: flex; align-items: center; justify-content: space-between; }
  .dv-e__pergunta { font-size: clamp(24px, 2.7vw, 40px); }
  .dv-e__proxima { display: flex; align-items: center; gap: 10px; height: 46px; margin: 22px auto 0; padding: 0 18px 0 22px; border: 0; border-radius: 23px; background: #f2f2ee; color: #161616; font: inherit; font-size: 14.5px; font-weight: 500; cursor: pointer; }
  .dv-e__proxima svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 999.98px) {
    .grade7 > li, .grade7 > li:nth-child(n + 5) { grid-column: span 6; }
    .grade7 > li:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 699.98px) {
    .dorsol__barra { left: 10px; right: 10px; top: auto; bottom: 74px; grid-auto-flow: column; overflow-x: auto; border-radius: 999px; }
    .dorsol__barra span { display: none; }
    .dorsol__barra button { white-space: nowrap; }
    .grade7 > li, .grade7 > li:nth-child(n + 5) { grid-column: 1 / -1; }
    .dv-a__seletor { justify-content: space-between; gap: 4px; }
    .dv-a__seletor .pastilha { width: 40px; height: 40px; border-radius: 12px; }
    .dv-a__cartao .resposta { padding-right: 0; }
    .dv-a__cartao .conta { position: static; justify-self: end; margin-top: -18px; }
    .dv-b__cartao, .dv-d__cartao { min-height: 0; }
    .dv-b__frente { gap: 18px; }
    .dv-c__balao { max-width: 94%; }
    .dv-e__carta { transform: translateY(calc(var(--pos) * -14px)) scale(calc(1 - var(--pos) * .05)); }
  }
  @media (prefers-reduced-motion: reduce) { .dorsol * { transition: none !important; } }
</style>
