---
/**
 * TESTE (10/10/2026), fora da home: a dobra "O que muda na sua clínica" como
 * conversa. Das cinco versões testadas, a Lenora aprovou esta ("cirúrgico"):
 * o dono de clínica pergunta (a dor da copy original, docs/03-copy/home.md,
 * seção 3) e a Renke responde (o ganho da versão ajustada). Pedidos dela para
 * fechar: título à esquerda e conversa à direita, animação acabada e um jeito
 * de a pessoa trocar a pergunta.
 * A troca é feita por sugestões no pé da conversa, como as respostas rápidas
 * de um aplicativo de mensagens: tocar numa sugestão envia aquela pergunta.
 * A conversa também avança sozinha, devagar, até a pessoa interagir.
 * Os rótulos curtos das sugestões são rascunho e precisam de validação.
 */
import { Image } from 'astro:assets';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';
import lari from '../../assets/equipe/lari.jpg';
import julio from '../../assets/equipe/julio-caldeira.jpg';
import isa from '../../assets/equipe/isa.jpg';

const icones: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
const atalhos = ['Custo por paciente', 'Conversão de leads', 'Processo', 'Melhor canal', 'Mês ruim', 'Mês bom', 'Concorrentes'];
/* Textos encurtados só para este teste (10/10: "crie um bom senso de caracteres
   para manter um padrão de espaçamento"): perguntas com até ~70 caracteres e
   respostas com até ~90, para todo par ocupar a mesma altura e não sobrar vão.
   São rascunho a partir da copy original e dos ganhos; precisam de validação. */
const conversa = [
  { q: 'Quanto custa, de verdade, um paciente novo pra sua clínica?', t: 'Aquisição sob controle.', r: 'Custo por paciente e retorno de cada canal, à vista.' },
  { q: 'Dos leads que chegam, quantos sentam na cadeira do consultório?', t: 'Mais conversão.', r: 'Cada oportunidade acompanhada até o agendamento.' },
  { q: 'Se sua secretária sai amanhã, o processo continua?', t: 'Processos que funcionam.', r: 'Uma operação comercial que não depende de uma só pessoa.' },
  { q: 'Você sabe qual canal trouxe seus melhores pacientes este mês?', t: 'Investimento mais inteligente.', r: 'Verba nos canais que dão mais retorno.' },
  { q: 'No mês ruim, você encontra o motivo nos dados, com facilidade?', t: 'Decisões baseadas em dados.', r: 'Indicadores que mostram onde a clínica perde.' },
  { q: 'E no mês bom, você sabe o porquê para repetir o resultado?', t: 'Crescimento replicável.', r: 'O que funciona vira processo e se repete.' },
  { q: 'Você sabe o que seus concorrentes comunicam e que espaço deixam aberto?', t: 'Oportunidades de mercado.', r: 'Inteligência sobre a concorrência e os espaços livres.' },
];
const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const };
---
<section class="dc" aria-labelledby="dc-titulo" data-dc>
  <div class="container dc__grade">
    <header class="dc__cabeca">
      <Selo>O que muda na sua clínica</Selo>
      <h2 class="dc__titulo" id="dc-titulo">Do seu paciente, você sabe tudo. <strong>E do seu negócio?</strong></h2>
      <p class="dc__apoio">Sete perguntas que todo dono de clínica já se fez. Escolha uma e veja o que muda com a Renke.</p>
    </header>

    <div class="dc__cartao">
      <div class="dc__topo">
        <span class="dc__rostos"><Image src={lari} {...rosto} /><Image src={julio} {...rosto} /><Image src={isa} {...rosto} /></span>
        <span class="dc__quem"><strong>Renke<i aria-hidden="true"></i></strong><span>Responde o que a sua clínica precisa saber</span></span>
      </div>

      <div class="dc__conversa" aria-live="polite">
        {conversa.map((p, i) => (
          <div class:list={['dc__par', i === 0 && 'dc__par--ativo']} data-par={i}>
            <p class="dc__balao dc__balao--dono">{p.q}</p>
            <div class="dc__vez">
              <span class="dc__digitando" aria-hidden="true"><i></i><i></i><i></i></span>
              <p class="dc__balao dc__balao--renke"><strong><i aria-hidden="true"></i>{p.t}</strong> {p.r}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="dc__pe">
        <span class="dc__pe-rotulo">Outras perguntas</span>
        <div class="dc__atalhos" role="tablist" aria-label="Perguntas">
          {perguntas.map((p, i) => (
            <button class:list={['dc__atalho', i === 0 && 'dc__atalho--ativo']} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} title={p.pergunta} data-atalho={i}>
              <IconeRenke nome={icones[i]} size={18} />{atalhos[i]}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-dc]');
  if (raiz) {
    const atalhos = [...raiz.querySelectorAll<HTMLButtonElement>('[data-atalho]')];
    const pares = [...raiz.querySelectorAll<HTMLElement>('[data-par]')];
    let atual = 0, manual = false, relogio = 0;
    const ir = (n: number, rolar = false) => {
      atual = (n + pares.length) % pares.length;
      pares.forEach((p, i) => p.classList.toggle('dc__par--ativo', i === atual));
      atalhos.forEach((a, i) => { a.classList.toggle('dc__atalho--ativo', i === atual); a.setAttribute('aria-selected', String(i === atual)); });
      // No celular as sugestões rolam de lado: centraliza a escolhida sem mexer na rolagem da página.
      const trilho = atalhos[atual].parentElement!;
      if (rolar && trilho.scrollWidth > trilho.clientWidth) trilho.scrollTo({ left: atalhos[atual].offsetLeft - (trilho.clientWidth - atalhos[atual].offsetWidth) / 2, behavior: 'smooth' });
    };
    atalhos.forEach((a, i) => a.addEventListener('click', () => { manual = true; clearInterval(relogio); raiz.classList.remove('dc--auto'); ir(i, true); }));
    // Avança sozinha só com a dobra na tela e enquanto ninguém escolheu uma pergunta.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        clearInterval(relogio);
        const anda = e.isIntersecting && !manual;
        raiz.classList.toggle('dc--auto', anda);
        if (anda) { ir(atual); relogio = window.setInterval(() => ir(atual + 1), 7000); }
      }, { threshold: .45 }).observe(raiz);
    }
  }
</script>

<style>
  .dc { --s: cubic-bezier(.22, 1, .36, 1); position: relative; padding-block: clamp(80px, 8vw, 132px); background: #0c0c0c; color: #f2f2ee; }
  .dc__grade { display: grid; gap: clamp(32px, 4vw, 72px); align-items: center; }
  .dc__cabeca { display: grid; justify-items: start; gap: 20px; }
  .dc__apoio { margin: 0; max-width: 40ch; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; color: #aaa; text-wrap: pretty; }
  .dc__titulo { margin: 0; max-width: 20ch; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(34px, 3.4vw, 52px); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; }
  .dc__titulo strong { display: block; font-weight: 500; }

  /* A conversa mora num cartão só: superfície escura com luz no canto e sombra longa. */
  .dc__cartao {
    display: grid; gap: clamp(14px, 1.3vw, 18px); min-width: 0; width: 100%; max-width: 520px; justify-self: end; padding: clamp(16px, 1.5vw, 22px); border-radius: clamp(22px, 1.9vw, 28px);
    background: radial-gradient(120% 130% at 0% 0%, #262625 0%, #171716 60%);
    box-shadow: 0 1px 0 rgb(255 255 255 / .1) inset, 0 0 0 1px rgb(255 255 255 / .06) inset, 0 60px 80px -50px rgb(0 0 0 / .95);
  }
  .dc__topo { display: flex; align-items: center; gap: 14px; padding-bottom: clamp(12px, 1.1vw, 16px); border-bottom: 1px solid rgb(242 242 238 / .08); }
  .dc__rostos { display: flex; flex: none; }
  .dc__rostos :global(img) { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #1f1f1e; }
  .dc__rostos :global(img + img) { margin-left: -10px; }
  .dc__quem { display: grid; min-width: 0; line-height: 1.25; }
  .dc__quem strong { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; }
  /* Amarelo só no detalhe: o ponto de "no ar" e o losango que abre cada resposta. */
  .dc__quem strong i { width: 7px; height: 7px; border-radius: 50%; background: var(--amarelo-marca, #FFD103); }
  .dc__quem span { font-size: 13px; color: rgb(242 242 238 / .6); }

  /* Todos os pares ocupam a mesma célula: a altura é a do maior e nada pula na troca. */
  .dc__conversa { display: grid; }
  .dc__par { grid-area: 1 / 1; display: grid; align-content: start; gap: 16px; padding-block: 4px; visibility: hidden; }
  .dc__par--ativo { visibility: visible; }
  .dc__balao { margin: 0; max-width: min(86%, 520px); }
  .dc__balao--dono { justify-self: start; padding: 12px 16px 14px; border-radius: 18px 18px 18px 6px; background: #2c2c2b; box-shadow: 0 1px 0 rgb(255 255 255 / .08) inset; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; transform-origin: 0 100%; }
  .dc__vez { display: grid; justify-items: end; }
  .dc__vez > * { grid-area: 1 / 1; }
  .dc__balao--renke { padding: 12px 16px 14px; border-radius: 18px 18px 6px 18px; background: linear-gradient(180deg, #fbfbf8, #ecece7); color: #161616; box-shadow: 0 24px 34px -22px rgb(0 0 0 / .8); font-size: clamp(14.5px, 1.05vw, 15.5px); line-height: 1.45; letter-spacing: -.01em; text-wrap: pretty; transform-origin: 100% 100%; }
  .dc__balao--renke strong { font-weight: 600; }
  .dc__balao--renke strong i { display: inline-block; width: 8px; height: 8px; margin-right: 9px; border-radius: 1px; background: var(--amarelo-marca, #FFD103); box-shadow: 0 0 0 1px rgb(22 22 22 / .28); transform: rotate(45deg) translateY(-1px); }
  .dc__digitando { align-self: start; display: flex; gap: 5px; padding: 13px 14px; border-radius: 16px 16px 6px 16px; background: #2c2c2b; opacity: 0; }
  .dc__digitando i { width: 6px; height: 6px; border-radius: 50%; background: var(--amarelo-marca, #FFD103); }

  /* A vez de cada um: a pergunta chega, a Renke digita, a resposta entra. */
  @media (prefers-reduced-motion: no-preference) {
    .dc__par--ativo .dc__balao--dono { animation: dc-entra .7s var(--s) both; }
    .dc__par--ativo .dc__digitando { animation: dc-digita 1.5s var(--s) .45s both; }
    .dc__par--ativo .dc__digitando i { animation: dc-ponto 1s ease-in-out infinite; }
    .dc__par--ativo .dc__digitando i:nth-child(2) { animation-delay: .15s; }
    .dc__par--ativo .dc__digitando i:nth-child(3) { animation-delay: .3s; }
    .dc__par--ativo .dc__balao--renke { animation: dc-entra .8s var(--s) 1.75s both; }
  }
  @keyframes dc-entra { from { opacity: 0; transform: translateY(14px) scale(.96); } }
  @keyframes dc-digita { 0% { opacity: 0; transform: translateY(8px); } 20%, 82% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
  @keyframes dc-ponto { 0%, 100% { transform: none; opacity: .5; } 40% { transform: translateY(-3px); opacity: 1; } }

  /* Sugestões no pé: tocar numa envia aquela pergunta. */
  .dc__pe { display: grid; gap: 10px; min-width: 0; padding-top: clamp(12px, 1.1vw, 16px); border-top: 1px solid rgb(242 242 238 / .08); }
  .dc__pe-rotulo { font-size: 13px; color: rgb(242 242 238 / .56); }
  .dc__atalhos { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .dc__atalho { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 13px 0 10px; border: 0; border-radius: 17px; background: rgb(242 242 238 / .06); box-shadow: 0 0 0 1px rgb(242 242 238 / .09) inset; color: rgb(242 242 238 / .82); font: inherit; font-size: 13px; letter-spacing: -.01em; white-space: nowrap; cursor: pointer; transition: background-color .4s var(--s), color .4s var(--s), box-shadow .4s var(--s); }
  .dc__atalho:hover { background: rgb(242 242 238 / .1); color: #f2f2ee; }
  .dc__atalho:focus-visible { outline: 2px solid #f2f2ee; outline-offset: 2px; }
  /* A sugestão ativa não é mais branca: fio amarelo, fundo levemente tingido e, enquanto a conversa anda sozinha, um traço que enche até a próxima pergunta. */
  .dc__atalho { position: relative; overflow: hidden; }
  .dc__atalho--ativo, .dc__atalho--ativo:hover { background: rgb(255 209 3 / .09); color: #f2f2ee; box-shadow: 0 0 0 1px rgb(255 209 3 / .6) inset; }
  .dc__atalho--ativo::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--amarelo-marca, #FFD103); transform: scaleX(0); transform-origin: 0 50%; }
  .dc--auto .dc__atalho--ativo::after { animation: dc-tempo 7s linear both; }
  @keyframes dc-tempo { to { transform: scaleX(1); } }

  @media (min-width: 1000px) {
    .dc__grade { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 699.98px) {
    .dc__titulo { max-width: none; font-size: clamp(1.9rem, 7.5vw, 2.8rem); }
    .dc__balao { max-width: 94%; }
    .dc__cartao { max-width: none; }
    .dc__quem span { display: none; }
    /* No celular as sugestões rolam de lado, numa linha só. */
    .dc__atalhos { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * clamp(16px, 1.5vw, 22px)); padding-inline: clamp(16px, 1.5vw, 22px); scrollbar-width: none; }
    .dc__atalhos::-webkit-scrollbar { display: none; }
  }
</style>
