---
/**
 * Camada de fundo com os três anéis (protótipo, 22/09/2026). Um <canvas>
 * fixo atrás da página; a cena (aneis-cena.ts) só carrega depois que o
 * texto pintou, por import dinâmico, e nunca atrasa a hero.
 * Especificação: docs/04-design/hero-aneis-prompt.md.
 */
---
<canvas class="aneis-fundo" data-aneis aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-aneis]');
  const temWebGL = (() => {
    try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
  })();
  if (canvas && temWebGL) {
    const comecar = () => import('./aneis-cena').then(({ iniciar }) => iniciar(canvas));
    if ('requestIdleCallback' in window) requestIdleCallback(comecar, { timeout: 1200 });
    else setTimeout(comecar, 300);
  }
</script>

<style>
  .aneis-fundo {
    position: fixed; inset: 0; z-index: 0; width: 100vw; height: 100vh;
    display: block; pointer-events: none; opacity: 0;
  }
</style>
