---
/**
 * TESTE (10/10/2026), fora da home: "Resultados por especialidade" como cases
 * de números grandes. Pedido da Lenora: a foto não é o foco ("é só uma
 * representação"), o número ficava longe do texto e a dobra tem de convencer
 * como case. Segue o molde da faixa de números do ClickUp (10/10: "seguir à
 * risca a referência"): colunas em fio fino, com a especialidade, o número
 * grande, o que ele mede colado embaixo e o contexto. Sem foto. Os textos reorganizam
 * as frases de data/home.ts (números ainda provisórios, ver a nota de lá).
 */
import Selo from '../ui/Selo.astro';

const cases = [
  { area: 'Dermatologia', antes: '', valor: 19, depois: '%', mede: 'de taxa de agendamento', contexto: 'Alcançada em 90 dias de operação.' },
  { area: 'Cirurgia plástica', antes: '', valor: 38, depois: '%', mede: 'da receita vinda do digital', contexto: 'O digital passou a ser parte medida do faturamento da clínica.' },
  { area: 'Otorrino', antes: '', valor: 29, depois: '%', mede: 'de leads recuperados', contexto: 'Com processo comercial automatizado e follow-ups estruturados.' },
  { area: 'Nutrologia', antes: '', valor: 24, depois: '%', mede: 'de pacientes reativados', contexto: 'Em um trimestre, com ações estruturadas de relacionamento.' },
  { area: 'Tricologia', antes: '', valor: 60, depois: ' dias', mede: 'para rastrear a origem de cada lead', contexto: 'Com os dados centralizados em um único painel.' },
];
---
<section class="secao resultados-editoriais" id="resultados" data-tom="claro" aria-labelledby="resultados-titulo">
  <div class="container">
    <header class="rc__cabeca">
      <Selo class="cabeca-dobra__selo">Resultados por especialidade</Selo>
      <h2 class="rc__titulo" id="resultados-titulo">O que muda quando a <strong>operação tem estrutura</strong>.</h2>
      <p class="rc__apoio">Clínicas de especialidades diferentes, com a operação estruturada pela Renke.</p>
    </header>

    <ol class="rc" aria-label="Resultados por especialidade">
      {cases.map((c, i) => (
        <li class="rc__case" style={`--i:${i}`} data-rc>
          <p class="rc__area">{c.area}</p>
          <p class="rc__numero num">
            <span class="visually-hidden">{c.antes}{c.valor}{c.depois}</span>
            <span aria-hidden="true"><span data-rc-n={c.valor}>{c.valor}</span><span class="rc__unidade">{c.depois}</span></span>
          </p>
          <p class="rc__mede">{c.mede}</p>
          <p class="rc__contexto">{c.contexto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cartoes = [...document.querySelectorAll<HTMLElement>('[data-rc]')];
  if (cartoes.length && 'IntersectionObserver' in window) {
    const contar = (el: HTMLElement) => {
      const alvo = Number(el.dataset.rcN), t0 = performance.now(), dur = 1600;
      const passo = (agora: number) => {
        const t = Math.min(1, (agora - t0) / dur);
        el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - t, 4))));
        if (t < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('rc__case--visto');
        const n = e.target.querySelector<HTMLElement>('[data-rc-n]');
        if (n && !parado) contar(n);
        obs.unobserve(e.target);
      }
    }, { threshold: .35 });
    cartoes.forEach((c) => obs.observe(c));
  } else cartoes.forEach((c) => c.classList.add('rc__case--visto'));
</script>

<style>
  /* Molde da faixa de números do ClickUp (docs/04-design/referencia-clickup.md):
     cabeça à esquerda e, embaixo, colunas separadas por fio fino. Sem cartão,
     sem sombra e sem foto. O número e o que ele mede ficam colados. */
  .rc__cabeca { display: grid; justify-items: start; margin-bottom: clamp(36px, 4vw, 60px); }
  .rc__titulo { margin: 0; font-family: var(--font-titulo); font-weight: 300; font-size: clamp(34px, 3.4vw, 52px); line-height: 1.08; letter-spacing: -.035em; text-wrap: balance; color: #252523; }
  .rc__titulo strong { font-weight: 500; }
  .rc__apoio { margin: clamp(14px, 1.4vw, 20px) 0 0; max-width: 52ch; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.6; color: #50504e; }

  .rc { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid rgb(37 37 35 / .14); }
  .rc__case { display: grid; grid-template-rows: auto auto auto 1fr; min-width: 0; padding: clamp(20px, 1.8vw, 28px) 0 clamp(24px, 2.4vw, 36px); border-bottom: 1px solid rgb(37 37 35 / .14); color: #252523; }
  .rc__area { margin: 0 0 clamp(14px, 1.4vw, 20px); font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: #6b6b68; }
  .rc__numero { margin: 0; font-family: var(--font-titulo); font-size: clamp(56px, 5.6vw, 96px); font-weight: 350; line-height: .9; letter-spacing: -.06em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rc__unidade { font-size: .46em; letter-spacing: -.03em; margin-left: .08em; color: #6b6b68; }
  .rc__mede { margin: clamp(10px, 1vw, 14px) 0 0; font-family: var(--font-titulo); font-size: clamp(17px, 1.35vw, 20px); font-weight: 500; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .rc__contexto { align-self: end; margin: clamp(40px, 5vw, 84px) 0 0; font-size: clamp(14px, 1.05vw, 15.5px); line-height: 1.5; color: #50504e; text-wrap: pretty; }

  @media (min-width: 900px) {
    .rc { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .rc__case { padding-inline: clamp(16px, 1.6vw, 26px); border-left: 1px solid rgb(37 37 35 / .14); }
    .rc__case:first-child { padding-left: 0; border-left: 0; }
    .rc__case:last-child { padding-right: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .rc__case > * { opacity: 0; transform: translateY(14px); transition: opacity .9s cubic-bezier(.22, 1, .36, 1), transform .9s cubic-bezier(.22, 1, .36, 1); transition-delay: calc(var(--i) * 90ms); }
    .rc__case--visto > * { opacity: 1; transform: none; }
  }
</style>
