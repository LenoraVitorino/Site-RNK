---
import { rodape } from '../data/nav';
import { existe } from '../data/rotas';
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col">
        <img class="logo__img logo__img--rodape" src="/marca/renke-assinatura.png" alt="Renke" width="299" height="62" />
        <p class="footer__tagline">{rodape.tagline}</p>
      </div>

      <nav class="footer__col" aria-label="Links do rodapé">
        <p class="footer__title">Links</p>
        <ul>
          {rodape.links.map((l) => (
            <li>
              <a
                href={existe(l.rota) ? l.rota : '#'}
                data-rota={l.rota}
                class:list={[!existe(l.rota) && 'nav--pendente']}
              >{l.rotulo}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__title">Siga-nos</p>
        <ul>
          {rodape.redes.map((r) => <li><a href={r.rota}>{r.rotulo}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__title">Contato</p>
        <ul class="footer__contact">
          <li>{rodape.endereco.map((linha, i) => <>{i > 0 && <br />}{linha}</>)}</li>
          <li>{rodape.email}</li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>{rodape.copyright}</p>
      <p><em>{rodape.assinatura}</em></p>
    </div>
  </div>
</footer>
