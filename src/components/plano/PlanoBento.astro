---
/**
 * "O que o Start faz" em bento, no molde do bento do Protocolo Revena da
 * home (10/10/2026): cartões arredondados, margem larga, a arte em cima numa
 * área de altura fixa e o texto embaixo. As ideias de cada peça ficaram; o
 * que mudou é que elas contam um processo feito por gente, como na home, em
 * vez de mostrar uma tela parada ("tem que ter storytelling, um processo
 * para contar; não precisa ser muito animado"):
 *   0 · a Juliana chega pelo Google e anda do contato ao fechamento, com
 *       quem cuida dela em cada etapa (marketing, comercial, clínica);
 *   1 · a etapa de avaliação sendo cumprida, critério por critério, pelo
 *       time comercial;
 *   2 · as automações saindo sozinhas, cada uma no seu momento;
 *   3 · a reunião mensal: quem lê os dados aponta o canal que mais fecha.
 * A mesma clínica fictícia da home (Clínica Âmbar) e as fotos reais da
 * equipe. Sem métricas inventadas; amarelo num detalhe por peça. Uma coisa
 * se move por peça, devagar; sem movimento, cada arte mostra o estado final.
 */
import { Image } from 'astro:assets';
import Selo from '../ui/Selo.astro';
import type { ContextoSecao } from '../pagina/contexto';
import isa from '../../assets/equipe/isa.jpg';
import julio from '../../assets/equipe/julio-caldeira.jpg';
import lari from '../../assets/equipe/lari.jpg';
import pedro from '../../assets/equipe/pedro-packness.jpg';
import maria from '../../assets/equipe/maria.jpg';

interface Props { h2: string; sub?: string; itens: { titulo: string; texto?: string }[]; selo?: string; secao: ContextoSecao }
const { h2, sub, itens, selo, secao } = Astro.props;
const pecas = ['origem', 'processo', 'automacao', 'dados'];
const rosto = { width: 96, height: 96, format: 'webp' as const, quality: 80, alt: '', loading: 'lazy' as const, class: 'pb-rosto' };

/* 0 · A jornada: quatro etapas e quem cuida de cada uma. Tempos em % de 14 s. */
const etapas = [
  { nome: 'Contato', quem: 'Marketing', estado: 'Novo contato' },
  { nome: 'Agendamento', quem: 'Comercial', estado: 'Agendada' },
  { nome: 'Avaliação', quem: 'Clínica', estado: 'Em avaliação' },
  { nome: 'Fechamento', quem: 'Clínica', estado: 'Fechou' },
];
const TJ = [18, 40, 62];
const quadrosJornada = [
  `@keyframes pb-j-fio{0%,${TJ[0]}%{transform:scaleX(0)}${TJ[0] + 8}%,${TJ[1]}%{transform:scaleX(.3333)}${TJ[1] + 8}%,${TJ[2]}%{transform:scaleX(.6667)}${TJ[2] + 8}%,94%{transform:scaleX(1)}100%{transform:scaleX(0)}}`,
  ...TJ.map((t, k) => `@keyframes pb-j-no-${k + 1}{0%,${t + 6}%{opacity:.34}${t + 10}%,94%{opacity:1}100%{opacity:.34}}`),
  `@keyframes pb-j-est-0{0%,${TJ[0] + 6}%{opacity:1}${TJ[0] + 8}%,98%{opacity:0}100%{opacity:1}}`,
  ...[1, 2].map((k) => `@keyframes pb-j-est-${k}{0%,${TJ[k - 1] + 8}%{opacity:0}${TJ[k - 1] + 10}%,${TJ[k] + 6}%{opacity:1}${TJ[k] + 8}%,100%{opacity:0}}`),
  `@keyframes pb-j-est-3{0%,${TJ[2] + 8}%{opacity:0;transform:scale(.92)}${TJ[2] + 12}%,94%{opacity:1;transform:none}98%,100%{opacity:0;transform:none}}`,
].join('');

/* 1 · Os critérios da etapa sendo cumpridos: `em` é quando entra em
   andamento e `feito` quando conclui, em % de 14 s. */
const criterios = [
  { titulo: 'Roteiro de atendimento', area: 'Recepção', dono: pedro, em: 10, feito: 24 },
  { titulo: 'Orçamento apresentado', area: 'Comercial', dono: lari, em: 34, feito: 48 },
  { titulo: 'Retorno em 48 horas', area: 'Follow-up', dono: lari, em: 58, feito: 72 },
];
const quadrosProcesso = criterios.map((t, k) => [
  `@keyframes pb-c-${k}{0%,${t.em}%{opacity:.34}${t.em + 3}%,94%{opacity:1}100%{opacity:.34}}`,
  `@keyframes pb-c-dono-${k}{0%,${t.em}%{opacity:0;transform:scale(.7)}${t.em + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
  `@keyframes pb-c-ponto-${k}{0%,${t.em}%{opacity:0}${t.em + 3}%,${t.feito}%{opacity:1}${t.feito + 2}%,100%{opacity:0}}`,
  `@keyframes pb-c-visto-${k}{0%,${t.feito}%{opacity:0;transform:scale(.5)}${t.feito + 3}%,94%{opacity:1;transform:none}100%{opacity:0;transform:none}}`,
].join('')).join('')
  + `@keyframes pb-c-barra{0%,${criterios[0].feito}%{transform:scaleX(0)}${criterios.map((t, k) => `${t.feito + 4}%${k < 2 ? `,${criterios[k + 1].feito}%` : ',94%'}{transform:scaleX(${((k + 1) / 3).toFixed(4)})}`).join('')}100%{transform:scaleX(0)}}`
  + '@keyframes pb-c-est-a{0%,76%{opacity:1}78%,96%{opacity:0}100%{opacity:1}}'
  + '@keyframes pb-c-est-b{0%,78%{opacity:0;transform:scale(.92)}82%,94%{opacity:1;transform:none}98%,100%{opacity:0;transform:none}}';

/* 2 · As automações, cada uma saindo no seu momento. */
const automacoes = [
  ['Confirmação', 'ao agendar'],
  ['Lembrete', '24 horas antes'],
  ['Follow-up', '2 dias depois'],
  ['Alerta', 'sem resposta'],
];
const quadrosAutomacao = automacoes.map((_, k) => {
  const t = 8 + k * 20;
  return `@keyframes pb-a-${k}{0%,${t}%{opacity:.38}${t + 3}%,94%{opacity:1}100%{opacity:.38}}`
    + `@keyframes pb-a-antes-${k}{0%,${t + 6}%{opacity:1}${t + 8}%,97%{opacity:0}100%{opacity:1}}`
    + `@keyframes pb-a-depois-${k}{0%,${t + 8}%{opacity:0;transform:scale(.9)}${t + 11}%,94%{opacity:1;transform:none}98%,100%{opacity:0;transform:none}}`;
}).join('');

/* 3 · A leitura dos dados na reunião do mês: o cursor de quem conduz vai
   até o canal que mais fecha e a nota aparece. */
const quadrosDados = [
  '@keyframes pb-d-mouse{0%,8%{opacity:0;transform:translate(52cqw,210px)}18%,26%{opacity:1;transform:translate(44cqw,150px)}40%,84%{opacity:1;transform:translate(80cqw,132px)}92%,100%{opacity:0;transform:translate(84cqw,150px)}}',
  '@keyframes pb-d-forte{0%,40%{background:rgb(242 242 238 / .18)}46%,90%{background:#F2F2EE}98%,100%{background:rgb(242 242 238 / .18)}}',
  '@keyframes pb-d-nota{0%,44%{opacity:0;transform:translateY(8px) scale(.96)}50%,90%{opacity:1;transform:none}96%,100%{opacity:0;transform:none}}',
].join('');
---
<section class="plano-faz plano-bento-dobra" id={secao.id} data-cena={secao.cena} aria-labelledby={secao.tituloId}>
  <div class="container">
    <header class="plano-cabeca entra">
      {selo && <Selo class="cabeca-dobra__selo">{selo}</Selo>}
      <h2 id={secao.tituloId} class="titulo">{h2}</h2>
      {sub && <p class="cabeca-dobra__apoio plano-faz__sub">{sub}</p>}
    </header>
    <ol class="plano-bento">
      {itens.map((it, i) => (
        <li class:list={['feature-card', 'revena-peca', 'plano-peca', `plano-peca--${pecas[i]}`, 'entra']} style={`--i:${i % 2}`}>
          <div class="feature-card__texto"><h3>{it.titulo}</h3>{it.texto && <p>{it.texto}</p>}</div>

          {i === 0 && (
            <div class="plano-peca__arte pb pb-jornada" aria-hidden="true">
              <style is:inline set:html={quadrosJornada}></style>
              <div class="pb-lead">
                <i class="pb-ini">JM</i>
                <div><strong>Juliana M.</strong><span>Harmonização · veio do Google</span></div>
                <span class="pb-estado">
                  {etapas.map((e, k) => <b class:list={['pb-anim', k === 3 && 'pb-estado__fim']} style={`--a:pb-j-est-${k}`}>{k === 3 && <i></i>}{e.estado}</b>)}
                </span>
              </div>
              <ol class="pb-trilha">
                {etapas.map((e, k) => (
                  <li class:list={[k > 0 && 'pb-anim', k === 3 && 'pb-trilha__fim']} style={k > 0 ? `--a:pb-j-no-${k}` : undefined}>
                    <i></i>
                    <b>{e.nome}</b>
                    <span class="pb-quem">
                      {k === 0 && <span class="pb-rostos"><Image src={isa} {...rosto} /><Image src={julio} {...rosto} /></span>}
                      {k === 1 && <span class="pb-rostos"><Image src={lari} {...rosto} /><Image src={pedro} {...rosto} /></span>}
                      {k > 1 && <span class="pb-clinica"><svg viewBox="0 0 24 24" focusable="false"><path d="M6.5 17.5 12 6l5.5 11.5" /><circle cx="12" cy="15.2" r="1.3" /></svg></span>}
                      {e.quem}
                    </span>
                  </li>
                ))}
                <li class="pb-trilha__fio"><b class="pb-anim" style="--a:pb-j-fio"></b></li>
              </ol>
            </div>
          )}

          {i === 1 && (
            <div class="plano-peca__arte pb pb-processo" aria-hidden="true">
              <style is:inline set:html={quadrosProcesso}></style>
              <div class="pb-topo">
                <span class="pb-rostos"><Image src={lari} {...rosto} /><Image src={pedro} {...rosto} /></span>
                <div><strong>Avaliação</strong><span>Etapa do processo</span></div>
                <span class="pb-estado">
                  <b class="pb-anim" style="--a:pb-c-est-a">Em andamento</b>
                  <b class="pb-estado__fim pb-anim" style="--a:pb-c-est-b"><svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.4l3 3 6-6.6" /></svg>Cumprida</b>
                </span>
              </div>
              <div class="pb-barra"><i class="pb-anim" style="--a:pb-c-barra"></i></div>
              <ul class="pb-lista">
                {criterios.map((t, k) => (
                  <li class="pb-tarefa pb-anim" style={`--a:pb-c-${k}`}>
                    <span class="pb-tarefa__marca">
                      <b class="pb-tarefa__ponto pb-anim" style={`--a:pb-c-ponto-${k}`}><svg viewBox="0 0 20 20" focusable="false"><path d="M10 3a7 7 0 0 1 7 7" /></svg></b>
                      <b class="pb-tarefa__visto pb-anim" style={`--a:pb-c-visto-${k}`}><svg viewBox="0 0 20 20" focusable="false"><path d="M5.6 10.4l3 3 5.8-6.6" /></svg></b>
                    </span>
                    <span class="pb-tarefa__texto">{t.titulo}<span>{t.area}</span></span>
                    <Image src={t.dono} {...rosto} class="pb-rosto pb-anim" style={`--a:pb-c-dono-${k}`} />
                  </li>
                ))}
              </ul>
            </div>
          )}

          {i === 2 && (
            <div class="plano-peca__arte pb pb-automacao" aria-hidden="true">
              <style is:inline set:html={quadrosAutomacao}></style>
              <div class="pb-topo">
                <span class="pb-clinica"><svg viewBox="0 0 24 24" focusable="false"><path d="M6.5 17.5 12 6l5.5 11.5" /><circle cx="12" cy="15.2" r="1.3" /></svg></span>
                <div><strong>Clínica Âmbar</strong><span>Juliana M. · avaliação na sexta</span></div>
              </div>
              <ul class="pb-lista pb-lista--fios">
                {automacoes.map(([nome, quando], k) => (
                  <li class="pb-regra pb-anim" style={`--a:pb-a-${k}`}>
                    <b>{nome}</b><small>{quando}</small>
                    <span class="pb-envio">
                      <em class="pb-anim" style={`--a:pb-a-antes-${k}`}>Programado</em>
                      <em class="pb-envio__feito pb-anim" style={`--a:pb-a-depois-${k}`}><svg viewBox="0 0 16 16" focusable="false"><path d="M3.5 8.4l3 3 6-6.6" /></svg>Enviado</em>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {i === 3 && (
            <div class="plano-peca__arte pb pb-dados" aria-hidden="true">
              <style is:inline set:html={quadrosDados}></style>
              <div class="pb-topo">
                <Image src={maria} {...rosto} />
                <div><strong>Reunião mensal</strong><span>Leitura dos dados com a clínica</span></div>
              </div>
              <div class="pb-leituras">
                <div class="pb-painel">
                  <p>Custo por paciente</p>
                  <svg viewBox="0 0 160 64" preserveAspectRatio="none"><path class="pb-area" d="M0 12C28 14 40 30 66 32S110 46 148 50V64H0Z" /><path class="pb-linha" d="M0 12C28 14 40 30 66 32S110 46 148 50" /></svg>
                </div>
                <div class="pb-painel">
                  <p>Conversão por etapa</p>
                  <div class="pb-funil"><i style="--l:100%"></i><i style="--l:72%"></i><i style="--l:48%"></i><i style="--l:30%"></i></div>
                </div>
                <div class="pb-painel">
                  <p>Performance por canal</p>
                  <div class="pb-colunas"><i style="--h:46%"></i><i style="--h:100%;--a:pb-d-forte" class="forte pb-anim"></i><i style="--h:64%"></i><i style="--h:34%"></i></div>
                </div>
              </div>
              <div class="pb-nota pb-anim" style="--a:pb-d-nota"><i></i><div><strong>Canal que mais fecha</strong><span>Google</span></div></div>
              <div class="pb-mouse pb-anim" style="--a:pb-d-mouse">
                <svg viewBox="0 0 16 16" focusable="false"><path d="M1.5 1.5l12 4.6-5.2 2.2-2.2 5.2z" /></svg>
                <span class="pb-mouse__quem"><Image src={maria} {...rosto} /></span>
              </div>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .plano-bento {
    --peca-vao: 16px; --peca-recuo: clamp(24px, 2.2vw, 34px); --arte-h: 280px;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--peca-vao); margin: 0; padding: 0; list-style: none;
  }
  .plano-bento .plano-peca {
    --base: var(--peca-recuo);
    grid-column: span 12; gap: 0; clip-path: none; border-radius: clamp(22px, 2vw, 30px); padding: var(--peca-recuo);
    background: linear-gradient(160deg, #151514, #0c0c0c 72%); box-shadow: 0 0 0 1px rgb(242 242 238 / .06) inset;
  }
  .plano-peca .feature-card__texto { order: 2; margin: 0; padding-top: clamp(16px, 1.5vw, 22px); }
  .plano-peca .feature-card__texto p { max-width: 46ch; }
  .plano-peca .plano-peca__arte { order: 1; flex: none; position: relative; height: var(--arte-h); margin: 0; padding: 0; }
  @media (min-width: 1000px) {
    .plano-bento .plano-peca--origem, .plano-bento .plano-peca--dados { grid-column: span 7; }
    .plano-bento .plano-peca--processo, .plano-bento .plano-peca--automacao { grid-column: span 5; }
  }

  /* O vocabulário das artes (o mesmo do Protocolo da home). */
  .pb { --tinta: #F2F2EE; --suave: rgb(242 242 238 / .58); --fio: rgb(242 242 238 / .1); --anel: rgb(242 242 238 / .26); container-type: inline-size; display: flex; flex-direction: column; font-family: var(--font-titulo); color: var(--tinta); font-size: 14px; line-height: 1.35; letter-spacing: -.01em; }
  .pb strong { display: block; font-weight: 500; font-size: 15px; letter-spacing: -.015em; }
  .pb strong + span { display: block; margin-top: 2px; color: var(--suave); font-size: 13px; }
  .pb svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .pb .pb-rosto { display: block; width: 40px; height: 40px; flex: none; border-radius: 50%; object-fit: cover; background: #2a2a29; }
  .pb-rostos { display: flex; flex: none; }
  .pb-rostos > * + * { margin-left: -12px; box-shadow: 0 0 0 2px #121212; }
  .pb-clinica { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--amarelo-marca, #FFD103); color: #161616; }
  .pb-clinica svg { width: 62%; height: 62%; stroke-width: 1.7; }
  .pb-clinica circle { fill: #161616; stroke: none; }
  .pb-topo { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .pb-topo > div { min-width: 0; }
  /* O estado, que troca conforme o processo anda; o final é o elemento claro. */
  .pb-estado { display: grid; justify-items: end; margin-left: auto; }
  .pb-estado b { grid-area: 1 / 1; display: flex; align-items: center; gap: 7px; height: 30px; padding-inline: 12px; border-radius: 15px; box-shadow: 0 0 0 1px rgb(242 242 238 / .2) inset; font-size: 12.5px; font-weight: 400; white-space: nowrap; opacity: 0; }
  .pb-estado .pb-estado__fim { background: #F2F2EE; color: #161616; box-shadow: none; font-weight: 500; opacity: 1; }
  .pb-estado__fim i { width: 7px; height: 7px; border-radius: 50%; background: var(--amarelo-marca, #FFD103); box-shadow: 0 0 0 1px rgb(22 22 22 / .3); }
  .pb-estado__fim svg { width: 15px; height: 15px; margin-left: -3px; stroke-width: 1.8; }
  .pb-lista { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; margin: 0; padding: 0; list-style: none; }

  /* 0 · A jornada da Juliana: a ficha em cima, as etapas e quem cuida embaixo. */
  .pb-jornada { justify-content: center; gap: clamp(32px, 3.4vw, 48px); }
  /* A ficha solta no cartão, sem caixa própria (bloco dentro de bloco reprovado). */
  .pb-lead { display: flex; align-items: center; gap: 12px; }
  .pb-lead > div { min-width: 0; }
  .pb-ini { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #F2F2EE; color: #161616; font-style: normal; font-size: 14px; font-weight: 500; }
  .pb-trilha { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .pb-trilha li:not(.pb-trilha__fio) { position: relative; z-index: 1; display: grid; justify-items: start; min-width: 0; }
  .pb-trilha li > i { width: 11px; height: 11px; border-radius: 50%; background: #F2F2EE; box-shadow: 0 0 0 4px #111110; }
  .pb-trilha .pb-trilha__fim > i { background: var(--amarelo-marca, #FFD103); }
  .pb-trilha li > b { margin-top: 16px; font-size: 15px; font-weight: 500; letter-spacing: -.015em; }
  .pb-quem { display: flex; align-items: center; gap: 8px; margin-top: 12px; color: var(--suave); font-size: 13px; }
  .pb-quem .pb-rosto, .pb-quem .pb-clinica { width: 26px; height: 26px; }
  .pb-quem .pb-rostos > * + * { margin-left: -9px; }
  .pb-trilha__fio { position: absolute; left: 5px; top: 5px; width: 75%; height: 1px; background: rgb(242 242 238 / .16); }
  .pb-trilha__fio b { display: block; height: 100%; background: #F2F2EE; transform-origin: 0 50%; }

  /* 1 · Os critérios da etapa: em andamento (arco girando) e cumprido (visto). */
  .pb-barra { flex: none; height: 3px; margin: 16px 0 6px; border-radius: 2px; background: rgb(242 242 238 / .12); overflow: hidden; }
  .pb-barra i { display: block; height: 100%; border-radius: 2px; background: #F2F2EE; transform-origin: 0 50%; }
  .pb-tarefa { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 0 12px; }
  .pb-tarefa__marca { position: relative; width: 22px; height: 22px; border-radius: 50%; box-shadow: 0 0 0 1px var(--anel) inset; }
  .pb-tarefa__marca b { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 50%; }
  .pb-tarefa__marca svg { display: block; width: 100%; height: 100%; }
  .pb-tarefa__ponto { opacity: 0; }
  .pb-tarefa__ponto svg { stroke: var(--amarelo-marca, #FFD103); stroke-width: 1.6; }
  .pb-tarefa__visto { background: #F2F2EE; }
  .pb-tarefa__visto svg { stroke: #161616; stroke-width: 1.8; }
  .pb-tarefa__texto { min-width: 0; font-size: 14.5px; line-height: 1.25; }
  .pb-tarefa__texto > span { display: block; margin-top: 2px; color: var(--suave); font-size: 12.5px; }
  .pb-tarefa .pb-rosto { width: 30px; height: 30px; }

  /* 2 · As automações: nome, momento e o envio. */
  .pb-lista--fios { margin-top: 10px; }
  .pb-regra { display: grid; grid-template-columns: minmax(0, 1fr) auto 92px; align-items: center; gap: 14px; flex: 1; border-top: 1px solid var(--fio); }
  .pb-regra b { font-weight: 400; font-size: 14.5px; }
  .pb-regra small { font-size: 13px; color: var(--suave); white-space: nowrap; }
  .pb-envio { display: grid; justify-items: end; }
  .pb-envio em { grid-area: 1 / 1; display: flex; align-items: center; gap: 6px; font-style: normal; font-size: 12.5px; color: var(--suave); white-space: nowrap; opacity: 0; }
  .pb-envio .pb-envio__feito { color: var(--tinta); opacity: 1; }
  .pb-envio__feito svg { width: 16px; height: 16px; padding: 2px; border-radius: 50%; background: #F2F2EE; stroke: #161616; stroke-width: 2; }

  /* 3 · A leitura dos dados: três leituras soltas, o cursor de quem conduz e a nota. */
  .pb-leituras { --vao: clamp(24px, 3vw, 40px); flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--vao); margin-top: 22px; }
  .pb-painel { position: relative; display: grid; grid-template-rows: auto 1fr; gap: 14px; min-width: 0; }
  .pb-painel + .pb-painel::before { content: ''; position: absolute; left: calc(var(--vao) / -2); top: 0; bottom: 0; width: 1px; background: var(--fio); }
  .pb-painel p { margin: 0; font-size: 13px; color: var(--suave); text-wrap: balance; }
