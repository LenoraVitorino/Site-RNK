---
/**
 * Hero dos planos Revena (04/10/2026). Partiu da referência Tres Mares
 * Capital (Private Equity) e, a pedido da Lenora, ficou como o plano na
 * home: fundo chapado (sem a cena 3D que se mexe), o nome do plano
 * diagramado à esquerda, em duas linhas desencontradas, com o selo, a frase
 * e o botão; à direita, grande, a arte do plano (slot "arte"): o símbolo
 * oficial como janela para o sistema funcionando (JanelaStart no Start; a
 * mão com a seringa da home saiu: "não gostei de repetir o que tem na
 * home"). Na base, a ficha do plano em colunas, como na referência.
 */
import Icone from '../ui/Icone.astro';
import Selo from '../ui/Selo.astro';
import { semSeta, type ContextoSecao } from '../pagina/contexto';

interface Props {
  linhas: [string, string];
  sub?: string;
  cta?: string;
  rotaCta?: string;
  ficha: { rotulo: string; valor: string }[];
  secao: ContextoSecao;
}
const { linhas, sub, cta, rotaCta = '#secao-2', ficha, secao } = Astro.props;
const naPagina = rotaCta.startsWith('#');

---
<section class="plano-hero" id={secao.id} data-cena={secao.cena} aria-labelledby={secao.tituloId}>
  <div class="container plano-hero__grade">
    <div class="plano-hero__texto">
      <Selo marca="revena">Protocolo Revena</Selo>
      <h1 id={secao.tituloId} class="plano-hero__titulo">
        <span class="plano-hero__linha">{linhas[0]}</span>
        <span class="plano-hero__linha plano-hero__linha--2">{linhas[1]}</span>
      </h1>
      {sub && <p class="plano-hero__sub">{sub}</p>}
      {cta && (
        <p class="plano-hero__acoes">
          <a class="botao botao--lg" href={rotaCta}>
            <span class="botao__texto">{semSeta(cta)}</span>
            <Icone nome={naPagina ? 'ArrowDown' : 'ArrowUpRight'} class={`botao__icone${naPagina ? ' botao__icone--baixo' : ''}`} size={20} />
          </a>
        </p>
      )}
    </div>
    <div class="plano-hero__imagem">
      <div class="plano-hero__arte"><slot name="arte" /></div>
    </div>
    <dl class="plano-hero__ficha">
      {ficha.map((f) => <div><dt>{f.rotulo}</dt><dd>{f.valor}</dd></div>)}
    </dl>
  </div>
</section>
