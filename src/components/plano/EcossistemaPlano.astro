---
/**
 * Arte da hero dos planos Revena (04/10/2026; parametrizada em 05/10 para
 * os cinco planos). Versão limpa, pedida pela Lenora: "mais elegante,
 * moderna, minimalista… clean, soft, pegando tudo que a gente já criou de
 * ilustração". Poucas peças, no idioma das ilustrações do Protocolo: o
 * núcleo com anéis, com o símbolo do plano; um cartão que chega; uma
 * mensagem, confirmada pelo cursor Renke; e uma pílula de estado. Uma luz
 * amarela percorre os três fios, um de cada vez. Laço de 9 s, só CSS; com
 * movimento reduzido, parado. Caixa de 640 × 560 com as peças em %; os
 * fios são traçados pelo script a partir da posição real de cada peça.
 * O conteúdo de cada plano vem de src/data/planos.ts.
 */
import type { ArtePlano } from '../../data/planos';
interface Props { plano: string; arte: ArtePlano }
const { plano, arte } = Astro.props;
const fios = [0, 1, 2];
const ICONES = {
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="3.75" /><circle cx="16.9" cy="7.1" r=".9" fill="currentColor" stroke="none" />',
  relatorio: '<rect x="4.5" y="3.5" width="15" height="17" rx="2.5" /><path d="M8.5 15.5V12M12 15.5V9M15.5 15.5V11" />',
  busca: '<circle cx="11" cy="11" r="6.5" /><path d="M16 16L20.5 20.5" />',
  campanha: '<path d="M4 10V14H7L14 18.5V5.5L7 10ZM17.5 9.5A4 4 0 0 1 17.5 14.5" />',
} as const;
---
<div class="eco" aria-hidden="true" data-eco>
  <svg class="eco__fios" viewBox="0 0 640 560" focusable="false">
    {fios.map((i) => <path class="eco__fio" data-fio={i} />)}
    {fios.map((i) => <path class:list={['eco__luz', `eco__luz--${i}`]} data-fio={i} pathLength="1" />)}
  </svg>

  <div class="eco__nucleo">
    <span class="eco__anel eco__anel--3"></span>
    <span class="eco__anel eco__anel--2"></span>
    <span class="eco__anel eco__anel--1"></span>
    <span class="eco__miolo"><img src={`/icones/plano-${plano}-dark.svg`} alt="" width="1080" height="1080" /></span>
  </div>

  <div class="eco__peca eco__lead">
    <span class="eco__icone"><svg viewBox="0 0 24 24" set:html={ICONES[arte.chegada.icone]} /></span>
    <span class="eco__texto"><b>{arte.chegada.titulo}</b><small>{arte.chegada.sub}</small></span>
  </div>

  <div class="eco__peca eco__lembrete">
    <p class="eco__cabeca">
      <svg viewBox="0 0 24 24"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.6L3.5 20.5l1.4-4.4A8.5 8.5 0 1 1 20.5 11.5Z" /></svg>
      <b>{arte.mensagem.rotulo}</b><small>{arte.mensagem.canal}</small><small class="eco__agora">{arte.mensagem.quando}</small>
    </p>
    <p class="eco__mensagem">{arte.mensagem.texto}</p>
    <svg class="eco__visto" viewBox="0 0 24 24"><path d="M2.5 12.5L7 17L15.5 7.5M9.5 15.5L11 17L19.5 7.5" /></svg>
  </div>

  <div class="eco__peca eco__agendado"><span class="eco__ponto"></span><b>{arte.estado.titulo}</b><small>{arte.estado.sub}</small></div>

  <div class="eco__cursor"><svg viewBox="0 0 24 24"><path d="M3 2L21 10L13 12L10 21Z" /></svg><span>Renke</span></div>
</div>

<script>
  /* Traça os fios entre as peças: lead → topo do núcleo; lado do núcleo →
     topo do lembrete; base do núcleo → lado da pílula de agendado. */
  document.querySelectorAll<HTMLElement>('[data-eco]').forEach((eco) => {
    const svg = eco.querySelector('svg')!;
    const q = (s: string) => eco.querySelector<HTMLElement>(s)!;
    const tracar = () => {
      const b = eco.getBoundingClientRect(); if (!b.width) return;
      const r = (s: string) => { const x = q(s).getBoundingClientRect(); return { l: x.left - b.left, t: x.top - b.top, r: x.right - b.left, b: x.bottom - b.top, cx: x.left - b.left + x.width / 2, cy: x.top - b.top + x.height / 2 }; };
      const lead = r('.eco__lead'), miolo = r('.eco__miolo'), lem = r('.eco__lembrete'), ag = r('.eco__agendado');
      const f = (n: number) => n.toFixed(1);
      const lx = lem.l + (lem.r - lem.l) * .78;   /* chega ao lembrete pela direita do núcleo */
      const d = [
        `M${f(lead.r)} ${f(lead.cy)}C${f(miolo.cx)} ${f(lead.cy)} ${f(miolo.cx)} ${f(lead.cy)} ${f(miolo.cx)} ${f(miolo.t)}`,
        `M${f(miolo.r)} ${f(miolo.cy)}C${f(lx)} ${f(miolo.cy)} ${f(lx)} ${f(miolo.cy)} ${f(lx)} ${f(lem.t)}`,
        `M${f(miolo.cx)} ${f(miolo.b)}C${f(miolo.cx)} ${f(ag.cy)} ${f(miolo.cx)} ${f(ag.cy)} ${f(ag.r)} ${f(ag.cy)}`,
      ];
      svg.setAttribute('viewBox', `0 0 ${f(b.width)} ${f(b.height)}`);
      svg.querySelectorAll<SVGPathElement>('[data-fio]').forEach((p) => p.setAttribute('d', d[Number(p.dataset.fio)]));
    };
    tracar();
    document.fonts?.ready.then(tracar);
    new ResizeObserver(tracar).observe(eco);
  });
</script>

<style>
  .eco { position: absolute; inset: 0; container-type: inline-size; font-family: var(--font-titulo); color: #ecece8; }
  .eco__fios { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .eco__fio { fill: none; stroke: rgb(242 242 238 / .16); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .eco__luz { fill: none; stroke: var(--destaque, #FFD103); stroke-width: 1.6; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: .16 1.2; stroke-dashoffset: .16; opacity: 0; }

  /* O núcleo: anéis quase invisíveis em volta do símbolo do plano. */
  .eco__nucleo { position: absolute; left: 52%; top: 43%; translate: -50% -50%; width: 15cqw; aspect-ratio: 1; display: grid; place-items: center; }
  .eco__nucleo > * { grid-area: 1 / 1; }
  .eco__anel { border-radius: 3.6cqw; border: 1px solid rgb(255 255 255 / .06); background: rgb(255 255 255 / .012); }
  .eco__anel--1 { width: 22cqw; height: 22cqw; }
  .eco__anel--2 { width: 30cqw; height: 30cqw; border-radius: 4.6cqw; border-color: rgb(255 255 255 / .045); }
  .eco__anel--3 { width: 38cqw; height: 38cqw; border-radius: 5.6cqw; border-color: rgb(255 255 255 / .03); background: none; }
  .eco__miolo {
    position: relative; display: grid; place-items: center; width: 15cqw; height: 15cqw; border-radius: 3cqw;
    background: linear-gradient(160deg, #262624, #141413); border: 1px solid rgb(255 255 255 / .1);
    box-shadow: 0 2cqw 5cqw rgb(0 0 0 / .45), inset 0 1px 0 rgb(255 255 255 / .06);
  }
  .eco__miolo img { width: 74%; height: auto; }
  .eco__miolo::after { content: ''; position: absolute; inset: -1px; border-radius: inherit; box-shadow: 0 0 0 1px var(--destaque, #FFD103), 0 0 3cqw rgb(255 209 3 / .25); opacity: 0; }

  /* As peças: vidro escuro suave, como os cartões do Protocolo. */
  .eco__peca {
    position: absolute; display: flex; align-items: center; gap: max(8px, 1.4cqw);
    padding: max(10px, 1.7cqw) max(12px, 2cqw); border-radius: max(12px, 2cqw);
    background: linear-gradient(160deg, rgb(255 255 255 / .08), rgb(255 255 255 / .03));
    border: 1px solid rgb(255 255 255 / .09);
    -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    box-shadow: 0 2.4cqw 6cqw rgb(0 0 0 / .4);
  }
  .eco__peca b { font-weight: 500; font-size: max(12px, 2.2cqw); letter-spacing: -.01em; white-space: nowrap; }
  .eco__peca small { font-size: max(11px, 1.85cqw); color: rgb(242 242 238 / .5); white-space: nowrap; }
  .eco__texto { display: grid; gap: .3cqw; }
  .eco__lead { left: 4%; top: 6%; }
  .eco__icone { display: grid; place-items: center; width: max(30px, 5.6cqw); height: max(30px, 5.6cqw); border-radius: 50%; background: rgb(255 255 255 / .06); border: 1px solid rgb(255 255 255 / .08); }
  .eco__icone svg, .eco__cabeca svg { width: max(15px, 2.6cqw); height: max(15px, 2.6cqw); fill: none; stroke: currentColor; stroke-width: 1.5; }

  .eco__lembrete { left: 48%; top: 72%; width: 51%; display: grid; gap: max(6px, 1cqw); }
  .eco__cabeca { margin: 0; display: flex; align-items: center; gap: max(6px, 1cqw); }
  .eco__agora { margin-left: auto; }
  .eco__mensagem { margin: 0; padding-right: max(22px, 4cqw); font-size: max(12px, 2.05cqw); line-height: 1.45; color: rgb(242 242 238 / .82); text-wrap: pretty; }
  .eco__visto { position: absolute; right: max(12px, 2cqw); bottom: max(10px, 1.7cqw); width: max(16px, 2.8cqw); height: max(16px, 2.8cqw); fill: none; stroke: rgb(242 242 238 / .35); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .eco__agendado { left: 2%; top: 62%; padding-block: max(9px, 1.4cqw); border-radius: 99px; }
  .eco__ponto { width: max(7px, 1.2cqw); height: max(7px, 1.2cqw); border-radius: 50%; background: rgb(242 242 238 / .3); }

  .eco__cursor { position: absolute; z-index: 3; left: 88%; top: 86%; display: flex; align-items: flex-start; gap: .3cqw; opacity: 0; }
  .eco__cursor svg { width: max(16px, 3cqw); height: max(16px, 3cqw); fill: #f2f2ee; stroke: #161616; stroke-width: 1.2; stroke-linejoin: round; }
  .eco__cursor span { margin-top: max(12px, 2.2cqw); padding: .45cqw 1.3cqw; border-radius: 99px; background: var(--destaque, #FFD103); color: #161616; font-size: max(10px, 1.6cqw); font-weight: 500; }

  /* Celular: a caixa fica mais alta e as peças se espaçam na vertical. */
  @container (max-width: 520px) {
    .eco__nucleo { left: 58%; top: 40%; }
    .eco__lead { left: 0; top: 2%; }
    .eco__agendado { left: 0; top: 60%; }
    .eco__lembrete { left: 22%; top: 76%; width: 78%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada: o núcleo, depois as peças, uma a uma, subindo de leve. */
    :global(.js) .eco__nucleo { animation: eco-surge 1.4s var(--easing) .2s both; }
    :global(.js) .eco__fio { animation: eco-surge 1.2s var(--easing) .6s both; }
    :global(.js) .eco__lead { animation: eco-sobe 1.2s var(--easing) .7s both; }
    :global(.js) .eco__lembrete { animation: eco-sobe 1.2s var(--easing) .9s both; }
    :global(.js) .eco__agendado { animation: eco-sobe 1.2s var(--easing) 1.1s both; }
    /* O laço de 9 s: a luz corre lead → núcleo → lembrete → agendado. */
    .eco__luz--0 { animation: eco-luz-0 9s linear 2s infinite; }
    .eco__luz--1 { animation: eco-luz-1 9s linear 2s infinite; }
    .eco__luz--2 { animation: eco-luz-2 9s linear 2s infinite; }
    .eco__miolo::after { animation: eco-acende 9s var(--easing) 2s infinite; }
    .eco__visto { animation: eco-visto 9s var(--easing) 2s infinite; }
    .eco__ponto { animation: eco-ponto 9s var(--easing) 2s infinite; }
    .eco__cursor { animation: eco-cursor 9s var(--easing) 2s infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eco__visto { stroke: var(--destaque, #FFD103); }
    .eco__ponto { background: var(--destaque, #FFD103); }
  }
  @keyframes eco-surge { from { opacity: 0; } }
  @keyframes eco-sobe { from { opacity: 0; translate: 0 12px; } }
  @keyframes eco-luz-0 { 0% { opacity: 0; stroke-dashoffset: .16; } 2% { opacity: 1; } 16% { opacity: 1; stroke-dashoffset: -1; } 17%, 100% { opacity: 0; stroke-dashoffset: -1; } }
  @keyframes eco-luz-1 { 0%, 21% { opacity: 0; stroke-dashoffset: .16; } 23% { opacity: 1; } 37% { opacity: 1; stroke-dashoffset: -1; } 38%, 100% { opacity: 0; stroke-dashoffset: -1; } }
  @keyframes eco-luz-2 { 0%, 58% { opacity: 0; stroke-dashoffset: .16; } 60% { opacity: 1; } 74% { opacity: 1; stroke-dashoffset: -1; } 75%, 100% { opacity: 0; stroke-dashoffset: -1; } }
  @keyframes eco-acende { 0%, 14% { opacity: 0; } 19% { opacity: 1; } 30%, 100% { opacity: 0; } }
  @keyframes eco-visto { 0%, 50% { stroke: rgb(242 242 238 / .35); } 53%, 90% { stroke: var(--destaque, #FFD103); } 96%, 100% { stroke: rgb(242 242 238 / .35); } }
  @keyframes eco-ponto { 0%, 72% { background: rgb(242 242 238 / .3); box-shadow: none; } 76%, 90% { background: var(--destaque, #FFD103); box-shadow: 0 0 1.6cqw rgb(255 209 3 / .5); } 96%, 100% { background: rgb(242 242 238 / .3); box-shadow: none; } }
  /* O cursor chega ao visto do lembrete, clica e sai. */
  @keyframes eco-cursor {
    0%, 30% { opacity: 0; left: 96%; top: 96%; }
    36% { opacity: 1; }
    46% { left: 92%; top: 85%; transform: none; }
    49% { transform: scale(.86); }
    52% { transform: none; }
    62% { opacity: 1; left: 92%; top: 85%; }
    70%, 100% { opacity: 0; left: 96%; top: 96%; }
  }
</style>
