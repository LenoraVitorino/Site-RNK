---
/**
 * Arte da hero do Revena Start (04/10/2026): um infográfico do ecossistema
 * que o Start monta, no lugar do símbolo (a Lenora reprovou o sistema
 * dentro do símbolo e a mão da home: "faz um ecossisteminha, um
 * infográfico"). As quatro frentes de "O que o Start faz" em volta do CRM,
 * a fonte única:
 *   esquerda — Marketing: os canais de onde os leads chegam;
 *   em cima — Processo comercial: Lead → Contato → Agendado → Paciente;
 *   direita — Automação: follow-up, lembrete, confirmação;
 *   embaixo — Dados: custo por paciente, conversão por etapa, performance por canal.
 * Em laço, devagar: um ponto amarelo sai de um canal e chega ao CRM; do CRM
 * o lead percorre as etapas, dispara uma automação e alimenta um painel de
 * dados. Com movimento reduzido, fica parado. Sem números inventados.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

/* O símbolo oficial, versão para fundo claro (amarelo e grafite), no cartão do CRM. */
const simbolo = readFileSync(join(__RAIZ__, 'public', 'icones', 'plano-start-light.svg'), 'utf8')
  .match(/<rect[\s\S]*<\/svg>/)?.[0].replace('</svg>', '')
  .replace(/class="cls-1"/g, 'fill="#FFD103"').replace(/<rect (?![^>]*fill=)/g, '<rect fill="#232321" ') ?? '';

const ch = (x: number, y: number, w: number, h: number, c: number) =>
  `M${x + c} ${y}H${x + w - c}L${x + w} ${y + c}V${y + h - c}L${x + w - c} ${y + h}H${x + c}L${x} ${y + h - c}V${y + c}Z`;

const HUB = { x: 228, y: 232, w: 168, h: 104 };
const hc = { x: HUB.x + HUB.w / 2, y: HUB.y + HUB.h / 2 };
const canais = ['Google', 'Meta', 'Instagram', 'Site', 'Indicação'].map((n, i) => ({ n, y: 176 + i * 46 }));
const etapas = ['Lead', 'Contato', 'Agendado', 'Paciente'].map((n, i) => ({ n, x: 164 + i * 112 }));
const autos = ['Follow-up', 'Lembrete', 'Confirmação'].map((n, i) => ({ n, y: 214 + i * 46 }));
const dados = ['Custo por paciente', 'Conversão por etapa', 'Performance por canal'].map((n, i) => ({ n, x: 98 + i * 162 }));
/* Mini gráficos dos painéis de dados (alturas relativas, sem valores). */
const barras = [[.45, .6, .5, .75, .62, .9], [1, .72, .5, .3], [.8, .55, .95, .4, .65]];
---
<div class="eco" data-eco aria-hidden="true">
  <svg viewBox="0 0 640 560" focusable="false">
    <!-- Fios -->
    <g class="eco__fios">
      {canais.map((c, i) => <path class="eco__fio" data-fio={`canal-${i}`} pathLength="1" d={`M146 ${c.y}C190 ${c.y} 190 ${hc.y} ${HUB.x} ${hc.y}`} style={`--i:${i}`} />)}
      <path class="eco__fio" data-fio="etapas" pathLength="1" d={`M${hc.x} ${HUB.y}V150H${hc.x}`} style="--i:5" />
      {autos.map((a, i) => <path class="eco__fio" data-fio={`auto-${i}`} pathLength="1" d={`M${HUB.x + HUB.w} ${hc.y}C${HUB.x + HUB.w + 40} ${hc.y} ${474 - 40} ${a.y} 474 ${a.y}`} style={`--i:${6 + i}`} />)}
      {dados.map((d, i) => <path class="eco__fio" data-fio={`dado-${i}`} pathLength="1" d={`M${hc.x} ${HUB.y + HUB.h}V410H${d.x + 72}V436`} style={`--i:${9 + i}`} />)}
      <path class="eco__fio eco__fio--etapas" d={`M${etapas[0].x + 96} 116H${etapas[3].x}`} />
    </g>
    <g data-pulsos></g>

    <!-- Rótulos das frentes -->
    <text class="eco__frente" x="18" y="156">Marketing</text>
    <text class="eco__frente" x="164" y="74">Processo comercial</text>
    <text class="eco__frente" x="474" y="194">Automação</text>

    <!-- Marketing: canais -->
    {canais.map((c, i) => (
      <g class="eco__no" data-no={`canal-${i}`} style={`--i:${i}`}>
        <rect x="18" y={c.y - 16} width="128" height="32" rx="16" />
        <circle class="eco__marca" cx="36" cy={c.y} r="3.5" />
        <text x="48" y={c.y + 4.5}>{c.n}</text>
      </g>
    ))}

    <!-- Processo comercial: etapas -->
    {etapas.map((e, i) => (
      <g class="eco__no eco__no--etapa" data-no={`etapa-${i}`} style={`--i:${5 + i}`}>
        <rect x={e.x} y="98" width="96" height="36" rx="10" />
        <text x={e.x + 48} y="121" text-anchor="middle">{e.n}</text>
        {i < 3 && <path class="eco__seta" d={`M${e.x + 101} 112L${e.x + 107} 116L${e.x + 101} 120`} />}
      </g>
    ))}

    <!-- O CRM, a fonte única -->
    <g class="eco__hub" data-hub>
      <path class="eco__hub-fundo" d={ch(HUB.x, HUB.y, HUB.w, HUB.h, 12)} />
      <g class="eco__hub-simbolo" transform={`translate(${HUB.x + 10} ${HUB.y + 14}) scale(.0705)`} set:html={simbolo} />
      <text class="eco__hub-nome" x={HUB.x + 92} y={HUB.y + 48}>CRM</text>
      <text class="eco__hub-sub" x={HUB.x + 92} y={HUB.y + 66}>fonte única</text>
      <text class="eco__hub-sub" x={HUB.x + 92} y={HUB.y + 81}>dos dados</text>
    </g>

    <!-- Automação -->
    {autos.map((a, i) => (
      <g class="eco__no" data-no={`auto-${i}`} style={`--i:${9 + i}`}>
        <rect x="474" y={a.y - 16} width="148" height="32" rx="16" />
        <path class="eco__raio" d={`M492 ${a.y - 6}L487 ${a.y + 1}H492L489 ${a.y + 7}L497 ${a.y - 1}H492Z`} />
        <text x="506" y={a.y + 4.5}>{a.n}</text>
      </g>
    ))}

    <!-- Dados -->
    <text class="eco__frente" x="98" y="404">Dados</text>
    {dados.map((d, i) => (
      <g class="eco__no eco__no--dado" data-no={`dado-${i}`} style={`--i:${12 + i}`}>
        <rect x={d.x} y="436" width="144" height="112" rx="12" />
        <text class="eco__dado-nome" x={d.x + 14} y="460">{d.n}</text>
        {barras[i].map((h, k) => {
          const n = barras[i].length, larg = (116 - (n - 1) * 6) / n;
          return <rect class:list={['eco__barra', { 'eco__barra--viva': k === n - 1 || (i === 1 && k === 0) }]} x={d.x + 14 + k * (larg + 6)} y={536 - h * 54} width={larg} height={h * 54} rx="2" style={`--k:${k}`} />;
        })}
      </g>
    ))}
  </svg>
</div>

<script>
  /* O laço do ecossistema: canal → CRM → etapas → automação → dados. */
  document.querySelectorAll<HTMLElement>('[data-eco]').forEach((raiz) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { raiz.classList.add('eco--parado'); return; }
    const svg = raiz.querySelector('svg')!, camada = svg.querySelector('[data-pulsos]')!;
    const no = (id: string) => svg.querySelector<SVGGElement>(`[data-no="${id}"]`);
    const fio = (id: string) => svg.querySelector<SVGPathElement>(`[data-fio="${id}"]`)!;
    const hub = svg.querySelector('[data-hub]')!;
    const suave = (k: number) => (k < .5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
    const acende = (el: Element | null, ms = 1400) => { if (!el) return; el.classList.add('eco--aceso'); setTimeout(() => el.classList.remove('eco--aceso'), ms); };
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const pulso = (p: SVGPathElement, dur: number, volta = false) => new Promise<void>((fim) => {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('r', '4.5'); c.setAttribute('fill', '#FFD103'); camada.appendChild(c);   /* criado no script: o estilo com escopo não alcança */
      const len = p.getTotalLength(), t0 = performance.now();
      const passo = (t: number) => {
        const k = Math.min(1, (t - t0) / dur), d = suave(k) * len, pt = p.getPointAtLength(volta ? len - d : d);
        c.setAttribute('cx', pt.x.toFixed(1)); c.setAttribute('cy', pt.y.toFixed(1));
        if (k < 1) requestAnimationFrame(passo); else { c.remove(); fim(); }
      };
      requestAnimationFrame(passo);
    });
    let visivel = false, rodando = false, n = 0;
    const ciclo = async () => {
      rodando = true;
      while (visivel) {
        const c = n % 5, a = n % 3, d = (n + 1) % 3; n++;
        acende(no(`canal-${c}`), 1600);
        await pulso(fio(`canal-${c}`), 1300);
        acende(hub, 900);
        await pulso(fio('etapas'), 700);
        for (let e = 0; e < 4; e++) { acende(no(`etapa-${e}`), e === 3 ? 1800 : 700); await espera(380); }
        await Promise.all([
          pulso(fio(`auto-${a}`), 1000).then(() => acende(no(`auto-${a}`), 1500)),
          pulso(fio(`dado-${d}`), 1200).then(() => acende(no(`dado-${d}`), 1700)),
        ]);
        await espera(900);
      }
      rodando = false;
    };
    new IntersectionObserver(([e]) => { visivel = e.isIntersecting; if (visivel && !rodando) setTimeout(ciclo, 2200); }, { threshold: .3 }).observe(raiz);
  });
</script>

<style>
  .eco { position: absolute; inset: 0; display: grid; place-items: center; }
  .eco svg { width: 100%; height: 100%; overflow: visible; font-family: var(--font-titulo); }
  .eco__fio { fill: none; stroke: rgb(242 242 238 / .16); stroke-width: 1; }
  .eco__fio--etapas { stroke: rgb(242 242 238 / .22); }
  .eco__frente { font-size: 10.5px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; fill: rgb(242 242 238 / .46); }
  .eco__no rect:first-child { fill: rgb(255 255 255 / .035); stroke: rgb(242 242 238 / .16); stroke-width: 1; transition: stroke .7s var(--easing), fill .7s var(--easing); }
  .eco__no text { font-size: 13px; fill: #dcdcd8; transition: fill .7s var(--easing); }
  .eco__marca { fill: rgb(242 242 238 / .35); transition: fill .7s var(--easing); }
  .eco__raio { fill: rgb(242 242 238 / .45); transition: fill .7s var(--easing); }
  .eco__seta { fill: none; stroke: rgb(242 242 238 / .35); stroke-width: 1.2; }
  .eco__dado-nome { font-size: 11.5px !important; fill: #c9c9c5 !important; }
  .eco__barra { fill: rgb(242 242 238 / .16); transition: fill .8s var(--easing); }
  .eco__barra--viva { fill: rgb(242 242 238 / .42); }
  .eco__hub-fundo { fill: #f2f2ee; }
  .eco__hub-nome { font-size: 22px; font-weight: 500; letter-spacing: -.02em; fill: #232321; }
  .eco__hub-sub { font-size: 11.5px; fill: #5f5f5c; }
  .eco__hub-simbolo { transition: transform .7s var(--easing); }

  /* Aceso: o fio fino vira amarelo, o texto clareia. */
  .eco__no.eco--aceso rect:first-child { stroke: var(--destaque, #FFD103); fill: rgb(255 209 3 / .06); }
  .eco__no.eco--aceso text { fill: #fff; }
  .eco__no.eco--aceso .eco__marca, .eco__no.eco--aceso .eco__raio { fill: var(--destaque, #FFD103); }
  .eco__no--etapa.eco--aceso rect:first-child { fill: var(--destaque, #FFD103); }
  .eco__no--etapa.eco--aceso text { fill: #232321; font-weight: 500; }
  .eco__no--dado.eco--aceso .eco__barra--viva { fill: var(--destaque, #FFD103); }
  .eco__hub.eco--aceso .eco__hub-fundo { fill: #fff; }

  /* Entrada: o CRM primeiro, depois cada frente e os fios se desenhando. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .eco__hub { animation: eco-aparece 1.1s var(--easing) .2s both; }
    :global(.js) .eco__no, :global(.js) .eco__frente { animation: eco-aparece 1s var(--easing) calc(.55s + var(--i, 4) * 70ms) both; }
    :global(.js) .eco__fio { stroke-dasharray: 1; stroke-dashoffset: 1; animation: eco-fio 1.4s var(--easing) calc(.5s + var(--i, 0) * 60ms) forwards; }
    :global(.js) .eco__fio--etapas { stroke-dasharray: none; animation: eco-aparece 1s var(--easing) .9s both; }
  }
  @keyframes eco-aparece { from { opacity: 0; } }
  @keyframes eco-fio { to { stroke-dashoffset: 0; } }
</style>
