---
/**
 * "Ideal para clínicas que:" nos planos (10/10/2026). Uma caixa escura de
 * cantos arredondados, como os cartões do bento, que sobe sobre o pé da hero
 * e serve de limite para o símbolo. Dentro, o título e os tópicos lado a
 * lado, separados por fios, cada um com o losango amarelo. Sem foto, ícone
 * ou número; lista empilhada e frase corrida foram reprovadas.
 */
import type { ContextoSecao } from '../pagina/contexto';

interface Props { h2: string; itens: string[]; secao: ContextoSecao }   // serve a qualquer lista do plano
const { h2, itens, secao } = Astro.props;
---
<section class="plano-ideal" id={secao.id} data-cena={secao.cena} aria-labelledby={secao.tituloId}>
  <div class="container">
    <div class="plano-ideal__caixa">
      <h2 id={secao.tituloId} class="titulo plano-ideal__titulo">{h2}</h2>
      <ol class="plano-ideal__lista">
        {itens.map((item) => <li class="plano-ideal__item">{item}</li>)}
      </ol>
    </div>
  </div>
</section>
