---
/**
 * "Ideal para clínicas que:" nos planos (04/10/2026). A dobra vira o painel
 * claro translúcido com chanfro da home (método e Resultados). Desde
 * 06/10, no desenho dos números de "O que a Renke faz": o título no alto e
 * os itens lado a lado, em colunas separadas por fios, cada um com o ícone
 * no quadrado amarelo (sem número: a Lenora não gosta de numeração, 04/10).
 * A coluna do título presa deixava meia dobra vazia.
 */
import IconeRenke from '../ui/IconeRenke.astro';
import type { ContextoSecao } from '../pagina/contexto';

interface Props { h2: string; itens: string[]; secao: ContextoSecao }   // serve a qualquer lista do plano
const { h2, itens, secao } = Astro.props;
---
<section class="plano-painel plano-ideal" id={secao.id} data-tom="claro" aria-labelledby={secao.tituloId}>
  <div class="container">
    <h2 id={secao.tituloId} class="titulo plano-ideal__titulo entra">{h2}</h2>
    <ol class="plano-ideal__lista" style={`--cols:${itens.length}`}>
      {itens.map((item, i) => (
        <li class="plano-ideal__item entra" style={`--i:${i}`}>
          <span class="plano-ideal__n" aria-hidden="true"><IconeRenke nome="verificado" size={20} /></span>
          <span>{item}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
