---
/**
 * Os 4 valores (04/10/2026). Sobre a cena, a cabeça centrada da home; a
 * foto do estúdio num cartão grande à esquerda e os quatro valores em
 * cartões de vidro com ícone à direita, dois por dois.
 */
import { Image } from 'astro:assets';
import estudio from '../../assets/sede/estudio.jpg';
import { doisPesos } from '../editorial/pesos';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
import type { NomeIconeRenke } from '../../data/icones-renke';
import type { BlocoDe } from '../pagina/contexto';

interface Props { bloco: BlocoDe<'blocos'> }
const { bloco } = Astro.props;
const [leve, forte] = doisPesos(bloco.h2, 1);
const icones: NomeIconeRenke[] = ['bussola', 'verificado', 'pessoas', 'crescimento'];
---
<section class="ed-secao ed-secao--cena fp-valores" id="faca-parte-valores" data-cena="pilares" data-tom="cena" aria-labelledby="faca-parte-valores-titulo">
  <div class="container">
    <header class="ed-cabeca ed-mascara entra">
      <Selo class="cabeca-dobra__selo">Valores</Selo>
      <h2 class="ed-titulo" id="faca-parte-valores-titulo">{leve} <b>{forte}</b></h2>
    </header>
    <div class="fp-valores__grade">
      <figure class="ed-foto fp-valores__foto entra">
        <Image src={estudio} alt="Parede amarela com o nome Renke em neon e a frase “Pense, elabore e surpreenda!”." format="webp" quality={78} widths={[560, 960, 1280]} sizes="(min-width: 900px) 48vw, 100vw" />
      </figure>
      {bloco.itens.map((v, i) => (
        <article class="ed-cartao fp-valor entra" style={`--i:${i}`}>
          <span class="ed-anel" aria-hidden="true"><IconeRenke nome={icones[i]} size={22} /></span>
          <div class="ed-cartao__corpo">
            <h3 class="ed-cartao__nome">{v.titulo}</h3>
            <p class="ed-cartao__texto">{v.texto}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .fp-valores__grade { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ed-vao); }
  .fp-valores__foto { grid-column: 1 / span 2; grid-row: 1 / span 2; min-height: 100%; }
  .fp-valor { min-height: clamp(240px, 19vw, 290px); }
  .fp-valor .ed-cartao__nome { font-size: clamp(17px, 1.35vw, 22px); }   /* "Autorresponsabilidade" numa linha */
  @media (max-width: 899.98px) {
    .fp-valores__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fp-valores__foto { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 4 / 3; }
    .fp-valor { min-height: 0; }
  }
  @media (max-width: 599.98px) { .fp-valores__grade { grid-template-columns: 1fr; } }
</style>
