---
/**
 * Os 4 valores (04/10/2026). Sobre a cena, a foto do estúdio entra pela
 * direita e se desfaz; o título fica por cima,
 * à esquerda, e os quatro valores descem em colunas numeradas, entre fios.
 */
import { Image } from 'astro:assets';
import estudio from '../../assets/sede/estudio.jpg';
import { doisPesos } from '../editorial/pesos';
import type { BlocoDe } from '../pagina/contexto';

interface Props { bloco: BlocoDe<'blocos'> }
const { bloco } = Astro.props;
const [leve, forte] = doisPesos(bloco.h2, 1);
---
<section class="ed-secao ed-secao--grafite fp-valores" id="faca-parte-valores" data-cena="pilares" data-tom="cena" aria-labelledby="faca-parte-valores-titulo">
  <figure class="ed-foto fp-valores__foto" aria-hidden="true">
    <Image src={estudio} alt="" format="webp" quality={74} widths={[800, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
  </figure>
  <div class="container ed-grade fp-valores__grade">
    <h2 class="ed-display ed-mascara fp-valores__titulo entra" id="faca-parte-valores-titulo"><span>{leve}</span> <span><b>{forte}</b></span></h2>
    <ol class="fp-valores__lista ed-mascara" role="list">
      {bloco.itens.map((v, i) => (
        <li class="fp-valor entra" style={`--i:${i}`}>
          <span class="fp-valor__n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="fp-valor__titulo">{v.titulo}</h3>
          <p class="ed-corpo">{v.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* A foto entra pela direita e se desfaz na cena. */
  .fp-valores__foto {
    position: absolute; top: var(--ed-recuo); right: var(--ed-recuo); width: 62%; height: min(78%, 760px); z-index: -2; background: transparent; clip-path: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 50%), linear-gradient(to bottom, #000 50%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 50%), linear-gradient(to bottom, #000 50%, transparent);
    mask-composite: intersect;
  }
  .fp-valores__grade { row-gap: clamp(120px, 14vw, 240px); }
  .fp-valores__titulo { grid-column: 1 / span 7; font-size: clamp(56px, 8vw, 144px); padding-top: clamp(40px, 6vw, 120px); }
  .fp-valores__lista {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px var(--ed-gap);
  }
  .fp-valor { display: grid; align-content: start; gap: 14px; padding-top: 24px; border-top: 1px solid var(--ed-fio-escuro); }
  .fp-valor__n { font-size: 14px; color: var(--ed-amarelo); letter-spacing: .04em; }
  .fp-valor__titulo { margin: 0 0 4px; font-size: clamp(20px, 1.7vw, 28px); font-weight: 400; line-height: 1.1; letter-spacing: -.035em; }
  @media (max-width: 1099.98px) { .fp-valores__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 899.98px) {
    .fp-valores__foto { width: 100%; height: 520px; opacity: .6; }
    .fp-valores__titulo { grid-column: 1 / -1; }
  }
  @media (max-width: 599.98px) { .fp-valores__lista { grid-template-columns: 1fr; } }
</style>
