---
/**
 * O time (04/10/2026, layout editorial). Os retratos do time em grade, no
 * grafite: o fundo escuro e o amarelo dos retratos são os do próprio
 * estúdio fotográfico da Renke. O último quadro é o convite, em amarelo:
 * o próximo pode ser você (o único bloco amarelo da página).
 */
import { Image } from 'astro:assets';
import { equipe } from '../../data/equipe';
import { facaParteEd } from '../../data/paginas/faca-parte';
import Seta from '../editorial/Seta.astro';
import { doisPesos } from '../editorial/pesos';
const { time, convite } = facaParteEd;
const [leve, forte] = time.h2.includes(' ') ? doisPesos(time.h2, 2) : ['', time.h2];
---
<section class="ed-secao ed-secao--grafite fp-time" id="faca-parte-time" aria-labelledby="faca-parte-time-titulo">
  <div class="container fp-time__miolo">
    <header class="fp-time__cabeca entra">
      {time.rotulo && <p class="ed-antetitulo">{time.rotulo}</p>}
      <h2 class="ed-display ed-display--medio" id="faca-parte-time-titulo">{leve}{leve && ' '}<b>{forte}</b></h2>
    </header>
    <ul class="fp-time__grade" role="list">
      {equipe.map((p, i) => (
        <li class="fp-pessoa entra" style={`--i:${i % 6}`}>
          <figure class="fp-pessoa__quadro">
            <Image src={p.foto} alt="" format="webp" quality={78} widths={[240, 400, 560]} sizes="(min-width: 1200px) 220px, (min-width: 900px) 16vw, (min-width: 600px) 30vw, 46vw" />
          </figure>
          <p class="fp-pessoa__nome">{p.nome}</p>
        </li>
      ))}
      <li class="fp-convite entra" style="--i:5">
        <a class="fp-convite__link" href={convite.rota}>
          <span class="fp-convite__frase">{convite.frase}</span>
          <span class="fp-convite__acao">{convite.rotulo}<Seta /></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .fp-time__miolo { display: grid; gap: clamp(48px, 5vw, 80px); }
  .fp-time__cabeca .ed-antetitulo { color: rgb(242 242 238 / .66); }
  .fp-time__grade {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(28px, 2.6vw, 40px) var(--ed-gap);
  }
  .fp-pessoa { display: grid; gap: 12px; }
  .fp-pessoa__quadro { margin: 0; aspect-ratio: 1; overflow: hidden; background: #1a1a1a; }
  .fp-pessoa__quadro :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.2s cubic-bezier(.22, 1, .36, 1);
  }
  .fp-pessoa:hover .fp-pessoa__quadro :global(img) { transform: scale(1.04); }
  .fp-pessoa__nome { margin: 0; font-size: 15px; font-weight: 500; letter-spacing: -.01em; color: rgb(242 242 238 / .86); }
  /* O convite ocupa um quadro, com a altura do retrato. */
  .fp-convite { display: grid; min-width: 0; }
  .fp-convite__link {
    aspect-ratio: 1; min-width: 0; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between;
    padding: clamp(16px, 1.6vw, 24px); background: var(--ed-amarelo); color: #161616; text-decoration: none;
    transition: background-color .5s ease;
  }
  .fp-convite__link:hover { background: #ffdc3a; }
  .fp-convite__frase { font-size: clamp(17px, 1.6vw, 26px); font-weight: 700; line-height: .98; letter-spacing: -.045em; text-transform: uppercase; }
  .fp-convite__acao { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; }
  .fp-convite__acao :global(.ed-seta) { width: 26px; margin: 0; color: #161616; transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  .fp-convite__link:hover :global(.ed-seta) { transform: translateX(4px); }
  .fp-convite__link:focus-visible { outline: 2px solid var(--papel); outline-offset: 4px; }
  @media (max-width: 1099.98px) { .fp-time__grade { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 699.98px) { .fp-time__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
