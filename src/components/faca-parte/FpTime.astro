---
/**
 * O time (04/10/2026). Sobre a cena, a cabeça centrada da home e os
 * retratos em grade, em cantos arredondados. O último quadro é o convite,
 * em amarelo, como o cartão amarelo do bento do Protocolo.
 */
import { Image } from 'astro:assets';
import { equipe } from '../../data/equipe';
import { facaParteEd } from '../../data/paginas/faca-parte';
import { doisPesos } from '../editorial/pesos';
import Selo from '../ui/Selo.astro';
import IconeRenke from '../ui/IconeRenke.astro';
const { time, convite } = facaParteEd;
const [leve, forte] = time.h2.includes(' ') ? doisPesos(time.h2, 2) : ['', time.h2];
---
<section class="ed-secao ed-secao--cena fp-time" id="faca-parte-time" data-cena="pilares" data-tom="cena" aria-labelledby="faca-parte-time-titulo">
  <div class="container">
    <header class="ed-cabeca ed-mascara entra">
      {time.rotulo && <Selo class="cabeca-dobra__selo">{time.rotulo}</Selo>}
      <h2 class="ed-titulo" id="faca-parte-time-titulo">{leve}{leve && ' '}<b>{forte}</b></h2>
    </header>
    <ul class="fp-time__grade" role="list">
      {equipe.map((p, i) => (
        <li class="fp-pessoa entra" style={`--i:${i % 6}`}>
          <figure class="ed-foto fp-pessoa__quadro">
            <Image src={p.foto} alt="" format="webp" quality={78} widths={[240, 400, 560]} sizes="(min-width: 1200px) 200px, (min-width: 900px) 16vw, (min-width: 600px) 24vw, 46vw" />
          </figure>
          <p class="fp-pessoa__nome">{p.nome}</p>
        </li>
      ))}
      <li class="fp-convite entra" style="--i:5">
        <a class="fp-convite__link" href={convite.rota}>
          <span class="fp-convite__frase">{convite.frase}</span>
          <span class="fp-convite__acao">{convite.rotulo}<IconeRenke nome="seta" size={18} /></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .fp-time__grade { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 28px var(--ed-vao); }
  .fp-pessoa { display: grid; gap: 12px; align-content: start; }
  .fp-pessoa__quadro { aspect-ratio: 1; }
  .fp-pessoa__quadro :global(img) { transition: transform 1.2s cubic-bezier(.22, 1, .36, 1); }
  .fp-pessoa:hover .fp-pessoa__quadro :global(img) { transform: scale(1.04); }
  .fp-pessoa__nome { margin: 0; font-size: 15px; letter-spacing: -.01em; color: rgb(242 242 238 / .8); }
  .fp-convite { min-width: 0; }
  .fp-convite__link {
    aspect-ratio: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; overflow: hidden;
    padding: clamp(16px, 1.6vw, 24px); border-radius: var(--ed-raio-foto);
    background: var(--amarelo-marca, #FFD103); color: #161616; text-decoration: none; transition: background-color .5s ease;
  }
  .fp-convite__link:hover { background: #ffdc3a; }
  .fp-convite__frase { font-size: clamp(18px, 1.6vw, 26px); font-weight: 400; line-height: 1.1; letter-spacing: -.035em; }
  .fp-convite__acao { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 14px; font-weight: 500; }
  .fp-convite__link:focus-visible { outline: 2px solid var(--papel); outline-offset: 4px; }
  @media (max-width: 1099.98px) { .fp-time__grade { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 699.98px) { .fp-time__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
