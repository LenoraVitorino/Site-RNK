---
/**
 * Capa do Faça parte (04/10/2026). O retrato da Geise com a camiseta da
 * Renke entra pela direita e se desfaz na cena; o título da hero da home
 * passa por cima dele. O selo GPTW já aparece aqui, ao lado do botão.
 */
import { Image } from 'astro:assets';
import retrato from '../../assets/equipe/geise-retrato.jpg';
import seloGptw from '../../assets/selos/gptw-2025.png';
import Selo from '../ui/Selo.astro';
import Botao from '../ui/Botao.astro';
import { semSeta } from '../pagina/contexto';
import type { BlocoDe } from '../pagina/contexto';

interface Props { bloco: BlocoDe<'hero'> }
const { bloco } = Astro.props;
const forte = bloco.realce ?? bloco.titulo.length - 1;
---
<section class="ed-capa fp-capa" id="faca-parte-capa" data-cena="hero" data-tom="cena" aria-labelledby="faca-parte-titulo">
  <figure class="ed-capa__foto fp-capa__foto">
    <Image src={retrato} alt="Geise, do time da Renke, com a camiseta da marca." format="webp" quality={80} widths={[480, 800, 1280]} sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" />
  </figure>
  <div class="container fp-capa__miolo">
    <Selo class="fp-capa__rotulo" tom="escuro">A Renke</Selo>
    <h1 class="ed-capa__titulo entra" id="faca-parte-titulo">
      {bloco.titulo.map((l, i) => <span>{i === forte ? <b>{l}</b> : l}</span>)}
    </h1>
    {bloco.sub && <p class="ed-capa__sub entra" style="--i:1">{bloco.sub}</p>}
    <div class="fp-capa__acoes entra" style="--i:2">
      {bloco.cta && <Botao href={bloco.rotaCta ?? '#formulario'} variante="claro">{semSeta(bloco.cta)}</Botao>}
      <Image class="fp-capa__selo" src={seloGptw} alt="Selo Great Place To Work: empresa certificada no Brasil." width={84} />
    </div>
  </div>
</section>

<style>
  .fp-capa__foto {
    left: auto; width: min(52%, 820px);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 34%), linear-gradient(to bottom, #000 62%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 34%), linear-gradient(to bottom, #000 62%, transparent);
    mask-composite: intersect;
  }
  .fp-capa__foto :global(img) { object-position: 50% 18%; }
  .fp-capa::before { background: linear-gradient(to top, rgb(8 8 8 / .5) 0%, rgb(8 8 8 / 0) 40%); }
  .fp-capa__miolo { display: grid; justify-items: start; }
  .fp-capa__rotulo { margin-bottom: clamp(20px, 2.2vw, 28px); }
  .fp-capa__acoes { display: flex; align-items: center; gap: 24px; margin-top: clamp(28px, 3vw, 40px); }
  .fp-capa__acoes :global(.botao) { white-space: nowrap; }
  .fp-capa__selo { width: 84px; height: auto; }
  @media (max-width: 899.98px) { .fp-capa__foto { width: 100%; opacity: .5; } }
</style>
