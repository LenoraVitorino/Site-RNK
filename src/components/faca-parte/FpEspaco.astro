---
/**
 * O espaço (04/10/2026, layout editorial). Três fotos da sede numa faixa
 * de alturas diferentes, como página dupla de revista, com o título em
 * caixa alta por cima da primeira. Texto da casa do Sobre (data/sobre.ts),
 * que já tem as duas versões.
 */
import { Image } from 'astro:assets';
import cafe from '../../assets/sede/cafe.jpg';
import salaVidro from '../../assets/sede/sala-vidro.jpg';
import operacao from '../../assets/sede/operacao.jpg';
import { casa } from '../../data/sobre';
import { doisPesos } from '../editorial/pesos';
const [leve, forte] = doisPesos(casa.h2, 1);
---
<section class="ed-secao ed-secao--papel fp-espaco" id="faca-parte-espaco" data-tom="claro" aria-labelledby="faca-parte-espaco-titulo">
  <div class="container ed-grade fp-espaco__grade">
    <h2 class="ed-display ed-display--medio fp-espaco__titulo entra" id="faca-parte-espaco-titulo"><span>{leve}</span> <span><b>{forte}</b></span></h2>
    <p class="ed-chamada fp-espaco__texto entra" style="--i:1">{casa.texto}</p>
    <figure class="ed-foto ed-revela entra ed-sangra-esq fp-espaco__a">
      <Image src={cafe} alt="Área do café da sede, com bancada e cadeiras amarelas." format="webp" quality={78} widths={[640, 1120, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
    </figure>
    <figure class="ed-foto ed-revela entra fp-espaco__b" style="--i:1">
      <Image src={salaVidro} alt="Sala de reunião com divisória de vidro e palavras em amarelo na parede." format="webp" quality={78} widths={[400, 720, 1000]} sizes="(min-width: 900px) 24vw, 50vw" style="object-position: 20% 50%" />
    </figure>
    <figure class="ed-foto ed-revela entra ed-sangra-dir fp-espaco__c" style="--i:2">
      <Image src={operacao} alt="Time nas estações de trabalho, com o R amarelo na parede." format="webp" quality={78} widths={[400, 720, 1000]} sizes="(min-width: 900px) 24vw, 50vw" />
    </figure>
  </div>
</section>

<style>
  .fp-espaco__grade { row-gap: clamp(48px, 5vw, 80px); align-items: end; }
  .fp-espaco__titulo { grid-column: 1 / span 7; }
  .fp-espaco__texto { grid-column: 9 / -1; font-weight: 400; color: var(--ed-tinta-2); }
  .fp-espaco__a { grid-column: 1 / span 6; grid-row: 2; aspect-ratio: 4 / 3; }
  .fp-espaco__b { grid-column: 7 / span 3; grid-row: 2; aspect-ratio: 3 / 4; margin-bottom: clamp(48px, 6vw, 112px); }
  .fp-espaco__c { grid-column: 10 / -1; grid-row: 2; aspect-ratio: 3 / 5; }
  @media (max-width: 899.98px) {
    .fp-espaco__titulo, .fp-espaco__texto, .fp-espaco__a { grid-column: 1 / -1; grid-row: auto; }
    .fp-espaco__a { margin-right: 0; }
    .fp-espaco__b { grid-column: 1 / span 3; grid-row: auto; margin: 0; }
    .fp-espaco__c { grid-column: 4 / -1; grid-row: auto; margin-left: 0; }
  }
</style>
