---
/**
 * Botão do design system.
 *
 * Variantes de conversão (uma por página, no ponto principal):
 *   brilho      — borda cônica animada em amarelo sobre preto
 *   metal-ouro  — metálico na rampa do amarelo da marca
 *   vidro       — vidro líquido; precisa de fundo com textura atrás
 *
 * Variantes de uso corrente:
 *   relevo      — gradiente com relevo, para ações de destaque repetidas
 *   solido      — preenchimento escuro, padrão
 *   contorno    — secundária sobre fundo claro
 *   claro       — sobre fundo escuro
 *   metal       — metálico neutro
 *   texto       — terciária, peso de link
 *   onda        — escuro com painel amarelo de setas pontilhadas que cresce no hover (home v2)
 *
 * Ver docs/04-design/design-system.md
 */

interface Props {
  variante?:
    | 'brilho' | 'metal-ouro' | 'vidro'
    | 'relevo' | 'solido' | 'contorno' | 'claro' | 'metal' | 'texto' | 'onda';
  tamanho?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  bloco?: boolean;
  class?: string;
}

const {
  variante = 'solido',
  tamanho = 'md',
  href,
  type = 'button',
  bloco = false,
  class: extra = '',
} = Astro.props;

const ehMetal = variante === 'metal' || variante === 'metal-ouro';

const classes = [
  'botao',
  `botao--${variante}`,
  tamanho !== 'md' && `botao--${tamanho}`,
  bloco && 'botao--bloco',
  extra,
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'button';

/* Variante "onda": painel amarelo à esquerda com setas pontilhadas em onda,
   que cresce até o fim no hover. Cinco setas, dez pontos cada, com atrasos
   escalonados (desenho próprio, no amarelo original da marca). */
const pontos = [
  [2, 2, 0], [5, 5, .05], [8, 8, .1], [5, 11, .15], [2, 14, .2],
  [6, 2, .05], [9, 5, .1], [12, 8, .15], [9, 11, .2], [6, 14, .25],
];
const setas = [0, 1, 2, 3, 4];
---
{ehMetal ? (
  /* O metálico é feito de três camadas: borda em gradiente, miolo em
     gradiente e a superfície do botão. Cada uma reage a hover e active. */
  <span class={`metal ${bloco ? 'metal--bloco' : ''}`} data-tom={variante === 'metal-ouro' ? 'ouro' : 'neutro'}>
    <span class="metal__miolo" aria-hidden="true"></span>
    <Tag class={classes} href={href} type={href ? undefined : type}>
      <span class="botao__texto"><slot /></span>
    </Tag>
  </span>
) : (
  <Tag class={classes} href={href} type={href ? undefined : type}>
    {variante === 'vidro' && <span class="botao__vidro" aria-hidden="true"></span>}
    {variante === 'onda' && (
      <span class="onda" aria-hidden="true">
        {setas.map((i) => (
          <svg class="onda__seta" viewBox="0 0 14 16" width="14" height="16">
            {pontos.map(([cx, cy, d]) => (
              <circle cx={cx} cy={cy} r="1" class="onda__ponto" style={`animation-delay:${(i * 0.12 + d).toFixed(2)}s`} />
            ))}
          </svg>
        ))}
      </span>
    )}
    <span class="botao__texto"><slot /></span>
  </Tag>
)}
