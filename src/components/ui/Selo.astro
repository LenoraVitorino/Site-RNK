---
/**
 * Selo do texto de apoio (sobretítulo) das dobras: uma etiqueta com os
 * cantos levemente chanfrados (Lenora, 01/10: "ao invés de arredondado,
 * acabamento levemente diagonal, mas cuidar com o uso"), no mesmo corte dos
 * cartões do Protocolo e do painel do método, em escala pequena, com uma
 * sombra suave para baixo e para a esquerda. O chanfro fica nestes selos e
 * nos painéis; botões, campos e pílulas de interface seguem arredondados.
 * Leva uma marca num quadrado escuro, também chanfrado, à esquerda (a
 * Lenora chegou a tirar esse quadrado em 02/10 e pediu de volta em
 * seguida: "volta com o detalhe interno do shape"). marca="revena" leva o
 * logo do Protocolo Revena; marca="estrela" (padrão), o ✦ amarelo.
 * tom="auto" (padrão) é escuro e fica claro dentro das superfícies claras
 * do site; "claro" e "escuro" forçam o tom.
 * Todos os selos têm a mesma espessura (Lenora, 02/10): 45px de altura e
 * texto em 16px / 500, com ou sem o logo, inclusive o da hero.
 */
import LogoRevena from './LogoRevena.astro';

interface Props {
  tag?: 'h2' | 'p';
  id?: string;
  class?: string;
  tom?: 'auto' | 'claro' | 'escuro';
  marca?: 'revena' | 'estrela';
}
const { tag: Tag = 'p', id, class: classe, tom = 'auto', marca = 'estrela' } = Astro.props;
---
<Tag class:list={['selo-revena', `selo-revena--${tom}`, classe]} id={id}>
  <span class="selo-revena__marca" aria-hidden="true">{marca === 'revena' ? <LogoRevena /> : <span class="selo-revena__estrela">✦</span>}</span>
  <span class="selo-revena__texto"><slot /></span>
</Tag>

<style>
  /* A forma é um polígono recortado; o fundo e o fio de contorno ficam em
     dois pseudo-elementos, e a sombra vai em filter no elemento de fora,
     porque o recorte cortaria um box-shadow. */
  .selo-revena {
    --selo-corte: 9px; --selo-fundo: rgb(15 17 17 / .85); --selo-fio: rgb(242 242 238 / .12);
    --selo-sombra: rgb(0 0 0 / .55); --selo-anel: rgb(242 242 238 / .1);
    position: relative; isolation: isolate;
    display: inline-flex; align-items: center; gap: 12px; width: fit-content;   /* em grade, não estica; centra onde a grade centra */
    margin: 0; padding: 6px 20px 6px 6px;
    font-family: var(--font); font-size: 16px; font-weight: 500; line-height: 1.2;
    letter-spacing: -.01em; text-transform: none; text-wrap: balance; max-width: 100%;
    color: var(--papel);
    filter: drop-shadow(-10px 16px 16px var(--selo-sombra));
  }
  .selo-revena::before, .selo-revena::after, .selo-revena__marca::before, .selo-revena__marca::after {
    content: ''; position: absolute; z-index: -1;
    clip-path: polygon(
      var(--c) 0, calc(100% - var(--c)) 0, 100% var(--c), 100% calc(100% - var(--c)),
      calc(100% - var(--c)) 100%, var(--c) 100%, 0 calc(100% - var(--c)), 0 var(--c));
  }
  .selo-revena::before { --c: calc(var(--selo-corte) + .5px); inset: -1px; z-index: -2; background: var(--selo-fio); }
  .selo-revena::after { --c: var(--selo-corte); inset: 0; background: var(--selo-fundo); }
  .selo-revena--claro,
  :global(:is(.palcoplanos, .resultados-editoriais, #o-que-fazemos, .int-secao--papel)) .selo-revena--auto {
    --selo-fundo: #fff; --selo-fio: rgb(22 22 22 / .1); --selo-sombra: rgb(22 22 22 / .16); --selo-anel: rgb(22 22 22 / .08);
    color: #252523;
  }
  .selo-revena__marca {
    position: relative; isolation: isolate;
    display: grid; place-items: center; flex: none; width: 33px; height: 33px;
  }
  .selo-revena__marca::before { --c: 6.5px; inset: -2px; z-index: -2; background: var(--selo-anel); }
  .selo-revena__marca::after { --c: 5px; inset: 0; background: radial-gradient(circle at 35% 28%, #3a3a3a, #121212 72%); }
  .selo-revena__marca :global(svg) { width: 56%; height: 56%; }
  .selo-revena__estrela { color: var(--destaque); font-size: 16px; line-height: 1; }
  /* No celular, um ponto a menos para a frase da hero caber numa linha. */
  @media (max-width: 479.98px) { .selo-revena { gap: 10px; padding-right: 16px; font-size: 14.5px; } }
  /* Algumas dobras definem a entrelinha dos parágrafos por id; o texto do selo mantém a dele. */
  .selo-revena__texto { line-height: 1.2; }
</style>
