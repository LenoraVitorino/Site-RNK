---
/**
 * Os três números do briefing lado a lado, em amarelo, com a legenda
 * embaixo, sem rótulo nem fio (hero.numeros repartidos à mão,
 * ⚠️ D1). Era um carrossel; virou linha em 16/09/2026, a pedido da Lenora.
 */
const numeros = [
  { valor: '~30', legenda: 'clínicas atendidas' },
  { valor: '4 anos', legenda: 'de método validado' },
  { valor: 'R$42M', legenda: 'em faturamento gerado' },
];
---
<aside class="impacto entra" aria-label="Nossos números">
  <ul class="impacto__lista">
    {numeros.map((n) => (
      <li class="impacto__item">
        <p class="impacto__num num">{n.valor}</p>
        <p class="impacto__legenda">{n.legenda}</p>
      </li>
    ))}
  </ul>
</aside>
