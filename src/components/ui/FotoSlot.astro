---
/**
 * Espaço reservado para foto. Fundo neutro, ícone e um rótulo dizendo o que
 * vai ali — para o layout ser avaliado com o peso real da imagem, e para o
 * time saber exatamente o que produzir. Troca-se por <img> quando a foto
 * chegar, sem mexer no layout.
 */
interface Props {
  rotulo: string;
  /** Proporção largura/altura, ex.: "3 / 4". */
  prop?: string;
  reta?: boolean;
  class?: string;
}
const { rotulo, prop, reta = false, class: extra = '' } = Astro.props;
---
<figure class:list={['foto', reta && 'foto--reta', extra]} style={prop ? `--prop: ${prop}` : undefined} aria-label={`Espaço para foto: ${rotulo}`}>
  <div class="foto__caixa">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <circle cx="9" cy="10" r="2" />
      <path d="M21 16l-5-5-8 8" />
    </svg>
    <span>{rotulo}</span>
  </div>
</figure>
