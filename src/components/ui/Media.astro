---
import { porId, rotuloTipo } from '../../data/midia';
import Reel from './Reel.astro';

interface Props {
  /** Id do slot em src/data/midia.ts */
  id: string;
}

const { id } = Astro.props;
const slot = porId(id);
---
{slot.embed ? (
  <Reel embed={slot.embed} proporcao={slot.proporcao} titulo={slot.titulo} />
) : (
  <figure class="slot" style={`--proporcao: ${slot.proporcao}`} data-tipo={slot.tipo}>
    <div class="slot__caixa">
      <span class="slot__tipo">{rotuloTipo[slot.tipo]}</span>
      <span class="slot__titulo">{slot.titulo}</span>
    </div>
  </figure>
)}
