---
/**
 * Laboratório: a home com a camada dos três anéis por trás (22/09/2026).
 * Página de teste, fora dos buscadores e do menu. As dobras são as mesmas
 * da home; só o fundo e os cartões dos pilares mudam, com estilos presos a
 * body.laboratorio-aneis. Especificação: docs/04-design/hero-aneis-prompt.md.
 */
import Base2 from '../../layouts/Base2.astro';
import { seo } from '../../data/home';
import AneisFundo from '../../components/laboratorio/AneisFundo.astro';

import Hero from '../../components/home2/Hero.astro';
import OQueFaz from '../../components/home2/OQueFaz.astro';
import Protocolos from '../../components/home2/Protocolos.astro';
import Letreiro from '../../components/home2/Letreiro.astro';
import PlanosPalco from '../../components/home2/PlanosPalco.astro';
import Planos from '../../components/home2/Planos.astro';
import Perguntas from '../../components/home2/Perguntas.astro';
import Resultados from '../../components/home2/Resultados.astro';
import CtaFinal from '../../components/home2/CtaFinal.astro';
import AcademyTools from '../../components/home2/AcademyTools.astro';
import Formulario from '../../components/home2/Formulario.astro';
import Sobre from '../../components/home2/Sobre.astro';
import { copyLiteral } from '../../data/versao';
---
<Base2 titulo={`Laboratório · ${seo.titulo}`} descricao={seo.descricao} noindex classe="laboratorio-aneis">
  <AneisFundo slot="fundo" />
  <Hero />
  <OQueFaz />
  <Protocolos />
  <Letreiro />
  {!copyLiteral && <PlanosPalco />}
  {copyLiteral && <Planos />}
  <Perguntas />
  <Resultados />
  <CtaFinal />
  <AcademyTools />
  <Sobre />
  <Formulario />
</Base2>

<style is:global>
  /* Dobras escuras sem fundo próprio: o fundo passa a ser a cena dos anéis.
     As claras e a amarela continuam sólidas e sobem por cima dela. */
  body.laboratorio-aneis { background: #000; }
  .laboratorio-aneis .hero,
  .laboratorio-aneis #o-que-fazemos,
  .laboratorio-aneis #pilares-revena,
  .laboratorio-aneis .letreiro,
  .laboratorio-aneis #perguntas,
  .laboratorio-aneis #formulario { background: transparent; }
  .laboratorio-aneis .hero__fundo { display: none; }
  /* Dobras escuras que não participam: sólidas, para os anéis não aparecerem nelas. */
  .laboratorio-aneis #academy-tools,
  .laboratorio-aneis #sobre { background: var(--fundo); }
  /* Tudo o que é conteúdo fica acima da tela fixa dos anéis. */
  .laboratorio-aneis .footer { position: relative; z-index: 1; }

  /* Cartões dos pilares em vidro: escuro a 55% (abaixo disso o texto cinza
     perde contraste sobre o anel desfocado), desfoque do que está
     atrás, fio claro e brilho fino na borda de cima (terceira referência). */
  .laboratorio-aneis .pilar-card {
    background: rgb(12 12 11 / .55);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    backdrop-filter: blur(22px) saturate(1.25);
    border: 1px solid rgb(242 242 238 / .12);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .09), 0 30px 60px -30px rgb(0 0 0 / .6);
    transition: background .4s ease, border-color .4s ease;
  }
  .laboratorio-aneis .pilar-card:hover { background: rgb(22 22 20 / .62); border-color: rgb(242 242 238 / .2); }
  /* O pai com overflow: hidden recortaria o desfoque nas bordas da dobra. */
  .laboratorio-aneis #pilares-revena { overflow: visible; }
</style>
