---
/**
 * Laboratório: a home com o fundo vivo por trás (22/09/2026). Página de
 * teste, fora dos buscadores e do menu. As dobras são as mesmas da home; só
 * o fundo e os cartões mudam, com estilos presos a body.laboratorio-fundo.
 * O seletor compara os dois caminhos do briefing (?fundo=particulas|superficie).
 * Os anéis continuam em /laboratorio/aneis.
 * Especificação: docs/04-design/fundo-vivo-briefing.md.
 */
import Base2 from '../../layouts/Base2.astro';
import { seo } from '../../data/home';
import FundoVivo from '../../components/laboratorio/FundoVivo.astro';

import Hero from '../../components/home2/Hero.astro';
import OQueFaz from '../../components/home2/OQueFaz.astro';
import Protocolos from '../../components/home2/Protocolos.astro';
import Letreiro from '../../components/home2/Letreiro.astro';
import PlanosPalco from '../../components/home2/PlanosPalco.astro';
import Planos from '../../components/home2/Planos.astro';
import Perguntas from '../../components/home2/Perguntas.astro';
import Resultados from '../../components/home2/Resultados.astro';
import CtaFinal from '../../components/home2/CtaFinal.astro';
import AcademyTools from '../../components/home2/AcademyTools.astro';
import Formulario from '../../components/home2/Formulario.astro';
import Sobre from '../../components/home2/Sobre.astro';
import { copyLiteral } from '../../data/versao';
---
<Base2 titulo={`Laboratório · ${seo.titulo}`} descricao={seo.descricao} noindex classe="laboratorio-fundo">
  <FundoVivo slot="fundo" />
  <Hero />
  <OQueFaz />
  <Protocolos />
  <Letreiro />
  {!copyLiteral && <PlanosPalco />}
  {copyLiteral && <Planos />}
  <Perguntas />
  <Resultados />
  <CtaFinal />
  <AcademyTools />
  <Sobre />
  <Formulario />
  <nav class="lab-seletor" aria-label="Fundo">
    <span>Fundo</span>
    {[['particulas', 'Partículas'], ['superficie', 'Superfície']].map(([id, nome]) => (
      <a href={`?fundo=${id}`} data-fundo={id}>{nome}</a>
    ))}
  </nav>
</Base2>

<script>
  // Marca o fundo em uso no seletor (partículas é o padrão).
  const atual = new URLSearchParams(location.search).get('fundo') === 'superficie' ? 'superficie' : 'particulas';
  document.querySelector(`[data-fundo="${atual}"]`)?.setAttribute('aria-current', 'true');
</script>

<style is:global>
  /* Todas as dobras escuras ficam sem fundo próprio: o fundo passa a ser a
     cena, do começo ao fim, como nos vídeos de referência. As claras e a
     amarela continuam sólidas e sobem por cima dela, como cortina. */
  body.laboratorio-fundo { background: #000; }
  .laboratorio-fundo .hero,
  .laboratorio-fundo #o-que-fazemos,
  .laboratorio-fundo #pilares-revena,
  .laboratorio-fundo .letreiro,
  .laboratorio-fundo #perguntas,
  .laboratorio-fundo #academy-tools,
  .laboratorio-fundo #sobre,
  .laboratorio-fundo #formulario { background: transparent; }
  /* Na copy, as perguntas entram numa cortina por cima do trilho escuro dos
     Planos: ali elas precisam do fundo próprio para cobrir o trilho. */
  .laboratorio-fundo .cortina > #perguntas { background: #000; }
  .laboratorio-fundo .hero__fundo { display: none; }
  .laboratorio-fundo .footer { position: relative; z-index: 1; }
  /* Pais com overflow: hidden recortariam o desfoque nas bordas da dobra. */
  .laboratorio-fundo #pilares-revena { overflow: visible; }

  /* Vidro: escuro a 55% (abaixo disso o texto cinza perde contraste sobre o
     fundo desfocado), desfoque do que está atrás, fio claro e brilho fino na
     borda de cima, como na terceira referência. Vale para todo cartão que
     fica sobre o fundo vivo. */
  .laboratorio-fundo .pilar-card,
  .laboratorio-fundo #academy-tools .cartao,
  .laboratorio-fundo .form-card {
    background: rgb(12 12 11 / .55);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    backdrop-filter: blur(22px) saturate(1.25);
    border: 1px solid rgb(242 242 238 / .12);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .09), 0 30px 60px -30px rgb(0 0 0 / .6);
    transition: background .4s ease, border-color .4s ease;
  }
  .laboratorio-fundo .pilar-card:hover,
  .laboratorio-fundo #academy-tools .cartao:hover { background: rgb(22 22 20 / .62); border-color: rgb(242 242 238 / .2); }
  /* Os cartões da Academy e do Tools eram colunas com fio embaixo; como
     vidro, ganham respiro dos quatro lados. */
  .laboratorio-fundo #academy-tools .cartao { padding: clamp(18px, 1.6vw, 24px) clamp(18px, 1.6vw, 24px) clamp(24px, 2.2vw, 32px); }
  .laboratorio-fundo .cartao--tools .cartao__arte { background: rgb(242 242 238 / .04); }
  /* A pílula da hero também vira vidro. */
  .laboratorio-fundo .hero__selo {
    background: rgb(12 12 11 / .5);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
  }

  /* Seletor do laboratório: pílula vertical fixa na lateral direita, longe do conteúdo. */
  .lab-seletor {
    position: fixed; right: 12px; top: 50%; transform: translateY(-50%); z-index: 120;
    display: flex; flex-direction: column; align-items: stretch; gap: 4px; text-align: center;
    padding: 6px; border-radius: 22px; background: rgb(12 12 11 / .72);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border: 1px solid rgb(242 242 238 / .14); font-size: 13px; color: var(--cinza);
  }
  .lab-seletor span { padding: 6px 4px 2px; text-transform: uppercase; letter-spacing: .12em; font-size: 10px; }
  .lab-seletor a { padding: 7px 14px; border-radius: 999px; color: var(--papel); text-decoration: none; }
  .lab-seletor a:hover { background: rgb(242 242 238 / .08); }
  .lab-seletor a[aria-current] { background: var(--destaque); color: var(--grafite); }
  @media (max-width: 899.98px) {
    .lab-seletor { top: auto; bottom: 16px; right: 50%; transform: translateX(50%); flex-direction: row; border-radius: 999px; }
    .lab-seletor span { padding: 0 6px 0 8px; }
  }
</style>
