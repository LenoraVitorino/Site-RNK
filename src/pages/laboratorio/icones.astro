---
/**
 * Laboratório dos ícones Renke, V1 (02/10/2026). O conjunto inteiro no
 * escuro e no claro, em quatro tamanhos, ao lado da Lucide que cada um
 * substitui, e aplicado nos cartões dos ganhos e nas pílulas das
 * ilustrações. Nada disso está na home ainda: é a V1 para a Lenora aprovar.
 * Fora dos buscadores e do menu.
 */
import Base2 from '../../layouts/Base2.astro';
import IconeRenke from '../../components/ui/IconeRenke.astro';
import Icone from '../../components/ui/Icone.astro';
import { ICONES_RENKE, type NomeIconeRenke } from '../../data/icones-renke';
import { perguntas } from '../../data/home';

const nomes = Object.keys(ICONES_RENKE) as NomeIconeRenke[];
const grupos = [...new Set(nomes.map((n) => ICONES_RENKE[n].grupo))];
const ganhos: NomeIconeRenke[] = ['mira', 'funil', 'fluxo', 'investimento', 'dados', 'camadas', 'bussola'];
const pilulas: NomeIconeRenke[] = ['anuncios', 'instagram', 'google', 'atendimento', 'agenda', 'consulta'];
const comparar = nomes.filter((n) => 'substitui' in ICONES_RENKE[n]);
---
<Base2 titulo="Laboratório · ícones Renke" descricao="Ícones Renke, V1" noindex classe="lab-icones">
  <main class="li">
    <header class="li__cabeca">
      <p class="li__rotulo">Ícones Renke · V1</p>
      <h1 class="li__titulo">Um conjunto próprio, com o acabamento da marca.</h1>
      <ul class="li__regras">
        <li><strong>Grade de 24, traço 1,5</strong>, quinas vivas e pontas retas.</li>
        <li><strong>Chanfro de 45°</strong> nos retângulos, o mesmo das peças do site. O octógono vira forma de base; círculos seguem círculos.</li>
        <li><strong>Assinatura: o losango.</strong> Marca o ponto que importa em cada ícone e pode acender em amarelo.</li>
      </ul>
    </header>

    {[['escuro', 'Sobre o escuro'], ['claro', 'Sobre o claro']].map(([tom, nome]) => (
      <section class:list={['li__painel', `li__painel--${tom}`]}>
        <h2 class="li__painel-titulo">{nome}</h2>
        {grupos.map((g) => (
          <div class="li__grupo">
            <h3 class="li__grupo-titulo">{g}</h3>
            <ul class="li__grade">
              {nomes.filter((n) => ICONES_RENKE[n].grupo === g).map((n) => (
                <li class="li__item"><IconeRenke nome={n} size={32} /><span>{ICONES_RENKE[n].rotulo}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section class="li__painel li__painel--escuro">
      <h2 class="li__painel-titulo">Tamanhos (16, 20, 24, 32, 48)</h2>
      <div class="li__tamanhos">
        {(['seta-diagonal', 'menu', 'verificado', 'mira', 'agenda', 'investimento'] as NomeIconeRenke[]).map((n) => (
          <div class="li__linha-tam">{[16, 20, 24, 32, 48].map((s) => <IconeRenke nome={n} size={s} />)}</div>
        ))}
      </div>
    </section>

    <section class="li__painel li__painel--escuro">
      <h2 class="li__painel-titulo">Antes (Lucide) e depois (Renke)</h2>
      <ul class="li__comparacao">
        {comparar.map((n) => (
          <li><span class="li__antes"><Icone nome={(ICONES_RENKE[n] as { substitui: string }).substitui as any} size={28} /></span><IconeRenke nome={n} size={28} /><span>{ICONES_RENKE[n].rotulo}</span></li>
        ))}
      </ul>
    </section>

    <section class="li__painel li__painel--escuro li__painel--contexto">
      <h2 class="li__painel-titulo">Nos cartões dos ganhos</h2>
      <ul class="li__cartoes">
        {perguntas.map((p, i) => (
          <li class="li__cartao">
            <span class="li__anel"><IconeRenke nome={ganhos[i]} size={22} /></span>
            <div><h3>{p.titulo}</h3><p>{p.texto}</p></div>
          </li>
        ))}
      </ul>
      <h2 class="li__painel-titulo">Nas pílulas das ilustrações e nos botões</h2>
      <div class="li__pilulas">
        {pilulas.map((n) => <span class="li__pilula"><IconeRenke nome={n} size={16} />{ICONES_RENKE[n].rotulo}</span>)}
      </div>
      <div class="li__botoes">
        <span class="li__botao">Conhecer solução <IconeRenke nome="seta-diagonal" size={18} /></span>
        <span class="li__botao li__botao--claro">Ver os planos <IconeRenke nome="seta" size={18} /></span>
        <span class="li__selo"><span class="li__selo-marca"><IconeRenke nome="brilho" size={16} /></span>O que muda na sua clínica</span>
      </div>
    </section>
  </main>
</Base2>

<style is:global>
  .lab-icones { background: #050505; }
  .li { --icone-acento: var(--destaque, #FFD103); width: min(100% - 32px, 1240px); margin: 0 auto; padding: 120px 0 96px; display: grid; gap: 24px; color: #f2f2ee; }
  .li__rotulo { margin: 0 0 16px; font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; color: rgb(242 242 238 / .6); }
  .li__titulo { margin: 0; max-width: 20ch; font-size: clamp(32px, 3.4vw, 52px); font-weight: 300; line-height: 1.08; letter-spacing: -.045em; }
  .li__regras { margin: 28px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; max-width: 70ch; color: rgb(242 242 238 / .7); font-size: 16px; line-height: 1.55; }
  .li__regras strong { color: #f2f2ee; font-weight: 500; }
  .li__painel { padding: clamp(24px, 3vw, 48px); border-radius: 18px; border: 1px solid rgb(255 255 255 / .07); background: #0e0e0e; }
  .li__painel--claro { background: #e9e9e6; color: #1d1d1b; border-color: transparent; --icone-acento: #1d1d1b; }
  .li__painel-titulo { margin: 0 0 24px; font-size: 20px; font-weight: 400; letter-spacing: -.02em; }
  .li__grupo + .li__grupo { margin-top: 32px; }
  .li__grupo-titulo { margin: 0 0 14px; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; opacity: .55; }
  .li__grade { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 8px; }
  .li__item { display: grid; justify-items: center; gap: 12px; padding: 22px 8px 16px; border-radius: 12px; background: rgb(255 255 255 / .03); font-size: 12px; text-align: center; opacity: .92; }
  .li__painel--claro .li__item { background: rgb(0 0 0 / .035); }
  .li__item span { opacity: .7; }
  .li__tamanhos { display: grid; gap: 18px; }
  .li__linha-tam { display: flex; align-items: center; gap: 28px; }
  .li__comparacao { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .li__comparacao li { display: flex; align-items: center; gap: 16px; padding: 14px 16px; border-radius: 12px; background: rgb(255 255 255 / .03); font-size: 13px; }
  .li__comparacao li > span:last-child { opacity: .7; }
  .li__antes { color: rgb(242 242 238 / .45); display: inline-flex; padding-right: 16px; border-right: 1px solid rgb(255 255 255 / .1); }
  .li__cartoes { margin: 0 0 40px; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .li__cartao { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; min-height: 250px; padding: 26px; border-radius: 18px; border: 1px solid rgb(255 255 255 / .09); background: linear-gradient(160deg, rgb(255 255 255 / .07), rgb(255 255 255 / .025)); }
  .li__cartao h3 { margin: 0 0 10px; font-size: 24px; font-weight: 400; letter-spacing: -.025em; line-height: 1.15; }
  .li__cartao p { margin: 0; font-size: 15px; line-height: 1.55; color: rgb(242 242 238 / .66); }
  .li__anel { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid rgb(255 255 255 / .14); border-radius: 50%; color: var(--destaque, #FFD103); }
  .li__pilulas, .li__botoes { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .li__botoes { margin-top: 28px; gap: 16px; }
  .li__pilula { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 16px 0 12px; border-radius: 99px; border: 1px solid rgb(255 255 255 / .1); background: rgb(255 255 255 / .04); font-size: 13.5px; color: #c9c9c4; --icone-acento: #c9c9c4; }
  .li__botao { display: inline-flex; align-items: center; gap: 14px; height: 48px; padding: 0 22px; border-radius: 10px; background: #f2f2ee; color: #161616; font-size: 15px; font-weight: 500; }
  .li__botao--claro { background: transparent; color: #f2f2ee; border: 1px solid rgb(255 255 255 / .3); }
  .li__selo { display: inline-flex; align-items: center; gap: 12px; height: 45px; padding: 0 20px 0 6px; border-radius: 6px; background: #161616; border: 1px solid rgb(255 255 255 / .12); font-size: 16px; font-weight: 500; }
  .li__selo-marca { display: grid; place-items: center; width: 33px; height: 33px; border-radius: 5px; background: #0a0a0a; color: var(--destaque, #FFD103); }
</style>
