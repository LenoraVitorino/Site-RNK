---
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/design-system.css';

/* Atualizado em 11/10/2026: a página mostra o sistema como ele está na home
   (tokens-v2.css e home2.css). Pouco texto: cada tópico é uma amostra e uma
   ficha curta. O registro do que mudou fica no fim, em linhas com filtro.
   O moodboard saiu por enquanto (Lenora, 11/10). */
const atualizado = '11/10/2026';

const pilares = [
  ['Luz filtrada', 'Um véu de luz sobre o preto, como a tarde numa cortina de linho.'],
  ['Operação à vista', 'A tela de quem trabalha, com gente real. Sem número inventado.'],
  ['Calma que custa caro', 'Vidro, fio fino e vazio. Impressiona pelo acabamento.'],
  ['Amarelo como assinatura', 'Um ponto: ícone, rótulo ou botão. Nunca uma dobra.'],
  ['Movimento que acompanha', 'Lento e em sequência. O fundo anda com a rolagem.'],
];

const nunca = ['Cor viva em bloco', 'Neon', 'Caixa dentro de caixa', 'Sombra pesada', 'Ilustração com cara de IA', 'Métrica inventada', 'Cara de agência'];

const cores = [
  { nome: 'Preto', hex: '#000000', papel: 'Fundo' },
  { nome: 'Painel', hex: '#0B0B0B', papel: 'Segundo plano' },
  { nome: 'Superfície', hex: '#111111', papel: 'Cartões' },
  { nome: 'Grafite', hex: '#161616', papel: 'Texto sobre claro' },
  { nome: 'Papel', hex: '#F2F2EE', papel: 'Texto' },
  { nome: 'Cinza', hex: '#A3A39B', papel: 'Texto de apoio' },
  { nome: 'Amarelo Renke', hex: '#FFD103', papel: 'Só detalhe' },
  { nome: 'Amarelo', hex: '#FFE27A', papel: 'Painéis' },
  { nome: 'Amarelo claro', hex: '#FFEBA3', papel: 'Hover' },
];

const escala = [
  { nome: 'Título de dobra', uso: '32–56px · 300', estilo: 'font-size:clamp(2rem,3.6vw,3.5rem);font-weight:300;letter-spacing:-.035em;line-height:1.04' },
  { nome: 'Pergunta', uso: '32–46px · 300', estilo: 'font-size:clamp(1.6rem,2.9vw,2.875rem);font-weight:300;letter-spacing:-.02em;line-height:1.1' },
  { nome: 'Tópico', uso: '24–32px · 300', estilo: 'font-size:clamp(24px,2.1vw,32px);font-weight:300;line-height:1.1' },
  { nome: 'Corpo', uso: '16–18px · 400', estilo: 'font-size:clamp(16px,1.25vw,18px);font-weight:400' },
  { nome: 'Botão e rótulo', uso: '15px · 500', estilo: 'font-size:15px;font-weight:500' },
  { nome: 'Legenda', uso: '12px · caixa alta', estilo: 'font-size:12px;letter-spacing:.09em;text-transform:uppercase' },
];

const raios = [
  { nome: 'Botões', valor: '999px' },
  { nome: 'Painéis', valor: '26–34px', raio: '30px' },
  { nome: 'Campos', valor: '16px' },
  { nome: 'Peças de cena', valor: '14px' },
  { nome: 'Selo de ícone', valor: '12px' },
];

const medidas = [
  ['Largura do conteúdo', '1560px'],
  ['Laterais', '24–136px'],
  ['Entre dobras', '72–128px'],
  ['Entre fileiras da lista', '96–168px'],
  ['Pergunta e resposta', '26–36px'],
];

const movimento = [
  ['Títulos', 'Palavra por palavra · 60 ms'],
  ['Cartões', 'Em sequência · 110 ms'],
  ['Lista', 'Dos lados, com a rolagem'],
  ['Cenas', 'Ciclo de 8,5 s · pulo curto'],
  ['Fundo', 'Desde a abertura, anda com a rolagem'],
];

/* Registro: [tipo, item, nota curta]. */
const registro = [
  ['novo', 'Lista “O que muda na sua clínica”', 'Fileiras em zigue-zague, no lugar do trilho'],
  ['novo', 'Resposta “Com a Renke”', 'Rótulo amarelo com selo de ícone'],
  ['novo', 'Resultados em cases', 'Número grande e gráfico'],
  ['novo', 'Cantos do palco dos planos', 'Lista vertical e traços'],
  ['novo', 'Entradas das dobras', 'Títulos palavra por palavra'],
  ['novo', 'Prévia pública da home', 'Só a home, menu travado'],
  ['alterado', 'Tipografia', 'Inter em 300, 400 e 500'],
  ['alterado', 'Botões', 'Todos em pílula'],
  ['alterado', 'Formulário', 'Vidro arredondado, campos preenchidos'],
  ['alterado', 'Contraste das cenas', 'Painel mais escuro, peças mais claras'],
  ['alterado', 'Palco dos planos', 'Textos em diagonal'],
  ['alterado', 'Ecossistema', 'Acabamento novo, sem números'],
  ['alterado', 'Rodapé', 'RENKE em vidro leve'],
  ['alterado', 'Fundo animado', 'Cena original, desde a abertura'],
  ['alterado', 'Cenas dos painéis', 'Mais rápidas e vivas'],
  ['sugestao', 'Licenciar os arquivos do fundo', 'Antes de publicar'],
  ['sugestao', 'Formulário com envio próprio', 'Hoje abre e-mail ou WhatsApp'],
  ['sugestao', 'Apagar páginas de teste', 'Laboratório e componentes antigos'],
  ['sugestao', 'Tirar os botões antigos', 'Ainda vivem nas subpáginas'],
  ['pendente', 'Fotos dos doutores', 'Hoje são da equipe'],
  ['pendente', 'Fotos do ecossistema', 'Academy e Tools'],
  ['pendente', 'Logos de clientes', 'O convite repete o da Renke'],
  ['pendente', 'Números e textos', 'Validar cases e respostas'],
  ['pendente', 'Subpáginas', 'Planos, Sobre e Faça parte'],
  ['pendente', 'Logo em SVG', 'Três versões'],
];
const nomes: Record<string, string> = { novo: 'Adicionado', alterado: 'Alterado', sugestao: 'Sugestão', pendente: 'Falta' };
const conta = (t: string) => registro.filter((r) => r[0] === t).length;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Design System — Renke</title>
  <meta name="description" content="Design system do site da Renke: conceito, referências, fundamentos, componentes e registro de mudanças." />
</head>
<body class="ds">

<header class="ds__topo">
  <img src="/marca/renke-monograma.png" alt="Monograma Renke" width="44" height="44" />
  <div>
    <h1>Design System</h1>
    <p>Renke · atualizado em {atualizado}</p>
  </div>
</header>

<div class="ds__grade">
<nav class="ds__lateral" aria-label="Tópicos">
  <p>Direção</p>
  <a href="#conceito">Conceito</a>
  <p>Fundamentos</p>
  <a href="#cor">Cor</a>
  <a href="#tipografia">Tipografia</a>
  <a href="#forma">Forma e espaço</a>
  <p>Componentes</p>
  <a href="#botoes">Botões</a>
  <a href="#painel">Painel de vidro</a>
  <a href="#resposta">Pergunta e resposta</a>
  <a href="#campo">Formulário</a>
  <a href="#cantos">Detalhes de canto</a>
  <a href="#movimento">Movimento</a>
  <p>Registro</p>
  <a href="#mudou">O que mudou</a>
</nav>

<main class="ds__corpo">

  <section class="ds__secao" id="conceito">
    <small class="ds-olho">Conceito</small>
    <p class="ds-conceito">Uma clínica de alto padrão, traduzida em site: <strong>luz filtrada sobre o preto</strong>, operação à vista e nenhum exagero.</p>
    <div class="ds-pilares">
      {pilares.map(([titulo, texto], i) => (
        <article><small>{String(i + 1).padStart(2, '0')}</small><h3>{titulo}</h3><p>{texto}</p></article>
      ))}
    </div>
    <h3>Nunca entra</h3>
    <ul class="ds-chips">{nunca.map((n) => <li>{n}</li>)}</ul>
  </section>

  <section class="ds__secao" id="cor">
    <h2>Cor</h2>
    <p class="ds__intro">Base neutra. O amarelo é só detalhe.</p>
    <div class="ds__cores">
      {cores.map((c) => (
        <div class="ds__cor">
          <div class="ds__amostra" style={`background:${c.hex}`}></div>
          <strong>{c.nome}</strong>
          <code>{c.hex}</code>
          <p>{c.papel}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ds__secao" id="tipografia">
    <h2>Tipografia</h2>
    <p class="ds__intro">Inter. Títulos em 300, corpo em 400, destaque em 500.</p>
    <div class="ds-tipos">
      {escala.map((e) => (
        <div><span style={e.estilo}>Uma operação <b style="font-weight:500">estruturada</b></span><small>{e.nome} · {e.uso}</small></div>
      ))}
    </div>
  </section>

  <section class="ds__secao" id="forma">
    <h2>Forma e espaço</h2>
    <div class="ds__formas">
      {raios.map((r) => (
        <div class="ds__forma" style={`border-radius:${r.raio ?? r.valor}`}><code>{r.valor}</code><small>{r.nome}</small></div>
      ))}
    </div>
    <dl class="ds-ficha">{medidas.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>

  <section class="ds__secao" id="botoes">
    <h2>Botões</h2>
    <p class="ds__intro">Todos em pílula. O amarelo aparece uma vez por tela.</p>
    <div class="ds__demo ds__demo--escura">
      <a class="dsh-botao dsh-botao--amarelo" href="#botoes">Conhecer solução<i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></i></a>
      <a class="dsh-botao" href="#botoes">Contato<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg></a>
      <a class="dsh-botao dsh-botao--claro" href="#botoes">Enviar</a>
    </div>
    <dl class="ds-ficha">
      <div><dt>Amarelo com seta</dt><dd>Ação principal</dd></div>
      <div><dt>Contorno</dt><dd>Secundária e menu</dd></div>
      <div><dt>Claro</dt><dd>Envio de formulário</dd></div>
    </dl>
  </section>

  <section class="ds__secao" id="painel">
    <h2>Painel de vidro</h2>
    <p class="ds__intro">Cartões, formulário e cenas. Nunca caixa dentro de caixa.</p>
    <div class="ds__demo ds__demo--textura">
      <div class="dsh-painel">
        <div class="dsh-cena">
          <div class="dsh-bloco">
            <div class="dsh-linha">Mídia paga<span class="dsh-chips"><b>Google</b><b>Instagram</b></span></div>
            <div class="dsh-linha">Pacientes novos<span class="dsh-chips"><b>3</b></span></div>
          </div>
          <div class="dsh-resultado"><i></i><div><strong>Custo por paciente</strong><span>Calculado por canal, todo mês</span></div></div>
        </div>
      </div>
    </div>
    <dl class="ds-ficha">
      <div><dt>Painel</dt><dd>Base escura a 92% · fio de 1px</dd></div>
      <div><dt>Peças</dt><dd><code>#2d2d2b</code> · fio a 14%</dd></div>
      <div><dt>Etiquetas</dt><dd><code>#414140</code></dd></div>
      <div><dt>Resultado</dt><dd><code>#F2F2EE</code> com ponto amarelo</dd></div>
    </dl>
  </section>

  <section class="ds__secao" id="resposta">
    <h2>Pergunta e resposta</h2>
    <div class="ds__demo ds__demo--escura">
      <div class="dsh-fala">
        <p class="dsh-pergunta">Quanto custa, de verdade, um <strong>paciente novo</strong> pra sua clínica?</p>
        <span class="dsh-marca"><i class="dsh-selo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v9h9" /><path d="M20.5 15.5A9 9 0 1 1 8.5 3.5" /></svg></i><b>Com a Renke</b></span>
        <p class="dsh-resposta"><strong>Você passa a saber.</strong> A gente mostra o custo por paciente e o retorno de cada canal.</p>
      </div>
    </div>
    <dl class="ds-ficha">
      <div><dt>Rótulo</dt><dd>Amarelo · 500 · ícone na mesma linha</dd></div>
      <div><dt>Selo</dt><dd>38px · vidro</dd></div>
      <div><dt>Computador</dt><dd>Fileiras em zigue-zague</dd></div>
      <div><dt>Celular</dt><dd>Texto em cima, painel embaixo</dd></div>
    </dl>
  </section>

  <section class="ds__secao" id="campo">
    <h2>Formulário</h2>
    <div class="ds__demo ds__demo--escura">
      <label class="dsh-campo"><span>Nome</span><input type="text" placeholder="Como podemos te chamar?" /></label>
    </div>
    <dl class="ds-ficha">
      <div><dt>Campo</dt><dd>Preenchido · 16px de canto</dd></div>
      <div><dt>Foco</dt><dd>Anel amarelo</dd></div>
      <div><dt>Cartão</dt><dd>Painel de vidro</dd></div>
    </dl>
  </section>

  <section class="ds__secao" id="cantos">
    <h2>Detalhes de canto</h2>
    <p class="ds__intro">No palco dos planos.</p>
    <div class="ds__demo ds__demo--escura dsh-cantos">
      <ul class="dsh-legenda"><li>Start</li><li class="dsh-atual">Full</li><li>Growth</li><li>Scale</li><li>Prime</li></ul>
      <span class="dsh-tracos"><i></i><i class="dsh-atual"></i><i></i><i></i><i></i></span>
    </div>
    <dl class="ds-ficha">
      <div><dt>Lista</dt><dd>Vertical · caixa alta · atual em contraste</dd></div>
      <div><dt>Traços</dt><dd>14px · atual com 24px</dd></div>
    </dl>
  </section>

  <section class="ds__secao" id="movimento">
    <h2>Movimento</h2>
    <p class="ds__intro">Lento e amortecido. Desliga com movimento reduzido.</p>
    <div class="ds__demo ds__demo--escura">
      <p class="dsh-palavras" aria-label="O que muda quando a operação tem estrutura.">
        {'O que muda quando a operação tem estrutura.'.split(' ').map((w, i) => <span style={`--p:${i}`}>{w}&nbsp;</span>)}
      </p>
    </div>
    <dl class="ds-ficha">{movimento.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>

  <section class="ds__secao" id="mudou">
    <h2>O que mudou</h2>
    <div class="ds-filtro" role="group" aria-label="Filtrar o registro">
      <button type="button" data-filtro="" aria-pressed="true">Tudo <small>{registro.length}</small></button>
      {Object.keys(nomes).map((t) => <button type="button" data-filtro={t} aria-pressed="false">{nomes[t]} <small>{conta(t)}</small></button>)}
    </div>
    <ul class="ds-linhas">
      {registro.map(([tipo, item, nota]) => (
        <li data-tipo={tipo}><span class={`ds-tag ds-tag--${tipo}`}>{nomes[tipo]}</span><strong>{item}</strong><span>{nota}</span></li>
      ))}
    </ul>
  </section>

</main>
</div>

<footer class="ds__rodape">
  <p>Renke · design system · {atualizado}</p>
</footer>

<script is:inline>
  (function () {
    /* Marca na barra lateral o tópico que está na tela. */
    var links = document.querySelectorAll('.ds__lateral a');
    var alvos = [].map.call(links, function (a) { return document.querySelector(a.getAttribute('href')); });
    function marcar() {
      var atual = 0;
      alvos.forEach(function (el, i) { if (el && el.getBoundingClientRect().top < innerHeight * .35) atual = i; });
      links.forEach(function (a, i) { a.toggleAttribute('aria-current', i === atual); });
    }
    addEventListener('scroll', marcar, { passive: true }); marcar();

    /* Filtro do registro. */
    var botoes = document.querySelectorAll('.ds-filtro button');
    var linhas = document.querySelectorAll('.ds-linhas li');
    botoes.forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.dataset.filtro;
        botoes.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)); });
        linhas.forEach(function (l) { l.hidden = !!f && l.dataset.tipo !== f; });
      });
    });
  })();
</script>

</body>
</html>
