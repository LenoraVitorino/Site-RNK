---
/**
 * Sobre a Renke. Layout editorial desde 04/10/2026 (a Lenora pediu a página
 * "moderna, profissional, design sofisticado"; na mesma noite, "não perder
 * a identidade da home"): a home com o texto sobre as fotos dos carrosséis
 * da Renke. Ritmo: capa com foto, painel claro, cena, painel claro, cena,
 * painel claro e o fecho na cena. Estilos comuns em src/styles/editorial.css;
 * o que é de uma dobra só fica no <style> dela, em src/components/sobre/.
 *
 * Todo o texto vem de src/data/sobre.ts, que separa o das duas versões.
 */
import Base2 from '../layouts/Base2.astro';          // primeiro: a ordem do CSS depende disso
import FundoInterno from '../components/pagina/FundoInterno.astro';
import BlocoCtaFinal from '../components/pagina/BlocoCtaFinal.astro';
import type { ContextoSecao } from '../components/pagina/contexto';
import SobreAbertura from '../components/sobre/SobreAbertura.astro';
import SobreManifesto from '../components/sobre/SobreManifesto.astro';
import SobreTese from '../components/sobre/SobreTese.astro';
import SobreProva from '../components/sobre/SobreProva.astro';
import SobreCasa from '../components/sobre/SobreCasa.astro';
import SobreCultura from '../components/sobre/SobreCultura.astro';
import '../styles/paginas2.css';
import '../styles/editorial.css';
import { seo, fecho } from '../data/sobre';

/** O fecho é um BlocoCtaFinal comum, de volta à cena, no quadro do formulário. */
const secaoFecho: ContextoSecao = {
  id: 'sobre-fecho', tituloId: 'sobre-fecho-titulo', indice: 6,
  cena: 'formulario', tom: 'cena', junta: false, colaAbaixo: false, primeira: false,
};
---
<Base2 titulo={seo.titulo} descricao={seo.descricao} classe="home-refinada pg-sobre pg-editorial">
  <FundoInterno slot="fundo" />
  <SobreAbertura />
  <SobreManifesto />
  <SobreTese />
  <SobreProva />
  <SobreCasa />
  <SobreCultura />
  <BlocoCtaFinal bloco={fecho} secao={secaoFecho} />
</Base2>
