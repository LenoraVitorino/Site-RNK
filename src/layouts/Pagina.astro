---
/**
 * Casca das páginas internas no sistema da home (27/09/2026): Base2 com o
 * body .home-refinada, a cena ao fundo (FundoInterno) e os blocos de
 * src/data/paginas/ desenhados pelo despachante (Blocos2), mais o índice
 * lateral da página. Especificação: docs/04-design/paginas-internas.md.
 */
import Base2 from './Base2.astro';
import FundoInterno from '../components/pagina/FundoInterno.astro';
import Blocos2 from '../components/pagina/Blocos2.astro';
import IndicePagina from '../components/pagina/IndicePagina.astro';
import { indiceDaPagina, planejarSecoes } from '../components/pagina/contexto';
import '../styles/paginas2.css';
import type { Pagina } from '../data/paginas/tipos';

interface Props {
  pagina: Pagina;
}

const { pagina } = Astro.props;
const indice = indiceDaPagina(planejarSecoes(pagina.blocos, pagina.rota));
---
<Base2 titulo={pagina.titulo} descricao={pagina.descricao} classe="home-refinada">
  <FundoInterno slot="fundo" />
  <Blocos2 blocos={pagina.blocos} rota={pagina.rota} />
  <IndicePagina itens={indice} />
</Base2>
