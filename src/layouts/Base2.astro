---
/**
 * Casca da home v2. Mesma estrutura da Base, com a folha nova (home2.css)
 * e a Instrument Sans self-hosted. As internas continuam na Base até
 * migrarem para o sistema novo.
 */
import '@fontsource-variable/inter/wght.css';          // uma família só: títulos finos, corpo, destaques
import '@fontsource-variable/inter/wght-italic.css';   // as falas dos doutores, em itálico
/* Pré-carrega o arquivo latino da Inter: sem isso a hero pinta na fonte do
   sistema e troca no meio da entrada. */
import interLatina from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/home2.css';
import '../styles/home-refinamento.css';
import '../styles/icones.css';
import '../styles/sem-contornos.css';
import '../styles/header-menu.css';
import '../styles/movimento.css';           // por último: entradas e detalhes de movimento
import '../styles/botao-pilula.css';        // forma e cor dos botões (05/10)
import '../styles/responsivo.css';          // revisão de celular, tablet e desktops menores (09/10)
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descricao: string;
  /** Páginas de teste (laboratório): fora dos buscadores. */
  noindex?: boolean;
  /** Classe extra no <body>, para estilos de uma página só. */
  classe?: string;
}
const { titulo, descricao, noindex = false, classe } = Astro.props;
/**
 * Prévia só da home (11/10/2026): com `PREVIA=home` no build, o visitante vê
 * o site inteiro da home — menu abrindo, âncoras, formulário — mas os links
 * que levam a outras páginas ficam travados, com o aviso "Em breve".
 *   PREVIA=home npm run build
 */
const previaHome = process.env.PREVIA === 'home';
const cssPrevia = `
[data-previa] a[data-travado] { cursor: not-allowed; }
.previa-aviso { position: fixed; z-index: 2000; left: 50%; bottom: 28px; translate: -50% 12px; padding: 10px 16px; border-radius: 999px; background: #F2F2EE; color: #161616; font: 500 14px/1.2 Inter, system-ui, sans-serif; white-space: nowrap; box-shadow: 0 16px 32px -12px rgb(0 0 0 / .6); opacity: 0; pointer-events: none; transition: opacity .3s ease, translate .3s ease; }
.previa-aviso[data-on] { opacity: 1; translate: -50% 0; }
`;
/* Trava os links para outras páginas. Âncoras da própria home, e-mail,
   telefone e sites de fora continuam funcionando; "Contato" leva ao
   formulário da home. */
const jsPrevia = `(function () {
  var caminho = function (a) { return (a.getAttribute('href') || '').split('#')[0].replace(/[/]$/, ''); };
  var externa = function (a) { var h = a.getAttribute('href') || ''; return !h || h[0] === '#' || /^(mailto:|tel:|https?:|[/][/])/i.test(h); };
  var contato = function (a) { return !externa(a) && caminho(a) === '/contato'; };
  var interna = function (a) { return !externa(a) && caminho(a) !== '' && !contato(a); };
  var aviso, relogio;
  var avisar = function () {
    if (!aviso) { aviso = document.createElement('div'); aviso.className = 'previa-aviso'; aviso.setAttribute('role', 'status'); aviso.textContent = 'Esta página fica disponível em breve.'; document.body.appendChild(aviso); }
    aviso.setAttribute('data-on', '');
    clearTimeout(relogio);
    relogio = setTimeout(function () { aviso.removeAttribute('data-on'); }, 2200);
  };
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('a[href]').forEach(function (a) {
      if (interna(a)) { a.setAttribute('data-travado', ''); a.setAttribute('aria-disabled', 'true'); a.setAttribute('title', 'Em breve'); }
    });
  });
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
    if (!a) return;
    var h = a.getAttribute('href') || '';
    if (interna(a)) { e.preventDefault(); e.stopImmediatePropagation(); avisar(); return; }
    var id = contato(a) ? 'formulario' : (h.indexOf('/#') === 0 ? h.slice(2) : '');
    var alvo = id && document.getElementById(id);
    if (alvo) { e.preventDefault(); e.stopImmediatePropagation(); alvo.scrollIntoView({ behavior: 'smooth' }); }
  }, true);
})();`;
---
<!doctype html>
<html lang="pt-BR" data-previa={previaHome ? 'home' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  {(noindex || previaHome) && <meta name="robots" content="noindex, nofollow" />}
  <link rel="preload" href={interLatina} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/marca/renke-monograma.png" type="image/png" />
  <script is:inline>
    /* Marca que o JS está vivo antes da primeira pintura. Só então o CSS
       esconde o que vai entrar animado. Sem JS, tudo nasce visível. */
    document.documentElement.classList.add('js');
  </script>
  {previaHome && <style is:inline set:html={cssPrevia} />}
  {previaHome && <script is:inline set:html={jsPrevia} />}
</head>
<body class={classe}>
  <slot name="fundo" />
  <Header />
  <main id="conteudo" class="trilhos">
    <slot />
  </main>
  <Footer />

  <script>
    /* Revela os blocos conforme entram na viewport. */
    const alvos = document.querySelectorAll('.entra');
    if (alvos.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('visivel');
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );
      alvos.forEach((a) => obs.observe(a));
    } else {
      alvos.forEach((a) => a.classList.add('visivel'));
    }
  </script>
</body>
</html>
